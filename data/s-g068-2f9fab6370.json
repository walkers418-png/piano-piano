,"parlare"],[38,44,"ancora"],[45,48,"di"],[49,52,"mio"],[53,63,0]]},{"it":"- Tu non l’hai mai visto? - ha domandato a Virginia.","ja":"","t":[[2,4,"tu"],[5,8,"non"],[9,10,"il"],[11,14,"avere"],[15,18,"mai"],[19,24,"vedere"],[28,30,"avere"],[31,40,"domandare"],[41,42,"a"],[43,51,0]]},{"it":"- No.","ja":"","t":[[2,4,"no"]]},{"it":"- Faglielo vedere, Giannino: vedrai ci siamo tutti, e come somiglianti!","ja":"","t":[[2,10,"fare"],[11,17,"vedere"],[19,27,0],[29,35,"vedere"],[36,38,"ci"],[39,44,"essere"],[45,50,"tutto"],[52,53,"e"],[54,58,"come"],[59,70,0]]},{"it":"Giannino è un artista! -","ja":"","t":[[0,8,0],[9,10,"essere"],[11,13,"un"],[14,21,"artista"]]},{"it":"Io tutto contento ho preso il giornalino e ho mostrato a mia sorella le figure, ma ho proibito a tutti di leggerlo, perché voglio che i miei pensieri rimangano segreti.","ja":"","t":[[0,2,"io"],[3,8,"tutto"],[9,17,"contento"],[18,20,"avere"],[21,26,"prendere"],[27,29,"il"],[30,40,0],[41,42,"e"],[43,45,"avere"],[46,54,"mostrare"],[55,56,"a"],[57,60,"mio"],[61,68,"sorella"],[69,71,"il"],[72,78,"figura"],[80,82,"ma"],[83,85,"avere"],[86,94,"proibire"],[95,96,"a"],[97,102,"tutto"],[103,105,"di"],[106,114,"leggere"],[116,122,"perché"],[123,129,"volere"],[130,133,"che"],[134,135,"il"],[136,140,"mio"],[141,149,"pensiero"],[150,159,"rimanere"],[160,167,"segreto"]]},{"it":"Però, nonostante la mia proibizione, a un certo punto, Virginia ha esclamato:","ja":"","t":[[0,4,"però"],[6,16,"nonostante"],[17,19,"il"],[20,23,"mio"],[24,35,0],[37,38,"a"],[39,41,"un"],[42,47,"certo"],[48,53,"punto"],[55,63,0],[64,66,"avere"],[67,76,"esclamare"]]},{"it":"- Ah, guarda: qui c’è il nostro sposalizio di San Francesco al Monte! - A queste parole mio cognato s’è slanciato sul giornalino e ha voluto vedere quelle pagine dove è descritto il mio viaggio sulla traversa dietro la carrozza e la scena che, successe quando li sorpresi tutti in chiesa e li rimproverai perché non mi avevano detto nulla.","ja":"","t":[[2,4,"ah"],[6,12,"guardare"],
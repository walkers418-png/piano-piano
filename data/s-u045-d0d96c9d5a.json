,[29,39,"attenzione"],[40,44,"quello"],[45,51,0],[52,57,"colore"],[58,60,"di"],[61,65,0],[67,71,"quello"],[72,79,"piccolo"],[80,85,"corpo"],[86,95,0],[96,98,"in"],[99,103,"quello"],[104,109,"panni"],[110,120,0],[121,122,"e"],[123,132,0],[134,140,"quello"],[141,146,"occhio"],[147,152,"buono"],[153,154,"e"],[155,161,"triste"],[163,166,"che"],[167,177,0],[178,179,"il"],[180,184,"suo"],[186,188,"ma"],[189,192,"che"],[193,203,"lasciare"],[204,214,"indovinare"],[215,218,"un"],[219,225,"storia"],[226,228,"di"],[229,238,0],[240,243,"poi"],[244,247,"il"],[248,253,"dire"],[254,257,"con"],[258,262,"voce"],[263,268,"pieno"],[269,271,"di"],[272,279,"affetto"],[281,294,"attaccare"],[295,297,"il"],[298,306,"medaglia"],[307,311,"a"],[312,318,"spalla"],[322,330,0],[332,334,"ti"],[335,337,0],[338,340,"il"],[341,349,"medaglia"]]},{"it":"Nessuno è più degno di te di portarla.","ja":"","t":[[0,7,"nessuno"],[8,9,"essere"],[10,13,"più"],[14,19,0],[20,22,"di"],[23,25,"te"],[26,28,"di"],[29,37,"portare"]]},{"it":"Non la dò soltanto alla tua intelligenza e al tuo buon volere, la dò al tuo cuore, la dò al tuo coraggio, al tuo carattere di bravo e buon figliuolo.","ja":"","t":[[0,3,"non"],[4,6,"il"],[7,9,0],[10,18,"soltanto"],[19,23,"a"],[24,27,"tuo"],[28,40,"intelligenza"],[41,42,"e"],[43,45,"a"],[46,49,"tuo"],[50,54,"buono"],[55,61,"volere"],[63,65,"il"],[66,68,0],[69,71,"a"],[72,75,"tuo"],[76,81,"cuore"],[83,85,"il"],[86,88,0],[89,91,"a"],[92,95,"tuo"],[96,104,"coraggio"],[106,108,"a"],[109,112,"tuo"],[113,122,"carattere"],[123,125,"di"],[126,131,"bravo"],[132,133,"e"],[134,138,"buono"],[139,148,"figliuolo"]]},{"it":"Non è vero, — soggiunse, voltandosi verso la classe, — che egli la merita anche per questo?","ja":"","t":[[0,3,"non"],[4,5,"essere"],[6,10,"vero"],[14,23,"dire"],[25,35,"voltare"],[36,41,"verso"],[42,44,"il"],[45,51,"classe"],[55,58,"che"],[59,63,"egli"],[64,66,"il"],[67,73,"meritare"],[74,79,"anche"],[80,83,"per"],[84,90,"questo"]]},{"it":"— Sì, sì, — risposero tutti a una voce.","ja":"","t":[[2,4,"sì"],[6,8,"sì"],[12,21,"rispondere"],[22,27,"tutto"],[28,29,"a"],[30,33,"un"],[34,38,"voce"]]},{"it":"Precossi fece un movimento del collo come per inghiottire qualche cosa, e girò sui banchi uno sguardo dolcissimo, che esprimeva una gratitudine immensa.","ja":"","t":[[0,8,0],[9,13,"fare"],[14,16,"un"],[17,26,"movimento"],[27,30,"di"],[31,36,"collo"],[37,41,"come"],[42,45,"per"],[46,57,"inghiottire"],[58,65,"qualche"],[66,70,"cosa"],[72,73,"e"],[74,78,"girare"],[79,82,"su"],[83,89,"banco"],[90,93,"un"],[94,101,"sguardo"],[102,112,"dolce"],[114,117,"che"],[118,127,"esprimere"],[128,131,"un"],[132,143,"gratitudine"],[144,151,"immenso"]]},{"it":"— Va’, dunque, gli disse il Sovrintendente, — caro ragazzo!","ja":"","t":[[2,4,"andare"],[7,13,"dunque"],[15,18,"il"],[19,24,"dire"],[25,27,"il"],[28,42,0],[46,50,"caro"],[51,58,"ragazzo"]]},{"it":"E Dio ti protegga!","ja":"","t":[[0,1,"e"],[2,5,"Dio"],[6,8,"ti"],[9,17,"proteggere"]]},{"it":"— Era l’ora d’uscire.","ja":"","t":[[2,5,"essere"],[6,7,"il"],[8,11,"ora"],[12,13,"di"],[14,20,"uscire"]]},{"it":"La nostra classe uscì avanti le altre.","ja":"","t":[[0,2,"il"],[3,9,"nostro"],[10,16,"classe"],[17,21,"uscire"],[22,28,"avanti"],[29,31,"il"],[32,37,"altro"]]},{"it":"Appena siamo fuori dell’uscio... chi vediamo lì nel camerone, proprio sull’entrata?","ja":"","t":[[0,6,"appena"],[7,12,"essere"],[13,18,"fuori"],[19,23,"di"],[24,29,"uscio"],[33,36,"chi"],[37,44,"vedere"],[45,47,"lì"],[48,51,"in"],[52,60,0],[62,69,"proprio"],[70,74,"su"],[75,82,"entrata"]]},{"it":"Il padre di Precossi, il fabbro ferraio, pallido, come al solito, col viso torvo, coi capelli negli occhi, col berretto per traverso, malfermo sulle gambe.","ja":"","t":[[0,2,"il"],[3,8,"padre"],[9,11,"di"],[12,20,0],[22,24,"il"],[25,31,"fabbro"],[32,39,0],[41,48,"pallido"],[50,54,"come"],[55,57,"a"],[58,64,"solito"],[66,69,"con"],[70,74,"viso"],[75,80,0],[82,85,"con"],[86,93,"capello"],[94,99,"in"],[100,105,"occhio"],[107,110,"con"],[111,119,"berr
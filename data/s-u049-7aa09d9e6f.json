{"id":"u049","title":"Febbraio・I feriti del lavoro","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"I FERITI DEL LAVORO","ja":"","t":[[0,1,"il"],[2,8,"ferito"],[9,12,"di"],[13,19,"lavoro"]]},{"it":"13, lunedì","ja":"","t":[[4,10,"lunedì"]]},{"it":"Nobis può fare il paio con Franti: non si commossero nè l’uno nè l’altro, questa mattina, davanti allo spettacolo terribile che ci passò sotto gli occhi.","ja":"","t":[[0,5,0],[6,9,"potere"],[10,14,"fare"],[15,17,"il"],[18,22,"paio"],[23,26,"con"],[27,33,0],[35,38,"non"],[39,41,"si"],[42,52,0],[53,55,"né"],[56,57,"il"],[58,61,"un"],[62,64,"né"],[65,66,"il"],[67,72,"altro"],[74,80,"questo"],[81,88,"mattina"],[90,97,"davanti"],[98,102,"a"],[103,113,"spettacolo"],[114,123,"terribile"],[124,127,"che"],[128,130,"ci"],[131,136,"passare"],[137,142,"sotto"],[143,146,"il"],[147,152,"occhio"]]},{"it":"Uscito dalla scuola, stavo con mio padre a guardar certi birbaccioni della seconda, che si buttavan ginocchioni per terra a strofinare il ghiaccio con le mantelline e con le berrette, per far gli sdruccioloni più lesti, quando vedemmo venir d’in fondo alla strada una folla di gente, a passo affrettato, tutti seri e come spaventati, che parlavano a voce bassa.","ja":"","t":[[0,6,"uscire"],[7,12,"da"],[13,19,"scuola"],[21,26,"stare"],[27,30,"con"],[31,34,"mio"],[35,40,"padre"],[41,42,"a"],[43,50,"guardare"],[51,56,"certo"],[57,68,0],[69,74,"di"],[75,82,"secondo"],[84,87,"che"],[88,90,"si"],[91,99,0],[100,111,0],[112,115,"per"],[116,121,"terra"],[122,123,"a"],[124,134,"strofinare"],[135,137,"il"],[138,146,"ghiaccio"],[147,150,"con"],[151,153,"il"],[154,164,0],[165,166,"e"],[167,170,"con"],[171,173,"il"],[174,182,0],[184,187,"per"],[188,191,"fare"],[192,195,"il"],[196,208,0],[209,212,"più"],[213,218,"lesto"],[220,226,"quando"],[227,234,"vedere"],[235,240,"venire"],[241,242,"di"],[243,245,"in"],[246,251,"fondo"],[252,256,"a"],[257,263,"strada"],[264,267,"un"],[268,273,"folla"],[274,276,"di"
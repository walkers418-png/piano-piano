ine"],[10,12,"mi"],[13,19,"decidere"],[20,21,"a"],[22,32,"ripigliare"],[33,35,"il"],[36,39,"mio"],[40,46,"lavoro"],[47,53,"dentro"],[54,55,"il"],[56,66,"armadietto"],[68,70,"il"],[71,78,"segnale"],[79,82,"con"],[83,88,"quale"],[89,91,"il"],[92,102,0],[103,105,"mi"],[106,111,"avere"],[112,117,"prima"],[118,128,0],[129,131,"il"],[132,135,"suo"],[136,144,"presenza"],[145,147,"mi"],[148,153,"avere"],[154,163,"suggerire"],[164,166,"il"],[167,171,"modo"],[172,174,"di"],[175,181,0],[182,187,"senza"],[188,196,"pericolo"],[197,199,"il"],[200,204,"tela"],[205,208,"che"],[209,216,"rendere"],[217,224,"inutile"],[225,227,"il"],[228,231,"mio"],[232,244,"osservatorio"]]},{"it":"Ma prima di accingermi a tal lavoro ho voluto allargare la buca, e adoperando con tutta la prudenza possibile lo scalpello nelle connessiture dei quattro lati di un mattone riuscii a indebolirlo talmente che finì con lo staccarsi.","ja":"","t":[[0,2,"ma"],[3,8,"prima"],[9,11,"Dio"],[12,22,0],[23,24,"a"],[25,28,0],[29,35,"lavoro"],[36,38,"avere"],[39,45,"volere"],[46,55,"allargare"],[56,58,"il"],[59,63,"buca"],[65,66,"e"],[67,77,"adoperare"],[78,81,"con"],[82,87,"tutto"],[88,90,"il"],[91,99,"prudenza"],[100,109,"possibile"],[110,112,"il"],[113,122,"scalpello"],[123,128,"in"],[129,141,0],[142,145,"di"],[146,153,"quattro"],[154,158,"lato"],[159,161,"di"],[162,164,"un"],[165,172,"mattone"],[173,180,"riuscire"],[181,182,"a"],[183,194,0],[195,203,"talmente"],[204,207,"che"],[208,212,"finire"],[213,216,"con"],[217,219,"il"],[220,229,"staccare"]]},{"it":"Ora avevo dinanzi a me un vero e proprio finestrino che potevo a mio talento richiudere e riaprire, rimettendo o rilevando il mattone, a seconda del bisogno.","ja":"","t":[[0,3,"ora"],[4,9,"avere"],[10,17,"dinanzi"],[18,19,"a"],[20,22,"me"],[23,25,"un"],[26,30,"vero"],[31,32,"e"],[33,40,"proprio"],[41,51,"finestrino"],[52,55,"che"],[56,62,"potere"],[63,64,"a"],[65,68,"mio"],[69,76,"talento"],[77,87,"richiudere"],[88,89,"e"],[90,98,"riaprire"],[100,110,"rimettere"],
{"id":"g072","title":"17 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"17 gennaio.","ja":"","t":[[3,10,"gennaio"]]},{"it":"Ieri mattina me n’è successa una bella.","ja":"","t":[[0,4,"ieri"],[5,12,"mattina"],[13,15,"me"],[16,17,0],[18,19,"essere"],[20,28,"succedere"],[29,32,"un"],[33,38,"bello"]]},{"it":"Nel ritornare a casa, dopo aver comprato la cartella per il Maralli e i due razzi, passai dallo studio, e vedendo nella stanza d’aspetto che Ambrogio non c’era e che aveva lasciato sotto il tavolino lo scaldino spento, mi venne l’idea di fargli una sorpresa e gli ci misi dentro i due razzi, nascosti ben bene sotto la cenere.","ja":"","t":[[0,3,"in"],[4,13,"ritornare"],[14,15,"a"],[16,20,"casa"],[22,26,"dopo"],[27,31,"avere"],[32,40,"comprare"],[41,43,"il"],[44,52,"cartella"],[53,56,"per"],[57,59,"il"],[60,67,0],[68,69,"e"],[70,71,"il"],[72,75,"due"],[76,81,"razzo"],[83,89,"passare"],[90,95,"da"],[96,102,"studio"],[104,105,"e"],[106,113,"vedere"],[114,119,"in"],[120,126,"stanza"],[127,128,"di"],[129,136,"aspetto"],[137,140,"che"],[141,149,0],[150,153,"non"],[154,155,"ci"],[156,159,"essere"],[160,161,"e"],[162,165,"che"],[166,171,"avere"],[172,180,"lasciare"],[181,186,"sotto"],[187,189,"il"],[190,198,"tavolino"],[199,201,"il"],[202,210,"scaldare"],[211,217,"spegnere"],[219,221,"mi"],[222,227,"venire"],[228,229,"il"],[230,234,"idea"],[235,237,"di"],[238,244,"fare"],[245,248,"un"],[249,257,"sorpresa"],[258,259,"e"],[260,263,"il"],[264,266,"ci"],[267,271,"mettere"],[272,278,"dentro"],[279,280,"il"],[281,284,"due"],[285,290,"razzo"],[292,300,"nascondere"],[301,304,"bene"],[305,309,"bene"],[310,315,"sotto"],[316,318,"il"],[319,325,"cenere"]]},{"it":"Veramente, se avessi potuto immaginare le conseguenze, questo scherzo non lo avrei fatto; ma come si fa, santo Dio, a immaginarsi le conseguenze che hanno il torto di venir sempre dopo, quando nelle cose non c’è più rimedio?","ja":"","t":[[0,9,"veramente"],[11,13,"se"],[14,20,"avere"],[21,27,"potere"],[28,38,"immaginare"],[39,41,"il"],[42,53,"conseguenza"],[55,61,"questo"],[62,69,"scherzo"],[70,73,"non"],[74,76,"il"],[77,82,"avere"],[83,88,"fare"],[90,92,"ma"],[93,97,"come"],[98,100,"si"],[101,103,"fare"],[105,110,"santo"],[111,114,"Dio"],[116,117,"a"],[118,129,"immaginare"],[130,132,"il"],[133,144,"conseguenza"],[145,148,"che"],[149,154,"avere"],[155,157,"il"],[158,163,"torto"],[164,166,"di"],[167,172,"venire"],[173,179,"sempre"],[180,184,"dopo"],[186,192,"quando"],[193,198,"in"],[199,203,"cosa"],[204,207,"non"],[208,209,"ci"],[210,211,"essere"],[212,215,"più"],[216,223,"rimediare"]]},{"it":"Però da qui in avanti voglio pensarci ben bene prima di fare una burla in modo che non mi succeda più di sentirmi dire, come per questo fatto, che io fo gli scherzi di cattivo genere.","ja":"","t":[[0,4,"però"],[5,7,"da"],[8,11,"qui"],[12,14,"in"],[15,21,"avanti"],[22,28,"volere"],[29,37,"pensare"],[38,41,"bene"],[42,46,"bene"],[47,52,"prima"],[53,55,"Dio"],[56,60,"fare"],[61,64,"un"],[65,70,0],[71,73,"in"],[74,78,"modo"],[79,82,"che"],[83,86,"non"],[87,89,"mi"],[90,97,"succedere"],[98,101,"più"],[102,104,"di"],[105,113,"sentire"],[114,118,"dire"],[120,124,"come"],[125,128,"per"],[129,135,"questo"],[136,141,"fare"],[143,146,"che"],[147,149,"io"],[150,152,"fare"],[153,156,"il"],[157,164,"scherzo"],[165,167,"di"],[168,175,"cattivo"],[176,182,"genere"]]},{"it":"È stata proprio una faccenda seria, ma per me che sapevo che non c’era pericolo è stata una cosa da morire dal ridere.","ja":"","t":[[0,1,"essere"],[2,7,"essere"],[8,15,"proprio"],[16,19,"un"],[20,28,"faccenda"],[29,34,"serio"],[36,38,"ma"],[39,42,"per"],[43,45,"me"],[46,49,"che"],[50,56,"sapere"],[57,60,"che"],[61,64,"non"],[65,66,"ci"],[67,70,"essere"],[71,79,"pericolo"],[80,81,"essere"],[82,87,"essere"],[88,91,"un"],[92,96,"cosa"],[97,99,"da"],[100,106,"morire"],[107,110,"da"],[111,117,"ridere"]]},{"it":"Io avevo visto Ambrogio andare in cucina ad assettare
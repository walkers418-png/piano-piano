7,"un"],[18,22,"sera"]]},{"it":"Vi racconterò quest’ultima disgrazia di Gigino, ma ve la racconterò con parole quasi allegre, per non farvi piangere.","ja":"","t":[[0,2,"vi"],[3,13,"raccontare"],[14,19,"questo"],[20,26,"ultimo"],[27,36,"disgrazia"],[37,39,"di"],[40,46,0],[48,50,"ma"],[51,53,"ve"],[54,56,"il"],[57,67,"raccontare"],[68,71,"con"],[72,78,"parola"],[79,84,"quasi"],[85,92,"allegro"],[94,97,"per"],[98,101,"non"],[102,107,"fare"],[108,116,"piangere"]]},{"it":"Una sera, in casa sua, c’era festa di ballo.","ja":"","t":[[0,3,"un"],[4,8,"sera"],[10,12,"in"],[13,17,"casa"],[18,21,"suo"],[23,24,"ci"],[25,28,"essere"],[29,34,"festa"],[35,37,"di"],[38,43,"ballo"]]},{"it":"Gigino, non volendo sfigurare di fronte agli altri, andò per tempo a chiudersi in camera: e li si pettinò, si lisciò, e si agghindò, come un vero figurino di Parigi.","ja":"","t":[[0,6,0],[8,11,"non"],[12,19,"volere"],[20,29,0],[30,32,"di"],[33,39,"fronte"],[40,44,"a"],[45,50,"altro"],[52,56,"andare"],[57,60,"per"],[61,66,"tempo"],[67,68,"a"],[69,78,"chiudere"],[79,81,"in"],[82,88,"camera"],[90,91,"e"],[92,94,"li"],[95,97,"si"],[98,105,"pettinare"],[107,109,"si"],[110,116,0],[118,119,"e"],[120,122,"si"],[123,131,0],[133,137,"come"],[138,140,"un"],[141,145,"vero"],[146,154,"figurare"],[155,157,"di"],[158,164,0]]},{"it":"Aveva una bella camicia bianca, col goletto rovesciato, e una giacchettina di panno nero, che gli tornava a pennello.","ja":"","t":[[0,5,"avere"],[6,9,"un"],[10,15,"bello"],[16,23,"camicia"],[24,30,"bianco"],[32,35,"con"],[36,43,0],[44,54,"rovesciare"],[56,57,"e"],[58,61,"un"],[62,74,0],[75,77,"di"],[78,83,"panno"],[84,88,"nero"],[90,93,"che"],[94,97,"il"],[98,105,"tornare"],[106,107,"a"],[108,116,"pennello"]]},{"it":"Quando sentì che il pianoforte accennava i primi preludi della polka e della mazurka, corse subito.... ma prima di entrare in sala, fece capolino alla porta e vide....","ja":"","t":[[0,6,"quando"],[7,12,"sentire"],[13,16,"che"],[17,19,"il"],[20,30,"pianoforte"],[31,40,
ti; se avessi avuto voglia di studiare e di lavorare, se fossi rimasto in casa col mio povero babbo, a quest’ora non mi troverei qui, in mezzo ai campi, a fare il cane di guardia alla casa di un contadino.","ja":"","t":[[0,2,"se"],[3,8,"essere"],[9,14,"essere"],[15,17,"un"],[18,27,"ragazzino"],[28,31,"per"],[32,36,"bene"],[38,42,"come"],[43,45,"ce"],[46,47,0],[48,49,"essere"],[50,55,"tanto"],[57,59,"se"],[60,66,"avere"],[67,72,"avere"],[73,79,"voglia"],[80,82,"di"],[83,91,"studiare"],[92,93,"e"],[94,96,"dire"],[97,105,"lavorare"],[107,109,"se"],[110,115,"essere"],[116,123,"rimanere"],[124,126,"in"],[127,131,"casa"],[132,135,"con"],[136,139,"mio"],[140,146,"povero"],[147,152,"babbo"],[154,155,"a"],[156,161,"questo"],[162,165,"ora"],[166,169,"non"],[170,172,"mi"],[173,181,"trovare"],[182,185,"qui"],[187,189,"in"],[190,195,"mezzo"],[196,198,"a"],[199,204,"campo"],[206,207,"a"],[208,212,"fare"],[213,215,"il"],[216,220,"cane"],[221,223,"di"],[224,231,"guardia"],[232,236,"a"],[237,241,"casa"],[242,244,"di"],[245,247,"un"],[248,257,"contadino"]]},{"it":"Oh, se potessi rinascere un’altra volta!…","ja":"","t":[[0,2,"oh"],[4,6,"se"],[7,14,"potere"],[15,24,0],[25,27,"un"],[28,33,"altro"],[34,39,"volta"]]},{"it":"Ma oramai è tardi e ci vuol pazienza!","ja":"","t":[[0,2,"ma"],[3,9,"ormai"],[10,11,"essere"],[12,17,"tardi"],[18,19,"e"],[20,22,"ci"],[23,27,"volere"],[28,36,"pazienza"]]},{"it":"—","ja":"","t":[]},{"it":"Fatto questo piccolo sfogo, che gli venne proprio dal cuore, entrò dentro il casotto e si addormentò.","ja":"","t":[[0,5,"fare"],[6,12,"questo"],[13,20,"piccolo"],[21,26,0],[28,31,"che"],[32,35,"il"],[36,41,"venire"],[42,49,"proprio"],[50,53,"da"],[54,59,"cuore"],[61,66,"entrare"],[67,73,"dentro"],[74,76,"il"],[77,84,"casotto"],[85,86,"e"],[87,89,"si"],[90,100,"addormentare"]]}],"q":[{"skill":"match","s":"農夫が彼にさせた仕事は？","o":["番犬","畑仕事","馬の世話"],"why":"死んだ犬メラムポの代わりです。"},{"skill":"match","s":"彼の気持ちは？","o":["自分の行いを悔やむ","大喜び","農夫を尊敬する"],"why":"泣きながら後悔します。"}],"g":{},"n":698
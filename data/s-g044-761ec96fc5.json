e i ragazzi, queste.","ja":"","t":[[0,3,"non"],[4,7,"essere"],[8,12,"cosa"],[13,16,"che"],[17,24,"potere"],[25,31,"capire"],[32,33,"il"],[34,41,"ragazzo"],[43,49,"questo"]]},{"it":"Sta’ zitto e basta.","ja":"","t":[[0,3,"stare"],[5,10,"zitto"],[11,12,"e"],[13,18,"bastare"]]},{"it":"Ecco dunque un’altra delle tante solite cose che i ragazzi non possono capire!","ja":"","t":[[0,4,"ecco"],[5,11,"dunque"],[12,14,"un"],[15,20,"altro"],[21,26,"di"],[27,32,"tanto"],[33,39,"solito"],[40,44,"cosa"],[45,48,"che"],[49,50,"il"],[51,58,"ragazzo"],[59,62,"non"],[63,70,"potere"],[71,77,"capire"]]},{"it":"Ed è possibile - domando io - che delle persone grandi credano sul serio che una ragione simile possa soddisfare un ragazzo?","ja":"","t":[[0,2,"e"],[3,4,"essere"],[5,14,"possibile"],[17,24,"domandare"],[25,27,"io"],[30,33,"che"],[34,39,"di"],[40,47,"persona"],[48,54,"grande"],[55,62,"credere"],[63,66,"su"],[67,72,"serio"],[73,76,"che"],[77,80,"un"],[81,88,"ragione"],[89,95,"simile"],[96,101,"potere"],[102,112,"soddisfare"],[113,115,"un"],[116,123,"ragazzo"]]},{"it":"Basta.","ja":"","t":[[0,5,"bastare"]]},{"it":"L’interessante per me è che ora tutti mi vogliono bene; siamo tornati a casa, e nel ritorno sono stato a cassetta col vetturino, e ho guidato quasi sempre io; e, quel che più conta, ora non mangerò più minestre di capellini per un pezzo.","ja":"","t":[[0,1,"il"],[2,14,"interessante"],[15,18,"per"],[19,21,"me"],[22,23,"essere"],[24,27,"che"],[28,31,"ora"],[32,37,"tutto"],[38,40,"mi"],[41,49,"volere"],[50,54,"bene"],[56,61,"essere"],[62,69,"tornare"],[70,71,"a"],[72,76,"casa"],[78,79,"e"],[80,83,"in"],[84,91,"ritorno"],[92,96,"essere"],[97,102,"essere"],[103,104,"a"],[105,113,"cassetta"],[114,117,"con"],[118,127,0],[129,130,"e"],[131,133,"avere"],[134,141,"guidare"],[142,147,"quasi"],[148,154,"sempre"],[155,157,"io"],[159,160,"e"],[162,166,"quello"],[167,170,"che"],[171,174,"più"],[175,180,"contare"],[182,185,"ora"],[186,189,"non"],[190,197,"mangiare"],[198,201,"più"],[202,2
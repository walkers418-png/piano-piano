],[149,156,"ragazzo"]]},{"it":"— Ah, ladracchiòlo!","ja":"","t":[[2,4,"ah"],[6,18,0]]},{"it":"— disse il contadino incollerito — dunque sei tu che mi porti via le galline?","ja":"","t":[[2,7,"dire"],[8,10,"il"],[11,20,"contadino"],[21,32,0],[35,41,"dunque"],[42,45,"essere"],[46,48,"tu"],[49,52,"che"],[53,55,"mi"],[56,61,"portare"],[62,65,"via"],[66,68,"il"],[69,76,"gallina"]]},{"it":"— Io no, io no!","ja":"","t":[[2,4,"io"],[5,7,"no"],[9,11,"io"],[12,14,"no"]]},{"it":"— gridò Pinocchio, singhiozzando.","ja":"","t":[[2,7,"gridare"],[8,17,0],[19,32,"singhiozzare"]]},{"it":"— Io sono entrato nel campo per prendere soltanto due grappoli d’uva!","ja":"","t":[[2,4,"io"],[5,9,"essere"],[10,17,"entrare"],[18,21,"in"],[22,27,"campo"],[28,31,"per"],[32,40,"prendere"],[41,49,"soltanto"],[50,53,"due"],[54,62,"grappolo"],[63,64,"di"],[65,68,"uva"]]},{"it":"— Chi ruba l’uva è capacissimo di rubare anche i polli.","ja":"","t":[[2,5,"chi"],[6,10,"rubare"],[11,12,"il"],[13,16,"uva"],[17,18,"essere"],[19,30,"capace"],[31,33,"di"],[34,40,"rubare"],[41,46,"anche"],[47,48,"il"],[49,54,"pollo"]]},{"it":"Lascia fare a me, che ti darò una lezione da ricordartene per un pezzo.","ja":"","t":[[0,6,"lasciare"],[7,11,"fare"],[12,13,"a"],[14,16,"me"],[18,21,"che"],[22,24,"ti"],[25,29,"dare"],[30,33,"un"],[34,41,"lezione"],[42,44,"da"],[45,57,"ricordare"],[58,61,"per"],[62,64,"un"],[65,70,"pezzo"]]},{"it":"—","ja":"","t":[]},{"it":"E aperta la tagliuola, afferrò il burattino per","ja":"","t":[[0,1,"e"],[2,8,"aprire"],[9,11,"il"],[12,21,0],[23,30,"afferrare"],[31,33,"il"],[34,43,"burattino"],[44,47,"per"]]},{"it":"― Ah, ladracchiòlo! dunque sei tu che mi porti via le galline?","ja":"","t":[[2,4,"ah"],[6,18,0],[20,26,"dunque"],[27,30,"essere"],[31,33,"tu"],[34,37,"che"],[38,40,"mi"],[41,46,"portare"],[47,50,"via"],[51,53,"il"],[54,61,"gallina"]]},{"it":"la collottola e lo portò di peso fino a casa, come si porterebbe un agnellino di latte.","ja":"","t":[[0,2,"il"],[3,13,0],[14,15,"e"],[16,18,"il"],
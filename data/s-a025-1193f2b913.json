{"id":"a025","title":"Chi non ha coraggio non vada alla guerra・II","lv":8,"kind":"童話","note":"Carlo Collodi「Storie allegre」（1887年）の原文です。古い語や綴りがあります。","lines":[{"it":"II.","ja":"","t":[[0,2,0]]},{"it":"Tutte le mattine che Dio mandava in terra, i sei ragazzi, dopo aver preso con sè il pane e il companatico per fare il rancio, si mettevano in marcia armati di tutto punto, avviandosi a combattere qualche gran battaglia nel vicino bosco, distante forse un chilometro dalla villa.","ja":"","t":[[0,5,"tutto"],[6,8,"il"],[9,16,"mattina"],[17,20,"che"],[21,24,"Dio"],[25,32,"mandare"],[33,35,"in"],[36,41,"terra"],[43,44,"il"],[45,48,"essere"],[49,56,"ragazzo"],[58,62,"dopo"],[63,67,"avere"],[68,73,"prendere"],[74,77,"con"],[78,80,"sé"],[81,83,"il"],[84,88,"pane"],[89,90,"e"],[91,93,"il"],[94,105,0],[106,109,"per"],[110,114,"fare"],[115,117,"il"],[118,124,0],[126,128,"si"],[129,138,"mettere"],[139,141,"in"],[142,148,"marcia"],[149,155,"armare"],[156,158,"di"],[159,164,"tutto"],[165,170,"punto"],[172,182,"avviare"],[183,184,"a"],[185,195,"combattere"],[196,203,"qualche"],[204,208,"grande"],[209,218,"battaglia"],[219,222,"in"],[223,229,"vicino"],[230,235,"bosco"],[237,245,"distante"],[246,251,"forse"],[252,254,"un"],[255,265,"chilometro"],[266,271,"da"],[272,277,"villa"]]},{"it":"Arrivati a mezza strada, facevano alto in mezzo a un prato, e lì, sdraiati sull’erba, mangiavano, o, per dir meglio, divoravano il rancio, mentre uno di loro, s’intende bene, rimaneva a far da sentinella avanzata in fondo al prato, per dare il grido d’allarme nel caso che i nemici fossero sbucati fuori all’improvviso.","ja":"","t":[[0,8,"arrivare"],[9,10,"a"],[11,16,"mezzo"],[17,23,"strada"],[25,33,"fare"],[34,38,"alto"],[39,41,"in"],[42,47,"mezzo"],[48,49,"a"],[50,52,"un"],[53,58,"prato"],[60,61,"e"],[62,64,"lì"],[66,74,"sdraiare"],[75,79,"su"],[80,84,"erba"],[86,96,"mangiare"],[98,99,"o"],[101,104,"per"],[105,108,"dire"],[109,115,"meglio"],[117,127,"divorare"],[128,130,"il"],[131,137,0],[139,145,"mentre"],[146,149,"un"],[150,152,"Dio"],[153,157,"loro"],[159,160,"si"],[161,168,"intendere"],[169,173,"bene"],[175,183,"rimanere"],[184,185,"a"],[186,189,"fare"],[190,192,"da"],[193,203,"sentinella"],[204,212,"avanzare"],[213,215,"in"],[216,221,"fondo"],[222,224,"a"],[225,230,"prato"],[232,235,"per"],[236,240,"dare"],[241,243,"il"],[244,249,"gridare"],[250,251,"di"],[252,259,"allarme"],[260,263,"in"],[264,268,"caso"],[269,272,"che"],[273,274,"il"],[275,281,"nemico"],[282,289,"essere"],[290,297,0],[298,303,"fuori"],[304,307,"a"],[308,318,"improvviso"]]},{"it":"Ma l’uso della sentinella avanzata durò poco, e vi dirò il perchè.","ja":"","t":[[0,2,"ma"],[3,4,"il"],[5,8,"usare"],[9,14,"di"],[15,25,"sentinella"],[26,34,"avanzare"],[35,39,"durare"],[40,44,"poco"],[46,47,"e"],[48,50,"vi"],[51,55,"dire"],[56,58,"il"],[59,65,"perché"]]},{"it":"Una mattina toccò a far da sentinella al trombettiere Arnolfo, un ragazzino che non aveva ancora sett’anni finiti.","ja":"","t":[[0,3,"un"],[4,11,"mattina"],[12,17,"toccare"],[18,19,"a"],[20,23,"fare"],[24,26,"da"],[27,37,"sentinella"],[38,40,"a"],[41,53,0],[54,61,0],[63,65,"un"],[66,75,"ragazzino"],[76,79,"che"],[80,83,"non"],[84,89,"avere"],[90,96,"ancora"],[97,101,0],[102,106,"anno"],[107,113,"finire"]]},{"it":"Arnolfo, ubbidiente ai regolamenti e alla disciplina militare, si rassegnò a fare una mezz’ora di sentinella: ma appena smontato, corse subito in mezzo ai compagni, per farsi dare la sua parte di rancio.","ja":"","t":[[0,7,0],[9,19,"ubbidiente"],[20,22,"a"],[23,34,"regolamento"],[35,36,"e"],[37,41,"a"],[42,52,0],[53,61,"militare"],[63,65,"si"],[66,74,"rassegnare"],[75,76,"a"],[77,81,"fare"],[82,85,"un"],[86,90,"mezzo"],[91,94,"ora"],[95,97,"di"],[98,108,"sentinella"],[110,112,"ma"],[113,119,"appena"],[120,128,0],[130,135,"correre"],[136,142,"subito"],[143,145,"in"],[146,151,"mezzo"],[152,154,"a"],[155,163,"compagno"],[165,168,"per"],[169,174,"fare"],[175,179,"dare"],[180,182,"il"],[183,186,"suo"],[187,192,"parte"],[193,195,"di"],[196,202,0]]},{"it":"E lascio pensare a voi come restò, quando si accorse che i suoi compagni avevano mangiato tutto, diluviato tutto, spolverato tutto: fino i minuzzoli di pane, fin le cortecce del cacio, fin le bucce del salame!","ja":"","t":[[0,1,"e"],[2,8,"lasciare"],[9,16,"pensare"],[17,18,"a"],[19,22,"voi"],[23,27,"come"],[28,33,"restare"],[35,41,"quando"],[42,44,"si"],[45,52,"accorgersi"],[53,56,"che"],[57,58,"il"],[59,63,"suo"],[64,72,"compagno"],[73,80,"avere"],[81,89,"mangiare"],[90,95,"tutto"],[97,106,0],[107,112,"tutto"],[114,124,0],[125,130,"tutto"],[132,136,"fino"],[137,138,"il"],[139,148,0],[149,151,"di"],[152,156,"pane"],[158,161,"fino"],[162,164,"il"],[165,173,0],[174,177,"di"],[178,183,"cacio"],[185,188,"fino"],[189,191,"il"],[192,197,"buccia"],[198,201,"di"],[202,208,"salame"]]},{"it":"Il povero figliuolo, che aveva una fame che la vedeva proprio cogli occhi, trovandosi così barbaramente burlato, cominciò a piangere e a strillare: e il suo strillare fu così acuto e ostinato, che in tutta la storia militare, dalla presa di Gerico fino a noi, non c’è l’esempio d’un altro trombettiere che abbia strillato tanto, quanto lui.","ja":"","t":[[0,2,"il"],[3,9,"povero"],[10,19,"figliuolo"],[21,24,"che"],[25,30,"avere"],[31,34,"un"],[35,39,"fame"],[40,43,"che"],[44,46,"il"],[47,53,"vedere"],[54,61,"proprio"],[62,67,"con"],[68,73,"occhio"],[75,85,"trovare"],[86,90,"così"],[91,103,0],[104,111,0],[113,121,"cominciare"],[122,123,"a"],[124,132,"piangere"],[133,134,"e"],[135,136,"a"],[137,146,"strillare"],[148,149,"e"],[150,152,"il"],[153,156,"suo"],[157,166,"strillare"],[167,169,"essere"],[170,174,"così"],[175,180,"acuto"],[181,182,"e"],[183,191,"ostinare"],[193,196,"che"],[197,199,"in"],[200,205,"tutto"],[206,208,"il"],[209,215,"storia"],[216,224,"militare"],[226,231,"da"],[232,237,"prendere"],[238,240,"di"],[241,247,0],[248,252,"fino"],[253,254,"a"],[255,258,"noi"],[260,263,"non"],[264,265,"ci"],[266,267,"essere"],[268,269,"il"],[270,277,"esempio"],[278,279,"di"],[280,282,"un"],[283,288,"altro"],[289,301,0],[302,305,"che"],[306,311,"avere"],[312,321,"strillare"],[322,327,"tanto"],[329,335,"quanto"],[336,339,"lui"]]},{"it":"Da quel giorno in poi, in quel corpo d’armata composto di sei ragazzi, non si trovò più un soldato che volesse fare da sentinella avanzata durante l’ora del rancio.","ja":"","t":[[0,2,"da"],[3,7,"quello"],[8,14,"giorno"],[15,17,"in"],[18,21,"poi"],[23,25,"in"],[26,30,"quello"],[31,36,"corpo"],[37,38,"di"],[39,45,"armare"],[46,54,"comporre"],[55,57,"di"],[58,61,"essere"],[62,69,"ragazzo"],[71,74,"non"],[75,77,"si"],[78,83,"trovare"],[84,87,"più"],[88,90,"un"],[91,98,"soldato"],[99,102,"che"],[103,110,"volere"],[111,115,"fare"],[116,118,"da"],[119,129,"sentinella"],[130,138,"avanzare"],[139,146,"durante"],[147,148,"il"],[149,152,"ora"],[153,156,"di"],[157,163,0]]},{"it":"Di fronte a un atto così grave d’insubordinazione, la disciplina militare ci scapitò assai; ma lo stomaco dei soldati ci guadagnò dimolto.... e tutti pari.","ja":"","t":[[0,2,"di"],[3,9,"fronte"],[10,11,"a"],[12,14,"un"],[15,19,"atto"],[20,24,"così"],[25,30,"grave"],[31,32,"di"],[33,49,0],[51,53,"il"],[54,64,0],[65,73,"militare"],[74,76,"ci"],[77,84,0],[85,90,"assai"],[92,94,"ma"],[95,97,"il"],[98,105,"stomaco"],[106,109,"di"],[110,117,"soldato"],[118,120,"ci"],[121,129,"guadagnare"],[130,137,0],[142,143,"e"],[144,149,"tutto"],[150,154,"pari"]]},{"it":"— E le battaglie combattute da questi piccoli eroi contro chi erano?","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,16,"battaglia"],[17,27,"combattere"],[28,30,"da"],[31,37,"questo"],[38,45,"piccolo"],[46,50,"eroe"],[51,57,"contro"],[58,61,"chi"],[62,67,"essere"]]},{"it":"— Ve lo dico subito.","ja":"","t":[[2,4,"ve"],[5,7,"il"],[8,12,"dire"],[13,19,"subito"]]},{"it":"Appena finito il rancio, l’esercito col suo comandante alla testa si rimetteva in marcia, inoltrandosi a passo di carica dentro il bosco.","ja":"","t":[[0,6,"appena"],[7,13,"finire"],[14,16,"il"],[17,23,0],[25,26,"il"],[27,35,"esercito"],[36,39,"con"],[40,43,"suo"],[44,54,"comandante"],[55,59,"a"],[60,65,"testa"],[66,68,"si"],[69,78,"rimettere"],[79,81,"in"],[82,88,"marcia"],[90,102,0],[103,104,"a"],[105,110,"passo"],[111,113,"di"],[114,120,"carico"],[121,127,"dentro"],[128,130,"il"],[131,136,"bosco"]]},{"it":"Giunti dinanzi a una grossa quercia, che aveva più di cent’anni, il generale Leoncino schierava le sue truppe in riga di battaglia, e dopo aver caracollato dinanzi a loro, figurando di essere a cavallo, dopo avere colle parole e coi gesti incoraggiati i soldati alla pugna, dava l’ordine di cominciare","ja":"","t":[[0,6,"giungere"],[7,14,"dinanzi"],[15,16,"a"],[17,20,"un"],[21,27,"grosso"],[28,35,"quercia"],[37,40,"che"],[41,46,"avere"],[47,50,"più"],[51,53,"di"],[54,58,0],[59,63,"anno"],[65,67,"il"],[68,76,"generale"],[77,85,0],[86,95,"schierare"],[96,98,"il"],[99,102,"suo"],[103,109,"truppa"],[110,112,"in"],[113,117,"riga"],[118,120,"di"],[121,130,"battaglia"],[132,133,"e"],[134,138,"dopo"],[139,143,"avere"],[144,155,0],[156,163,"dinanzi"],[164,165,"a"],[166,170,"loro"],[172,181,"figurare"],[182,184,"di"],[185,191,"essere"],[192,193,"a"],[194,201,"cavallo"],[203,207,"dopo"],[208,213,"avere"],[214,219,"con"],[220,226,"parola"],[227,228,"e"],[229,232,"con"],[233,238,"gesto"],[239,251,0],[252,253,"il"],[254,261,"soldato"],[262,266,"a"],[267,272,0],[274,278,"dare"],[279,280,"il"],[281,287,"ordine"],[288,290,"di"],[291,301,"cominciare"]]},{"it":"Pag. 131.","ja":"","t":[[0,3,0]]},{"it":"Quando i soldati, stanchi trafelati, non ne potevano proprio più, allora buttavano via i bastoni e la battaglia era finita.","ja":"","t":[[0,6,"quando"],[7,8,"il"],[9,16,"soldato"],[18,25,"stanco"],[26,35,0],[37,40,"non"],[41,43,"ne"],[44,52,"potere"],[53,60,"proprio"],[61,64,"più"],[66,72,"allora"],[73,82,"buttare"],[83,86,"via"],[87,88,"il"],[89,96,0],[97,98,"e"],[99,101,"il"],[102,111,"battaglia"],[112,115,"essere"],[116,122,"finire"]]},{"it":"E la quercia?...","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,12,"quercia"]]},{"it":"La povera quercia si lasciava tutti i giorni bastonare, senza mai rivoltarsi, senza mai mandar fuori una mezza parola di lamento: solo di tanto in tanto scoteva malinconicamente i suoi rami coperti di foglie, quasi volesse dire:","ja":"","t":[[0,2,"il"],[3,9,"povero"],[10,17,"quercia"],[18,20,"si"],[21,29,"lasciare"],[30,35,"tutto"],[36,37,"il"],[38,44,"giorno"],[45,54,0],[56,61,"senza"],[62,65,"mai"],[66,76,"rivoltare"],[78,83,"senza"],[84,87,"mai"],[88,94,"mandare"],[95,100,"fuori"],[101,104,"un"],[105,110,"mezzo"],[111,117,"parola"],[118,120,"di"],[121,128,"lamentarsi"],[130,134,"solo"],[135,137,"di"],[138,143,"tanto"],[144,146,"in"],[147,152,"tanto"],[153,160,"scuotere"],[161,177,0],[178,179,"il"],[180,184,"suo"],[185,189,"ramo"],[190,197,"coprire"],[198,200,"di"],[201,207,"foglia"],[209,214,"quasi"],[215,222,"volere"],[223,227,"dire"]]},{"it":"— Poveri ragazzi! lasciamoli fare!","ja":"","t":[[2,8,"povero"],[9,16,"ragazzo"],[18,28,"lasciare"],[29,33,"fare"]]},{"it":"Hanno così poco giudizio!...","ja":"","t":[[0,5,"avere"],[6,10,"così"],[11,15,"poco"],[16,24,"giudizio"]]},{"it":"—","ja":"","t":[]}],"q":[],"g":{},"n":484,"w":["Dio","a","accorgersi","acuto","allarme","allora","alto","altro","ancora","anno","appena","armare","arrivare","assai","atto","avanzare","avere","avviare","battaglia","bene","bosco","buccia","buttare","cacio","carico","caso","cavallo","che","chi","chilometro","ci","comandante","combattere","come","cominciare","compagno","comporre","con","contro","coprire","corpo","correre","così","da","dare","dentro","di","dinanzi","dire","distante","divorare","dopo","durante","durare","e","erba","eroe","esempio","esercito","essere","fame","fare","figliuolo","figurare","finire","fino","foglia","fondo","forse","fronte","fuori","generale","gesto","giorno","giudizio","giungere","grande","grave","gridare","grosso","guadagnare","il","improvviso","in","intendere","lamentarsi","lasciare","loro","lui","lì","ma","mai","mandare","mangiare","marcia","mattina","m
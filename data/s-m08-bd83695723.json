{"id":"m08","title":"第8話 洞窟の中","lv":3,"kind":"連載","note":"","lines":[{"it":"La grotta era più profonda di quanto sembrava.","ja":"洞窟は見た目より深くなっていました。","t":[[0,2,"il"],[3,9,"grotta"],[10,13,"essere"],[14,17,"più"],[18,26,"profondo"],[27,29,"di"],[30,36,"quanto"],[37,45,"sembrare"]]},{"it":"Sotto la croce, sulla pietra, qualcuno aveva scritto una frase.","ja":"十字の下の石に、誰かが文を書いていました。","t":[[0,5,"sotto"],[6,8,"il"],[9,14,"croce"],[16,21,"su"],[22,28,"pietra"],[30,38,"qualcuno"],[39,44,"avere"],[45,52,"scrivere"],[53,56,"un"],[57,62,"frase"]]},{"it":"«Conta i passi del gabbiano e guarda dove il mare non arriva.»","ja":"「カモメの歩数を数え、海の届かぬところを見よ」","t":[[1,6,"contare"],[7,8,"il"],[9,14,"g:passi"],[15,18,"di"],[19,27,"gabbiano"],[28,29,"e"],[30,36,"guardare"],[37,41,"dove"],[42,44,"il"],[45,49,"mare"],[50,53,"non"],[54,60,"arrivare"]]},{"it":"«Che cosa vuol dire?» ha chiesto Matteo.","ja":"「どういう意味？」とマッテオが尋ねました。","t":[[1,4,"che"],[5,9,"cosa"],[10,14,"volere"],[15,19,"dire"],[22,24,"avere"],[25,32,"chiedere"],[33,39,0]]},{"it":"«È un indovinello» ha risposto Elisa. «Il nonno voleva farci pensare.»","ja":"「なぞなぞだよ」とエリーザは答えました。「おじいちゃんは考えさせたかったんだ」","t":[[1,2,"essere"],[3,5,"un"],[6,17,"g:indovinello"],[19,21,"avere"],[22,30,"rispondere"],[31,36,0],[39,41,"il"],[42,47,"nonno"],[48,54,"volere"],[55,60,"fare"],[61,68,"pensare"]]},{"it":"Fuori la pioggia continuava.","ja":"外では雨が続いていました。","t":[[0,5,"fuori"],[6,8,"il"],[9,16,"pioggia"],[17,27,"continuare"]]},{"it":"Hanno mangiato i panini seduti su una roccia.","ja":"岩に座ってパニーニを食べました。","t":[[0,5,"avere"],[6,14,"mangiare"],[15,16,"il"],[17,23,"panino"],[24,30,"sedere"],[31,33,"su"],[34,37,"un"],[38,44,"roccia"]]},{"it":"All'improvviso Matteo ha sentito qualcosa.","ja":"突然、マッテオは何かを聞きました。","t":[[0,3,"a"],[4,14,"improvviso"],[15,21,0],[22,24,"avere"],[25,32,"sentire"],[33,41,"qualcosa"]]},{"it":"Non era il vento. Erano passi.","ja":"風ではありません。足音でした。","t":[[0,3,"non"],[4,7,"essere"],[8,10,"il"],[11,16,"vento"],[18,23,"essere"],[24,29,"g:passi"]]},
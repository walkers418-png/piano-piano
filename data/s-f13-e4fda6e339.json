{"id":"f13","title":"のどの渇いたカラス","lv":2,"kind":"昔話","note":"大昔から伝わるイソップの話を、やさしく書き直したものです。","lines":[{"it":"Era estate e non pioveva da settimane.","ja":"夏で、何週間も雨が降っていませんでした。","t":[[0,3,"essere"],[4,10,"estate"],[11,12,"e"],[13,16,"non"],[17,24,"piovere"],[25,27,"da"],[28,37,"settimana"]]},{"it":"Un corvo aveva molta sete e volava da un posto all'altro.","ja":"カラスはとてものどが渇いて、あちこち飛んでいました。","t":[[0,2,"un"],[3,8,"corvo"],[9,14,"avere"],[15,20,"molto"],[21,25,"sete"],[26,27,"e"],[28,34,"volare"],[35,37,"da"],[38,40,"un"],[41,46,"posto"],[47,50,"a"],[51,56,"altro"]]},{"it":"Finalmente ha visto una vecchia brocca in un giardino.","ja":"ついに庭に古い水差しを見つけました。","t":[[0,10,"finalmente"],[11,13,"avere"],[14,19,"vedere"],[20,23,"un"],[24,31,"vecchio"],[32,38,"g:brocca"],[39,41,"in"],[42,44,"un"],[45,53,"giardino"]]},{"it":"Dentro c'era un po' d'acqua, ma era molto in basso.","ja":"中に少し水がありましたが、ずっと下の方でした。","t":[[0,6,"dentro"],[7,8,"ci"],[9,12,"essere"],[13,15,"un"],[16,18,"poco"],[20,21,"di"],[22,27,"acqua"],[29,31,"ma"],[32,35,"essere"],[36,41,"molto"],[42,44,"in"],[45,50,"basso"]]},{"it":"Il corvo ha messo il becco dentro, ma non arrivava all'acqua.","ja":"カラスはくちばしを入れましたが、水に届きません。","t":[[0,2,"il"],[3,8,"corvo"],[9,11,"avere"],[12,17,"mettere"],[18,20,"il"],[21,26,"becco"],[27,33,"dentro"],[35,37,"ma"],[38,41,"non"],[42,50,"arrivare"],[51,54,"a"],[55,60,"acqua"]]},{"it":"Ha provato a rovesciare la brocca, ma era troppo pesante.","ja":"水差しを倒そうとしましたが、重すぎました。","t":[[0,2,"avere"],[3,10,"provare"],[11,12,"a"],[13,23,"g:rovesciare"],[24,26,"il"],[27,33,"g:brocca"],[35,37,"ma"],[38,41,"essere"],[42,48,"troppo"],[49,56,"pesante"]]},{"it":"Allora ha pensato un momento.","ja":"そこで少し考えました。","t":[[0,6,"allora"],[7,9,"avere"],[10,17,"pensare"],[18,20,"un"],[21,28,"momento"]]},{"it":"Ha preso una pietra piccola con il becco e l'ha lasciata cadere nella brocca.","ja":"小石をくちばしでつかみ、水差しに落としました。","t":[[0,2,"avere"],[3,8,"prendere"],[9,12,"un"],[13,19,"pietra"],[20,27,"piccolo"],[28,31,"con"],[32,34,"il"],[35,40,"becco"],[41,42,"e"],[43,44,"il"],[45,47,"avere"],[48,56,"lasciare"],[57,63,"cadere"],[64,69,"in"],[70,76,"g:brocca"]]},{"it":"Poi un'altra, e un'altra ancora.","ja":"それからまた1つ、また1つ。","t":[[0,3,"poi"],[4,6,"un"],[7,12,"altro"],[14,15,"e"],[16,18,"un"],[19,24,"altro"],[25,31,"ancora"]]},{"it":"L'acqua saliva piano piano.","ja":"水は少しずつ上がってきました。","t":[[0,1,"il"],[2,7,"acqua"],[8,14,"salire"],[15,20,"piano"],[21,26,"piano"]]},{"it":"Alla fine il corvo ha potuto bere.","ja":"ついにカラスは飲むことができました。","t":[[0,4,"a"],[5,9,"fine"],[10,12,"il"],[13,18,"corvo"],[19,21,"avere"],[22,28,"potere"],[29,33,"bere"]]},{"it":"L'intelligenza può più della forza.","ja":"知恵は力にまさります。","t":[[0,1,"il"],[2,14,"g:intelligenza"],[15,18,"potere"],[19,22,"più"],[23,28,"di"],[29,34,"forza"]]}],"q":[{"skill":"match","s":"カラスが水を飲めた方法は？","o":["小石を入れて水面を上げた","水差しを倒した","雨を待った"],"why":"ha lasciata cadere ... L'acqua saliva."},{"skill":"main","s":"この話の教訓は？","o":["力より知恵が役立つ","カラスは強い","夏は暑い"],"why":"最後の文です。"},{"skill":"vocab","s":"piano piano の使い方は？","o":["少しずつ、ゆっくり","ピアノを弾く","階の上で"],"why":"アプリの名前の由来です。"}],"g":{"brocca":"水差し","rovesciare":"倒す","intelligenza":"知恵"},"n":107,"w":["a","acqua","allora","altro","ancora","arrivare","avere","basso","becco","bere","cadere","ci","con","corvo","da","dentro","di","e","essere","estate","finalmente","fine","forza","giardino","il","in","lasciare","ma","mettere","molto","momento","non","pensare","pesante","piano","piccolo","pietra","piovere","più","poco","poi","posto","potere","prendere","provare","salire","sete","settimana","troppo","un","vecchio","vedere","volare"]}
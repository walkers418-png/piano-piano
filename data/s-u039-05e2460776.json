,61,0],[63,65,"e"],[66,70,"egli"],[71,73,"fare"],[74,80,"peggio"]]},{"it":"Provò a pigliarlo con le buone, ed egli se ne fece beffa.","ja":"","t":[[0,5,"provare"],[6,7,"a"],[8,17,"pigliare"],[18,21,"con"],[22,24,"il"],[25,30,"buono"],[32,34,"e"],[35,39,"egli"],[40,42,"se"],[43,45,"ne"],[46,50,"fare"],[51,56,0]]},{"it":"Gli disse delle parole terribili, ed egli si coprì il viso con le mani, come se piangesse, e rideva.","ja":"","t":[[0,3,"il"],[4,9,"dire"],[10,15,"di"],[16,22,"parola"],[23,32,"terribile"],[34,36,"e"],[37,41,"egli"],[42,44,"si"],[45,50,"coprire"],[51,53,"il"],[54,58,"viso"],[59,62,"con"],[63,65,"il"],[66,70,"mano"],[72,76,"come"],[77,79,"se"],[80,89,"piangere"],[91,92,"e"],[93,99,"ridere"]]},{"it":"Fu sospeso dalla scuola per tre giorni, e tornò più tristo e più insolente di prima.","ja":"","t":[[0,2,"essere"],[3,10,"sospendere"],[11,16,"da"],[17,23,"scuola"],[24,27,"per"],[28,31,"tre"],[32,38,"giorno"],[40,41,"e"],[42,47,"tornare"],[48,51,"più"],[52,58,0],[59,60,"e"],[61,64,"più"],[65,74,0],[75,77,"di"],[78,83,"prima"]]},{"it":"Derossi gli disse un giorno: — Ma finiscila, vedi che il maestro ci soffre troppo, — ed egli lo minacciò di piantargli un chiodo nel ventre.","ja":"","t":[[0,7,0],[8,11,"il"],[12,17,"dire"],[18,20,"un"],[21,27,"giorno"],[31,33,"ma"],[34,43,"finire"],[45,49,"vedere"],[50,53,"che"],[54,56,"il"],[57,64,"maestro"],[65,67,"ci"],[68,74,"soffrire"],[75,81,"troppo"],[85,87,"e"],[88,92,"egli"],[93,95,"il"],[96,104,"minacciare"],[105,107,"di"],[108,118,"piantare"],[119,121,"un"],[122,128,"chiodo"],[129,132,"in"],[133,139,0]]},{"it":"Ma questa mattina, finalmente, si fece scacciare come un cane.","ja":"","t":[[0,2,"ma"],[3,9,"questo"],[10,17,"mattina"],[19,29,"finalmente"],[31,33,"si"],[34,38,"fare"],[39,48,0],[49,53,"come"],[54,56,"un"],[57,61,"cane"]]},{"it":"Mentre il maestro dava a Garrone la brutta copia del Tamburino sardo, il racconto mensile di gennaio, da trascrivere, egli gittò sul pavimento un petardo che scoppiò facendo rintr
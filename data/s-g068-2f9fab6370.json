{"id":"g068","title":"13 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"13 gennaio.","ja":"","t":[[3,10,"gennaio"]]},{"it":"Il mio cognato è proprio una brava persona.","ja":"","t":[[0,2,"il"],[3,6,"mio"],[7,14,"cognato"],[15,16,"essere"],[17,24,"proprio"],[25,28,"un"],[29,34,"bravo"],[35,42,"persona"]]},{"it":"Egli mi tratta come se io fossi un uomo, non mi dà mai mortificazioni e ripete sempre:","ja":"","t":[[0,4,"egli"],[5,7,"mi"],[8,14,"trattare"],[15,19,"come"],[20,22,"se"],[23,25,"io"],[26,31,"essere"],[32,34,"un"],[35,39,"uomo"],[41,44,"non"],[45,47,"mi"],[48,50,"dare"],[51,54,"mai"],[55,69,0],[70,71,"e"],[72,78,"ripetere"],[79,85,"sempre"]]},{"it":"- Giannino in fondo è un bravo ragazzo e diventerà qualche cosa.","ja":"","t":[[2,10,0],[11,13,"in"],[14,19,"fondo"],[20,21,"essere"],[22,24,"un"],[25,30,"bravo"],[31,38,"ragazzo"],[39,40,"e"],[41,50,"diventare"],[51,58,"qualche"],[59,63,"cosa"]]},{"it":"Or ora mi ha sorpreso mentre avevo dinanzi a me il giornalino, e lo ha sfogliato guardando le figure che vi ho disegnato.","ja":"","t":[[0,2,0],[3,6,"ora"],[7,9,"mi"],[10,12,"avere"],[13,21,"sorprendere"],[22,28,"mentre"],[29,34,"avere"],[35,42,"dinanzi"],[43,44,"a"],[45,47,"me"],[48,50,"il"],[51,61,0],[63,64,"e"],[65,67,"il"],[68,70,"avere"],[71,80,0],[81,90,"guardare"],[91,93,"il"],[94,100,"figura"],[101,104,"che"],[105,107,"vi"],[108,110,"avere"],[111,120,"disegnare"]]},{"it":"- Ma sai - ha detto - che tu hai una grande disposizione per il disegno?","ja":"","t":[[2,4,"ma"],[5,8,"sapere"],[11,13,"avere"],[14,19,"dire"],[22,25,"che"],[26,28,"tu"],[29,32,"avere"],[33,36,"un"],[37,43,"grande"],[44,56,"disposizione"],[57,60,"per"],[61,63,"il"],[64,71,"disegno"]]},{"it":"E poi si vede che osservi e ti vai migliorando...","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,8,"si"],[9,13,"vedere"],[14,17,"che"],[18,25,"osservare"],[26,27,"e"],[28,30,"ti"],[31,34,"andare"],[35,46,"migliorare"]]},{
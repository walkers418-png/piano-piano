osa della foglia arricciata d’un fiore, come un cannello di pasta, ch’egli avesse modellato con le mani.","ja":"","t":[[0,4,"alzare"],[5,7,"un"],[8,14,"grosso"],[15,23,"martello"],[24,25,"e"],[26,34,"cominciare"],[35,36,"a"],[37,46,"picchiare"],[48,57,"spingere"],[58,60,"il"],[61,66,"parte"],[67,74,0],[75,78,"ora"],[79,81,"di"],[82,85,"qua"],[86,89,"ora"],[90,92,"di"],[93,95,"là"],[96,99,"tra"],[100,103,"un"],[104,109,"punta"],[110,114,"di"],[115,123,0],[124,125,"e"],[126,128,"il"],[129,134,"mezzo"],[136,137,"e"],[138,149,0],[150,152,"in"],[153,157,"vario"],[158,162,"modo"],[164,166,"e"],[167,170,"essere"],[171,174,"un"],[175,185,"meravigliarsi"],[186,187,"a"],[188,194,"vedere"],[195,199,"come"],[200,205,"sotto"],[206,208,"a"],[209,214,"colpo"],[215,221,"rapido"],[222,223,"e"],[224,231,"precisare"],[232,235,"di"],[236,244,"martello"],[245,247,"il"],[248,253,"ferro"],[254,255,"si"],[256,265,0],[267,268,"si"],[269,278,0],[280,288,"pigliare"],[289,292,"via"],[293,296,"via"],[297,299,"il"],[300,305,"forma"],[306,314,"grazioso"],[315,320,"di"],[321,327,"foglia"],[328,338,0],[339,340,"di"],[341,343,"un"],[344,349,"fiore"],[351,355,"come"],[356,358,"un"],[359,367,0],[368,370,"di"],[371,376,"pasta"],[378,380,"che"],[381,385,"egli"],[386,392,"avere"],[393,402,0],[403,406,"con"],[407,409,"il"],[410,414,"mano"]]},{"it":"E intanto il suo figliuolo ci guardava, con una cert’aria altera, come per dire: — Vedete come lavora mio padre!","ja":"","t":[[0,1,"e"],[2,9,"intanto"],[10,12,"il"],[13,16,"suo"],[17,26,"figliuolo"],[27,29,"ci"],[30,38,"guardare"],[40,43,"con"],[44,47,"un"],[48,52,0],[53,57,"aria"],[58,64,"alterare"],[66,70,"come"],[71,74,"per"],[75,79,"dire"],[83,89,"vedere"],[90,94,"come"],[95,101,"lavorare"],[102,105,"mio"],[106,111,"padre"]]},{"it":"— Ha visto come si fa, il signorino?","ja":"","t":[[2,4,"avere"],[5,10,"vedere"],[11,15,"come"],[16,18,"si"],[19,21,"fare"],[23,25,"il"],[26,35,"signorino"]]},{"it":"— mi domandò il fabbro, quand’ebbe finito, mettendomi davanti
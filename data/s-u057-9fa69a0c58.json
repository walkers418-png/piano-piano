,"due"],[7,16,"fanciullo"],[17,24,0],[26,34,"dividere"],[36,38,"se"],[39,42,"essere"],[43,46,"due"],[47,53,"uomo"],[54,65,"allontanare"],[67,70,"non"],[71,80,"assistere"],[81,85,"a"],[86,96,"spettacolo"],[97,102,"di"],[103,111,"violenza"],[112,119,0],[121,124,"che"],[125,132,"offendere"],[133,134,"e"],[135,144,0],[145,147,"il"],[148,153,"cuore"]]},{"it":"E quando passa un uomo legato fra due guardie, non aggiungere la tua alla curiosità crudele della folla: egli può essere un innocente.","ja":"","t":[[0,1,"e"],[2,8,"quando"],[9,14,"passare"],[15,17,"un"],[18,22,"uomo"],[23,29,"legare"],[30,33,"fra"],[34,37,"due"],[38,45,"guardia"],[47,50,"non"],[51,61,"aggiungere"],[62,64,"il"],[65,68,"tuo"],[69,73,"a"],[74,83,"curiosità"],[84,91,"crudele"],[92,97,"di"],[98,103,"folla"],[105,109,"egli"],[110,113,"potere"],[114,120,"essere"],[121,123,"un"],[124,133,"innocente"]]},{"it":"Cessa di parlar col tuo compagno e di sorridere quando incontri una lettiga d’ospedale, che porta forse un moribondo, o un convoglio mortuario, chè ne potrebbe uscir uno domani di casa tua.","ja":"","t":[[0,5,"cessare"],[6,8,"di"],[9,15,"parlare"],[16,19,"con"],[20,23,"tuo"],[24,32,"compagno"],[33,34,"e"],[35,37,"dire"],[38,47,"sorridere"],[48,54,"quando"],[55,63,"incontrare"],[64,67,"un"],[68,75,"lettiga"],[76,77,"di"],[78,86,"ospedale"],[88,91,"che"],[92,97,"portare"],[98,103,"forse"],[104,106,"un"],[107,116,0],[118,119,"o"],[120,122,"un"],[123,132,"convoglio"],[133,142,0],[144,147,"che"],[148,150,"ne"],[151,159,"potere"],[160,165,"uscire"],[166,169,"un"],[170,176,"domani"],[177,179,"di"],[180,184,"casa"],[185,188,"tuo"]]},{"it":"Guarda con riverenza tutti quei ragazzi degli istituti che passano a due a due: i ciechi, i muti, i rachitici, gli orfani, i fanciulli abbandonati: pensa che è la sventura e la carità umana che passa.","ja":"","t":[[0,6,"guardare"],[7,10,"con"],[11,20,"riverenza"],[21,26,"tutto"],[27,31,"quello"],[32,39,"ragazzo"],[40,45,"di"],[46,54,"istituto"],[55,58,"che"],[59,66,"passar
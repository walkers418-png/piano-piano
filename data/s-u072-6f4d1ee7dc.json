157,"pozzo"]]},{"it":"Ci saranno stati venti intorno a un batuffoletto alto così, che aveva in mano un cartoccino di zucchero, tutti a fargli cerimonie per aver il permesso d’intingere il pane, e lui a certi lo dava, ed ad altri, pregato bene, non imprestava che il dito da succhiare.","ja":"","t":[[0,2,"ci"],[3,10,"essere"],[11,16,"essere"],[17,22,"venti"],[23,30,"intorno"],[31,32,"a"],[33,35,"un"],[36,48,0],[49,53,"alto"],[54,58,"così"],[60,63,"che"],[64,69,"avere"],[70,72,"in"],[73,77,"mano"],[78,80,"un"],[81,91,0],[92,94,"di"],[95,103,"zucchero"],[105,110,"tutto"],[111,112,"a"],[113,119,"fare"],[120,129,"cerimonia"],[130,133,"per"],[134,138,"avere"],[139,141,"il"],[142,150,"permettere"],[151,152,"di"],[153,162,0],[163,165,"il"],[166,170,"pane"],[172,173,"e"],[174,177,"lui"],[178,179,"a"],[180,185,"certo"],[186,188,"il"],[189,193,"dare"],[195,197,"e"],[198,200,"a"],[201,206,"altro"],[208,215,"pregare"],[216,220,"bene"],[222,225,"non"],[226,236,"imprestare"],[237,240,"che"],[241,243,"il"],[244,248,"dito"],[249,251,"da"],[252,261,"succhiare"]]},{"it":"Intanto mia madre era venuta nel giardino e accarezzava ora l’uno ora l’altro.","ja":"","t":[[0,7,"intanto"],[8,11,"mio"],[12,17,"madre"],[18,21,"essere"],[22,28,"venire"],[29,32,"in"],[33,41,"giardino"],[42,43,"e"],[44,55,"accarezzare"],[56,59,"ora"],[60,61,"il"],[62,65,"un"],[66,69,"ora"],[70,71,"il"],[72,77,"altro"]]},{"it":"Molti le andavano intorno, anzi addosso, a chiederle un bacio col viso in su, come se guardassero a un terzo piano, aprendo e chiudendo la bocca, come per domandare la cioccia.","ja":"","t":[[0,5,"molto"],[6,8,"il"],[9,17,"andare"],[18,25,"intorno"],[27,31,"anzi"],[32,39,"addosso"],[41,42,"a"],[43,52,"chiedere"],[53,55,"un"],[56,61,"bacio"],[62,65,"con"],[66,70,"viso"],[71,73,"in"],[74,76,"su"],[78,82,"come"],[83,85,"se"],[86,97,"guardare"],[98,99,"a"],[100,102,"un"],[103,108,"terzo"],[109,114,"piano"],[116,123,"aprire"],[124,125,"e"],[126,135,"chiudere"],[136,138,"il"],[139,144,"bocca"],[146,15
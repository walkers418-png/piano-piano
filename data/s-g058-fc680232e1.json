:","ja":"","t":[[0,2,"il"],[3,11,0],[12,14,"mi"],[15,17,"avere"],[18,22,"dare"],[23,25,"un"],[26,34,"occhiata"],[35,38,"che"],[39,45,"parere"],[46,53,"volere"],[54,64,0],[66,68,"ma"],[69,72,"per"],[73,76,"non"],[77,89,0],[90,92,"il"],[93,103,"situazione"],[104,106,"avere"],[107,112,"dire"],[113,115,"in"],[116,122,"fretta"]]},{"it":"- Eh, già, già... vedremo, sicuro!","ja":"","t":[[2,4,0],[6,9,"già"],[11,14,"già"],[18,25,"vedere"],[27,33,"sicuro"]]},{"it":"Intanto ecco, signora marchesa, prenda questa boccetta e faccia delle inalazioni mattina e sera, versando poche gocce del contenuto in una catinella d’acqua bollente...","ja":"","t":[[0,7,"intanto"],[8,12,"ecco"],[14,21,"signora"],[22,30,"marchesa"],[32,38,"prendere"],[39,45,"questo"],[46,54,0],[55,56,"e"],[57,63,"fare"],[64,69,"di"],[70,80,0],[81,88,"mattina"],[89,90,"e"],[91,95,"sera"],[97,105,"versare"],[106,111,"poco"],[112,117,0],[118,121,"di"],[122,131,"contenere"],[132,134,"in"],[135,138,"un"],[139,148,"catinella"],[149,150,"di"],[151,156,"acqua"],[157,165,"bollente"]]},{"it":"Io sono uscito dalla sala e son corso da mia sorella, dove poco dopo mi ha raggiunto il Collalto che mi ha detto con la voce che gli tremava dalla rabbia:","ja":"","t":[[0,2,"io"],[3,7,"essere"],[8,14,"uscire"],[15,20,"da"],[21,25,"sala"],[26,27,"e"],[28,31,"essere"],[32,37,"correre"],[38,40,"da"],[41,44,"mio"],[45,52,"sorella"],[54,58,"dove"],[59,63,"poco"],[64,68,"dopo"],[69,71,"mi"],[72,74,"avere"],[75,84,"raggiungere"],[85,87,"il"],[88,96,0],[97,100,"che"],[101,103,"mi"],[104,106,"avere"],[107,112,"dire"],[113,116,"con"],[117,119,"il"],[120,124,"voce"],[125,128,"che"],[129,132,"il"],[133,140,"tremare"],[141,146,"da"],[147,153,"rabbia"]]},{"it":"- Bada bene, Giannino: se tu ardisci un’altra volta di entrare nella sala d’aspetto e di parlare con i clienti, io ti strozzo, hai capito?","ja":"","t":[[2,6,"badare"],[7,11,"bene"],[13,21,0],[23,25,"se"],[26,28,"tu"],[29,36,"ardire"],[37,39,"un"],[40,45,"altro"],[46,51,"volta"],[52,54,"di"]
o"],[149,150,"e"],[151,156,"senza"],[157,161,"vita"],[163,164,"e"],[165,168,"poi"],[169,175,"guardare"],[176,179,"voi"],[180,185,"altro"],[189,191,"mi"],[192,196,"parere"],[197,208,"impossibile"],[209,212,"che"],[213,216,"non"],[217,222,"essere"],[223,228,"tutto"],[229,235,"felice"]]},{"it":"Pensate: ci sono circa ventisei mila ciechi in Italia!","ja":"","t":[[0,7,"pensare"],[9,11,"ci"],[12,16,"essere"],[17,22,"circa"],[23,31,0],[32,36,"mille"],[37,43,"cieco"],[44,46,"in"],[47,53,0]]},{"it":"Ventisei mila persone che non vedono luce, capite; un esercito che c’impiegherebbe quattro ore a sfilare sotto le nostre finestre!","ja":"","t":[[0,8,0],[9,13,"mille"],[14,21,"persona"],[22,25,"che"],[26,29,"non"],[30,36,"vedere"],[37,41,"luce"],[43,49,"capire"],[51,53,"un"],[54,62,"esercito"],[63,66,"che"],[67,68,"ci"],[69,82,"impiegare"],[83,90,"quattro"],[91,94,"ora"],[95,96,"a"],[97,104,"sfilare"],[105,110,"sotto"],[111,113,"il"],[114,120,"nostro"],[121,129,"finestra"]]},{"it":"Il maestro tacque; non si sentiva un alito nella scuola.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,17,"tacere"],[19,22,"non"],[23,25,"si"],[26,33,"sentire"],[34,36,"un"],[37,42,0],[43,48,"in"],[49,55,"scuola"]]},{"it":"Derossi domandò se era vero che i ciechi hanno il tatto più fino di noi.","ja":"","t":[[0,7,0],[8,15,"domandare"],[16,18,"se"],[19,22,"essere"],[23,27,"vero"],[28,31,"che"],[32,33,"il"],[34,40,"cieco"],[41,46,"avere"],[47,49,"il"],[50,55,"tatto"],[56,59,"più"],[60,64,"fino"],[65,67,"di"],[68,71,"noi"]]},{"it":"Il maestro disse: — È vero.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,16,"dire"],[20,21,"essere"],[22,26,"vero"]]},{"it":"Tutti gli altri sensi si raffinano in loro, appunto perchè, dovendo supplire fra tutti a quello della vista, sono più e meglio esercitati di quello che non siano da chi ci vede.","ja":"","t":[[0,5,"tutto"],[6,9,"il"],[10,15,"altro"],[16,21,"senso"],[22,24,"si"],[25,34,0],[35,37,"in"],[38,42,"loro"],[44,51,"appunto"],[52,58,"perché"],[60,67,"dovere"],[68
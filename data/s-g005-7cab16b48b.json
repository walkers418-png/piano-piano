{"id":"g005","title":"8 ottobre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Ah, come mi son divertito oggi a andare a trovare tutti gli originali delle fotografie che presi alle mie sorelle!","ja":"","t":[[0,2,"ah"],[4,8,"come"],[9,11,"mi"],[12,15,"essere"],[16,25,"divertire"],[26,30,"oggi"],[31,32,"a"],[33,39,"andare"],[40,41,"a"],[42,49,"trovare"],[50,55,"tutto"],[56,59,"il"],[60,69,"originale"],[70,75,"di"],[76,86,"fotografia"],[87,90,"che"],[91,96,"prendere"],[97,101,"a"],[102,105,"mio"],[106,113,"sorella"]]},{"it":"Ho cominciato da Carlo Nelli, il padrone di quel bel negozio di mode che è nel Corso e che va vestito sempre tutto per l’appunto, e che cammina sempre in punta di piedi perché ha le scarpe troppo strette, il quale appena mi ha visto entrare mi ha detto:","ja":"","t":[[0,2,"avere"],[3,13,"cominciare"],[14,16,"da"],[17,22,0],[23,28,0],[30,32,"il"],[33,40,"padrone"],[41,43,"di"],[44,48,"quello"],[49,52,"bello"],[53,60,"negozio"],[61,63,"di"],[64,68,"moda"],[69,72,"che"],[73,74,"essere"],[75,78,"in"],[79,84,"corso"],[85,86,"e"],[87,90,"che"],[91,93,"andare"],[94,101,"vestito"],[102,108,"sempre"],[109,114,"tutto"],[115,118,"per"],[119,120,"il"],[121,128,"appunto"],[130,131,"e"],[132,135,"che"],[136,143,"camminare"],[144,150,"sempre"],[151,153,"in"],[154,159,"punta"],[160,162,"di"],[163,168,"piede"],[169,175,"perché"],[176,178,"avere"],[179,181,"il"],[182,188,"scarpa"],[189,195,"troppo"],[196,203,"stretto"],[205,207,"il"],[208,213,"quale"],[214,220,"appena"],[221,223,"mi"],[224,226,"avere"],[227,232,"vedere"],[233,240,"entrare"],[241,243,"mi"],[244,246,"avere"],[247,252,"dire"]]},{"it":"- Oh, Giannino, sei guarito bene?","ja":"","t":[[2,4,"oh"],[6,14,0],[16,19,"essere"],[20,27,"guarire"],[28,32,"bene"]]},{"it":"Io gli ho detto di sì, e poi ho risposto per bene a tutte le domande che mi faceva; ed egli mi ha regalato una bella cravatta tutta rossa.","ja":"","t":[[0,2,"io"],[3,6,"il"],[7,9,"avere"],[10,15,"dire"],[16,18,"di"],[19,21,"sì"],[23,24,"e"],[25,28,"poi"],[29,31,"avere"],[32,40,"rispondere"],[41,44,"per"],[45,49,"bene"],[50,51,"a"],[52,57,"tutto"],[58,60,"il"],[61,68,"domanda"],[69,72,"che"],[73,75,"mi"],[76,82,"fare"],[84,86,"e"],[87,91,"egli"],[92,94,"mi"],[95,97,"avere"],[98,106,"regalare"],[107,110,"un"],[111,116,"bello"],[117,125,"cravatta"],[126,131,"tutto"],[132,137,"rosso"]]},{"it":"Io l’ho ringraziato come era mio dovere, e siccome lui ha cominciato a rivolgermi delle interrogazioni sulle mie sorelle, io ho creduto bene che quello fosse il momento buono per tirar fuori la fotografia.","ja":"","t":[[0,2,"io"],[3,4,"il"],[5,7,"avere"],[8,19,"ringraziare"],[20,24,"come"],[25,28,"essere"],[29,32,"mio"],[33,39,"dovere"],[41,42,"e"],[43,50,"siccome"],[51,54,"lui"],[55,57,"avere"],[58,68,"cominciare"],[69,70,"a"],[71,81,"rivolgere"],[82,87,"di"],[88,102,"interrogazione"],[103,108,"su"],[109,112,"mio"],[113,120,"sorella"],[122,124,"io"],[125,127,"avere"],[128,135,"credere"],[136,140,"bene"],[141,144,"che"],[145,151,"quello"],[152,157,"essere"],[158,160,"il"],[161,168,"momento"],[169,174,"buono"],[175,178,"per"],[179,184,"tirare"],[185,190,"fuori"],[191,193,"il"],[194,204,"fotografia"]]},{"it":"Sotto c’era scritto a penna: vecchio gommeux; ma non so che cosa volesse dire.","ja":"","t":[[0,5,"sotto"],[6,7,"ci"],[8,11,"essere"],[12,19,"scrivere"],[20,21,"a"],[22,27,"penna"],[29,36,"vecchio"],[37,44,0],[46,48,"ma"],[49,52,"non"],[53,55,"sapere"],[56,59,"che"],[60,64,"cosa"],[65,72,"volere"],[73,77,"dire"]]},{"it":"Di più gli erano stati allungati i baffi e allargata la bocca fino alle orecchie.","ja":"","t":[[0,2,"di"],[3,6,"più"],[7,10,"il"],[11,16,"essere"],[17,22,"essere"],[23,32,"allungare"],[33,34,"il"],[35,40,"baffi"],[41,42,"e"],[43,52,"allargare"],[53,55,"il"],[56,61,"bocca"],[62,66,"fino"],[67,71,"a"],[72,80,"orecchio"]]},{"it":"Lui nel vedere il suo ritratto ridotto a quel modo, è diventato rosso come un peperone e ha detto subito:","ja":"","t":[[0,3,"lui"],[4,7,"in"],[8,14,"vedere"],[15,17,"il"],[18,21,"suo"],[22,30,"ritratto"],[31,38,"ridurre"],[39,40,"a"],[41,45,"quello"],[46,50,"modo"],[52,53,"essere"],[54,63,"diventare"],[64,69,"rosso"],[70,74,"come"],[75,77,"un"],[78,86,"peperone"],[87,88,"e"],[89,91,"avere"],[92,97,"dire"],[98,104,"subito"]]},{"it":"- Ah! sei stato tu, eh, brutto birbante?","ja":"","t":[[2,4,"ah"],[6,9,"essere"],[10,15,"essere"],[16,18,"tu"],[20,22,0],[24,30,"brutto"],[31,39,0]]},{"it":"Io gli ho risposto di no, che avevo trovato le fotografie a quel modo in camera delle mie sorelle, e sono scappato via perché aveva un viso da far paura, e poi non volevo più perder tempo con lui a dargli altre spiegazioni, avendo da distribuire le altre fotografie che avevo preso.","ja":"","t":[[0,2,"io"],[3,6,"il"],[7,9,"avere"],[10,18,"rispondere"],[19,21,"di"],[22,24,"no"],[26,29,"che"],[30,35,"avere"],[36,43,"trovare"],[44,46,"il"],[47,57,"fotografia"],[58,59,"a"],[60,64,"quello"],[65,69,"modo"],[70,72,"in"],[73,79,"camera"],[80,85,"di"],[86,89,"mio"],[90,97,"sorella"],[99,100,"e"],[101,105,"essere"],[106,114,"scappare"],[115,118,"via"],[119,125,"perché"],[126,131,"avere"],[132,134,"un"],[135,139,"viso"],[140,142,"da"],[143,146,"fare"],[147,152,"paura"],[154,155,"e"],[156,159,"poi"],[160,163,"non"],[164,170,"volere"],[171,174,"più"],[175,181,"perdere"],[182,187,"tempo"],[188,191,"con"],[192,195,"lui"],[196,197,"a"],[198,204,"dare"],[205,210,"altro"],[211,222,"spiegazione"],[224,230,"avere"],[231,233,"da"],[234,245,"distribuire"],[246,248,"il"],[249,254,"altro"],[255,265,"fotografia"],[266,269,"che"],[270,275,"avere"],[276,281,"prendere"]]},{"it":"Infatti sono andato subito in farmacia da Pietrino Masi.","ja":"","t":[[0,7,"infatti"],[8,12,"essere"],[13,19,"andare"],[20,26,"subito"],[27,29,"in"],[30,38,"farmacia"],[39,41,"da"],[42,50,0],[51,55,0]]},{"it":"Come è brutto, povero Pietrino, con quei capellacci rossi e con quella faccia gialla tutta butterata!","ja":"","t":[[0,4
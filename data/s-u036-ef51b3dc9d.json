{"id":"u036","title":"Gennaio・Il figliuolo del fabbro ferraio","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"a tutti: scusami; sempre malaticcio, e che pure studia tanto.","ja":"","t":[[0,1,"a"],[2,7,"tutto"],[9,16,"scusare"],[18,24,"sempre"],[25,35,0],[37,38,"e"],[39,42,"che"],[43,47,"pure"],[48,54,"studiare"],[55,60,"tanto"]]},{"it":"Suo padre rientra in casa briaco d’acquavite, e lo batte senza un perchè al mondo, gli butta in aria i libri e i quaderni con un rovescione; ed egli viene a scuola coi lividi sul viso, qualche volta col viso tutto gonfio e gli occhi infiammati dal gran piangere.","ja":"","t":[[0,3,"suo"],[4,9,"padre"],[10,17,"rientrare"],[18,20,"in"],[21,25,"casa"],[26,32,0],[33,34,"di"],[35,44,0],[46,47,"e"],[48,50,"il"],[51,56,"battere"],[57,62,"senza"],[63,65,"un"],[66,72,"perché"],[73,75,"a"],[76,81,"mondo"],[83,86,"il"],[87,92,"buttare"],[93,95,"in"],[96,100,"aria"],[101,102,"il"],[103,108,"libro"],[109,110,"e"],[111,112,"il"],[113,121,"quaderno"],[122,125,"con"],[126,128,"un"],[129,139,"rovesciare"],[141,143,"e"],[144,148,"egli"],[149,154,"venire"],[155,156,"a"],[157,163,"scuola"],[164,167,"con"],[168,174,"livido"],[175,178,"su"],[179,183,"viso"],[185,192,"qualche"],[193,198,"volta"],[199,202,"con"],[203,207,"viso"],[208,213,"tutto"],[214,220,"gonfio"],[221,222,"e"],[223,226,"il"],[227,232,"occhio"],[233,243,0],[244,247,"da"],[248,252,"grande"],[253,261,"piangere"]]},{"it":"Ma mai, mai che gli si possa far dire che suo padre l’ha battuto.","ja":"","t":[[0,2,"ma"],[3,6,"mai"],[8,11,"mai"],[12,15,"che"],[16,19,"il"],[20,22,"si"],[23,28,"potere"],[29,32,"fare"],[33,37,"dire"],[38,41,"che"],[42,45,"suo"],[46,51,"padre"],[52,53,"il"],[54,56,"avere"],[57,64,"battere"]]},{"it":"— È tuo padre che t’ha battuto!","ja":"","t":[[2,3,"essere"],[4,7,"tuo"],[8,13,"padre"],[14,17,"che"],[18,19,"ti"],[20,22,"avere"],[23,30,"battere"]]},{"it":"— gli dicono i compagni.","ja":"","t":[[2,5,"il"],[6,12,"dire"],[13,14,"il"],[15,23,"compagno"]]},{"it":"Ed egli grida subito: — Non è vero!","ja":"","t":[[0,2,"e"],[3,7,"egli"],[8,13,"gridare"],[14,20,"subito"],[24,27,"non"],[28,29,"essere"],[30,34,"vero"]]},{"it":"Non è vero!","ja":"","t":[[0,3,"non"],[4,5,"essere"],[6,10,"vero"]]},{"it":"— per non far disonore a suo padre.","ja":"","t":[[2,5,"per"],[6,9,"non"],[10,13,"fare"],[14,22,0],[23,24,"a"],[25,28,"suo"],[29,34,"padre"]]},{"it":"— Questo foglio non l’hai bruciato tu, — gli dice il maestro, mostrandogli il lavoro mezzo bruciato.","ja":"","t":[[2,8,"questo"],[9,15,"foglio"],[16,19,"non"],[20,21,"il"],[22,25,"avere"],[26,34,"bruciare"],[35,37,"tu"],[41,44,"il"],[45,49,"dire"],[50,52,"il"],[53,60,"maestro"],[62,74,"mostrare"],[75,77,"il"],[78,84,"lavoro"],[85,90,"mezzo"],[91,99,"bruciare"]]},{"it":"— Sì, — risponde lui, con la voce tremante; — son io che l’ho lasciato cadere sul fuoco.","ja":"","t":[[2,4,"sì"],[8,16,"rispondere"],[17,20,"lui"],[22,25,"con"],[26,28,"il"],[29,33,"voce"],[34,42,"tremare"],[46,49,"essere"],[50,52,"io"],[53,56,"che"],[57,58,"il"],[59,61,"avere"],[62,70,"lasciare"],[71,77,"cadere"],[78,81,"su"],[82,87,"fuoco"]]},{"it":"— Eppure noi lo sappiamo bene che è suo padre briaco che ha rovesciato tavolo e lume con una pedata, mentr’egli faceva il suo lavoro.","ja":"","t":[[2,8,"eppure"],[9,12,"noi"],[13,15,"il"],[16,24,"sapere"],[25,29,"bene"],[30,33,"che"],[34,35,"essere"],[36,39,"suo"],[40,45,"padre"],[46,52,0],[53,56,"che"],[57,59,"avere"],[60,70,"rovesciare"],[71,77,"tavolo"],[78,79,"e"],[80,84,"lume"],[85,88,"con"],[89,92,"un"],[93,99,"pedata"],[101,106,0],[107,111,"egli"],[112,118,"fare"],[119,121,"il"],[122,125,"suo"],[126,132,"lavoro"]]},{"it":"Egli sta in una soffitta della nostra casa, dall’altra scala, la portinaia racconta tutto a mia madre; mia sorella Silvia lo sentì gridare dal terrazzo un giorno che suo padre gli fece far la scala a capitomboli perchè gli aveva chiesto dei soldi da comperare la Grammatica.","ja":"","t":[[0,4,"egli"],[5,8,"sta
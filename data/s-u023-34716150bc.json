"],[45,50,"dare"],[51,53,"a"],[54,59,"cuore"],[60,66,"quello"],[67,73,"parola"],[75,77,"il"],[78,89,"gratitudine"],[90,93,"che"],[94,99,"sentire"],[100,103,"per"],[104,108,"quello"],[109,115,"povero"]]},{"it":"Mi par davvero che quel buon augurio debba conservarsi in buona salute per molto tempo, e ritorno a casa contento, e penso: Oh! quel povero m’ha reso assai più di quanto gli ho dato!","ja":"","t":[[0,2,"mi"],[3,6,"parere"],[7,14,"davvero"],[15,18,"che"],[19,23,"quello"],[24,28,"buono"],[29,36,"augurio"],[37,42,"dovere"],[43,54,"conservare"],[55,57,"in"],[58,63,"buono"],[64,70,"salute"],[71,74,"per"],[75,80,"molto"],[81,86,"tempo"],[88,89,"e"],[90,97,"ritornare"],[98,99,"a"],[100,104,"casa"],[105,113,"contento"],[115,116,"e"],[117,122,"pensare"],[124,126,"oh"],[128,132,"quello"],[133,139,"povero"],[140,141,"mi"],[142,144,"avere"],[145,149,"rendere"],[150,155,"assai"],[156,159,"più"],[160,162,"di"],[163,169,"quanto"],[170,173,"il"],[174,176,"avere"],[177,181,"dare"]]},{"it":"Ebbene, fa ch’io senta qualche volta quel buon augurio provocato, meritato da te; togli tratto tratto un soldo dalla tua piccola borsa per lasciarlo cadere nella mano d’un vecchio senza sostegno, d’una madre senza pane, d’un bimbo senza madre.","ja":"","t":[[0,6,"avere"],[8,10,"fare"],[11,13,"che"],[14,16,"io"],[17,22,"sentire"],[23,30,"qualche"],[31,36,"volta"],[37,41,"quello"],[42,46,"buono"],[47,54,"augurio"],[55,64,"provocare"],[66,74,"meritare"],[75,77,"da"],[78,80,"te"],[82,87,"togliere"],[88,94,"tratto"],[95,101,"tratto"],[102,104,"un"],[105,110,"soldo"],[111,116,"da"],[117,120,"tuo"],[121,128,"piccolo"],[129,134,"borsa"],[135,138,"per"],[139,148,"lasciare"],[149,155,"cadere"],[156,161,"in"],[162,166,"mano"],[167,168,"di"],[169,171,"un"],[172,179,"vecchio"],[180,185,"senza"],[186,194,"sostegno"],[196,197,"di"],[198,201,"un"],[202,207,"madre"],[208,213,"senza"],[214,218,"pane"],[220,221,"di"],[222,224,"un"],[225,230,"bimbo"],[231,236,"senza"],[237,242,"madre"]]},{"it":"I poveri amano l
,27,"in"],[28,31,"due"],[33,36,"con"],[37,39,"il"],[40,43,"suo"],[44,50,"grosso"],[51,56,"testa"],[57,62,"chinare"],[63,66,"su"],[67,72,"banco"],[74,75,"a"],[76,80,"fare"],[81,86,"di"],[87,93,0],[94,101,"intorno"],[102,103,"a"],[104,107,"un"],[108,118,"fotografia"],[119,121,"di"],[122,125,"suo"],[126,131,"padre"],[133,140,"vestito"],[141,143,"da"],[144,155,0],[157,160,"che"],[161,162,"essere"],[163,165,"un"],[166,170,"uomo"],[171,177,"grande"],[178,179,"e"],[180,186,"grosso"],[188,191,"con"],[192,194,"un"],[195,200,"collo"],[201,203,"di"],[204,208,"toro"],[210,211,"e"],[212,214,"avere"],[215,217,"un"],[218,222,"aria"],[223,228,"serio"],[229,230,"e"],[231,237,"onesto"],[239,243,"come"],[244,247,"lui"]]},{"it":"E mentre stava così curvo, con la camicia un poco aperta davanti, io gli vedevo sul petto nudo e robusto la crocina d’oro che gli regalò la madre di Nelli, quando seppe che proteggeva il suo figliuolo.","ja":"","t":[[0,1,"e"],[2,8,"mentre"],[9,14,"stare"],[15,19,"così"],[20,25,"curvo"],[27,30,"con"],[31,33,"il"],[34,41,"camicia"],[42,44,"un"],[45,49,"poco"],[50,56,"aperto"],[57,64,"davanti"],[66,68,"io"],[69,72,"il"],[73,79,"vedere"],[80,83,"su"],[84,89,"petto"],[90,94,"nudo"],[95,96,"e"],[97,104,"robusto"],[105,107,"il"],[108,115,0],[116,117,"di"],[118,121,"oro"],[122,125,"che"],[126,129,"il"],[130,136,"regalare"],[137,139,"il"],[140,145,"madre"],[146,148,"di"],[149,154,0],[156,162,"quando"],[163,168,"sapere"],[169,172,"che"],[173,183,"proteggere"],[184,186,"il"],[187,190,"suo"],[191,200,"figliuolo"]]},{"it":"Ma bisognava pure che glielo dicessi una volta che dovevo andar via.","ja":"","t":[[0,2,"ma"],[3,12,"bisognare"],[13,17,"pure"],[18,21,"che"],[22,28,"glielo"],[29,36,"dire"],[37,40,"un"],[41,46,"volta"],[47,50,"che"],[51,57,"dovere"],[58,63,"andare"],[64,67,"via"]]},{"it":"Glielo dissi: — Garrone, quest’autunno mio padre andrà via da Torino, per sempre.","ja":"","t":[[0,6,"glielo"],[7,12,"dire"],[16,23,0],[25,30,"questo"],[31,38,"autunno"],[39,42,"mio"],[43,48,"padre"],[49,54,"andare"],[55,58,"via"],[59,61,"da"],[62,68,0],[70,73,"per"],[74,80,"sempre"]]},{"it":"— Egli mi domandò se andavo via anch’io; gli risposi di sì.","ja":"","t":[[2,6,"egli"],[7,9,"mi"],[10,17,"domandare"],[18,20,"se"],[21,27,"andare"],[28,31,"via"],[32,36,"anche"],[37,39,"io"],[41,44,"il"],[45,52,"rispondere"],[53,55,"di"],[56,58,"sì"]]},{"it":"— Non farai più la quarta con noi?","ja":"","t":[[2,5,"non"],[6,11,"fare"],[12,15,"più"],[16,18,"il"],[19,25,"quarto"],[26,29,"con"],[30,33,"noi"]]},{"it":"— mi disse.","ja":"","t":[[2,4,"mi"],[5,10,"dire"]]},{"it":"Risposi di no.","ja":"","t":[[0,7,"rispondere"],[8,10,"di"],[11,13,"no"]]},{"it":"E allora egli stette un po’ senza parlare, continuando il suo disegno.","ja":"","t":[[0,1,"e"],[2,8,"allora"],[9,13,"egli"],[14,20,"stare"],[21,23,"un"],[24,26,"poco"],[28,33,"senza"],[34,41,"parlare"],[43,54,"continuare"],[55,57,"il"],[58,61,"suo"],[62,69,"disegno"]]},{"it":"Poi domandò senz’alzare il capo: — Ti ricorderai poi dei tuoi compagni di terza?","ja":"","t":[[0,3,"poi"],[4,11,"domandare"],[12,16,"senza"],[17,23,"alzare"],[24,26,"il"],[27,31,"capo"],[35,37,"ti"],[38,48,"ricordare"],[49,52,"poi"],[53,56,"di"],[57,61,"tuo"],[62,70,"compagno"],[71,73,"di"],[74,79,"terzo"]]},{"it":"— Sì, — gli dissi, — di tutti; ma di te... più che di tutti.","ja":"","t":[[2,4,"sì"],[8,11,"il"],[12,17,"dire"],[21,23,"di"],[24,29,"tutto"],[31,33,"ma"],[34,36,"dire"],[37,39,"te"],[43,46,"più"],[47,50,"che"],[51,53,"dire"],[54,59,"tutto"]]},{"it":"Chi si può scordare di te?","ja":"","t":[[0,3,"chi"],[4,6,"si"],[7,10,"potere"],[11,19,0],[20,22,"di"],[23,25,"te"]]},{"it":"— Egli mi guardò fisso e serio con uno sguardo che diceva mille cose; e non disse nulla, solo mi porse la mano sinistra, fingendo di continuare a disegnare con l’altra, ed io la strinsi tra le mie, quella mano forte e leale.","ja":"","t":[[2,6,"egli"],[7,9,"mi"],[10,16,"guardare"],[17,22,"fisso"],[23,24,"e"],[25,30,"serio"],[31,34,"con"],[35,38,"un"],[39,46,"s
9,"più"],[30,41,"nascondere"],[42,46,"dove"],[47,53,"andare"]]},{"it":"Il più bello poi è questo: che stando lì, udivo tutti i discorsi che facevano dentro la carrozza...","ja":"","t":[[0,2,"il"],[3,6,"più"],[7,12,"bello"],[13,16,"poi"],[17,18,"essere"],[19,25,"questo"],[27,30,"che"],[31,37,"stare"],[38,40,"lì"],[42,47,0],[48,53,"tutto"],[54,55,"il"],[56,64,"discorso"],[65,68,"che"],[69,77,"fare"],[78,84,"dentro"],[85,87,"il"],[88,96,"carrozza"]]},{"it":"E tra l’altro ho sentito il Maralli che diceva:","ja":"","t":[[0,1,"e"],[2,5,"tra"],[6,7,"il"],[8,13,"altro"],[14,16,"avere"],[17,24,"sentire"],[25,27,"il"],[28,35,0],[36,39,"che"],[40,46,"dire"]]},{"it":"- Per carità, badate che quel tremoto di Gian Burrasca non sappia niente di questa nostra gita... altrimenti lo ridice a mezzo mondo!","ja":"","t":[[2,5,"per"],[6,12,"carità"],[14,20,"badare"],[21,24,"che"],[25,29,"quello"],[30,37,0],[38,40,"di"],[41,45,0],[46,54,0],[55,58,"non"],[59,65,"sapere"],[66,72,"niente"],[73,75,"di"],[76,82,"questo"],[83,89,"nostro"],[90,94,"gita"],[98,108,"altrimenti"],[109,111,"il"],[112,118,0],[119,120,"a"],[121,126,"mezzo"],[127,132,"mondo"]]},{"it":"Cammina cammina, dopo molto tempo la carrozza s’è fermata e tutti sono scesi.","ja":"","t":[[0,7,"camminare"],[8,15,"camminare"],[17,21,"dopo"],[22,27,"molto"],[28,33,"tempo"],[34,36,"il"],[37,45,"carrozza"],[46,47,"si"],[48,49,"essere"],[50,57,"fermare"],[58,59,"e"],[60,65,"tutto"],[66,70,"essere"],[71,76,"scendere"]]},{"it":"Ho aspettato un poco e poi sono sceso anch’ io.","ja":"","t":[[0,2,"avere"],[3,12,"aspettare"],[13,15,"un"],[16,20,"poco"],[21,22,"e"],[23,26,"poi"],[27,31,"essere"],[32,37,"scendere"],[38,42,"anche"],[44,46,"io"]]},{"it":"Oh maraviglia!","ja":"","t":[[0,2,"oh"],[3,13,0]]},{"it":"Si era davanti a una chiesetta di campagna, nella quale erano entrati i miei genitori, le mie sorelle e il Maralli.","ja":"","t":[[0,2,"si"],[3,6,"essere"],[7,14,"davanti"],[15,16,"a"],[17,20,"un"],[21,30,0],[31,33,"di"],[34,42,"campagna"],[
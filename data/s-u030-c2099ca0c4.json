{"id":"u030","title":"Dicembre・In casa del ferito","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"fiorentino, che il maestro mi diede a copiare; e mio padre mi ha detto: — Andiamo su al quarto piano, a veder come sta dell’occhio quel signore.","ja":"","t":[[0,10,0],[12,15,"che"],[16,18,"il"],[19,26,"maestro"],[27,29,"mi"],[30,35,"dare"],[36,37,"a"],[38,45,0],[47,48,"e"],[49,52,"mio"],[53,58,"padre"],[59,61,"mi"],[62,64,"avere"],[65,70,"dire"],[74,81,"andare"],[82,84,"su"],[85,87,"a"],[88,94,"quarto"],[95,100,"piano"],[102,103,"a"],[104,109,"vedere"],[110,114,"come"],[115,118,"stare"],[119,123,"di"],[124,130,"occhio"],[131,135,"quello"],[136,143,"signore"]]},{"it":"— Siamo entrati in una camera quasi buia, dov’era il vecchio a letto, seduto, con molti cuscini dietro le spalle; accanto al capezzale sedeva sua moglie, e c’era in un canto il nipotino che si baloccava.","ja":"","t":[[2,7,"essere"],[8,15,"entrare"],[16,18,"in"],[19,22,"un"],[23,29,"camera"],[30,35,"quasi"],[36,40,"buio"],[42,45,"dove"],[46,49,"essere"],[50,52,"il"],[53,60,"vecchio"],[61,62,"a"],[63,68,"letto"],[70,76,"sedere"],[78,81,"con"],[82,87,"molto"],[88,95,"cuscino"],[96,102,"dietro"],[103,105,"il"],[106,112,"spalla"],[114,121,"accanto"],[122,124,"a"],[125,134,0],[135,141,"sedere"],[142,145,"suo"],[146,152,"moglie"],[154,155,"e"],[156,157,"ci"],[158,161,"essere"],[162,164,"in"],[165,167,"un"],[168,173,"cantare"],[174,176,"il"],[177,185,0],[186,189,"che"],[190,192,"si"],[193,202,0]]},{"it":"Il vecchio aveva l’occhio bendato.","ja":"","t":[[0,2,"il"],[3,10,"vecchio"],[11,16,"avere"],[17,18,"il"],[19,25,"occhio"],[26,33,0]]},{"it":"È stato molto contento di veder mio padre, ci ha fatto sedere e ha detto che stava meglio, che l’occhio non era perduto, non solo, ma che a capo di pochi giorni sarebbe guarito.","ja":"","t":[[0,1,"essere"],[2,7,"essere"],[8,13,"molto"],[14,22,"contento"],[23,25,"di"],[26,31,"vedere"],[32,35,"mio"],[36,41,"padre"],[43,45,"ci"],[46,48,"avere"],[49,54,"fare"],[55,61,"sedere"],[62,63,"e"],[64,66,"avere"],[67,72,"dire"],[73,76,"che"],[77,82,"stare"],[83,89,"meglio"],[91,94,"che"],[95,96,"il"],[97,103,"occhio"],[104,107,"non"],[108,111,"essere"],[112,119,"perdere"],[121,124,"non"],[125,129,"solo"],[131,133,"ma"],[134,137,"che"],[138,139,"a"],[140,144,"capo"],[145,147,"di"],[148,153,"poco"],[154,160,"giorno"],[161,168,"essere"],[169,176,"guarire"]]},{"it":"— Fu una disgrazia, — ha soggiunto; — mi duole dello spavento che deve aver avuto quel povero ragazzo.","ja":"","t":[[2,4,"essere"],[5,8,"un"],[9,18,"disgrazia"],[22,24,"avere"],[25,34,0],[38,40,"mi"],[41,46,0],[47,52,"di"],[53,61,"spavento"],[62,65,"che"],[66,70,"dovere"],[71,75,"avere"],[76,81,"avere"],[82,86,"quello"],[87,93,"povero"],[94,101,"ragazzo"]]},{"it":"— Poi ci ha parlato del medico, che doveva venir a quell’ora, a curarlo.","ja":"","t":[[2,5,"poi"],[6,8,"ci"],[9,11,"avere"],[12,19,"parlare"],[20,23,"di"],[24,30,"medico"],[32,35,"che"],[36,42,"dovere"],[43,48,"venire"],[49,50,"a"],[51,56,"quello"],[57,60,"ora"],[62,63,"a"],[64,71,"curare"]]},{"it":"Proprio in quel punto, suona il campanello.","ja":"","t":[[0,7,"proprio"],[8,10,"in"],[11,15,"quello"],[16,21,"punto"],[23,28,"suonare"],[29,31,"il"],[32,42,"campanello"]]},{"it":"— È il medico, — dice la signora.","ja":"","t":[[2,3,"essere"],[4,6,"il"],[7,13,"medico"],[17,21,"dire"],[22,24,"il"],[25,32,"signora"]]},{"it":"La porta s’apre....","ja":"","t":[[0,2,"il"],[3,8,"porta"],[9,10,"si"],[11,15,"aprire"]]},{"it":"E chi vedo?","ja":"","t":[[0,1,"e"],[2,5,"chi"],[6,10,"vedere"]]},{"it":"Garoffi, col suo mantello lungo, ritto sulla soglia, col capo chino, che non aveva coraggio di entrare.","ja":"","t":[[0,7,0],[9,12,"con"],[13,16,"suo"],[17,25,"mantello"],[26,31,"lungo"],[33,38,"ritto"],[39,44,"su"],[45,51,0],[53,56,"con"],[57,61,"capo"],[62,67,"chinare"],[69,72,"che"],[73,76,"non"],[77,82,"avere"],[83,91,"coraggio"],[92,94,"di"],[95,102,"entrare"]]},{"it":"— Chi è?","ja":"","t":[[2,5,"chi"],[6,7,"essere"]]},{"it":"— domanda il malato.","ja":"","t":[[2,9,"domanda"],[10,12,"il"],[13,19,"malato"]]},{"it":"— E il ragazzo che tirò la palla, — dice mio padre.","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,14,"ragazzo"],[15,18,"che"],[19,23,"tirare"],[24,26,"il"],[27,32,"palla"],[36,40,"dire"],[41,44,"mio"],[45,50,"padre"]]},{"it":"— E il vecchio allora: — O povero ragazzo! vieni avanti; sei venuto a domandar notizie del ferito, non è vero?","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,14,"vecchio"],[15,21,"allora"],[25,26,"o"],[27,33,"povero"],[34,41,"ragazzo"],[43,48,"venire"],[49,55,"avanti"],[57,60,"essere"],[61,67,"venire"],[68,69,"a"],[70,78,0],[79,86,"notizia"],[87,90,"di"],[91,97,"ferito"],[99,102,"non"],[103,104,"essere"],[105,109,"vero"]]},{"it":"Ma va meglio, sta tranquillo, va meglio, son quasi guarito.","ja":"","t":[[0,2,"ma"],[3,5,"andare"],[6,12,"meglio"],[14,17,"stare"],[18,28,"tranquillo"],[30,32,"andare"],[33,39,"meglio"],[41,44,"essere"],[45,50,"quasi"],[51,58,"guarire"]]},{"it":"Vieni qua.","ja":"","t":[[0,5,"venire"],[6,9,"qua"]]},{"it":"— Garoffi, confuso che non ci vedeva più, s’è avvicinato al letto, forzandosi per non piangere, e il vecchio l’ha carezzato, ma egli non poteva parlare.","ja":"","t":[[2,9,0],[11,18,"confuso"],[19,22,"che"],[23,26,"non"],[27,29,"ci"],[30,36,"vedere"],[37,40,"più"],[42,43,"si"],[44,45,"essere"],[46,56,"avvicinare"],[57,59,"a"],[60,65,"letto"],[67,77,0],[78,81,"per"],[82,85,"non"],[86,94,"piangere"],[96,97,"e"],[98,100,"il"],[101,108,"vecchio"],[109,110,"il"],[111,113,"avere"],[114,123,0],[125,127,"ma"],[128,132,"egli"],[133,136,"non"],[137,143,"potere"],[144,151,"parlare"]]},{"it":"— Grazie, — ha detto il vecchio, — va pure a dire a tuo padre e a tua madre che tutto va bene, che non si dian più pensiero.","ja":"","t":[[2,8,"grazie"],[12,14,"avere"],[15,20,"dire"],[21,23,"il"],[24,31,"vecchio"],[35,37,"andare"],[38,42,"pure"],[43,44,"a"],[45,49,"dire"],[50,51,"a"],[52,55,"tuo"],[56,61,"padre"],[62,63,"e"],[64
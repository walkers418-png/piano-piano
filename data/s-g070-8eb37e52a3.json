{"id":"g070","title":"15 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"15 gennaio.","ja":"","t":[[3,10,"gennaio"]]},{"it":"Il signor Venanzio è uggioso, ne convengo, ma ha delle buone qualità.","ja":"","t":[[0,2,"il"],[3,9,"signore"],[10,18,0],[19,20,"essere"],[21,28,0],[30,32,"ne"],[33,41,"convenire"],[43,45,"ma"],[46,48,"avere"],[49,54,"di"],[55,60,"buono"],[61,68,"qualità"]]},{"it":"Con me per esempio, è pieno di gentilezze e dice sempre che sono un ragazzo originale e che si diverte un mondo a sentirmi discorrere.","ja":"","t":[[0,3,"con"],[4,6,"me"],[7,10,"per"],[11,18,"esempio"],[20,21,"essere"],[22,27,"pieno"],[28,30,"di"],[31,41,"gentilezza"],[42,43,"e"],[44,48,"dire"],[49,55,"sempre"],[56,59,"che"],[60,64,"essere"],[65,67,"un"],[68,75,"ragazzo"],[76,85,"originale"],[86,87,"e"],[88,91,"che"],[92,94,"si"],[95,102,"divertire"],[103,105,"un"],[106,111,"mondo"],[112,113,"a"],[114,122,"sentire"],[123,133,"discorrere"]]},{"it":"È di una curiosità straordinaria.","ja":"","t":[[0,1,"essere"],[2,4,"dire"],[5,8,"un"],[9,18,"curiosità"],[19,32,"straordinario"]]},{"it":"Vuol saper tutto quello che si fa in casa e tutto quello che si dice di lui, e per questo mi dà quattro soldi al giorno.","ja":"","t":[[0,4,"volere"],[5,10,"sapere"],[11,16,"tutto"],[17,23,"quello"],[24,27,"che"],[28,30,"si"],[31,33,"fare"],[34,36,"in"],[37,41,"casa"],[42,43,"e"],[44,49,"tutto"],[50,56,"quello"],[57,60,"che"],[61,63,"si"],[64,68,"dire"],[69,71,"di"],[72,75,"lui"],[77,78,"e"],[79,82,"per"],[83,89,"questo"],[90,92,"mi"],[93,95,"dare"],[96,103,"quattro"],[104,109,"soldi"],[110,112,"a"],[113,119,"giorno"]]},{"it":"Stamani, per esempio, si è molto interessato ai soprannomi coi quali lo chiamano in casa, e io glie ne ho detti parecchi.","ja":"","t":[[0,7,"stamani"],[9,12,"per"],[13,20,"esempio"],[22,24,"si"],[25,26,"essere"],[27,32,"molto"],[33,44,"interessare"],[45,47,"a"],[48,58,"soprannome"],[59,62,"con"],[63,68,"quale"],[69,71,"il"],[72,80,"chiamare"],[81,83,"in"],[84,88,"casa"],[90,91,"e"],[92,94,"io"],[95,99,0],[100,102,"ne"],[103,105,"avere"],[106,111,"dire"],[112,120,"parecchio"]]},{"it":"Mia sorella Virginia lo chiama vecchio spilorcio, sordo rimbambito, spedale ambulante; il Maralli lo chiama lo zio Tirchio, lo zio Rùdero, e spesso gli dice anche vecchio immortale perché non muore mai.","ja":"","t":[[0,3,"mio"],[4,11,"sorella"],[12,20,0],[21,23,"il"],[24,30,"chiamare"],[31,38,"vecchio"],[39,48,0],[50,55,"sordo"],[56,66,0],[68,75,"spedire"],[76,85,0],[87,89,"il"],[90,97,0],[98,100,"il"],[101,107,"chiamare"],[108,110,"il"],[111,114,"zio"],[115,122,0],[124,126,"il"],[127,130,"zio"],[131,137,0],[139,140,"e"],[141,147,"spesso"],[148,151,"il"],[152,156,"dire"],[157,162,"anche"],[163,170,"vecchio"],[171,180,"immortale"],[181,187,"perché"],[188,191,"non"],[192,197,"morire"],[198,201,"mai"]]},{"it":"Perfino la donna di servizio gli ha messo il soprannome: lo chiama Gelatina perché trema sempre.","ja":"","t":[[0,7,"perfino"],[8,10,"il"],[11,16,"donna"],[17,19,"di"],[20,28,"servizio"],[29,32,"il"],[33,35,"avere"],[36,41,"mettere"],[42,44,"il"],[45,55,"soprannome"],[57,59,"il"],[60,66,"chiamare"],[67,75,0],[76,82,"perché"],[83,88,"tremare"],[89,95,"sempre"]]},{"it":"- Meno male! - ha detto il signor Venanzio. - Bisogna convenire che, fra tutti, la più gentile verso di me è la serva.","ja":"","t":[[2,6,"meno"],[7,11,"male"],[15,17,"avere"],[18,23,"dire"],[24,26,"il"],[27,33,"signore"],[34,42,0],[46,53,"bisognare"],[54,63,"convenire"],[64,67,"che"],[69,72,"fra"],[73,78,"tutto"],[80,82,"il"],[83,86,"più"],[87,94,"gentile"],[95,100,"verso"],[101,103,"di"],[104,106,"me"],[107,108,"essere"],[109,111,"il"],[112,117,"servire"]]},{"it":"La ricompenserò! -","ja":"","t":[[0,2,"il"],[3,15,0]]},{"it":"E s’è messo a ridere come un matto.","ja":"","t":[[0,1,"e"],[2,3,"si"],[4,5,"essere"],[6,11,"mettere"],[12,13,"a"],[14,20,"ridere"],[21,25,"come"],[26,28,"un"],[29,34,"matto"]]}],"q":
,16,"ci"],[17,26,"seguitare"],[27,29,"di"],[30,37,"lontano"],[39,42,"con"],[43,45,"il"],[46,56,"giacchetta"],[57,62,"su"],[63,69,"spalla"],[71,78,"fumare"],[79,82,"con"],[83,85,"il"],[86,89,"suo"],[90,94,0],[95,97,"di"],[98,103,0],[105,106,"e"],[107,109,"dire"],[110,115,"tanto"],[116,118,"in"],[119,124,"tanto"],[125,127,"ci"],[128,138,"minacciare"],[139,142,"con"],[143,145,"il"],[146,150,"mano"],[151,154,"che"],[155,158,"non"],[159,161,"ci"],[162,171,"fare"],[172,177,"di"],[178,183,"buca"],[184,187,"in"],[188,195,"calzoni"]]},{"it":"Precossi zufolava; non l’avevo mai sentito zufolare.","ja":"","t":[[0,8,0],[9,17,0],[19,22,"non"],[23,24,"il"],[25,30,"avere"],[31,34,"mai"],[35,42,"sentire"],[43,51,0]]},{"it":"Coretti figlio faceva di tutto, strada facendo; sa far di tutto, quell’ometto lì, col suo coltelluccio a cricco, lungo un dito: delle rotine da molino, delle forchette, degli schizzatoi; e voleva portar la roba degli altri, era carico che grondava sudore; ma sempre svelto come un capriolo.","ja":"","t":[[0,7,0],[8,14,"figlio"],[15,21,"fare"],[22,24,"di"],[25,30,"tutto"],[32,38,"strada"],[39,46,"fare"],[48,50,"sapere"],[51,54,"fare"],[55,57,"di"],[58,63,"tutto"],[65,70,"quello"],[71,77,0],[78,80,"lì"],[82,85,"con"],[86,89,"suo"],[90,102,0],[103,104,"a"],[105,111,0],[113,118,"lungo"],[119,121,"un"],[122,126,"dito"],[128,133,"di"],[134,140,0],[141,143,"da"],[144,150,0],[152,157,"di"],[158,167,"forchetta"],[169,174,"di"],[175,185,0],[187,188,"e"],[189,195,"volere"],[196,202,"portare"],[203,205,"il"],[206,210,"roba"],[211,216,"di"],[217,222,"altro"],[224,227,"essere"],[228,234,"carico"],[235,238,"che"],[239,247,0],[248,254,0],[256,258,"ma"],[259,265,"sempre"],[266,272,0],[273,277,"come"],[278,280,"un"],[281,289,0]]},{"it":"Derossi si fermava ogni momento a dirci i nomi delle piante e degli insetti: io non so come faccia a saper tante cose.","ja":"","t":[[0,7,0],[8,10,"si"],[11,18,"fermare"],[19,23,"ogni"],[24,31,"momento"],[32,33,"a"],[34,39,"dire"],[40,41,"il"],[42,46,"nome"],[47,52,"di"],[53,59,"pianta"],[60,61,"e"],[62,67,"di"],[68,75,"insetto"],[77,79,"io"],[80,83,"non"],[84,86,"sapere"],[87,91,"come"],[92,98,"fare"],[99,100,"a"],[101,106,0],[107,112,"tanto"],[113,117,"cosa"]]},{"it":"E Garrone mangiava del pane, in silenzio; ma non ci attacca mica più quei morsi allegri d’una volta, povero Garrone, dopo che ha perduto sua madre.","ja":"","t":[[0,1,"e"],[2,9,0],[10,18,"mangiare"],[19,22,"di"],[23,27,"pane"],[29,31,"in"],[32,40,"silenzio"],[42,44,"ma"],[45,48,"non"],[49,51,"ci"],[52,59,"attaccare"],[60,64,0],[65,68,"più"],[69,73,"quello"],[74,79,"mordere"],[80,87,"allegro"],[88,89,"di"],[90,93,"un"],[94,99,"volta"],[101,107,"povero"],[108,115,0],[117,121,"dopo"],[122,125,"che"],[126,128,"avere"],[129,136,"perdere"],[137,140,"suo"],[141,146,"madre"]]},{"it":"È sempre lui, però, buono come il pane: quando uno di noi pigliava la rincorsa per saltare un fosso, egli correva dall’altra parte e tendergli le mani; e perchè Precossi aveva paura delle vacche, chè da piccolo è stato cozzato, ogni volta che ne passava una, Garrone gli si parava davanti.","ja":"","t":[[0,1,"essere"],[2,8,"sempre"],[9,12,"lui"],[14,18,"però"],[20,25,"buono"],[26,30,"come"],[31,33,"il"],[34,38,"pane"],[40,46,"quando"],[47,50,"un"],[51,53,"Dio"],[54,57,"noi"],[58,66,"pigliare"],[67,69,"il"],[70,78,0],[79,82,"per"],[83,90,"saltare"],[91,93,"un"],[94,99,"fosso"],[101,105,"egli"],[106,113,"correre"],[114,118,"da"],[119,124,"altro"],[125,130,"parte"],[131,132,"e"],[133,142,"tendere"],[143,145,"il"],[146,150,"mano"],[152,153,"e"],[154,160,"perché"],[161,169,0],[170,175,"avere"],[176,181,"paura"],[182,187,"di"],[188,194,0],[196,199,"che"],[200,202,"da"],[203,210,"piccolo"],[211,212,"essere"],[213,218,"essere"],[219,226,0],[228,232,"ogni"],[233,238,"volta"],[239,242,"che"],[243,245,"ne"],[246,253,"passare"],[254,257,"un"],[259,266,0],[267,270,"il"],[271,273,"si"],[274,280,0],[281,288,"davanti"]]},{"it":"Andammo su fino a Santa Margherita, e poi giù per le chine a salti, a rotoloni, a scortica... mele.","ja":"","t":[[0,7,"andare"],[8,10,"su"],[11,15,"fino"],[16,17,"a"],[18,23,0],[24,34,"margherita"],[36,37,"e"],[38,41,"poi"],[42,45,"giù"],[46,49,"per"],[50,52,"il"],[53,58,0],[59,60,"a"],[61,66,"saltare"],[68,69,"a"],[70,78,0],[80,81,"a"],[82,90,0],[94,98,"mela"]]},{"it":"Precossi, inciampando in un cespuglio, si fece uno strappo al camiciotto, e restò lì vergognoso col suo brindello ciondoloni; ma Garoffi che ha sempre degli spilli nella giacchetta, glielo appuntò che non si vedeva, mentre quegli badava a dirgli: — Scusami, scusami; — e poi ricominciò a correre.","ja":"","t":[[0,8,0],[10,21,0],[22,24,"in"],[25,27,"un"],[28,37,0],[39,41,"si"],[42,46,"fare"],[47,50,"un"],[51,58,"strappare"],[59,61,"a"],[62,72,0],[74,75,"e"],[76,81,"restare"],[82,84,"lì"],[85,95,0],[96,99,"con"],[100,103,"suo"],[104,113,0],[114,124,0],[126,128,"ma"],[129,136,0],[137,140,"che"],[141,143,"avere"],[144,150,"sempre"],[151,156,"di"],[157,163,0],[164,169,"in"],[170,180,"giacchetta"],[182,188,"glielo"],[189,196,0],[197,200,"che"],[201,204,"non"],[205,207,"si"],[208,214,"vedere"],[216,222,"mentre"],[223,229,"quello"],[230,236,"badare"],[237,238,"a"],[239,245,"dire"],[249,256,"scusare"],[258,265,"scusare"],[269,270,"e"],[271,274,"poi"],[275,285,"ricominciare"],[286,287,"a"],[288,295,"correre"]]},{"it":"Garoffi non perdeva il suo tempo, per via: coglieva delle erbe da insalata, delle lumache, e ogni pietra che luccicasse un po’, se la metteva in tasca, pensando che ci fosse dentro dell’oro o dell’argento.","ja":"","t":[[0,7,0],[8,11,"non"],[12,19,"perdere"],[20,22,"il"],[23,26,"suo"],[27,32,"tempo"],[34,37,"per"],[38,41,"via"],[43,51,0],[52,57,"di"],[58,62,"erba"],[63,65,"da"],[66,74,"insalata"],[76,81,"di"],[82,89,"lumaca"],[91,92,"e"],[93,97,"ogni"],[98,104,"pietra"],[105,108,"che"],[109,119,0],[120,122,"un"],[123,125,"poco"],[128,130,"se"],[131,133,"il"],[134,141,"mettere"],[142,144,"in"],[145,150,"tasca"],[152,160,"pensare"],[161,164,"che"],[165,167,"ci"],[168,173,"essere"],[174,180,"dentro"],[181,185,"di"],[186,189,"oro"],[190,191,"o"],[192,196,"di"],[197,204,"argento"]]},{"it":"E avanti a correre, a ruzzolare, a rampicarsi, all’ombra e al sole, su e giù per tutti i rialzi e le scorciatoie, fin che arrivammo scalmanati e sfiatati sulla cima d’una collina, dove ci sedemmo a far merenda, sull’erba.","ja":"","t":[[0,1,"e"],[2,8,"avanti"],[9,10,"a"],[11,18,"correre"],[20,21,"a"],[22,31,0],[33,34,"a"],[35,45,0],[47,50,"a"],[51,56,"ombra"],[57,58,"e"],[59,61,"a"],[62,66,"sole"],[68,70,"su"],[71,72,"e"],[73,76,"giù"],[77,80,"per"],[81,86,"tutto"],[87,88,"il"],[89,95,0],[96,97,"e"],[98,100,"il"],[101,112,0],[114,117,"fino"],[118,121,"che"],[122,131,"arrivare"],[132,142,0],[143,144,"e"],[145,153,0],[154,159,"su"],[160,164,"cima"],[165,166,"di"],[167,170,"un"],[171,178,"collina"],[180,184,"dove"],[185,187,"ci"],[188,195,"sedere"],[196,197,"a"],[198,201,"fare"],[202,209,"merenda"],[211,215,"su"],[216,220,"erba"]]},{"it":"Si vedeva una pianura immensa, e tutte le Alpi azzurre con le cime bianche.","ja":"","t":[[0,2,"si"],[3,9,"vedere"],[10,13,"un"],[14,21,"pianura"],[22,29,"immenso"],[31,32,"e"],[33,38,"tutto"],[39,41,"il"],[42,46,0],[47,54,"azzurro"],[55,58,"con"],[59,61,"il"],[62,66,"cima"],[67,74,"bianco"]]},{"it":"Morivamo tutti di fame, il pane pareva che fondesse.","ja":"","t":[[0,8,"morire"],[9,14,"tutto"],[15,17,"di"],[18,22,"fame"],[24,26,"il"],[27,31,"pane"],[32,38,"parere"],[39,42,"che"],[43,51,0]]},{"it":"Coretti padre ci porgeva le porzioni di salsicciotto su delle foglie di zucca.","ja":"","t":[[0,7,0],[8,13,"padre"],[14,16,"ci"],[17,24,"porgere"],[25,27,"il"],[28,36,"porzione"],[37,39,"di"],[40,52,0],[53,55,"su"],[56,61,"di"],[62,68,"foglia"],[69,71,"di"],[72,77,"zucca"]]},{"it":"E allora cominciammo a parlare tutti insieme, dei maestri, dei compagni che non avevan potuto venire, e degli esami.","ja":"","t":[[0,1,"e"],[2,8,"allora"],[9,20,"cominciare"],[21,22,"a"],[23,30,"parlare"],[31,36,"tutto"],[37,44,"ins
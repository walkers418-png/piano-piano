ato, chi più felice di Gigino?","ja":"","t":[[0,3,"chi"],[4,7,"più"],[8,13,"beato"],[15,18,"chi"],[19,22,"più"],[23,29,"felice"],[30,32,"di"],[33,39,0]]},{"it":"Ballando e saltando corse a rinchiudersi nella sua camerina, e lì tanto fece e tanto annaspò, che finalmente potè guardarsi nello specchio col suo nuovo goletto intorno al collo.","ja":"","t":[[0,8,"ballare"],[9,10,"e"],[11,19,"saltare"],[20,25,"correre"],[26,27,"a"],[28,40,"rinchiudere"],[41,46,"in"],[47,50,"suo"],[51,59,0],[61,62,"e"],[63,65,"lì"],[66,71,"tanto"],[72,76,"fare"],[77,78,"e"],[79,84,"tanto"],[85,92,0],[94,97,"che"],[98,108,"finalmente"],[109,113,"potere"],[114,123,"guardare"],[124,129,"in"],[130,138,"specchio"],[139,142,"con"],[143,146,"suo"],[147,152,"nuovo"],[153,160,0],[161,168,"intorno"],[169,171,"a"],[172,177,"collo"]]},{"it":"Ma il nuovo goletto era così alto e così duramente insaldato, che il povero figliuolo sentiva tagliarsi la gola!","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,11,"nuovo"],[12,19,0],[20,23,"essere"],[24,28,"così"],[29,33,"alto"],[34,35,"e"],[36,40,"così"],[41,50,0],[51,60,0],[62,65,"che"],[66,68,"il"],[69,75,"povero"],[76,85,"figliuolo"],[86,93,"sentire"],[94,103,"tagliare"],[104,106,"il"],[107,111,"gola"]]},{"it":"Non poteva più abbassare la testa: non poteva voltarsi nè di qua nè di là: pareva proprio un impiccato.","ja":"","t":[[0,3,"non"],[4,10,"potere"],[11,14,"più"],[15,24,"abbassare"],[25,27,"il"],[28,33,"testa"],[35,38,"non"],[39,45,"potere"],[46,54,"voltare"],[55,57,"né"],[58,60,"di"],[61,64,"qua"],[65,67,"né"],[68,70,"di"],[71,73,"là"],[75,81,"parere"],[82,89,"proprio"],[90,92,"un"],[93,102,"impiccare"]]},{"it":"Eppure quel giuccherello era contento, tanto contento, che sarebbe difficile figurarselo!","ja":"","t":[[0,6,"eppure"],[7,11,"quello"],[12,24,0],[25,28,"essere"],[29,37,"contento"],[39,44,"tanto"],[45,53,"contento"],[55,58,"che"],[59,66,"essere"],[67,76,"difficile"],[77,88,0]]},{"it":"La sua prima idea fu quella di chiedere alla mamma il solito permesso p
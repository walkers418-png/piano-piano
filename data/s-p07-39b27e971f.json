e"]]},{"it":"— Pinocchiuccio mio!","ja":"","t":[[2,15,0],[16,19,"mio"]]},{"it":"Com’è che ti sei bruciato i piedi?","ja":"","t":[[0,3,"come"],[4,5,"essere"],[6,9,"che"],[10,12,"ti"],[13,16,"essere"],[17,25,"bruciare"],[26,27,"il"],[28,33,"piede"]]},{"it":"— Non lo so, babbo, ma credetelo che è stata una nottata d’inferno, e me ne ricorderò fin che campo.","ja":"","t":[[2,5,"non"],[6,8,"il"],[9,11,"sapere"],[13,18,"babbo"],[20,22,"ma"],[23,32,"credere"],[33,36,"che"],[37,38,"essere"],[39,44,"essere"],[45,48,"un"],[49,56,0],[57,58,"di"],[59,66,"inferno"],[68,69,"e"],[70,72,"me"],[73,75,"ne"],[76,85,"ricordare"],[86,89,"fino"],[90,93,"che"],[94,99,"campo"]]},{"it":"Tonava, balenava e io avevo una gran fame, e allora il Grillo-parlante mi disse: «Ti sta bene: sei stato cattivo e te lo meriti», e io gli dissi: «Bada, Grillo!…» e lui mi disse: «Tu sei un burattino e hai la testa di legno» e io gli tirai un manico di martello, e lui morì, ma la colpa fu sua, perchè io non volevo ammazzarlo, prova ne sia, che messi un tegamino sulla brace accesa del caldano, ma il pulcino scappò fuori e disse: «Arrivedella,... e tanti saluti a casa.","ja":"","t":[[0,6,0],[8,16,0],[17,18,"e"],[19,21,"io"],[22,27,"avere"],[28,31,"un"],[32,36,"grande"],[37,41,"fame"],[43,44,"e"],[45,51,"allora"],[52,54,"il"],[55,61,"grillo"],[62,70,"parlare"],[71,73,"mi"],[74,79,"dire"],[82,84,"ti"],[85,88,"stare"],[89,93,"bene"],[95,98,"essere"],[99,104,"essere"],[105,112,"cattivo"],[113,114,"e"],[115,117,"te"],[118,120,"il"],[121,127,"meritare"],[130,131,"e"],[132,134,"io"],[135,138,"il"],[139,144,"dire"],[147,151,0],[153,159,"grillo"],[163,164,"e"],[165,168,"lui"],[169,171,"mi"],[172,177,"dire"],[180,182,"tu"],[183,186,"essere"],[187,189,"un"],[190,199,"burattino"],[200,201,"e"],[202,205,"avere"],[206,208,"il"],[209,214,"testa"],[215,217,"di"],[218,223,"legno"],[225,226,"e"],[227,229,"io"],[230,233,"il"],[234,239,"tirare"],[240,242,"un"],[243,249,"manico"],[250,252,"di"],[253,261,"martello"],[263,264,"e"],[
o la storia della famosa latta cascata sul cappello a tuba del povero Gigino!","ja":"","t":[[0,10,"figurare"],[11,13,"il"],[14,17,"suo"],[18,29,"contentezza"],[31,37,"quando"],[38,41,"il"],[42,54,"raccontare"],[55,57,"il"],[58,64,"storia"],[65,70,"di"],[71,77,"famoso"],[78,83,"latta"],[84,91,"cascata"],[92,95,"su"],[96,104,"cappello"],[105,106,"a"],[107,111,"tuba"],[112,115,"di"],[116,122,"povero"],[123,129,0]]},{"it":"Prese subito di mira l’amico, e non gli dètte più pace; non lo lasciò più ben avere un minuto solo.","ja":"","t":[[0,5,"prendere"],[6,12,"subito"],[13,15,"di"],[16,20,"mirare"],[21,22,"il"],[23,28,"amico"],[30,31,"e"],[32,35,"non"],[36,39,"il"],[40,45,"dare"],[46,49,"più"],[50,54,"pace"],[56,59,"non"],[60,62,"il"],[63,69,"lasciare"],[70,73,"più"],[74,77,"bene"],[78,83,"avere"],[84,86,"un"],[87,93,"minuto"],[94,98,"solo"]]},{"it":"Tutte le volte che nell’andare a scuola s’imbatteva in lui, affibbiavagli subito un bello scappellotto sul berretto: e poi, fingendosi dolente e mortificato, diceva con voce di piagnisteo:","ja":"","t":[[0,5,"tutto"],[6,8,"il"],[9,14,"volta"],[15,18,"che"],[19,23,"in"],[24,30,"andare"],[31,32,"a"],[33,39,"scuola"],[40,41,"si"],[42,51,0],[52,54,"in"],[55,58,"lui"],[60,73,0],[74,80,"subito"],[81,83,"un"],[84,89,"bello"],[90,102,"scappellotto"],[103,106,"su"],[107,115,"berretto"],[117,118,"e"],[119,122,"poi"],[124,134,"fingere"],[135,142,0],[143,144,"e"],[145,156,"mortificare"],[158,164,"dire"],[165,168,"con"],[169,173,"voce"],[174,176,"di"],[177,187,0]]},{"it":"— Scusa, sai: mi pareva che tu avessi in testa il cappello a tuba!...","ja":"","t":[[2,7,"scusa"],[9,12,"sapere"],[14,16,"mi"],[17,23,"parere"],[24,27,"che"],[28,30,"tu"],[31,37,"avere"],[38,40,"in"],[41,46,"testa"],[47,49,"il"],[50,58,"cappello"],[59,60,"a"],[61,65,"tuba"]]},{"it":"Non lo farò più!...","ja":"","t":[[0,3,"non"],[4,6,"il"],[7,11,"fare"],[12,15,"più"]]},{"it":"—","ja":"","t":[]},{"it":"Il nostro Gigino, a questi scherzi sguaiati ci soffriva, proprio ci sof
{"id":"u058","title":"Marzo・Le scuole serali","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LE SCUOLE SERALI","ja":"","t":[[0,2,"il"],[3,9,"scuola"],[10,16,0]]},{"it":"2, giovedì","ja":"","t":[[3,10,"giovedì"]]},{"it":"Mio padre mi condusse ieri a vedere le scuole serali della nostra sezione Baretti, che eran già tutte illuminate, e gli operai cominciavano ad entrare.","ja":"","t":[[0,3,"mio"],[4,9,"padre"],[10,12,"mi"],[13,21,"condurre"],[22,26,"ieri"],[27,28,"a"],[29,35,"vedere"],[36,38,"il"],[39,45,"scuola"],[46,52,0],[53,58,"di"],[59,65,"nostro"],[66,73,"sezione"],[74,81,0],[83,86,"che"],[87,91,"essere"],[92,95,"già"],[96,101,"tutto"],[102,112,0],[114,115,"e"],[116,119,"il"],[120,126,"operaio"],[127,139,"cominciare"],[140,142,"a"],[143,150,"entrare"]]},{"it":"Arrivando, trovammo il Direttore e i maestri in gran collera perchè poco prima era stato rotto da una sassata il vetro d’una finestra: il bidello, saltato fuori, aveva acciuffato un ragazzo che passava; ma allora s’era presentato Stardi, che sta di casa in faccia alla scuola, e aveva detto: — Non è costui, ho visto coi miei occhi: è Franti che ha tirato, e m’ha detto: — Guai se tu parli!","ja":"","t":[[0,9,"arrivare"],[11,19,"trovare"],[20,22,"il"],[23,32,"direttore"],[33,34,"e"],[35,36,"il"],[37,44,"maestro"],[45,47,"in"],[48,52,"grande"],[53,60,"collera"],[61,67,"perché"],[68,72,"poco"],[73,78,"prima"],[79,82,"essere"],[83,88,"essere"],[89,94,"rompere"],[95,97,"da"],[98,101,"un"],[102,109,0],[110,112,"il"],[113,118,"vetro"],[119,120,"di"],[121,124,"un"],[125,133,"finestra"],[135,137,"il"],[138,145,"bidello"],[147,154,"saltare"],[155,160,"fuori"],[162,167,"avere"],[168,178,0],[179,181,"un"],[182,189,"ragazzo"],[190,193,"che"],[194,201,"passare"],[203,205,"ma"],[206,212,"allora"],[213,214,"si"],[215,218,"essere"],[219,229,"presentare"],[230,236,0],[238,241,"che"],[242,245,"stare"],[246,248,"di"],[249,253,"casa"],[254,256,"in"],[257,263,"fare"],[264,268,"a"],[269,275,"scuola"],[277,278,"e"],[279,284,"avere"],[285,290,"dire"],[294,297,"non"],[298,299,"essere"],[300,306,0],[308,310,"avere"],[311,316,"vedere"],[317,320,"con"],[321,325,"mio"],[326,331,"occhio"],[333,334,"essere"],[335,341,0],[342,345,"che"],[346,348,"avere"],[349,355,"tirare"],[357,358,"e"],[359,360,"mi"],[361,363,"avere"],[364,369,"dire"],[373,377,"guaio"],[378,380,"se"],[381,383,"tu"],[384,389,"parlare"]]},{"it":"— ma io non ho paura.","ja":"","t":[[2,4,"ma"],[5,7,"io"],[8,11,"non"],[12,14,"avere"],[15,20,"paura"]]},{"it":"E il Direttore disse che Franti sarà scacciato per sempre.","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,14,"direttore"],[15,20,"dire"],[21,24,"che"],[25,31,0],[32,36,"essere"],[37,46,0],[47,50,"per"],[51,57,"sempre"]]},{"it":"Intanto badava agli operai che entravano a due a tre insieme, e n’eran già entrati più di duecento.","ja":"","t":[[0,7,"intanto"],[8,14,"badare"],[15,19,"a"],[20,26,"operaio"],[27,30,"che"],[31,40,"entrare"],[41,42,"a"],[43,46,"due"],[47,48,"a"],[49,52,"tre"],[53,60,"insieme"],[62,63,"e"],[64,65,0],[66,70,"essere"],[71,74,"già"],[75,82,"entrare"],[83,86,"più"],[87,89,"di"],[90,98,0]]},{"it":"Non avevo mai visto come è bella una scuola serale!","ja":"","t":[[0,3,"non"],[4,9,"avere"],[10,13,"mai"],[14,19,"vedere"],[20,24,"come"],[25,26,"essere"],[27,32,"bello"],[33,36,"un"],[37,43,"scuola"],[44,50,0]]},{"it":"C’eran dei ragazzi da dodici anni in su, e degli uomini con la barba, che tornavano dal lavoro, portando libri e quaderni; c’eran dei falegnami, dei fochisti con la faccia nera, dei muratori con le mani bianche di calcina, dei garzoni fornai coi capelli infarinati e si sentiva odor di vernice, di coiami, di pece, d’olio, odori di tutti i mestieri.","ja":"","t":[[0,1,"ci"],[2,6,"essere"],[7,10,"di"],[11,18,"ragazzo"],[19,21,"da"],[22,28,"dodici"],[29,33,"anno"],[34,36,"in"],[37,39,"su"],[41,42,"e"],[43,48,"di"],[49,55,"uomo"],[56,59,"con"],[60,62,"il"],[63,68,"barba"],[70,73,"che"],[74,83,"tornare"],[84,87,"da"],[88,
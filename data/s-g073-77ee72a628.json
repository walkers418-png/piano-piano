osto allegro, e ho sentito che diceva:","ja":"","t":[[0,2,"il"],[3,10,0],[11,14,"essere"],[15,24,"piuttosto"],[25,32,"allegro"],[34,35,"e"],[36,38,"avere"],[39,46,"sentire"],[47,50,"che"],[51,57,"dire"]]},{"it":"- Ha detto al notaro che sarebbe stata una cosa lesta... e questo, capirai, è un buon segno perché vuol dire che ci saranno pochi legati... -","ja":"","t":[[2,4,"avere"],[5,10,"dire"],[11,13,"a"],[14,20,0],[21,24,"che"],[25,32,"essere"],[33,38,"essere"],[39,42,"un"],[43,47,"cosa"],[48,53,"lesto"],[57,58,"e"],[59,65,"questo"],[67,74,"capire"],[76,77,"essere"],[78,80,"un"],[81,85,"buono"],[86,91,"segno"],[92,98,"perché"],[99,103,"volere"],[104,108,"dire"],[109,112,"che"],[113,115,"ci"],[116,123,"essere"],[124,129,"poco"],[130,136,"legare"]]},{"it":"E a me che avevo steso la mano per aprir la maniglia della bussola ha soggiunto:","ja":"","t":[[0,1,"e"],[2,3,"a"],[4,6,"me"],[7,10,"che"],[11,16,"avere"],[17,22,"stendere"],[23,25,"il"],[26,30,"mano"],[31,34,"per"],[35,40,"aprire"],[41,43,"il"],[44,52,0],[53,58,"di"],[59,66,"bussola"],[67,69,"avere"],[70,79,0]]},{"it":"- Lascia andare...","ja":"","t":[[2,8,"lasciare"],[9,15,"andare"]]},{"it":"Non si può entrare.","ja":"","t":[[0,3,"non"],[4,6,"si"],[7,10,"potere"],[11,18,"entrare"]]},{"it":"C’è il notaro... fa il testamento... -","ja":"","t":[[0,1,"ci"],[2,3,"essere"],[4,6,"il"],[7,13,0],[17,19,"fare"],[20,22,"il"],[23,33,"testamento"]]},{"it":"Di lì a poco mio cognato se n’è andato nello studio perché gli è venuto un cliente, e anche Virginia è andata via, raccomandandomi di star lì e di avvertirla appena fosse uscito il notaro.","ja":"","t":[[0,2,"di"],[3,5,"lì"],[6,7,"a"],[8,12,"poco"],[13,16,"mio"],[17,24,"cognato"],[25,27,"se"],[28,29,0],[30,31,"essere"],[32,38,"andare"],[39,44,"in"],[45,51,"studio"],[52,58,"perché"],[59,62,"il"],[63,64,"essere"],[65,71,"venire"],[72,74,"un"],[75,82,"cliente"],[84,85,"e"],[86,91,"anche"],[92,100,0],[101,102,"essere"],[103,109,"andare"],[110,113,"via"],[115,130,"raccomandare"],
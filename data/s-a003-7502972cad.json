e"],[91,95,"parere"],[96,98,"un"],[99,106,"collare"]]},{"it":"Quei goletti, abbia pazienza, staranno bene agli uomini e ai giovinotti, perchè oramai la moda vuole così, e con la moda non ci si ragiona: ma i ragazzetti della sua età fanno miglior figura con la goletta arrovesciata, e che lascia scoperto e libero il collo.","ja":"","t":[[0,4,"quello"],[5,12,0],[14,19,"avere"],[20,28,"pazienza"],[30,38,"stare"],[39,43,"bene"],[44,48,"a"],[49,55,"uomo"],[56,57,"e"],[58,60,"a"],[61,71,0],[73,79,"perché"],[80,86,"ormai"],[87,89,"il"],[90,94,"moda"],[95,100,"volere"],[101,105,"così"],[107,108,"e"],[109,112,"con"],[113,115,"il"],[116,120,"moda"],[121,124,"non"],[125,127,"ci"],[128,130,"si"],[131,138,"ragionare"],[140,142,"ma"],[143,144,"il"],[145,155,"ragazzetto"],[156,161,"di"],[162,165,"suo"],[166,169,"età"],[170,175,"fare"],[176,183,"migliore"],[184,190,"figura"],[191,194,"con"],[195,197,"il"],[198,205,0],[206,218,0],[220,221,"e"],[222,225,"che"],[226,232,"lasciare"],[233,241,"scoprire"],[242,243,"e"],[244,250,"liberare"],[251,253,"il"],[254,259,"collo"]]},{"it":"La tenga a mente, sor Gigino, che i ragazzi bisogna che vestano da ragazzi: se no, c’è da scambiarli per tanti uomini rimasti nanerucoli piccini.","ja":"","t":[[0,2,"il"],[3,8,"tenere"],[9,10,"a"],[11,16,"mentire"],[18,21,0],[22,28,0],[30,33,"che"],[34,35,"il"],[36,43,"ragazzo"],[44,51,"bisognare"],[52,55,"che"],[56,63,"vestire"],[64,66,"da"],[67,74,"ragazzo"],[76,78,"se"],[79,81,"no"],[83,84,"ci"],[85,86,"essere"],[87,89,"da"],[90,100,"scambiare"],[101,104,"per"],[105,110,"tanto"],[111,117,"uomo"],[118,125,"rimanere"],[126,136,0],[137,144,"piccino"]]},{"it":"― O che sarebbe una vergogna?","ja":"","t":[[2,3,"o"],[4,7,"che"],[8,15,"essere"],[16,19,"un"],[20,28,"vergogna"]]},{"it":"Io sento che il babbo e la mamma, quando vogliono dire un gran bene di qualche ragazzo, lo sai come dicono?","ja":"","t":[[0,2,"io"],[3,8,"sentire"],[9,12,"che"],[13,15,"il"],[16,21,"babbo"],[22,23,"e"],[24,26,"il"],[27,32,"mamma"],[34,
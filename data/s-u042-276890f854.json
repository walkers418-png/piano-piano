{"id":"u042","title":"Gennaio・Invidia","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"INVIDIA.","ja":"","t":[[0,7,"invidia"]]},{"it":"25, mercoledì.","ja":"","t":[[4,13,"mercoledì"]]},{"it":"Anche il componimento sulla patria chi l’ha fatto meglio di tutti è Derossi.","ja":"","t":[[0,5,"anche"],[6,8,"il"],[9,21,0],[22,27,"su"],[28,34,"patria"],[35,38,"chi"],[39,40,"il"],[41,43,"avere"],[44,49,"fare"],[50,56,"meglio"],[57,59,"di"],[60,65,"tutto"],[66,67,"essere"],[68,75,0]]},{"it":"E Votini che si teneva sicuro della prima medaglia!","ja":"","t":[[0,1,"e"],[2,8,0],[9,12,"che"],[13,15,"si"],[16,22,"tenere"],[23,29,"sicuro"],[30,35,"di"],[36,41,"prima"],[42,50,"medaglia"]]},{"it":"Io gli vorrei bene a Votini, benchè sia un po’ vanesio e si rilisci troppo; ma mi fa dispetto, ora che gli son vicino di banco, veder com’è invidioso di Derossi.","ja":"","t":[[0,2,"io"],[3,6,"il"],[7,13,"volere"],[14,18,"bene"],[19,20,"a"],[21,27,0],[29,35,"benché"],[36,39,"essere"],[40,42,"un"],[43,45,"poco"],[47,54,0],[55,56,"e"],[57,59,"si"],[60,67,0],[68,74,"troppo"],[76,78,"ma"],[79,81,"mi"],[82,84,"fare"],[85,93,"dispetto"],[95,98,"ora"],[99,102,"che"],[103,106,"il"],[107,110,"essere"],[111,117,"vicino"],[118,120,"di"],[121,126,"banco"],[128,133,"vedere"],[134,137,"come"],[138,139,"essere"],[140,149,0],[150,152,"di"],[153,160,0]]},{"it":"E vorrebbe gareggiare con lui, studia; ma non ce ne può, in nessuna maniera, chè l’altro lo rivende dieci volte, in tutte le materie; e Votini si morde le dita.","ja":"","t":[[0,1,"e"],[2,10,"volere"],[11,21,0],[22,25,"con"],[26,29,"lui"],[31,37,"studiare"],[39,41,"ma"],[42,45,"non"],[46,48,"ce"],[49,51,"ne"],[52,55,"potere"],[57,59,"in"],[60,67,"nessuno"],[68,75,"maniera"],[77,80,"che"],[81,82,"il"],[83,88,"altro"],[89,91,"il"],[92,99,0],[100,105,"dieci"],[106,111,"volta"],[113,115,"in"],[116,121,"tutto"],[122,124,"il"],[125,132,"materia"],[134,135,"e"],[136,142,0],[143,145,"si"],[146,151,"mordere"],[152,154,"il"],[155,159,"dito"]]},{"it":"Anche Carlo Nobis lo invidia; ma ha tanta superbia in corpo che, appunto per superbia, non si fa scorgere.","ja":"","t":[[0,5,"anche"],[6,11,0],[12,17,0],[18,20,"il"],[21,28,"invidia"],[30,32,"ma"],[33,35,"avere"],[36,41,"tanto"],[42,50,"superbia"],[51,53,"in"],[54,59,"corpo"],[60,63,"che"],[65,72,"appunto"],[73,76,"per"],[77,85,"superbia"],[87,90,"non"],[91,93,"si"],[94,96,"fare"],[97,105,"scorgere"]]},{"it":"Votini invece si tradisce, si lamenta dei punti a casa sua, e dice che il maestro fa delle ingiustizie; e quando Derossi risponde alle interrogazioni così pronto e bene, come fa sempre, egli si rannuvola, china la testa, finge di non sentire, o si sforza di ridere, ma ride verde.","ja":"","t":[[0,6,0],[7,13,"invece"],[14,16,"si"],[17,25,"tradire"],[27,29,"si"],[30,37,"lamentarsi"],[38,41,"di"],[42,47,"punto"],[48,49,"a"],[50,54,"casa"],[55,58,"suo"],[60,61,"e"],[62,66,"dire"],[67,70,"che"],[71,73,"il"],[74,81,"maestro"],[82,84,"fare"],[85,90,"di"],[91,102,"ingiustizia"],[104,105,"e"],[106,112,"quando"],[113,120,0],[121,129,"rispondere"],[130,134,"a"],[135,149,"interrogazione"],[150,154,"così"],[155,161,"pronto"],[162,163,"e"],[164,168,"bene"],[170,174,"come"],[175,177,"fare"],[178,184,"sempre"],[186,190,"egli"],[191,193,"si"],[194,203,0],[205,210,"chinare"],[211,213,"il"],[214,219,"testa"],[221,226,"fingere"],[227,229,"di"],[230,233,"non"],[234,241,"sentire"],[243,244,"o"],[245,247,"si"],[248,254,"sforzare"],[255,257,"di"],[258,264,"ridere"],[266,268,"ma"],[269,273,"ridere"],[274,279,"verde"]]},{"it":"E siccome tutti lo sanno, così quando il maestro loda Derossi tutti si voltano a guardar Votini, che mastica veleno, e il muratorino gli fa il muso di lepre.","ja":"","t":[[0,1,"e"],[2,9,"siccome"],[10,15,"tutto"],[16,18,"il"],[19,24,"sapere"],[26,30,"così"],[31,37,"quando"],[38,40,"il"],[41,48,"maestro"],[49,53,"lodare"],[54,61,0],[62,67,"tutto"],[68,70,"si"],[71,78,"voltare"],[79,80,"a"],[81,88,"guardare"],[89,95,0],[97,
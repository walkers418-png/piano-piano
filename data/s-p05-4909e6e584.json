"],[72,77,"avere"],[78,83,"altro"],[84,92,"sollievo"],[93,96,"che"],[97,103,"quello"],[104,106,"di"],[107,118,"sbadigliare"],[120,121,"e"],[122,128,"fare"],[129,134,"di"],[135,143,"sbadigliare"],[144,148,"così"],[149,155,"lungo"],[157,160,"che"],[161,168,"qualche"],[169,174,"volta"],[175,177,"il"],[178,183,"bocca"],[184,187,"il"],[188,196,"arrivare"],[197,201,"fino"],[202,206,"a"],[207,214,"orecchio"]]},{"it":"E dopo avere sbadigliato, sputava, e sentiva che lo stomaco gli andava via.","ja":"","t":[[0,1,"e"],[2,6,"dopo"],[7,12,"avere"],[13,24,"sbadigliare"],[26,33,"sputare"],[35,36,"e"],[37,44,"sentire"],[45,48,"che"],[49,51,"il"],[52,59,"stomaco"],[60,63,"il"],[64,70,"andare"],[71,74,"via"]]},{"it":"Allora piangendo e disperandosi, diceva:","ja":"","t":[[0,6,"allora"],[7,16,"piangere"],[17,18,"e"],[19,31,"disperare"],[33,39,"dire"]]},{"it":"— Il Grillo-parlante aveva ragione.","ja":"","t":[[2,4,"il"],[5,11,"grillo"],[12,20,"parlare"],[21,26,"avere"],[27,34,"ragione"]]},{"it":"Ho fatto male a rivoltarmi al mio babbo e a fuggire di casa....","ja":"","t":[[0,2,"avere"],[3,8,"fare"],[9,13,"male"],[14,15,"a"],[16,26,"rivoltare"],[27,29,"a"],[30,33,"mio"],[34,39,"babbo"],[40,41,"e"],[42,43,"a"],[44,51,"fuggire"],[52,54,"di"],[55,59,"casa"]]},{"it":"Se il mio babbo fosse qui, ora non mi troverei a morire di sbadigli!","ja":"","t":[[0,2,"se"],[3,5,"il"],[6,9,"mio"],[10,15,"babbo"],[16,21,"essere"],[22,25,"qui"],[27,30,"ora"],[31,34,"non"],[35,37,"mi"],[38,46,"trovare"],[47,48,"a"],[49,55,"morire"],[56,58,"di"],[59,67,"sbadigliare"]]},{"it":"Oh! che brutta malattia che è la fame!","ja":"","t":[[0,2,"oh"],[4,7,"che"],[8,14,"brutto"],[15,23,"malattia"],[24,27,"che"],[28,29,"essere"],[30,32,"il"],[33,37,"fame"]]},{"it":"—","ja":"","t":[]},{"it":"Quand’ecco gli parve di vedere nel monte della spazzatura qualche cosa di tondo e di bianco, che somigliava tutto a un uovo di gallina.","ja":"","t":[[0,5,"quando"],[6,10,"ecco"],[11,14,"il"],[15,20,"parere"],[21,23,"di"],[24,30,"veder
{"id":"u094","title":"Giugno・La mia maestra morta","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LA MIA MAESTRA MORTA","ja":"","t":[[0,2,"il"],[3,6,"mio"],[7,14,"maestra"],[15,20,"morire"]]},{"it":"Martedì, 27","ja":"","t":[[0,7,"martedì"]]},{"it":"Mentre noi eravamo al Teatro Vittorio Emanuele, la mia povera maestra moriva.","ja":"","t":[[0,6,"mentre"],[7,10,"noi"],[11,18,"essere"],[19,21,"a"],[22,28,"teatro"],[29,37,0],[38,46,0],[48,50,"il"],[51,54,"mio"],[55,61,"povero"],[62,69,"maestra"],[70,76,"morire"]]},{"it":"È morta alle due, sette giorni dopo ch’era stata a trovar mia madre.","ja":"","t":[[0,1,"essere"],[2,7,"morire"],[8,12,"a"],[13,16,"due"],[18,23,"sette"],[24,30,"giorno"],[31,35,"dopo"],[36,38,"che"],[39,42,"essere"],[43,48,"essere"],[49,50,"a"],[51,57,"trovare"],[58,61,"mio"],[62,67,"madre"]]},{"it":"Il Direttore venne ieri mattina a darcene l’annunzio nella scuola.","ja":"","t":[[0,2,"il"],[3,12,"direttore"],[13,18,"venire"],[19,23,"ieri"],[24,31,"mattina"],[32,33,"a"],[34,41,"dare"],[42,43,"il"],[44,52,0],[53,58,"in"],[59,65,"scuola"]]},{"it":"E disse: — Quelli di voi che furono suoi alunni, sanno quanto era buona, come voleva bene ai ragazzi: era una madre, per loro.","ja":"","t":[[0,1,"e"],[2,7,"dire"],[11,17,"quello"],[18,20,"di"],[21,24,"voi"],[25,28,"che"],[29,35,"essere"],[36,40,"suo"],[41,47,"alunno"],[49,54,"sapere"],[55,61,"quanto"],[62,65,"essere"],[66,71,"buono"],[73,77,"come"],[78,84,"volere"],[85,89,"bene"],[90,92,"a"],[93,100,"ragazzo"],[102,105,"essere"],[106,109,"un"],[110,115,"madre"],[117,120,"per"],[121,125,"loro"]]},{"it":"Ora non c’è più.","ja":"","t":[[0,3,"ora"],[4,7,"non"],[8,9,"ci"],[10,11,"essere"],[12,15,"più"]]},{"it":"Una malattia terribile la consumava da molto tempo.","ja":"","t":[[0,3,"un"],[4,12,"malattia"],[13,22,"terribile"],[23,25,"il"],[26,35,"consumare"],[36,38,"da"],[39,44,"molto"],[45,50,"tempo"]]},{"it":"Se non avesse avuto da lavorare per guadagnarsi il pane, avrebbe potuto curarsi, e forse guarire; si sarebbe almeno prolungata la vita di qualche mese, se avesse preso un congedo.","ja":"","t":[[0,2,"se"],[3,6,"non"],[7,13,"avere"],[14,19,"avere"],[20,22,"da"],[23,31,"lavorare"],[32,35,"per"],[36,47,"guadagnare"],[48,50,"il"],[51,55,"pane"],[57,64,"avere"],[65,71,"potere"],[72,79,"curare"],[81,82,"e"],[83,88,"forse"],[89,96,"guarire"],[98,100,"si"],[101,108,"essere"],[109,115,"almeno"],[116,126,"prolungare"],[127,129,"il"],[130,134,"vita"],[135,137,"di"],[138,145,"qualche"],[146,150,"mese"],[152,154,"se"],[155,161,"avere"],[162,167,"prendere"],[168,170,"un"],[171,178,0]]},{"it":"Ma essa volle stare fra i suoi ragazzi fino all’ultimo giorno.","ja":"","t":[[0,2,"ma"],[3,7,"essa"],[8,13,"volere"],[14,19,"stare"],[20,23,"fra"],[24,25,"il"],[26,30,"suo"],[31,38,"ragazzo"],[39,43,"fino"],[44,47,"a"],[48,54,"ultimo"],[55,61,"giorno"]]},{"it":"La sera di sabato, 17, s’accomiatò da loro, con la certezza di non rivederli più, diede ancora dei buoni consigli, li baciò tutti, e se n’andò singhiozzando.","ja":"","t":[[0,2,"il"],[3,7,"sera"],[8,10,"di"],[11,17,"sabato"],[23,24,"si"],[25,34,0],[35,37,"da"],[38,42,"loro"],[44,47,"con"],[48,50,"il"],[51,59,"certezza"],[60,62,"di"],[63,66,"non"],[67,76,"rivedere"],[77,80,"più"],[82,87,"dare"],[88,94,"ancora"],[95,98,"di"],[99,104,"buono"],[105,113,"consiglio"],[115,117,"li"],[118,123,"baciare"],[124,129,"tutto"],[131,132,"e"],[133,135,"se"],[136,137,0],[138,142,"andare"],[143,156,"singhiozzare"]]},{"it":"Ora nessuno la rivedrà mai più.","ja":"","t":[[0,3,"ora"],[4,11,"nessuno"],[12,14,"il"],[15,22,"rivedere"],[23,26,"mai"],[27,30,"più"]]},{"it":"Ricordatevi di lei, figliuoli.","ja":"","t":[[0,11,"ricordare"],[12,14,"di"],[15,18,"lei"],[20,29,"figliuolo"]]},{"it":"— Il piccolo Precossi, che era stato suo scolaro nella prima superiore, chinò la testa sul banco e si mise a piangere.","ja":"","t":[[2,4,"il"],[5,12,"piccolo"],[13,21,0],[23,26,"che"],[27,30,"essere"],[31,36,"essere"],[37,40,"
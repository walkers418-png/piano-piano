{"id":"g060","title":"2 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Eccoci nell’anno novo!","ja":"","t":[[0,6,0],[7,11,"in"],[12,16,"anno"],[17,21,0]]},{"it":"Che pranzo, ieri!","ja":"","t":[[0,3,"che"],[4,10,"pranzare"],[12,16,"ieri"]]},{"it":"Quanti dolci e liquori e rosolii e pasticcini di tutti i colori e di tutti i sapori!","ja":"","t":[[0,6,"quanto"],[7,12,"dolce"],[13,14,"e"],[15,22,0],[23,24,"e"],[25,32,0],[33,34,"e"],[35,45,"pasticcino"],[46,48,"di"],[49,54,"tutto"],[55,56,"il"],[57,63,"colore"],[64,65,"e"],[66,68,"dire"],[69,74,"tutto"],[75,76,"il"],[77,83,"sapore"]]},{"it":"Che bella cosa è il capodanno e che peccato che venga così di rado!","ja":"","t":[[0,3,"che"],[4,9,"bello"],[10,14,"cosa"],[15,16,"essere"],[17,19,"il"],[20,29,0],[30,31,"e"],[32,35,"che"],[36,43,"peccato"],[44,47,"che"],[48,53,"venire"],[54,58,"così"],[59,61,"di"],[62,66,"rado"]]},{"it":"Se comandassi io, vorrei fare una legge perché il primo dell’anno capitasse almeno un paio di volte al mese, e ci starebbe anche la sora Matilde, la quale ieri mangiò tanti biscottini, che stamani ha dovuto pigliare l’acqua di Janos.","ja":"","t":[[0,2,"se"],[3,13,"comandare"],[14,16,"io"],[18,24,"volere"],[25,29,"fare"],[30,33,"un"],[34,39,"legge"],[40,46,"perché"],[47,49,"il"],[50,55,"primo"],[56,60,"di"],[61,65,"anno"],[66,75,"capitare"],[76,82,"almeno"],[83,85,"un"],[86,90,"paio"],[91,93,"di"],[94,99,"volta"],[100,102,"a"],[103,107,"mese"],[109,110,"e"],[111,113,"ci"],[114,122,"stare"],[123,128,"anche"],[129,131,"il"],[132,136,0],[137,144,0],[146,148,"il"],[149,154,"quale"],[155,159,"ieri"],[160,166,"mangiare"],[167,172,"tanto"],[173,183,0],[185,188,"che"],[189,196,"stamani"],[197,199,"avere"],[200,206,"dovere"],[207,215,"pigliare"],[216,217,"il"],[218,223,"acqua"],[224,226,"di"],[227,232,0]]}],"q":[],"g":{},"n":80,"w":["a","acqua","almeno","anche","anno","avere","bello","capitare","che","ci","colore","coman
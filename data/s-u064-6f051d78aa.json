ui senza mandare un saluto a quelli che faticano tanto per voi, che hanno consacrato a voi tutte le forze della loro intelligenza e del loro cuore, che vivono e muoiono per voi.","ja":"","t":[[0,6,"appena"],[7,13,"finire"],[15,16,"il"],[17,27,0],[28,35,"ragazzo"],[36,41,"di"],[42,48,0],[49,58,"cantare"],[59,61,"un"],[62,67,"altro"],[68,75,"canzone"],[76,86,"bello"],[88,91,"poi"],[92,97,"parlare"],[98,100,"il"],[101,108,"sindaco"],[110,111,"e"],[112,116,"dopo"],[117,119,"di"],[120,123,"lui"],[124,125,"il"],[126,135,0],[137,140,"che"],[141,148,"terminare"],[149,151,"il"],[152,155,"suo"],[156,164,"discorso"],[165,172,"dire"],[173,175,"a"],[176,183,"ragazzo"],[190,192,"ma"],[193,196,"non"],[197,203,"uscire"],[204,206,"di"],[207,210,"qui"],[211,216,"senza"],[217,224,"mandare"],[225,227,"un"],[228,234,"saluto"],[235,236,"a"],[237,243,"quello"],[244,247,"che"],[248,256,0],[257,262,"tanto"],[263,266,"per"],[267,270,"voi"],[272,275,"che"],[276,281,"avere"],[282,292,0],[293,294,"a"],[295,298,"voi"],[299,304,"tutto"],[305,307,"il"],[308,313,"forza"],[314,319,"di"],[320,324,"loro"],[325,337,"intelligenza"],[338,339,"e"],[340,343,"di"],[344,348,"loro"],[349,354,"cuore"],[356,359,"che"],[360,366,"vivere"],[367,368,"e"],[369,376,"morire"],[377,380,"per"],[381,384,"voi"]]},{"it":"Eccoli là!","ja":"","t":[[0,6,0],[7,9,"là"]]},{"it":"— E segnò la galleria dei maestri.","ja":"","t":[[2,3,"e"],[4,9,"segnare"],[10,12,"il"],[13,21,"galleria"],[22,25,"di"],[26,33,"maestro"]]},{"it":"E allora dalle gallerie, dai palchi, dalla platea tutti i ragazzi s’alzarono e tesero le braccia gridando verso le maestre e i maestri, i quali risposero agitando le mani, i cappelli, i fazzoletti, tutti ritti in piedi e commossi.","ja":"","t":[[0,1,"e"],[2,8,"allora"],[9,14,"da"],[15,23,"galleria"],[25,28,"da"],[29,35,"palco"],[37,42,"da"],[43,49,0],[50,55,"tutto"],[56,57,"il"],[58,65,"ragazzo"],[66,67,"si"],[68,76,"alzare"],[77,78,"e"],[79,85,"tendere"],[86,88,"il"],[89,96,"braccio"],[97,105,"gridare"],[106,
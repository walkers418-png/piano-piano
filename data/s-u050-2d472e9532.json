,127,"se"],[128,130,"si"],[131,139,"rammentare"],[141,144,"a"],[145,151,"ultimo"],[152,159,"lezione"],[160,161,"mi"],[162,164,"avere"],[165,169,"dare"],[170,172,"il"],[173,177,"mano"],[179,182,"ora"],[183,185,"avere"],[186,194,0],[195,197,"il"],[198,201,"mio"],[202,206,"pena"],[207,208,"e"],[209,212,"essere"],[213,216,"qui"],[220,221,"a"],[222,230,"pregare"],[231,234,"che"],[235,237,"mi"],[238,244,"fare"],[245,247,"il"],[248,254,"grazia"],[255,256,"di"],[257,266,"accettare"],[267,269,"un"],[270,273,"mio"],[274,281,"ricordo"],[283,286,"un"],[287,295,0],[296,299,"che"],[300,302,"avere"],[303,311,"lavorare"],[312,314,"in"],[315,323,"prigione"]]},{"it":"La vuol accettare per mia memoria, signor maestro?","ja":"","t":[[0,2,"il"],[3,7,"volere"],[8,17,"accettare"],[18,21,"per"],[22,25,"mio"],[26,33,"memoria"],[35,41,"signore"],[42,49,"maestro"]]},{"it":"— Io rimasi lì, senza parola.","ja":"","t":[[2,4,"io"],[5,11,"rimanere"],[12,14,"lì"],[16,21,"senza"],[22,28,"parola"]]},{"it":"Egli credette che non volessi accettare, e mi guardò, come per dire: — Sei anni di patimenti non sono dunque bastati a purgarmi le mani!; — ma con espressione così viva di dolore mi guardò, che tesi subito la mano e presi l’oggetto.","ja":"","t":[[0,4,"egli"],[5,13,"credere"],[14,17,"che"],[18,21,"non"],[22,29,"volere"],[30,39,"accettare"],[41,42,"e"],[43,45,"mi"],[46,52,"guardare"],[54,58,"come"],[59,62,"per"],[63,67,"dire"],[71,74,"essere"],[75,79,"anno"],[80,82,"di"],[83,92,0],[93,96,"non"],[97,101,"essere"],[102,108,"dunque"],[109,116,"bastare"],[117,118,"a"],[119,127,0],[128,130,"il"],[131,135,"mano"],[140,142,"ma"],[143,146,"con"],[147,158,"espressione"],[159,163,"così"],[164,168,"vivere"],[169,171,"di"],[172,178,"dolore"],[179,181,"mi"],[182,188,"guardare"],[190,193,"che"],[194,198,"tendere"],[199,205,"subito"],[206,208,"il"],[209,213,"mano"],[214,215,"e"],[216,221,"prendere"],[222,223,"il"],[224,231,"oggetto"]]},{"it":"Eccolo qui.„ — Guardammo attentamente il calamaio: pareva stato lavorato con la punta d’un chiodo, con lunghissima pazienza; c’era su scolpita una penna a traverso a un quaderno, e scritto intorno: „Al mio maestro.","ja":"","t":[[0,6,0],[7,10,"qui"],[15,24,"guardare"],[25,37,"attentamente"],[38,40,"il"],[41,49,"calamaio"],[51,57,"parere"],[58,63,"essere"],[64,72,"lavorare"],[73,76,"con"],[77,79,"il"],[80,85,"punta"],[86,87,"di"],[88,90,"un"],[91,97,"chiodo"],[99,102,"con"],[103,114,"lungo"],[115,123,"pazienza"],[125,126,"ci"],[127,130,"essere"],[131,133,"su"],[134,142,0],[143,146,"un"],[147,152,"penna"],[153,154,"a"],[155,163,"traverso"],[164,165,"a"],[166,168,"un"],[169,177,"quaderno"],[179,180,"e"],[181,188,"scrivere"],[189,196,"intorno"],[199,201,"a"],[202,205,"mio"],[206,213,"maestro"]]},{"it":"— Ricordo del numero 78 — Sei anni!“ — E sotto, in piccoli caratteri: — “Studio e speranza....„ Il maestro non disse altro; ce n’andammo.","ja":"","t":[[2,9,"ricordo"],[10,13,"di"],[14,20,"numero"],[26,29,"essere"],[30,34,"anno"],[39,40,"e"],[41,46,"sotto"],[48,50,"in"],[51,58,"piccolo"],[59,68,"carattere"],[73,79,"studio"],[80,81,"e"],[82,90,"speranza"],[96,98,"il"],[99,106,"maestro"],[107,110,"non"],[111,116,"dire"],[117,122,"altro"],[124,126,"ce"],[127,128,0],[129,136,"andare"]]},{"it":"Ma per tutto il tragitto da Moncalieri a Torino, io non potei più levarmi dal capo quel prigioniero affacciato al finestrino, quell’addio al maestro, quel povero calamaio lavorato in carcere, che diceva tante cose, e lo sognai la notte, e ci pensavo ancora questa mattina... quanto lontano dall’immaginare la sorpresa che m’aspettava alla scuola!","ja":"","t":[[0,2,"ma"],[3,6,"per"],[7,12,"tutto"],[13,15,"il"],[16,24,0],[25,27,"da"],[28,38,0],[39,40,"a"],[41,47,0],[49,51,"io"],[52,55,"non"],[56,61,"potere"],[62,65,"più"],[66,73,"levare"],[74,77,"da"],[78,82,"capo"],[83,87,"quello"],[88,99,"prigioniero"],[100,110,"affacciare"],[111,113,"a"],[114,124,"finestrino"],[126,131,"quello"],[132,137,"addio"],[138,140,"a"],[141,148,"maestro"],[150,154,"quello"],[155,161
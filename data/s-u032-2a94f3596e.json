,"giornale"],[41,42,"e"],[43,48,"in"],[49,55,"avviso"],[56,59,"di"],[60,66,"teatro"],[68,69,"e"],[70,74,"ogni"],[75,80,"volta"],[81,84,"che"],[85,87,"avere"],[88,93,"dieci"],[94,99,"soldi"],[100,102,"si"],[103,110,"comperare"],[111,113,"un"],[114,119,"libro"],[121,122,"si"],[123,124,"essere"],[125,128,"già"],[129,134,"mettere"],[135,142,"insieme"],[143,146,"un"],[147,154,"piccolo"],[155,165,"biblioteca"],[167,168,"e"],[169,171,"in"],[172,174,"un"],[175,182,"momento"],[183,185,"di"],[186,190,"buono"],[191,196,"umore"],[197,199,"si"],[200,206,"lasciare"],[207,214,"scappare"],[215,217,"di"],[218,223,"bocca"],[224,227,"che"],[228,230,"mi"],[231,239,"condurre"],[240,241,"a"],[242,246,"casa"],[247,248,"a"],[249,256,"vedere"]]},{"it":"Non parla a nessuno, non gioca con nessuno, è sempre lì al banco coi pugni alle tempie, fermo come un masso, a sentire il maestro.","ja":"","t":[[0,3,"non"],[4,9,"parlare"],[10,11,"a"],[12,19,"nessuno"],[21,24,"non"],[25,30,"giocare"],[31,34,"con"],[35,42,"nessuno"],[44,45,"essere"],[46,52,"sempre"],[53,55,"lì"],[56,58,"a"],[59,64,"banco"],[65,68,"con"],[69,74,"pugno"],[75,79,"a"],[80,86,"tempia"],[88,93,"fermare"],[94,98,"come"],[99,101,"un"],[102,107,0],[109,110,"a"],[111,118,"sentire"],[119,121,"il"],[122,129,"maestro"]]},{"it":"Quanto deve aver faticato, povero Stardi!","ja":"","t":[[0,6,"quanto"],[7,11,"dovere"],[12,16,"avere"],[17,25,"faticare"],[27,33,"povero"],[34,40,0]]},{"it":"Il maestro glielo disse questa mattina, benchè fosse impaziente e di malumore, quando diede le medaglie: — Bravo Stardi; chi la dura la vince.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,17,"glielo"],[18,23,"dire"],[24,30,"questo"],[31,38,"mattina"],[40,46,"benché"],[47,52,"essere"],[53,63,"impaziente"],[64,65,"e"],[66,68,"dire"],[69,77,"malumore"],[79,85,"quando"],[86,91,"dare"],[92,94,"il"],[95,103,"medaglia"],[107,112,"bravo"],[113,119,0],[121,124,"chi"],[125,127,"il"],[128,132,"duro"],[133,135,"il"],[136,141,"vincere"]]},{"it":"— Ma egli non parve affatto inorgoglito, non sorrise, e appena tornato al banco con la sua medaglia, ripiantò i due pugni alle tempie e stette più immobile e più attento di prima.","ja":"","t":[[2,4,"ma"],[5,9,"egli"],[10,13,"non"],[14,19,"parere"],[20,27,"affatto"],[28,39,0],[41,44,"non"],[45,52,"sorridere"],[54,55,"e"],[56,62,"appena"],[63,70,"tornare"],[71,73,"a"],[74,79,"banco"],[80,83,"con"],[84,86,"il"],[87,90,"suo"],[91,99,"medaglia"],[101,109,0],[110,111,"il"],[112,115,"due"],[116,121,"pugno"],[122,126,"a"],[127,133,"tempia"],[134,135,"e"],[136,142,"stare"],[143,146,"più"],[147,155,"immobile"],[156,157,"e"],[158,161,"più"],[162,169,"attento"],[170,172,"di"],[173,178,"prima"]]},{"it":"Ma il più bello fu all’uscita, che c’era a aspettarlo suo padre, — un flebotomo, — grosso e tozzo come lui, con un faccione e un vocione.","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,9,"più"],[10,15,"bello"],[16,18,"essere"],[19,22,"a"],[23,29,"uscita"],[31,34,"che"],[35,36,"ci"],[37,40,"essere"],[41,42,"a"],[43,53,"aspettare"],[54,57,"suo"],[58,63,"padre"],[67,69,"un"],[70,79,0],[83,89,"grosso"],[90,91,"e"],[92,97,"tozzo"],[98,102,"come"],[103,106,"lui"],[108,111,"con"],[112,114,"un"],[115,123,"fare"],[124,125,"e"],[126,128,"un"],[129,136,0]]},{"it":"Egli non se l’aspettava quella medaglia, e non ci voleva credere, bisognò che il maestro lo assicurasse, e allora si mise a ridere di gusto, e diede una manata sulla nuca al figliuolo, dicendo forte: — Ma bravo, ma bene, caro zuccone mio, va!","ja":"","t":[[0,4,"egli"],[5,8,"non"],[9,11,"se"],[12,13,"il"],[14,23,"aspettare"],[24,30,"quello"],[31,39,"medaglia"],[41,42,"e"],[43,46,"non"],[47,49,"ci"],[50,56,"volere"],[57,64,"credere"],[66,73,"bisognare"],[74,77,"che"],[78,80,"il"],[81,88,"maestro"],[89,91,"il"],[92,103,"assicurare"],[105,106,"e"],[107,113,"allora"],[114,116,"si"],[117,121,"mettere"],[122,123,"a"],[124,130,"ridere"],[131,133,"di"],[134,139,"gusto"],[141,142,"e"],[143,148,"dare"],[149,152,"un"],[153,159,0],[160,165,"su"],[166,170,"nuca"],[171,173,"a"
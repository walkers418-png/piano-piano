hi.","ja":"","t":[[2,11,"acchiappare"],[12,14,"il"],[15,21,"mosca"],[22,23,"e"],[24,27,"poi"],[28,30,"me"],[31,33,"il"],[34,36,"fare"],[37,43,"volare"],[44,50,"dentro"],[51,54,"il"],[55,62,"orecchio"]]},{"it":"—","ja":"","t":[]},{"it":"Allora il maestro, dopo avermi dato un altro saggio della magrezza e della durezza delle sue mani, mi faceva mutar posto daccapo.","ja":"","t":[[0,6,"allora"],[7,9,"il"],[10,17,"maestro"],[19,23,"dopo"],[24,30,"avere"],[31,35,"dare"],[36,38,"un"],[39,44,"altro"],[45,51,"saggio"],[52,57,"di"],[58,66,0],[67,68,"e"],[69,74,"di"],[75,82,0],[83,88,"di"],[89,92,"suo"],[93,97,"mano"],[99,101,"mi"],[102,108,"fare"],[109,114,"mutare"],[115,120,"posto"],[121,128,"daccapo"]]},{"it":"Fatto sta che, a furia di mutar posto tutti i giorni, sulla panca dei Romani non c’era più un romano che volesse accettarmi per suo vicino.","ja":"","t":[[0,5,"fare"],[6,9,"stare"],[10,13,"che"],[15,16,"a"],[17,22,"furia"],[23,25,"di"],[26,31,"mutare"],[32,37,"posto"],[38,43,"tutto"],[44,45,"il"],[46,52,"giorno"],[54,59,"su"],[60,65,"panca"],[66,69,"di"],[70,76,"romano"],[77,80,"non"],[81,82,"ci"],[83,86,"essere"],[87,90,"più"],[91,93,"un"],[94,100,"romano"],[101,104,"che"],[105,112,"volere"],[113,123,"accettare"],[124,127,"per"],[128,131,"suo"],[132,138,"vicino"]]},{"it":"Fui mandato, per ultimo ripiego, fra i Cartaginesi, e mi trovai accanto al più buon figliuolo di questo mondo, un certo Silvano, grasso come un cappone sotto le feste di Natale, il quale studiava poco, questo è vero, ma dormiva moltissimo, confessando da sè stesso che dormiva più volentieri sulle panche di scuola che sulle materasse del letto.","ja":"","t":[[0,3,"essere"],[4,11,"mandare"],[13,16,"per"],[17,23,"ultimo"],[24,31,0],[33,36,"fra"],[37,38,"il"],[39,50,0],[52,53,"e"],[54,56,"mi"],[57,63,"trovare"],[64,71,"accanto"],[72,74,"a"],[75,78,"più"],[79,83,"buono"],[84,93,"figliuolo"],[94,96,"di"],[97,103,"questo"],[104,109,"mondo"],[111,113,"un"],[114,119,"certo"],[120,127,0],[129,135,"grasso"],[
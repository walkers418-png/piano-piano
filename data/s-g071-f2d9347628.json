{"id":"g071","title":"16 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"16 gennaio.","ja":"","t":[[3,10,"gennaio"]]},{"it":"Ho già pensato al regalo che debbo fare a mio cognato.","ja":"","t":[[0,2,"avere"],[3,6,"già"],[7,14,"pensare"],[15,17,"a"],[18,24,"regalo"],[25,28,"che"],[29,34,"dovere"],[35,39,"fare"],[40,41,"a"],[42,45,"mio"],[46,53,"cognato"]]},{"it":"Gli comprerò una bella cartella da tenere sulla sua scrivania invece di quella che ha ora, che è tutta strappucchiata e sudicia d’inchiostro.","ja":"","t":[[0,3,"il"],[4,12,"comprare"],[13,16,"un"],[17,22,"bello"],[23,31,"cartella"],[32,34,"da"],[35,41,"tenero"],[42,47,"su"],[48,51,"suo"],[52,61,"scrivania"],[62,68,"invece"],[69,71,"di"],[72,78,"quello"],[79,82,"che"],[83,85,"avere"],[86,89,"ora"],[91,94,"che"],[95,96,"essere"],[97,102,"tutto"],[103,117,0],[118,119,"e"],[120,127,"sudicio"],[128,129,"di"],[130,140,"inchiostro"]]},{"it":"E poi comprerò anche un paio di razzi che manderò dalla terrazza in segno di gioia per esser finalmente diventato un buon ragazzo come desiderano i miei genitori.","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,14,"comprare"],[15,20,"anche"],[21,23,"un"],[24,28,"paio"],[29,31,"di"],[32,37,"razzo"],[38,41,"che"],[42,49,"mandare"],[50,55,"da"],[56,64,"terrazza"],[65,67,"in"],[68,73,"segno"],[74,76,"di"],[77,82,"gioia"],[83,86,"per"],[87,92,"essere"],[93,103,"finalmente"],[104,113,"diventare"],[114,116,"un"],[117,121,"buono"],[122,129,"ragazzo"],[130,134,"come"],[135,145,"desiderare"],[146,147,"il"],[148,152,"mio"],[153,161,"genitore"]]}],"q":[],"g":{},"n":64,"w":["a","anche","avere","bello","buono","cartella","che","cognato","come","comprare","da","desiderare","di","diventare","dovere","e","essere","fare","finalmente","genitore","gennaio","gioia","già","il","in","inchiostro","invece","mandare","mio","ora","paio","pensare","per","poi","quello","ragazzo","razzo","regalo","scrivania","segno","su","sudicio
{"id":"u078","title":"Aprile・Giuseppe Mazzini","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"GIUSEPPE MAZZINI","ja":"","t":[[0,8,0],[9,16,0]]},{"it":"29, sabato","ja":"","t":[[4,10,"sabato"]]},{"it":"Anche questa mattina Garrone venne alla scuola pallido e con gli occhi gonfi di pianto; e diede appena un’occhiata ai piccoli regali che gli avevamo messi sul banco per consolarlo.","ja":"","t":[[0,5,"anche"],[6,12,"questo"],[13,20,"mattina"],[21,28,0],[29,34,"venire"],[35,39,"a"],[40,46,"scuola"],[47,54,"pallido"],[55,56,"e"],[57,60,"con"],[61,64,"il"],[65,70,"occhio"],[71,76,"gonfiare"],[77,79,"di"],[80,86,"pianto"],[88,89,"e"],[90,95,"dare"],[96,102,"appena"],[103,105,"un"],[106,114,"occhiata"],[115,117,"a"],[118,125,"piccolo"],[126,132,"regalo"],[133,136,"che"],[137,140,"il"],[141,148,"avere"],[149,154,"mettere"],[155,158,"su"],[159,164,"banco"],[165,168,"per"],[169,179,"consolare"]]},{"it":"Ma il maestro aveva portato una pagina d’un libro, da leggergli, per fargli animo.","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,13,"maestro"],[14,19,"avere"],[20,27,"portare"],[28,31,"un"],[32,38,"pagina"],[39,40,"di"],[41,43,"un"],[44,49,"libro"],[51,53,"da"],[54,63,"leggere"],[65,68,"per"],[69,75,"fare"],[76,81,"animo"]]},{"it":"Prima ci avvertì che andassimo tutti domani al tocco al Municipio a veder dare la medaglia del valor civile a un ragazzo che ha salvato un bambino dal Po, e che lunedì egli ci avrebbe dettato la descrizione della festa, in luogo del racconto mensile.","ja":"","t":[[0,5,"prima"],[6,8,"ci"],[9,16,"avvertire"],[17,20,"che"],[21,30,"andare"],[31,36,"tutto"],[37,43,"domani"],[44,46,"a"],[47,52,"toccare"],[53,55,"a"],[56,65,"municipio"],[66,67,"a"],[68,73,"vedere"],[74,78,"dare"],[79,81,"il"],[82,90,"medaglia"],[91,94,"di"],[95,100,0],[101,107,"civile"],[108,109,"a"],[110,112,"un"],[113,120,"ragazzo"],[121,124,"che"],[125,127,"avere"],[128,135,"salvare"],[136,138,"un"],[139,146,"bambino"],[147,150,"da"],[151,153
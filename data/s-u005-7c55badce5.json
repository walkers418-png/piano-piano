{"id":"u005","title":"Ottobre・I miei compagni","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"I MIEI COMPAGNI.","ja":"","t":[[0,1,"il"],[2,6,"mio"],[7,15,"compagno"]]},{"it":"25, martedì.","ja":"","t":[[4,11,"martedì"]]},{"it":"Il ragazzo che mandò il francobollo al calabrese è quello che mi piace più di tutti, si chiama Garrone, è il più grande della classe, ha quasi quattordici anni, la testa grossa, le spalle larghe; è buono, si vede quando sorride; ma pare che pensi sempre, come un uomo.","ja":"","t":[[0,2,"il"],[3,10,"ragazzo"],[11,14,"che"],[15,20,"mandare"],[21,23,"il"],[24,35,"francobollo"],[36,38,"a"],[39,48,"calabrese"],[49,50,"essere"],[51,57,"quello"],[58,61,"che"],[62,64,"mi"],[65,70,"piacere"],[71,74,"più"],[75,77,"di"],[78,83,"tutto"],[85,87,"si"],[88,94,"chiamare"],[95,102,0],[104,105,"essere"],[106,108,"il"],[109,112,"più"],[113,119,"grande"],[120,125,"di"],[126,132,"classe"],[134,136,"avere"],[137,142,"quasi"],[143,154,"quattordici"],[155,159,"anno"],[161,163,"il"],[164,169,"testa"],[170,176,"grosso"],[178,180,"il"],[181,187,"spalla"],[188,194,"largo"],[196,197,"essere"],[198,203,"buono"],[205,207,"si"],[208,212,"vedere"],[213,219,"quando"],[220,227,"sorridere"],[229,231,"ma"],[232,236,"parere"],[237,240,"che"],[241,246,"pensare"],[247,253,"sempre"],[255,259,"come"],[260,262,"un"],[263,267,"uomo"]]},{"it":"Ora ne conosco già molti dei miei compagni.","ja":"","t":[[0,3,"ora"],[4,6,"ne"],[7,14,"conoscere"],[15,18,"già"],[19,24,"molto"],[25,28,"di"],[29,33,"mio"],[34,42,"compagno"]]},{"it":"Un altro mi piace pure, che ha nome Coretti, e porta una maglia color cioccolata e un berretto di pelo di gatto: sempre allegro, figliuolo d’un rivenditore di legna, che è stato soldato nella guerra del 66, nel quadrato del prìncipe Umberto, e dicono che ha tre medaglie.","ja":"","t":[[0,2,"un"],[3,8,"altro"],[9,11,"mi"],[12,17,"piacere"],[18,22,"pure"],[24,27,"che"],[28,30,"avere"],[31,35,"nome"],[36,43,0],[45,46
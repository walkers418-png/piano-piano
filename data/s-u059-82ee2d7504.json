{"id":"u059","title":"Marzo・La lotta","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LA LOTTA","ja":"","t":[[0,2,"il"],[3,8,"lotta"]]},{"it":"5, domenica","ja":"","t":[[3,11,"domenica"]]},{"it":"Era da aspettarsela: Franti, cacciato dal Direttore volle vendicarsi, e aspettò Stardi a una cantonata, dopo l’uscita della scuola, quand’egli passa con sua sorella, che va a prendere ogni giorno a un istituto di via Dora Grossa.","ja":"","t":[[0,3,"essere"],[4,6,"da"],[7,19,0],[21,27,0],[29,37,"cacciare"],[38,41,"da"],[42,51,"direttore"],[52,57,"volere"],[58,68,0],[70,71,"e"],[72,79,"aspettare"],[80,86,0],[87,88,"a"],[89,92,"un"],[93,102,0],[104,108,"dopo"],[109,110,"il"],[111,117,"uscita"],[118,123,"di"],[124,130,"scuola"],[132,137,"quando"],[138,142,"egli"],[143,148,"passare"],[149,152,"con"],[153,156,"suo"],[157,164,"sorella"],[166,169,"che"],[170,172,"andare"],[173,174,"a"],[175,183,"prendere"],[184,188,"ogni"],[189,195,"giorno"],[196,197,"a"],[198,200,"un"],[201,209,"istituto"],[210,212,"di"],[213,216,"via"],[217,221,0],[222,228,"grosso"]]},{"it":"Mia sorella Silvia, uscendo dalla sua sezione, vide tutto e tornò a casa piena di spavento.","ja":"","t":[[0,3,"mio"],[4,11,"sorella"],[12,18,0],[20,27,"uscire"],[28,33,"da"],[34,37,"suo"],[38,45,"sezione"],[47,51,"vedere"],[52,57,"tutto"],[58,59,"e"],[60,65,"tornare"],[66,67,"a"],[68,72,"casa"],[73,78,"pieno"],[79,81,"di"],[82,90,"spavento"]]},{"it":"Ecco quello che accadde.","ja":"","t":[[0,4,"ecco"],[5,11,"quello"],[12,15,"che"],[16,23,"accadere"]]},{"it":"Franti, col suo berretto di tela cerata schiacciato sur un orecchio, corse in punta di piedi dietro di Stardi, e per provocarlo, diede una strappata alla treccia di sua sorella, una strappata così forte che quasi la gittò in terra riversa.","ja":"","t":[[0,6,0],[8,11,"con"],[12,15,"suo"],[16,24,"berretto"],[25,27,"di"],[28,32,0],[33,39,0],[40,51,0],[52,55,"su"],[56,58,"un"],[59,67,"orecchio"],[69,74,"correre"],[75,77,"in"],[78,83,"punta"],[84,86,"di"],[87,92,"piede"],[93,99,"dietro"],[100,102,"di"],[103,109,0],[111,112,"e"],[113,116,"per"],[117,127,"provocare"],[129,134,"dare"],[135,138,"un"],[139,148,"strappare"],[149,153,"a"],[154,161,0],[162,164,"di"],[165,168,"suo"],[169,176,"sorella"],[178,181,"un"],[182,191,"strappare"],[192,196,"così"],[197,202,"forte"],[203,206,"che"],[207,212,"quasi"],[213,215,"il"],[216,221,0],[222,224,"in"],[225,230,"terra"],[231,238,0]]},{"it":"La ragazzina mise un grido, suo fratello si voltò.","ja":"","t":[[0,2,"il"],[3,12,0],[13,17,"mettere"],[18,20,"un"],[21,26,"gridare"],[28,31,"suo"],[32,40,"fratello"],[41,43,"si"],[44,49,"voltare"]]},{"it":"Franti, che è molto più alto e più forte di Stardi pensava: — O non rifiaterà, o gli darò le croste.","ja":"","t":[[0,6,0],[8,11,"che"],[12,13,"essere"],[14,19,"molto"],[20,23,"più"],[24,28,"alto"],[29,30,"e"],[31,34,"più"],[35,40,"forte"],[41,43,"di"],[44,50,0],[51,58,"pensare"],[62,63,"o"],[64,67,"non"],[68,77,0],[79,80,"o"],[81,84,"il"],[85,89,"dare"],[90,92,"il"],[93,99,0]]},{"it":"— Ma Stardi non stette a pensare, e così piccolo e tozzo com’è, si lanciò d’un salto su quel grandiglione, e cominciò a mescergli fior di pugni.","ja":"","t":[[2,4,"ma"],[5,11,0],[12,15,"non"],[16,22,"stare"],[23,24,"a"],[25,32,"pensare"],[34,35,"e"],[36,40,"così"],[41,48,"piccolo"],[49,50,"e"],[51,56,"tozzo"],[57,60,"come"],[61,62,"essere"],[64,66,"si"],[67,73,"lanciare"],[74,75,"di"],[76,78,"un"],[79,84,"saltare"],[85,87,"su"],[88,92,"quello"],[93,105,0],[107,108,"e"],[109,117,"cominciare"],[118,119,"a"],[120,129,0],[130,134,"fiore"],[135,137,"di"],[138,143,0]]},{"it":"Non ce ne poteva però, e ne toccava più di quel che ne desse.","ja":"","t":[[0,3,"non"],[4,6,"ce"],[7,9,"ne"],[10,16,"potere"],[17,21,"però"],[23,24,"e"],[25,27,"ne"],[28,35,"toccare"],[36,39,"più"],[40,42,"di"],[43,47,"quello"],[48,51,"che"],[52,54,"ne"],[55,60,"dare"]]},{"it":"Nella strada non c’eran che ragazze, nessuno poteva separarli.","ja":"","t":[[0,5,"in"],[6,12,"strada"],[13,16,"non"],[17,18,"ci"],[19,23,"essere"],[24,27,"che"],[28,35,"ragazza"],[37,44,"nessuno"],[45,51,"potere"],[52,61,0]]},{"it":"Franti lo buttò in terra; ma quegli su subito, e addosso daccapo, e Franti picchia come sur un uscio: in un momento gli strappò mezz’orecchia, gli ammaccò un occhio, gli fece uscir sangue dal naso.","ja":"","t":[[0,6,0],[7,9,"il"],[10,15,"buttare"],[16,18,"in"],[19,24,"terra"],[26,28,"ma"],[29,35,"quello"],[36,38,"su"],[39,45,"subito"],[47,48,"e"],[49,56,"addosso"],[57,64,"daccapo"],[66,67,"e"],[68,74,0],[75,82,"picchiare"],[83,87,"come"],[88,91,"su"],[92,94,"un"],[95,100,"uscio"],[102,104,"in"],[105,107,"un"],[108,115,"momento"],[116,119,"il"],[120,127,"strappare"],[128,132,"mezzo"],[133,141,0],[143,146,"il"],[147,154,0],[155,157,"un"],[158,164,"occhio"],[166,169,"il"],[170,174,"fare"],[175,180,"uscire"],[181,187,"sangue"],[188,191,"da"],[192,196,"naso"]]},{"it":"Ma Stardi duro; ruggiva: — M’ammazzerai, ma te la fò pagare.","ja":"","t":[[0,2,"ma"],[3,9,0],[10,14,"duro"],[16,23,0],[27,28,"mi"],[29,39,0],[41,43,"ma"],[44,46,"te"],[47,49,"il"],[50,52,0],[53,59,"pagare"]]},{"it":"— E Franti giù, calci e ceffoni, e Stardi sotto, a capate e a pedate.","ja":"","t":[[2,3,"e"],[4,10,0],[11,14,"giù"],[16,21,"calcio"],[22,23,"e"],[24,31,0],[33,34,"e"],[35,41,0],[42,47,"sotto"],[49,50,"a"],[51,57,0],[58,59,"e"],[60,61,"a"],[62,68,0]]},{"it":"Una donna gridò dalla finestra: — Bravo il piccolo!","ja":"","t":[[0,3,"un"],[4,9,"donna"],[10,15,"gridare"],[16,21,"da"],[22,30,"finestra"],[34,39,"bravo"],[40,42,"il"],[43,50,"piccolo"]]},{"it":"— Altre dicevano: — È un ragazzo che difende sua sorella.","ja":"","t":[[2,7,"altro"],[8,16,"dire"],[20,21,"essere"],[22,24,"un"],[25,32,"ragazzo"],[33,36,"che"],[37,44,"difendere"],[45,48,"suo"],[49,56,"sorella"]]},{"it":"— Coraggio!","ja":"","t":[[2,10,"coraggio"]]},{"it":"— Dagliele sode.","ja":"","t":[[2,10,"dare"],[11,15,0]]},{"it":"— E gridavano a Franti: — Prepotente, vigliaccone.","ja":"","t":[[2,3,"e"],[4,13,"gridare"],[14,15,"a"],[16,22,0],[26,36,0],[38,49,0]]},{"it":"— Ma Franti pure s’era inferocito, fece gambetta, Stardi cadde, ed egli addosso: — Arrenditi!","ja":"","t":[[2,4,"ma"],[5,11,0],[12,16,"pure"],[17,18,"si"],[19,22,"essere"],[23,33,0],[35,39,"fare"],[40,48,0],[50,56,0],[57,62,"cadere"],[64,66,"e"],[67,71,"egli"],[72,79,"addosso"],[83,92,0]]},{"it":"— No!","ja":"","t":[[2,4,"no"]]},{"it":"— Arrenditi!","ja":"","t":[[2,11,0]]},{"it":"— No!","ja":"","t":[[2,4,"no"]]},{"it":"— e d’un guizzo Stardi si rimise in piedi, avvinghiò Franti alla vita e con uno sforzo furioso lo stramazzò sul selciato e gli cascò con un ginocchio sul petto.","ja":"","t":[[2,3,"e"],[4,5,"di"],[6,8,"un"],[9,15,0],[16,22,0],[23,25,"si"],[26,32,"rimettere"],[33,35,"in"],[36,41,"piede"],[43,52,0],[53,59,0],[60,64,"a"],[65,69,"vita"],[70,71,"e"],[72,75,"con"],[76,79,"un"],[80,86,"sforzo"],[87,94,0],[95,97,"il"],[98,107,0],[108,111,"su"],[112,120,0],[121,122,"e"],[123,126,"il"],[127,132,0],[133,136,"con"],[137,139,"un"],[140,149,"ginocchio"],[150,153,"su"],[154,159,"petto"]]},{"it":"— Ah! l’infame che ha il coltello!","ja":"","t":[[2,4,"ah"],[6,7,"il"],[8,14,0],[15,18,"che"],[19,21,"avere"],[22,24,"il"],[25,33,"coltello"]]},{"it":"— gridò un uomo accorrendo per disarmare Franti.","ja":"","t":[[2,7,"gridare"],[8,10,"un"],[11,15,"uomo"],[16,26,0],[27,30,"per"],[31,40,0],[41,47,0]]},{"it":"Ma già Stardi, fuori di sé, gli aveva afferrato il braccio con due mani e dato al pugno un tal morso, che il coltello gli era cascato, e la mano gli sanguinava.","ja":"","t":[[0,2,"ma"],[3,6,"già"],[7,13,0],[15,20,"fuori"],[21,23,"di"],[24,26,"sé"],[28,31,"il"],[32,37,"avere"],[38,47,"afferrare"],[48,50,"il"],[51,58,"braccio"],[59,62,"con"],[63,66,"due"],[67,71,"mano"],[72,73,"e"],[74,78,"dare"],[79,81,"a"],[82,87,0],[88,90,"un"],[91,94,0],[95,100,"mordere"],[102,105,"che"],[106,108,"il"],[109,117,"coltello"],[118,121,"il"],[122,125,"essere"],[126,133,0],[135,136,"e"],[137,139,"il"],[140,144,"mano"],[145,148,"il"],[149,159,"sanguinare"]]},{"it":"Altri intanto erano accorsi, li divisero, li rialzarono; Franti se la dette a gambe, malconcio; e Stardi rimase là, graffiato in viso, con l’occhio pesto, — ma vincitore, accanto alla sorella che piangeva, mentre alcune ragazze raccoglievano i libri e i quaderni sparpagliati per la strada.","ja":"","t":[[0,5,"altro"],[6,13,"intanto"],[14,19,"essere"],[20,27,"accorgersi"],[29,31,"li"],[32,40,"dividere"],[42,44,"li"],[45,55,0],[57,63,0],[64,66,"se"],[67,69,"il"],[70,75,"dire"],[76,77,"a"],[78,83,"gamba"],[85,94,0],[96,97,"e"],[98,104,0],[105,111,"rimanere"],[112,114,"là"],[116,125,"graffiare"],[126,128,"in"],[129,133,"viso"],[135,138,"con"],[139,140,"il"],[141,147,"occhio"],[148,153,0],[157,159,"ma"],[160,169,"vincitore"],[171,178,"accanto"],[179,183,"a"],[184,191,"sorella"],[192,195,"che"],[196,204,"piangere"],[206,212,"mentre"],[213,219,"alcuno"],[220,227,"ragazza"],[228,241,"raccogliere"],[242,243,"il"],[244,249,"libro"],[250,251,"e"],[252,253,"il"],[254,262,"quaderno"],[263,275,0],[276,279,"per"],[280,282,"il"],[283,289,"strada"]]},{"it":"— Bravo il piccolo, — dicevano intorno, — che ha difeso sua sorella!","ja":"","t":[[2,7,"bravo"],[8,10,"il"],[11,18,"piccolo"],[22,30,"dire"],[31,38,"intorno"],[42,45,"che"],[46,48,"avere"],[49,55,"difendere"],[56,59,"suo"],[60,67,"sorella"]]},{"it":"— Ma Stardi, che si dava più pensiero del suo zaino che della sua vittoria, si mise subito a esaminare uno per uno i libri e i quaderni, se non c’era nulla di mancante o di guasto, li ripulì con la manica, guardò il pennino, rimise a posto ogni cosa, e poi, tranquillo e serio come sempre, disse a sua sorella: — Andiamo presto, che ci ho un problema di quattro operazioni.","ja":"","t":[[2,4,"ma"],[5,11,0],[13,16,"che"],[17,19,"si"],[20,24,"dare"],[25,28,"più"],[29,37,"pensiero"],[38,41,"di"],[42,45,"suo"],[46,51,"zaino"],[52,55,"che"],[56,61,"di"],[62,65,"suo"],[66,74,"vittoria"],[76,78,"si"],[79,83,"mettere"],[84,90,"subito"],
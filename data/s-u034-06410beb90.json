{"id":"u034","title":"Gennaio・Il maestro supplente","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL MAESTRO SUPPLENTE","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,20,"supplente"]]},{"it":"4, mercoledì","ja":"","t":[[3,12,"mercoledì"]]},{"it":"Aveva ragione mio padre: il maestro era di malumore perchè non stava bene, e da tre giorni, infatti, viene in sua vece il supplente, quello piccolo e senza barba, che pare un giovinetto.","ja":"","t":[[0,5,"avere"],[6,13,"ragione"],[14,17,"mio"],[18,23,"padre"],[25,27,"il"],[28,35,"maestro"],[36,39,"essere"],[40,42,"dire"],[43,51,"malumore"],[52,58,"perché"],[59,62,"non"],[63,68,"stare"],[69,73,"bene"],[75,76,"e"],[77,79,"da"],[80,83,"tre"],[84,90,"giorno"],[92,99,"infatti"],[101,106,"venire"],[107,109,"in"],[110,113,"suo"],[114,118,0],[119,121,"il"],[122,131,"supplente"],[133,139,"quello"],[140,147,"piccolo"],[148,149,"e"],[150,155,"senza"],[156,161,"barba"],[163,166,"che"],[167,171,"parere"],[172,174,"un"],[175,185,"giovinetto"]]},{"it":"Una brutta cosa accadde questa mattina.","ja":"","t":[[0,3,"un"],[4,10,"brutto"],[11,15,"cosa"],[16,23,"accadere"],[24,30,"questo"],[31,38,"mattina"]]},{"it":"Già il primo e il secondo giorno avevan fatto chiasso nella scuola, perchè il supplente ha una gran pazienza, e non fa che dire: — State zitti, state zitti, vi prego.","ja":"","t":[[0,3,"già"],[4,6,"il"],[7,12,"primo"],[13,14,"e"],[15,17,"il"],[18,25,"secondo"],[26,32,"giorno"],[33,39,"avere"],[40,45,"fare"],[46,53,"chiasso"],[54,59,"in"],[60,66,"scuola"],[68,74,"perché"],[75,77,"il"],[78,87,"supplente"],[88,90,"avere"],[91,94,"un"],[95,99,"grande"],[100,108,"pazienza"],[110,111,"e"],[112,115,"non"],[116,118,"fare"],[119,122,"che"],[123,127,"dire"],[131,136,"stare"],[137,142,"zitto"],[144,149,"stare"],[150,155,"zitto"],[157,159,"vi"],[160,165,"prego"]]},{"it":"— Ma questa mattina si passò la misura.","ja":"","t":[[2,4,"ma"],[5,11,"questo"],[12,19,"mattina"],[20,22,"si"],[23,28,"passare"],[29,31,"il"],[32,38,"misurare"]]},{"it":"Si faceva un ronzìo che non si sentivan più le sue parole, ed egli ammoniva, pregava: ma era fiato sprecato.","ja":"","t":[[0,2,"si"],[3,9,"fare"],[10,12,"un"],[13,19,0],[20,23,"che"],[24,27,"non"],[28,30,"si"],[31,39,"sentire"],[40,43,"più"],[44,46,"il"],[47,50,"suo"],[51,57,"parola"],[59,61,"e"],[62,66,"egli"],[67,75,"ammonire"],[77,84,"pregare"],[86,88,"ma"],[89,92,"essere"],[93,98,"fiatare"],[99,107,"sprecare"]]},{"it":"Due volte il Direttore s’affacciò all’uscio e guardò.","ja":"","t":[[0,3,"due"],[4,9,"volta"],[10,12,"il"],[13,22,"direttore"],[23,24,"si"],[25,33,"affacciare"],[34,37,"a"],[38,43,"uscio"],[44,45,"e"],[46,52,"guardare"]]},{"it":"Ma via lui, il sussurro cresceva, come in un mercato.","ja":"","t":[[0,2,"ma"],[3,6,"via"],[7,10,"lui"],[12,14,"il"],[15,23,"sussurrare"],[24,32,"crescere"],[34,38,"come"],[39,41,"in"],[42,44,"un"],[45,52,"mercato"]]},{"it":"Avevano un bel voltarsi Garrone e Derossi a far dei cenni ai compagni che stessero buoni, che era una vergogna.","ja":"","t":[[0,7,"avere"],[8,10,"un"],[11,14,"bello"],[15,23,"voltare"],[24,31,0],[32,33,"e"],[34,41,0],[42,43,"a"],[44,47,"fare"],[48,51,"di"],[52,57,"cenno"],[58,60,"a"],[61,69,"compagno"],[70,73,"che"],[74,82,"stare"],[83,88,"buono"],[90,93,"che"],[94,97,"essere"],[98,101,"un"],[102,110,"vergogna"]]},{"it":"Nessuno ci badava.","ja":"","t":[[0,7,"nessuno"],[8,10,"ci"],[11,17,"badare"]]},{"it":"Non c’era che Stardi che stesse quieto, coi gomiti sul banco e i pugni alle tempie, pensando forse alla sua famosa libreria, e Garoffi, quello del naso a uncino e dei francobolli, che era tutto occupato a far l’elenco dei sottoscrittori a due centesimi per la lotteria d’un calamaio da tasca.","ja":"","t":[[0,3,"non"],[4,5,"ci"],[6,9,"essere"],[10,13,"che"],[14,20,0],[21,24,"che"],[25,31,"stare"],[32,38,"quieto"],[40,43,"con"],[44,50,"gomito"],[51,54,"su"],[55,60,"banco"],[61,62,"e"],[63,64,"il"],[65,70,"pugno"],[71,75,"a"],[76,82,"tempia"],[84,92,"pens
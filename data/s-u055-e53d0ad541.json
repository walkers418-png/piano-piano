lauti da tutte le parti, e parlar forte e ridere, salendo e scendendo le scale a passi lesti, e girando liberamente per i corridoi e pei dormitori, non si direbbe mai che son quegli sventurati che sono.","ja":"","t":[[0,6,"eppure"],[10,16,"povero"],[17,24,"ragazzo"],[26,32,"quando"],[33,34,"si"],[35,40,"entrare"],[41,44,"per"],[45,47,"il"],[48,53,"prima"],[54,59,"volta"],[60,64,"in"],[65,73,"istituto"],[74,77,"di"],[78,84,"cieco"],[86,93,"durante"],[94,96,"il"],[97,108,"ricreazione"],[110,111,"a"],[112,120,"sentire"],[121,127,"suonare"],[128,135,"violino"],[136,137,"e"],[138,144,"flauto"],[145,147,"da"],[148,153,"tutto"],[154,156,"il"],[157,162,"parte"],[164,165,"e"],[166,172,"parlare"],[173,178,"forte"],[179,180,"e"],[181,187,"ridere"],[189,196,"salire"],[197,198,"e"],[199,208,"scendere"],[209,211,"il"],[212,217,"scala"],[218,219,"a"],[220,225,"passo"],[226,231,"lesto"],[233,234,"e"],[235,242,"girare"],[243,254,0],[255,258,"per"],[259,260,"il"],[261,269,"corridoio"],[270,271,"e"],[272,275,"per"],[276,285,"dormitorio"],[287,290,"non"],[291,293,"si"],[294,301,"dire"],[302,305,"mai"],[306,309,"che"],[310,313,"essere"],[314,320,"quello"],[321,331,0],[332,335,"che"],[336,340,"essere"]]},{"it":"Bisogna osservarli bene.","ja":"","t":[[0,7,"bisognare"],[8,18,"osservare"],[19,23,"bene"]]},{"it":"C’è dei giovani di sedici o diciott’anni, robusti e allegri, che portano la cecità con una certa disinvoltura, con una certa baldanza quasi; ma si capisce dall’espressione risentita e fiera dei visi, che debbono aver sofferto tremendamente prima di rassegnarsi a quella sventura.","ja":"","t":[[0,1,"ci"],[2,3,"essere"],[4,7,"di"],[8,15,"giovane"],[16,18,"di"],[19,25,"sedici"],[26,27,"o"],[28,35,0],[36,40,"anno"],[42,49,"robusto"],[50,51,"e"],[52,59,"allegro"],[61,64,"che"],[65,72,"portare"],[73,75,"il"],[76,82,0],[83,86,"con"],[87,90,"un"],[91,96,"certo"],[97,109,0],[111,114,"con"],[115,118,"un"],[119,124,"certo"],[125,133,0],[134,139,"quasi"],[141,143,"ma"],[144,146,"si"],[147,154,"
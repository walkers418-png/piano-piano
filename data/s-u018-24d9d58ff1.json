ria amorevole e triste.","ja":"","t":[[0,6,"povero"],[7,16,"direttore"],[18,22,"egli"],[23,24,"essere"],[25,31,"sempre"],[32,34,"il"],[35,40,"primo"],[41,43,"a"],[44,47,"suo"],[48,53,"posto"],[55,57,"il"],[58,65,"mattina"],[67,68,"a"],[69,78,"aspettare"],[79,82,"il"],[83,90,"scolaro"],[91,92,"e"],[93,94,"a"],[95,98,"dare"],[99,104,"retta"],[105,107,"a"],[108,115,"parente"],[117,118,"e"],[119,125,"quando"],[126,127,"il"],[128,135,"maestro"],[136,139,"essere"],[140,143,"già"],[144,151,"avviare"],[152,157,"verso"],[158,162,"casa"],[164,168,"girare"],[169,175,"ancora"],[176,183,"intorno"],[184,188,"a"],[189,195,"scuola"],[196,197,"a"],[198,204,"vedere"],[205,208,"che"],[209,210,"il"],[211,218,"ragazzo"],[219,222,"non"],[223,225,"si"],[226,233,"cacciare"],[234,239,"sotto"],[240,242,"il"],[243,251,"carrozza"],[253,254,"o"],[255,258,"non"],[259,261,"si"],[262,272,"trattenere"],[273,276,"per"],[277,279,"il"],[280,286,"strada"],[287,288,"a"],[289,292,"fare"],[293,302,0],[304,305,"o"],[306,307,"a"],[308,313,"empire"],[314,317,"il"],[318,323,"zaino"],[324,326,"di"],[327,333,"sabbia"],[334,335,"o"],[336,338,"di"],[339,344,"sasso"],[346,347,"e"],[348,352,"ogni"],[353,358,"volta"],[359,362,"che"],[363,369,"apparire"],[370,371,"a"],[372,375,"un"],[376,385,"cantonata"],[387,391,"così"],[392,396,"alto"],[397,398,"e"],[399,403,"nero"],[405,411,"stormo"],[412,414,"di"],[415,422,"ragazzo"],[423,431,"scappare"],[432,434,"da"],[435,440,"tutto"],[441,443,"il"],[444,449,"parte"],[451,460,"piantare"],[461,463,"lì"],[464,466,"il"],[467,473,"giocare"],[474,477,"di"],[478,485,0],[486,487,"e"],[488,493,"di"],[494,500,0],[502,504,"e"],[505,509,"egli"],[510,512,"li"],[513,521,"minaccia"],[522,525,"con"],[526,527,"il"],[528,534,"indice"],[535,537,"da"],[538,545,"lontano"],[547,550,"con"],[551,553,"il"],[554,557,"suo"],[558,562,"aria"],[563,572,0],[573,574,"e"],[575,581,"triste"]]},{"it":"Nessuno l’ha più visto ridere, dice mia madre, dopo che gli è morto il figliuolo ch’era volontario nell’esercito; ed egli ha sempre il suo ritratto davanti agli occhi, sul tavolino della Direzione.","ja":"","t":[[0,7,"nessuno"],[8,9,"il"],[10,12,"avere"],[13,16,"più"],[17,22,"vedere"],[23,29,"ridere"],[31,35,"dire"],[36,39,"mio"],[40,45,"madre"],[47,51,"dopo"],[52,55,"che"],[56,59,"il"],[60,61,"essere"],[62,67,"morire"],[68,70,"il"],[71,80,"figliuolo"],[81,83,"che"],[84,87,"essere"],[88,98,"volontario"],[99,103,"in"],[104,112,"esercito"],[114,116,"e"],[117,121,"egli"],[122,124,"avere"],[125,131,"sempre"],[132,134,"il"],[135,138,"suo"],[139,147,"ritratto"],[148,155,"davanti"],[156,160,"a"],[161,166,"occhio"],[168,171,"su"],[172,180,"tavolino"],[181,186,"di"],[187,196,"direzione"]]},{"it":"E se ne voleva andare dopo quella disgrazia; aveva già fatto la sua domanda di riposo al Municipio, e la teneva sempre sul tavolino, aspettando di giorno in giorno a mandarla, perchè gli rincresceva di lasciare i fanciulli.","ja":"","t":[[0,1,"e"],[2,4,"se"],[5,7,"ne"],[8,14,"volere"],[15,21,"andare"],[22,26,"dopo"],[27,33,"quello"],[34,43,"disgrazia"],[45,50,"avere"],[51,54,"già"],[55,60,"fare"],[61,63,"il"],[64,67,"suo"],[68,75,"domanda"],[76,78,"di"],[79,85,"riposare"],[86,88,"a"],[89,98,"municipio"],[100,101,"e"],[102,104,"il"],[105,111,"tenere"],[112,118,"sempre"],[119,122,"su"],[123,131,"tavolino"],[133,143,"aspettare"],[144,146,"di"],[147,153,"giorno"],[154,156,"in"],[157,163,"giorno"],[164,165,"a"],[166,174,"mandare"],[176,182,"perché"],[183,186,"il"],[187,198,0],[199,201,"di"],[202,210,"lasciare"],[211,212,"il"],[213,222,"fanciullo"]]},{"it":"Ma l’altro giorno pareva deciso, e mio padre ch’era con lui nella Direzione, gli diceva: — Che peccato che se ne vada, signor Direttore!","ja":"","t":[[0,2,"ma"],[3,4,"il"],[5,10,"altro"],[11,17,"giorno"],[18,24,"parere"],[25,31,"decidere"],[33,34,"e"],[35,38,"mio"],[39,44,"padre"],[45,47,"che"],[48,51,"essere"],[52,55,"con"],[56,59,"lui"],[60,65,"in"],[66,75,"direzione"],[77,80,"il"],[81,87,"dire"],[91,94,"che"],[95,102,"peccato"],[103,106,"ch
{"id":"u006","title":"Ottobre・Un tratto generoso","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"UN TRATTO GENEROSO.","ja":"","t":[[0,2,"un"],[3,9,"trattare"],[10,18,"generoso"]]},{"it":"26, mercoledì.","ja":"","t":[[4,13,"mercoledì"]]},{"it":"E si diede a conoscere appunto questa mattina, Garrone.","ja":"","t":[[0,1,"e"],[2,4,"si"],[5,10,"dare"],[11,12,"a"],[13,22,"conoscere"],[23,30,"appunto"],[31,37,"questo"],[38,45,"mattina"],[47,54,0]]},{"it":"Quando entrai nella scuola, — un poco tardi, chè m’avea fermato la maestra di prima superiore per domandarmi a che ora poteva venir a casa a trovarci, — il maestro non c’era ancora, e tre o quattro ragazzi tormentavano il povero Crossi, quello coi capelli rossi, che ha un braccio morto, e sua madre vende erbaggi.","ja":"","t":[[0,6,"quando"],[7,13,"entrare"],[14,19,"in"],[20,26,"scuola"],[30,32,"un"],[33,37,"poco"],[38,43,"tardi"],[45,48,"che"],[49,50,"mi"],[51,55,"avere"],[56,63,"fermare"],[64,66,"il"],[67,74,"maestra"],[75,77,"di"],[78,83,"prima"],[84,93,"superiore"],[94,97,"per"],[98,108,"domandare"],[109,110,"a"],[111,114,"che"],[115,118,"ora"],[119,125,"potere"],[126,131,"venire"],[132,133,"a"],[134,138,"casa"],[139,140,"a"],[141,149,"trovare"],[153,155,"il"],[156,163,"maestro"],[164,167,"non"],[168,169,"ci"],[170,173,"essere"],[174,180,"ancora"],[182,183,"e"],[184,187,"tre"],[188,189,"o"],[190,197,"quattro"],[198,205,"ragazzo"],[206,218,0],[219,221,"il"],[222,228,"povero"],[229,235,0],[237,243,"quello"],[244,247,"con"],[248,255,"capello"],[256,261,"rosso"],[263,266,"che"],[267,269,"avere"],[270,272,"un"],[273,280,"braccio"],[281,286,"morto"],[288,289,"e"],[290,293,"suo"],[294,299,"madre"],[300,305,"vendere"],[306,313,0]]},{"it":"Lo stuzzicavano colle righe, gli buttavano in faccia delle scorze di castagne, e gli davan dello storpio e del mostro, contraffacendolo, col suo braccio al collo.","ja":"","t":[[0,2,"il"],[3,15,0],[16,21,"con"],[22,27,"riga"],[29,32,"il"],[33,42,"buttare"],[43,45,"in"],[46,52,"fare"],[53,58,"di"],[59,65,"scorza"],[66,68,"di"],[69,77,"castagna"],[79,80,"e"],[81,84,"il"],[85,90,0],[91,96,"di"],[97,104,0],[105,106,"e"],[107,110,"di"],[111,117,"mostrare"],[119,135,0],[137,140,"con"],[141,144,"suo"],[145,152,"braccio"],[153,155,"a"],[156,161,"collo"]]},{"it":"Ed egli tutto solo in fondo al banco, smorto, stava a sentire, guardando ora l’uno ora l’altro con gli occhi supplichevoli, perchè lo lasciassero stare.","ja":"","t":[[0,2,"e"],[3,7,"egli"],[8,13,"tutto"],[14,18,"solo"],[19,21,"in"],[22,27,"fondo"],[28,30,"a"],[31,36,"banco"],[38,44,0],[46,51,"stare"],[52,53,"a"],[54,61,"sentire"],[63,72,"guardare"],[73,76,"ora"],[77,78,"il"],[79,82,"un"],[83,86,"ora"],[87,88,"il"],[89,94,"altro"],[95,98,"con"],[99,102,"il"],[103,108,"occhio"],[109,122,0],[124,130,"perché"],[131,133,"il"],[134,145,"lasciare"],[146,151,"stare"]]},{"it":"Ma gli altri sempre più lo sbeffavano, ed egli cominciò a tremare e a farsi rosso dalla rabbia.","ja":"","t":[[0,2,"ma"],[3,6,"il"],[7,12,"altro"],[13,19,"sempre"],[20,23,"più"],[24,26,"il"],[27,37,0],[39,41,"e"],[42,46,"egli"],[47,55,"cominciare"],[56,57,"a"],[58,65,"tremare"],[66,67,"e"],[68,69,"a"],[70,75,"fare"],[76,81,"rosso"],[82,87,"da"],[88,94,"rabbia"]]},{"it":"A un tratto Franti, quella brutta faccia, salì sur un banco, e facendo mostra di portar due cesti sulle braccia, scimmiottò la mamma di Crossi, quando veniva a aspettare il figliuolo alla porta; perchè ora è malata.","ja":"","t":[[0,1,"a"],[2,4,"un"],[5,11,"trattare"],[12,18,0],[20,26,"quello"],[27,33,"brutto"],[34,40,"fare"],[42,46,"salire"],[47,50,"su"],[51,53,"un"],[54,59,"banco"],[61,62,"e"],[63,70,"fare"],[71,77,"mostra"],[78,80,"di"],[81,87,"portare"],[88,91,"due"],[92,97,0],[98,103,"su"],[104,111,"braccio"],[113,123,0],[124,126,"il"],[127,132,"mamma"],[133,135,"di"],[136,142,0],[144,150,"quando"],[151,157,"venire"],[158,159,"a"],[160,169,"aspettare"],[170,172,"il"],[173,182,"figliuolo"],[183,187,"a"],[188,193,"porta"],[195,201,"perché"],[202,205,"ora"],[206,207,"essere"],[208,214,"malato"]]},{"it":"Molti si misero a ridere forte.","ja":"","t":[[0,5,"molto"],[6,8,"si"],[9,15,"mettere"],[16,17,"a"],[18,24,"ridere"],[25,30,"forte"]]},{"it":"Allora Crossi perse la testa, e afferrato un calamaio glie lo scaraventò al capo di tutta forza; ma Franti fece civetta, e il calamaio andò a colpire nel petto il maestro che entrava.","ja":"","t":[[0,6,"allora"],[7,13,0],[14,19,"perdere"],[20,22,"il"],[23,28,"testa"],[30,31,"e"],[32,41,"afferrare"],[42,44,"un"],[45,53,"calamaio"],[54,58,0],[59,61,"il"],[62,72,0],[73,75,"a"],[76,80,"capo"],[81,83,"di"],[84,89,"tutto"],[90,95,"forza"],[97,99,"ma"],[100,106,0],[107,111,"fare"],[112,119,"civetta"],[121,122,"e"],[123,125,"il"],[126,134,"calamaio"],[135,139,"andare"],[140,141,"a"],[142,149,"colpire"],[150,153,"in"],[154,159,"petto"],[160,162,"il"],[163,170,"maestro"],[171,174,"che"],[175,182,"entrare"]]},{"it":"Tutti scapparono al posto, e fecero silenzio, impauriti.","ja":"","t":[[0,5,"tutto"],[6,16,"scappare"],[17,19,"a"],[20,25,"posto"],[27,28,"e"],[29,35,"fare"],[36,44,"silenzio"],[46,55,"impaurito"]]},{"it":"Il maestro, pallido, salì al tavolino, e con voce alterata domandò:","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[12,19,"pallido"],[21,25,"salire"],[26,28,"a"],[29,37,"tavolino"],[39,40,"e"],[41,44,"con"],[45,49,"voce"],[50,58,0],[59,66,"domandare"]]},{"it":"— Chi è stato?","ja":"","t":[[2,5,"chi"],[6,7,"essere"],[8,13,"essere"]]},{"it":"Nessuno rispose.","ja":"","t":[[0,7,"nessuno"],[8,15,"rispondere"]]},{"it":"Il maestro gridò un’altra volta, alzando ancora la voce: — Chi è?","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,16,"gridare"],[17,19,"un"],[20,25,"altro"],[26,31,"volta"],[33,40,"alzare"],[41,47,"ancora"],[48,50,"il"],[51,55,"voce"],[59,62,"chi"],[63,64,"essere"]]},{"it":"Allora Garrone, mosso a pietà del povero Crossi, si alzò di scatto, e disse risolutamente: — Son io.","ja":"","t":[[0,6,"allora"],[7,14,0],[16,21,"muovere"],[22,23,"a"],[24,29,"pietà"],[30,33,"di"],[34,40,"povero"],[41,47,0],[49,51,"si"],[52,56,"alzare"],[57,59,"di"],[60,66,0],[68,69,"e"],[70,75,"dire"],[76,89,0],[93,96,"essere"],[97,99,"io"]]},{"it":"Il maestro lo guardò, guardò gli scolari stupiti; poi disse con voce tranquilla: — Non sei tu.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,13,"il"],[14,20,"guardare"],[22,28,"guardare"],[29,32,"il"],[33,40,"scolaro"],[41,48,"stupito"],[50,53,"poi"],[54,59,"dire"],[60,63,"con"],[64,68,"voce"],[69,79,"tranquillo"],[83,86,"non"],[87,90,"essere"],[91,93,"tu"]]},{"it":"E dopo un momento: — Il colpevole non sarà punito.","ja":"","t":[[0,1,"e"],[2,6,"dopo"],[7,9,"un"],[10,17,"momento"],[21,23,"il"],[24,33,"colpevole"],[34,37,"non"],[38,42,"essere"],[43,49,"punire"]]},{"it":"S’alzi!","ja":"","t":[[0,1,"si"],[2,6,"alzare"]]},{"it":"Crossi s’alzò, e disse piangendo: — Mi picchiavano e m’insultavano, io ho perso la testa, ho tirato....","ja":"","t":[[0,6,0],[7,8,"si"],[9,13,"alzare"],[15,16,"e"],[17,22,"dire"],[23,32,"piangere"],[36,38,"mi"],[39,50,"picchiare"],[51,52,"e"],[53,54,"mi"],[55,66,"insultare"],[68,70,"io"],[71,73,"avere"],[74,79,"perdere"],[80,82,"il"],[83,88,"testa"],[90,92,"avere"],[93,99,"tirare"]]},{"it":"— Siedi, — disse il maestro.","ja":"","t":[[2,7,"sedere"],[11,16,"dire"],[17,19,"il"],[20,27,"maestro"]]},{"it":"— S’alzino quelli che lo han provocato.","ja":"","t":[[2,3,"si"],[4,10,"alzare"],[11,17,"quello"],[18,21,"che"],[22,24,"il"],[25,28,"avere"],[29,38,"provocare"]]},{"it":"Quattro s’alzarono, col capo chino.","ja":"","t":[[0,7,"quattro"],[8,9,"si"],[10,18,"alzare"],[20,23,"con"],[24,28,"capo"],[29,34,"chinare"]]},{"it":"— Voi, — disse il maestro, — avete insultato un compagno che non vi provocava, schernito un disgraziato, percosso un debole che non si può difendere.","ja":"","t":[[2,5,"voi"],[9,14,"dire"],[15,17,"il"],[18,25,"maestro"],[29,34,"avere"],[35,44,"insultare"],[45,47,"un"],[48,56,"compagno"],[57,60,"che"],[61,64,"non"],[65,67,"vi"],[68,77,"provocare"
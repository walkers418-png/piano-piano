{"id":"u048","title":"Febbraio・Superbia","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"SUPERBIA","ja":"","t":[[0,8,"superbia"]]},{"it":"11, sabato","ja":"","t":[[4,10,"sabato"]]},{"it":"E dire che Carlo Nobis si pulisce la manica con affettazione quando Precossi lo tocca, passando!","ja":"","t":[[0,1,"e"],[2,6,"dire"],[7,10,"che"],[11,16,0],[17,22,0],[23,25,"si"],[26,33,"pulire"],[34,36,"il"],[37,43,"manica"],[44,47,"con"],[48,60,0],[61,67,"quando"],[68,76,0],[77,79,"il"],[80,85,"toccare"],[87,95,"passare"]]},{"it":"Costui è la superbia incarnata perchè suo padre è un riccone.","ja":"","t":[[0,6,"costui"],[7,8,"essere"],[9,11,"il"],[12,20,"superbia"],[21,30,0],[31,37,"perché"],[38,41,"suo"],[42,47,"padre"],[48,49,"essere"],[50,52,"un"],[53,60,0]]},{"it":"Ma anche il padre di Derossi è ricco!","ja":"","t":[[0,2,"ma"],[3,8,"anche"],[9,11,"il"],[12,17,"padre"],[18,20,"di"],[21,28,0],[29,30,"essere"],[31,36,"ricco"]]},{"it":"Egli vorrebbe avere un banco per sè solo, ha paura che tutti lo insudicino, guarda tutti dall’alto al basso, ha sempre un sorriso sprezzante sulle labbra: guai a urtargli un piede quando s’esce in fila a due a due!","ja":"","t":[[0,4,"egli"],[5,13,"volere"],[14,19,"avere"],[20,22,"un"],[23,28,"banco"],[29,32,"per"],[33,35,"sé"],[36,40,"solo"],[42,44,"avere"],[45,50,"paura"],[51,54,"che"],[55,60,"tutto"],[61,63,"il"],[64,74,0],[76,82,"guardare"],[83,88,"tutto"],[89,93,"da"],[94,98,"alto"],[99,101,"a"],[102,107,"basso"],[109,111,"avere"],[112,118,"sempre"],[119,121,"un"],[122,129,"sorriso"],[130,140,0],[141,146,"su"],[147,153,"labbro"],[155,159,"guaio"],[160,161,"a"],[162,170,"urtare"],[171,173,"un"],[174,179,"piede"],[180,186,"quando"],[187,188,"si"],[189,193,"uscire"],[194,196,"in"],[197,201,"fila"],[202,203,"a"],[204,207,"due"],[208,209,"a"],[210,213,"due"]]},{"it":"Per un nulla butta in viso una parola ingiuriosa o minaccia di far venire alla scuola suo padre.","ja":"","t":[[0,3,"per"],[4,6,"un"],[7,12,"nulla"],[13,18,"buttare"],[19,21,"in"],[22,26,"viso"],[27,30,"un"],[31,37,"parola"],[38,48,0],[49,50,"o"],[51,59,"minaccia"],[60,62,"di"],[63,66,"fare"],[67,73,"venire"],[74,78,"a"],[79,85,"scuola"],[86,89,"suo"],[90,95,"padre"]]},{"it":"E sì che suo padre gli ha dato la sua brava polpetta quando trattò da straccione il figliuolo del carbonaio!","ja":"","t":[[0,1,"e"],[2,4,"sì"],[5,8,"che"],[9,12,"suo"],[13,18,"padre"],[19,22,"il"],[23,25,"avere"],[26,30,"dare"],[31,33,"il"],[34,37,"suo"],[38,43,"bravo"],[44,52,"polpetta"],[53,59,"quando"],[60,66,"trattare"],[67,69,"da"],[70,80,"straccione"],[81,83,"il"],[84,93,"figliuolo"],[94,97,"di"],[98,107,"carbonaio"]]},{"it":"Io non ho mai visto una muffa compagna!","ja":"","t":[[0,2,"io"],[3,6,"non"],[7,9,"avere"],[10,13,"mai"],[14,19,"vedere"],[20,23,"un"],[24,29,0],[30,38,"compagna"]]},{"it":"Nessuno gli parla, nessuno gli dice addio quando s’esce, non c’è un cane che gli suggerisca quando non sa la lezione.","ja":"","t":[[0,7,"nessuno"],[8,11,"il"],[12,17,"parlare"],[19,26,"nessuno"],[27,30,"il"],[31,35,"dire"],[36,41,"addio"],[42,48,"quando"],[49,50,"si"],[51,55,"uscire"],[57,60,"non"],[61,62,"ci"],[63,64,"essere"],[65,67,"un"],[68,72,"cane"],[73,76,"che"],[77,80,"il"],[81,91,"suggerire"],[92,98,"quando"],[99,102,"non"],[103,105,"sapere"],[106,108,"il"],[109,116,"lezione"]]},{"it":"E lui non può patir nessuno, e finge di disprezzar sopra tutti Derossi, perchè è il primo, e Garrone perchè tutti gli voglion bene.","ja":"","t":[[0,1,"e"],[2,5,"lui"],[6,9,"non"],[10,13,"potere"],[14,19,"patire"],[20,27,"nessuno"],[29,30,"e"],[31,36,"fingere"],[37,39,"di"],[40,50,0],[51,56,"sopra"],[57,62,"tutto"],[63,70,0],[72,78,"perché"],[79,80,"essere"],[81,83,"il"],[84,89,"primo"],[91,92,"e"],[93,100,0],[101,107,"perché"],[108,113,"tutto"],[114,117,"il"],[118,125,"volere"],[126,130,"bene"]]},{"it":"Ma Derossi non lo guarda neppure quant’è lungo, e Garrone, quando gli riportarono che Nobis sparlava di lui, rispose: — Ha una superbia così stupida che non merita nemmeno i miei scapaccioni.","ja":"","t":[[0,2,"ma"],[3,10,0],[11,14,"non"],[15,17,"il"],[18,24,"guardare"],[25,32,"neppure"],[33,38,"quanto"],[39,40,"essere"],[41,46,"lungo"],[48,49,"e"],[50,57,0],[59,65,"quando"],[66,69,"il"],[70,81,"riportare"],[82,85,"che"],[86,91,0],[92,100,0],[101,103,"di"],[104,107,"lui"],[109,116,"rispondere"],[120,122,"avere"],[123,126,"un"],[127,135,"superbia"],[136,140,"così"],[141,148,"stupido"],[149,152,"che"],[153,156,"non"],[157,163,"meritare"],[164,171,"nemmeno"],[172,173,"il"],[174,178,"mio"],[179,190,"scapaccione"]]},{"it":"— Coretti pure, un giorno ch’egli sorrideva con disprezzo del suo berretto di pel di gatto, gli disse: — Va’ un poco da Derossi a imparare a far il signore!","ja":"","t":[[2,9,0],[10,14,"pure"],[16,18,"un"],[19,25,"giorno"],[26,28,"che"],[29,33,"egli"],[34,43,"sorridere"],[44,47,"con"],[48,57,0],[58,61,"di"],[62,65,"suo"],[66,74,"berretto"],[75,77,"di"],[78,81,"per"],[82,84,"di"],[85,90,"gatto"],[92,95,"il"],[96,101,"dire"],[105,107,"andare"],[109,111,"un"],[112,116,"poco"],[117,119,"da"],[120,127,0],[128,129,"a"],[130,138,"imparare"],[139,140,"a"],[141,144,"fare"],[145,147,"il"],[148,155,"signore"]]},{"it":"— Ieri si lamentò col maestro perchè il calabrese gli toccò una gamba col piede.","ja":"","t":[[2,6,"ieri"],[7,9,"si"],[10,17,"lamentarsi"],[18,21,"con"],[22,29,"maestro"],[30,36,"perché"],[37,39,"il"],[40,49,"calabrese"],[50,53,"il"],[54,59,"toccare"],[60,63,"un"],[64,69,"gamba"],[70,73,"con"],[74,79,"piede"]]},{"it":"Il maestro domandò al calabrese: — L’hai fatto apposta?","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,18,"domandare"],[19,21,"a"],[22,31,"calabrese"],[35,36,"il"],[37,40,"avere"],[41,46,"fare"],[47,54,"apposta"]]},{"it":"— No, signore, — rispose franco.","ja":"","t":[[2,4,"no"],[6,13,"signore"],[17,24,"rispondere"],[25,31,0]]},{"it":"E il maestro: — Siete troppo permaloso, Nobis.","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,12,"maestro"],[16,21,"essere"],[22,28,"troppo"],[29,38,0],[40,45,0]]},{"it":"— E Nobis, con quella sua aria: — Lo dirò a mio padre.","ja":"","t":[[2,3,"e"],[4,9,0],[11,14,"con"],[15,21,"quello"],[22,25,"suo"],[26,30,"aria"],[34,36,"il"],[37,41,"dire"],[42,43,"a"],[44,47,"mio"],[48,53,"padre"]]},{"it":"— Allora il maestro andò in collera: — Vostro padre vi darà torto, come fece altre volte.","ja":"","t":[[2,8,"allora"],[9,11,"il"],[12,19,"maestro"],[20,24,"andare"],[25,27,"in"],[28,35,"collera"],[39,45,"vostro"],[46,51,"padre"],[52,54,"vi"],[55,59,"dare"],[60,65,"torto"],[67,71,"come"],[72,76,"fare"],[77,82,"altro"],[83,88,"volta"]]},{"it":"E poi non c’è che il maestro, in iscuola, che giudichi e punisca.","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,9,"non"],[10,11,"ci"],[12,13,"essere"],[14,17,"che"],[18,20,"il"],[21,28,"maestro"],[30,32,"in"],[33,40,0],[42,45,"che"],[46,54,"giudicare"],[55,56,"e"],[57,64,"punire"]]},{"it":"— Poi soggiunse con dolcezza: — Andiamo, Nobis, cambiate modi, siate buono e cortese coi vostri compagni.","ja":"","t":[[2,5,"poi"],[6,15,"dire"],[16,19,"con"],[20,28,"dolcezza"],[32,39,"andare"],[41,46,0],[48,56,"cambiare"],[57,61,"modo"],[63,68,"essere"],[69,74,"buono"],[75,76,"e"],[77,84,"cortese"],[85,88,"con"],[89,95,"vostro"],[96,104,"compagno"]]},{"it":"Vedete, ci sono dei figliuoli d’operai e di signori, dei ricchi e dei poveri, e tutti si voglion bene, si trattan da fratelli, come sono.","ja":"","t":[[0,6,"vedere"],[8,10,"ci"],[11,15,"essere"],[16,19,"di"],[20,29,"figliuolo"],[30,31,"di"],[32,38,"operaio"],[39,40,"e"],[41,43,"dire"],[44,51,"signore"],[53,56,"di"],[57,63,"ricco"],[64,65,"e"],[66,69,"di"],[70,76,"povero"],[78,79,"e"],[80,85,"tutto"],[86,88,"si"],[89,96,"volere"],[97,101,"bene"],[103,105,"si"],[106,113,"trattare"],[114,116,"da"],[117,125,"fratello"],[127,131,"come"],[132,136,"essere"]]},{"it":"Perchè non fate anche voi come gli altri?","ja":"","t":[[0,6,"perché"],[7,10,"non"],[11,15,"fare"],[16,21,"anche"],[22,25,"voi"],[26,30,"come"],[31,34,"il"],[35,40,"altro"]]},{"it":"V
"],[89,92,"voi"],[93,95,"mi"],[96,101,"avere"],[102,110,"comprare"]]},{"it":"— Pur troppo!","ja":"","t":[[2,5,"pure"],[6,12,"troppo"]]},{"it":"E ti ho pagato venti soldi.","ja":"","t":[[0,1,"e"],[2,4,"ti"],[5,7,"avere"],[8,14,"pagare"],[15,20,"venti"],[21,26,"soldi"]]},{"it":"E ora, chi mi rende i miei poveri venti soldi?","ja":"","t":[[0,1,"e"],[2,5,"ora"],[7,10,"chi"],[11,13,"mi"],[14,19,"rendere"],[20,21,"il"],[22,26,"mio"],[27,33,"povero"],[34,39,"venti"],[40,45,"soldi"]]},{"it":"— E perchè mi avete comprato?","ja":"","t":[[2,3,"e"],[4,10,"perché"],[11,13,"mi"],[14,19,"avere"],[20,28,"comprare"]]},{"it":"Voi mi avete comprato per fare con la mia pelle un tamburo!… un tamburo!…","ja":"","t":[[0,3,"voi"],[4,6,"mi"],[7,12,"avere"],[13,21,"comprare"],[22,25,"per"],[26,30,"fare"],[31,34,"con"],[35,37,"il"],[38,41,"mio"],[42,47,"pelle"],[48,50,"un"],[51,58,"tamburo"],[61,63,"un"],[64,71,"tamburo"]]},{"it":"— Pur troppo!…","ja":"","t":[[2,5,"pure"],[6,12,"troppo"]]},{"it":"E ora dove troverò un’altra pelle!…","ja":"","t":[[0,1,"e"],[2,5,"ora"],[6,10,"dove"],[11,18,"trovare"],[19,21,"un"],[22,27,"altro"],[28,33,"pelle"]]},{"it":"— Non vi date alla disperazione, padrone.","ja":"","t":[[2,5,"non"],[6,8,"vi"],[9,13,"dare"],[14,18,"a"],[19,31,"disperazione"],[33,40,"padrone"]]},{"it":"Dei ciuchini ce n’è tanti, in questo mondo!","ja":"","t":[[0,3,"di"],[4,12,"ciuchino"],[13,15,"ce"],[16,17,0],[18,19,"essere"],[20,25,"tanto"],[27,29,"in"],[30,36,"questo"],[37,42,"mondo"]]},{"it":"— Dimmi, monello impertinente: e la tua storia finisce qui?","ja":"","t":[[2,7,"dire"],[9,16,"monello"],[17,29,"impertinente"],[31,32,"e"],[33,35,"il"],[36,39,"tuo"],[40,46,"storia"],[47,54,"finire"],[55,58,"qui"]]},{"it":"— No, — rispose il burattino, — ci sono altre due parole, e poi è finita.","ja":"","t":[[2,4,"no"],[8,15,"rispondere"],[16,18,"il"],[19,28,"burattino"],[32,34,"ci"],[35,39,"essere"],[40,45,"altro"],[46,49,"due"],[50,56,"parola"],[58,59,"e"],[60,63,"poi"],[64,65,"essere"],[66,72,"f
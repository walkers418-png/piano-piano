are"],[82,84,"un"],[85,92,"milione"]]},{"it":"Il Re già cominciava a rassicurarsi; e siccome la Reginotta era cresciuta, egli pensava di darle marito.","ja":"","t":[[0,2,"il"],[3,5,"re"],[6,9,"già"],[10,20,"cominciare"],[21,22,"a"],[23,35,0],[37,38,"e"],[39,46,"siccome"],[47,49,"il"],[50,59,"reginotta"],[60,63,"essere"],[64,73,"crescere"],[75,79,"egli"],[80,87,"pensare"],[88,90,"di"],[91,96,"dare"],[97,103,"marito"]]},{"it":"Parecchi Principi l’avevano chiesta.","ja":"","t":[[0,8,"parecchio"],[9,17,"principe"],[18,19,"il"],[20,27,"avere"],[28,35,"chiedere"]]},{"it":"Ma la Reginotta, quasi lo facesse a posta, a ogni domanda di matrimonio, rispondeva:","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,15,"reginotta"],[17,22,"quasi"],[23,25,"il"],[26,33,"fare"],[34,35,"a"],[36,41,"posta"],[43,44,"a"],[45,49,"ogni"],[50,57,"domanda"],[58,60,"di"],[61,71,"matrimonio"],[73,83,"rispondere"]]},{"it":"— Maestà, chiedo un altr’anno di tempo.","ja":"","t":[[2,8,"maestà"],[10,16,"chiedere"],[17,19,"un"],[20,24,0],[25,29,"anno"],[30,32,"di"],[33,38,"tempo"]]},{"it":"—","ja":"","t":[]},{"it":"Intanto era accaduto questo: in un paesetto del regno, nascosto fra le montagne, una povera donna aveva partorito un bambino mostruoso, col viso d’uomo e il resto del corpo di vero topolino, con le sue zampine e con la sua codina.","ja":"","t":[[0,7,"intanto"],[8,11,"essere"],[12,20,"accadere"],[21,27,"questo"],[29,31,"in"],[32,34,"un"],[35,43,0],[44,47,"di"],[48,53,"regnare"],[55,63,"nascondere"],[64,67,"fra"],[68,70,"il"],[71,79,"montagna"],[81,84,"un"],[85,91,"povero"],[92,97,"donna"],[98,103,"avere"],[104,113,0],[114,116,"un"],[117,124,"bambino"],[125,134,0],[136,139,"con"],[140,144,"viso"],[145,146,"di"],[147,151,"uomo"],[152,153,"e"],[154,156,"il"],[157,162,"restare"],[163,166,"di"],[167,172,"corpo"],[173,175,"di"],[176,180,"vero"],[181,189,"topolino"],[191,194,"con"],[195,197,"il"],[198,201,"suo"],[202,209,0],[210,211,"e"],[212,215,"con"],[216,218,"il"],[219,222,"suo"],[223,229,0]]},{"it":"Al ved
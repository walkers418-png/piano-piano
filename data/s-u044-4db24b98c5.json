 quello che baciasti ieri.","ja":"","t":[[0,7,"signore"],[9,11,"io"],[12,18,"volere"],[19,25,"essere"],[26,31,"buono"],[33,39,"nobile"],[41,51,"coraggioso"],[53,60,"gentile"],[62,69,"sincero"],[71,80,"aiutare"],[82,86,"fare"],[87,90,"che"],[91,95,"ogni"],[96,100,"sera"],[102,108,"quando"],[109,112,"mio"],[113,118,"madre"],[119,121,"mi"],[122,124,"dare"],[125,126,"il"],[127,133,"ultimo"],[134,140,"saluto"],[142,144,"io"],[145,150,"potere"],[151,156,"dire"],[158,160,"tu"],[161,165,"baciare"],[166,172,"questo"],[173,177,"sera"],[178,180,"un"],[181,190,"fanciullo"],[191,194,"più"],[195,201,"onesto"],[202,203,"e"],[204,207,"più"],[208,213,"degno"],[214,216,"di"],[217,223,"quello"],[224,227,"che"],[228,236,"baciare"],[237,241,"ieri"]]},{"it":"Abbi sempre nel tuo pensiero quell’altro Enrico sovrumano e felice, che tu potrai essere dopo questa vita.","ja":"","t":[[0,4,"avere"],[5,11,"sempre"],[12,15,"in"],[16,19,"tuo"],[20,28,"pensiero"],[29,34,"quello"],[35,40,"altro"],[41,47,0],[48,57,0],[58,59,"e"],[60,66,"felice"],[68,71,"che"],[72,74,"tu"],[75,81,"potere"],[82,88,"essere"],[89,93,"dopo"],[94,100,"questo"],[101,105,"vita"]]},{"it":"E prega.","ja":"","t":[[0,1,"e"],[2,7,"pregare"]]},{"it":"Tu non puoi immaginare che dolcezza provi, quanto si senta migliore una madre quando vede il suo fanciullo con le mani giunte.","ja":"","t":[[0,2,"tu"],[3,6,"non"],[7,11,"potere"],[12,22,"immaginare"],[23,26,"che"],[27,35,"dolcezza"],[36,41,"provare"],[43,49,"quanto"],[50,52,"si"],[53,58,"sentire"],[59,67,"migliore"],[68,71,"un"],[72,77,"madre"],[78,84,"quando"],[85,89,"vedere"],[90,92,"il"],[93,96,"suo"],[97,106,"fanciullo"],[107,110,"con"],[111,113,"il"],[114,118,"mano"],[119,125,"giungere"]]},{"it":"Quando io vedo te che preghi mi pare impossibile che non ci sia nessuno che ti guardi e ti ascolti.","ja":"","t":[[0,6,"quando"],[7,9,"io"],[10,14,"vedere"],[15,17,"te"],[18,21,"che"],[22,28,"pregare"],[29,31,"mi"],[32,36,"parere"],[37,48,"impossibile"],[49,52,"che"],[53,56,"non"],[57,59
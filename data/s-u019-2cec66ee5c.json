essi vanno a scuola; e ci sono poveri e signori, fra loro, come fra voi, e vengono da tutte le parti d’Italia.","ja":"","t":[[0,4,"essere"],[5,12,"ragazzo"],[13,17,"anche"],[18,22,"essi"],[24,29,"avere"],[30,35,"poco"],[36,40,"anno"],[41,44,"più"],[45,47,"di"],[48,51,"voi"],[53,54,"e"],[55,59,"anche"],[60,64,"essi"],[65,70,"andare"],[71,72,"a"],[73,79,"scuola"],[81,82,"e"],[83,85,"ci"],[86,90,"essere"],[91,97,"povero"],[98,99,"e"],[100,107,"signore"],[109,112,"fra"],[113,117,"loro"],[119,123,"come"],[124,127,"fra"],[128,131,"voi"],[133,134,"e"],[135,142,"venire"],[143,145,"da"],[146,151,"tutto"],[152,154,"il"],[155,160,"parte"],[161,162,"di"],[163,169,0]]},{"it":"Vedete, si posson quasi riconoscere al viso: passano dei Siciliani, dei Sardi, dei Napoletani, dei Lombardi.","ja":"","t":[[0,6,"vedere"],[8,10,"si"],[11,17,"potere"],[18,23,"quasi"],[24,35,"riconoscere"],[36,38,"a"],[39,43,"viso"],[45,52,"passare"],[53,56,"di"],[57,66,"siciliano"],[68,71,"di"],[72,77,"sardo"],[79,82,"di"],[83,93,"napoletano"],[95,98,"di"],[99,107,"lombardo"]]},{"it":"Questo qui è un reggimento vecchio, di quelli che hanno combattuto nel 1848.","ja":"","t":[[0,6,"questo"],[7,10,"qui"],[11,12,"essere"],[13,15,"un"],[16,26,"reggimento"],[27,34,"vecchio"],[36,38,"di"],[39,45,"quello"],[46,49,"che"],[50,55,"avere"],[56,66,"combattere"],[67,70,"in"]]},{"it":"I soldati non son più quelli, ma la bandiera è sempre la stessa.","ja":"","t":[[0,1,"il"],[2,9,"soldato"],[10,13,"non"],[14,17,"essere"],[18,21,"più"],[22,28,"quello"],[30,32,"ma"],[33,35,"il"],[36,44,"bandiera"],[45,46,"essere"],[47,53,"sempre"],[54,56,"il"],[57,63,"stesso"]]},{"it":"Quanti erano già morti per il nostro paese intorno a quella bandiera venti anni prima che voi nasceste!","ja":"","t":[[0,6,"quanto"],[7,12,"essere"],[13,16,"già"],[17,22,"morire"],[23,26,"per"],[27,29,"il"],[30,36,"nostro"],[37,42,"paese"],[43,50,"intorno"],[51,52,"a"],[53,59,"quello"],[60,68,"bandiera"],[69,74,"venti"],[75,79,"anno"],[80,85,"prima"],[86,89,"che"],[90,93,"voi"],[94,102,"nascere"]]},{"it":"— Eccola qui, — disse Garrone.","ja":"","t":[[2,8,0],[9,12,"qui"],[16,21,"dire"],[22,29,0]]},{"it":"E in fatti si vedeva poco lontano la bandiera, che veniva innanzi, al di sopra delle teste dei soldati.","ja":"","t":[[0,1,"e"],[2,4,"in"],[5,10,"fare"],[11,13,"si"],[14,20,"vedere"],[21,25,"poco"],[26,33,"lontano"],[34,36,"il"],[37,45,"bandiera"],[47,50,"che"],[51,57,"venire"],[58,65,"innanzi"],[67,69,"a"],[70,72,"Dio"],[73,78,"sopra"],[79,84,"di"],[85,90,"testa"],[91,94,"di"],[95,102,"soldato"]]},{"it":"— Fate una cosa, figliuoli, — disse il Direttore, — fate il vostro saluto di scolari, con la mano alla fronte, quando passano i tre colori.","ja":"","t":[[2,6,"fare"],[7,10,"un"],[11,15,"cosa"],[17,26,"figliuolo"],[30,35,"dire"],[36,38,"il"],[39,48,"direttore"],[52,56,"fare"],[57,59,"il"],[60,66,"vostro"],[67,73,"saluto"],[74,76,"di"],[77,84,"scolaro"],[86,89,"con"],[90,92,"il"],[93,97,"mano"],[98,102,"a"],[103,109,"fronte"],[111,117,"quando"],[118,125,"passare"],[126,127,"il"],[128,131,"tre"],[132,138,"colore"]]},{"it":"— La bandiera, portata da un ufficiale, ci passò davanti, tutta lacera e stinta, con le medaglie appese all’asta.","ja":"","t":[[2,4,"il"],[5,13,"bandiera"],[15,22,"portare"],[23,25,"da"],[26,28,"un"],[29,38,"ufficiale"],[40,42,"ci"],[43,48,"passare"],[49,56,"davanti"],[58,63,"tutto"],[64,70,"lacero"],[71,72,"e"],[73,79,0],[81,84,"con"],[85,87,"il"],[88,96,"medaglia"],[97,103,"appendere"],[104,107,"a"],[108,112,0]]},{"it":"Noi mettemmo la mano alla fronte, tutt’insieme.","ja":"","t":[[0,3,"noi"],[4,12,"mettere"],[13,15,"il"],[16,20,"mano"],[21,25,"a"],[26,32,"fronte"],[34,38,"tutto"],[39,46,"insieme"]]},{"it":"L’ufficiale ci guardò, sorridendo, e ci restituì il saluto con la mano.","ja":"","t":[[0,1,"il"],[2,11,"ufficiale"],[12,14,"ci"],[15,21,"guardare"],[23,33,"sorridere"],[35,36,"e"],[37,39,"ci"],[40,48,"restituire"],[49,51,"il"],[52,58,"saluto"],[59,62,"con"],[63,65,"il"],[66,70,"mano"]]},{"it":"— Bra
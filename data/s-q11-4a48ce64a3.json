{"id":"q11","title":"第11話 夜の台所","lv":1,"kind":"連載","note":"","lines":[{"it":"Stasera Kenta non va a casa.","ja":"今晩、ケンタは家に帰りません。","t":[[0,7,"stasera"],[8,13,0],[14,17,"non"],[18,20,"andare"],[21,22,"a"],[23,27,"casa"]]},{"it":"Si nasconde dietro l'armadio della cucina.","ja":"台所のたんすの後ろに隠れます。","t":[[0,2,"si"],[3,11,"nascondere"],[12,18,"dietro"],[19,20,"il"],[21,28,"armadio"],[29,34,"di"],[35,41,"cucina"]]},{"it":"La trattoria è chiusa e tutto è buio.","ja":"食堂は閉まり、すべて真っ暗です。","t":[[0,2,"il"],[3,12,"trattoria"],[13,14,"essere"],[15,21,"chiudere"],[22,23,"e"],[24,29,"tutto"],[30,31,"essere"],[32,36,"buio"]]},{"it":"Passa un'ora, poi due.","ja":"1時間、そして2時間が過ぎます。","t":[[0,5,"passare"],[6,8,"un"],[9,12,"ora"],[14,17,"poi"],[18,21,"due"]]},{"it":"Kenta ha sonno e ha freddo.","ja":"ケンタは眠くて、寒いです。","t":[[0,5,0],[6,8,"avere"],[9,14,"sonno"],[15,16,"e"],[17,19,"avere"],[20,26,"freddo"]]},{"it":"All'improvviso sente un rumore.","ja":"突然、物音が聞こえます。","t":[[0,3,"a"],[4,14,"improvviso"],[15,20,"sentire"],[21,23,"un"],[24,30,"rumore"]]},{"it":"La porta del cortile si apre piano.","ja":"中庭のドアがゆっくり開きます。","t":[[0,2,"il"],[3,8,"porta"],[9,12,"di"],[13,20,"g:cortile"],[21,23,"si"],[24,28,"aprire"],[29,34,"piano"]]},{"it":"Qualcuno entra con una piccola luce.","ja":"誰かが小さな明かりを持って入ってきます。","t":[[0,8,"qualcuno"],[9,14,"entrare"],[15,18,"con"],[19,22,"un"],[23,30,"piccolo"],[31,35,"luce"]]},{"it":"Non è Rita. Non è Bruni.","ja":"リータではありません。ブルーニでもありません。","t":[[0,3,"non"],[4,5,"essere"],[6,10,0],[12,15,"non"],[16,17,"essere"],[18,23,0]]},{"it":"Il cuore di Kenta batte forte.","ja":"ケンタの心臓が激しく打ちます。","t":[[0,2,"il"],[3,8,"cuore"],[9,11,"di"],[12,17,0],[18,23,"g:batte"],[24,29,"forte"]]},{"it":"La persona apre il cassetto e mette dentro qualcosa.","ja":"その人は引き出しを開け、中に何かを入れます。","t":[[0,2,"il"],[3,10,"persona"],[11,15,"aprire"],[16,18,"il"],[19,27,"g:cassetto"],[28,29,"e"],[30,35,"mettere"],[36,42,"dentro"],[43,51,"qualcosa"]]},{"it":"Poi si gira.","ja":"それから振り向きます。","t":[[0,3,"poi"],[4,6,"si"],[7,11,"girare"]]}],"q":[{"skill":"match","s":"ケンタが隠れた場所は？","o":["たんすの後ろ","ベッドの下","外の庭"],"why":"dietro l'armadio."},{"skill":"match","s":"入ってきた人が引き出しにしたことは？","o":["何かを入れた","何かを取り出した","壊した"],"why":"mette dentro qualcosa."},{"skill":"infer","s":"この回の終わり方の効果は？","o":["続きが気になる","話が完全に終わる","読者に質問に答えさせる"],"why":"振り向いたところで終わり、正体は次回です。"}],"g":{"cortile":"中庭","batte":"打つ","cassetto":"引き出し","si gira":"振り向く"},"n":74,"w":["a","andare","aprire","armadio","avere","buio","casa","chiudere","con","cucina","cuore","dentro","di","dietro","due","e","entrare","essere","forte","freddo","girare","il","improvviso","luce","mettere","nascondere","non","ora","passare","persona","piano","piccolo","poi","porta","qualcosa","qualcuno","rumore","sentire","si","sonno","stasera","trattoria","tutto","un"]}
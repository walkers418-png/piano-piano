{"id":"u015","title":"Novembre・La maestra di mio fratello","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LA MAESTRA DI MIO FRATELLO","ja":"","t":[[0,2,"il"],[3,10,"maestra"],[11,13,"di"],[14,17,"mio"],[18,26,"fratello"]]},{"it":"10, giovedì","ja":"","t":[[4,11,"giovedì"]]},{"it":"Il figliuolo del carbonaio fu scolaro della maestra Delcati, che è venuta oggi a trovar mio fratello malaticcio, e ci ha fatto ridere a raccontarci che la mamma di quel ragazzo, due anni fa, le portò a casa una grande grembialata di carbone, per ringraziarla che aveva dato la medaglia al figliuolo; e s’ostinava, povera donna, non voleva riportarsi il carbone a casa, e piangeva quasi, quando dovette tornarsene col grembiale pieno.","ja":"","t":[[0,2,"il"],[3,12,"figliuolo"],[13,16,"di"],[17,26,"carbonaio"],[27,29,"essere"],[30,37,"scolaro"],[38,43,"di"],[44,51,"maestra"],[52,59,0],[61,64,"che"],[65,66,"essere"],[67,73,"venire"],[74,78,"oggi"],[79,80,"a"],[81,87,"trovare"],[88,91,"mio"],[92,100,"fratello"],[101,111,0],[113,114,"e"],[115,117,"ci"],[118,120,"avere"],[121,126,"fare"],[127,133,"ridere"],[134,135,"a"],[136,147,"raccontare"],[148,151,"che"],[152,154,"il"],[155,160,"mamma"],[161,163,"di"],[164,168,"quello"],[169,176,"ragazzo"],[178,181,"due"],[182,186,"anno"],[187,189,"fa2"],[191,193,"il"],[194,199,"portare"],[200,201,"a"],[202,206,"casa"],[207,210,"un"],[211,217,"grande"],[218,229,0],[230,232,"di"],[233,240,"carbone"],[242,245,"per"],[246,258,"ringraziare"],[259,262,"che"],[263,268,"avere"],[269,273,"dare"],[274,276,"il"],[277,285,"medaglia"],[286,288,"a"],[289,298,"figliuolo"],[300,301,"e"],[302,303,"si"],[304,312,"ostinare"],[314,320,"povero"],[321,326,"donna"],[328,331,"non"],[332,338,"volere"],[339,349,"riportare"],[350,352,"il"],[353,360,"carbone"],[361,362,"a"],[363,367,"casa"],[369,370,"e"],[371,379,"piangere"],[380,385,"quasi"],[387,393,"quando"],[394,401,"dovere"],[402,412,0],[413,416,"con"],[417,426,0],[427,432,"pieno"]]},{"it":"Anche d’un’altra buona donna, ci ha detto, che le portò un mazzetto di fiori molto pesante, e c’era dentro un gruzzoletto di soldi.","ja":"","t":[[0,5,"anche"],[6,7,"di"],[8,10,"un"],[11,16,"altro"],[17,22,"buono"],[23,28,"donna"],[30,32,"ci"],[33,35,"avere"],[36,41,"dire"],[43,46,"che"],[47,49,"il"],[50,55,"portare"],[56,58,"un"],[59,67,"mazzetto"],[68,70,"di"],[71,76,"fiore"],[77,82,"molto"],[83,90,"pesante"],[92,93,"e"],[94,95,"ci"],[96,99,"essere"],[100,106,"dentro"],[107,109,"un"],[110,121,0],[122,124,"di"],[125,130,"soldi"]]},{"it":"Ci siamo molto divertiti a sentirla, e così mio fratello trangugiò la medicina, che prima non voleva.","ja":"","t":[[0,2,"ci"],[3,8,"essere"],[9,14,"molto"],[15,24,"divertire"],[25,26,"a"],[27,35,"sentire"],[37,38,"e"],[39,43,"così"],[44,47,"mio"],[48,56,"fratello"],[57,66,0],[67,69,"il"],[70,78,"medicina"],[80,83,"che"],[84,89,"prima"],[90,93,"non"],[94,100,"volere"]]},{"it":"Quanta pazienza debbono avere con quei ragazzi della prima inferiore, tutti sdentati come vecchietti, che non pronunziano l’erre e l’esse, e uno tosse, l’altro fila sangue dal naso, chi perde gli zoccoli sotto il banco, e chi bela perché s’è punto con la penna, e chi piange perché ha comprato un quaderno numero due invece di numero uno.","ja":"","t":[[0,6,"quanto"],[7,15,"pazienza"],[16,23,"dovere"],[24,29,"avere"],[30,33,"con"],[34,38,"quello"],[39,46,"ragazzo"],[47,52,"di"],[53,58,"prima"],[59,68,"inferiore"],[70,75,"tutto"],[76,84,0],[85,89,"come"],[90,100,"vecchietto"],[102,105,"che"],[106,109,"non"],[110,121,0],[122,123,"il"],[124,128,0],[129,130,"e"],[131,132,"il"],[133,137,0],[139,140,"e"],[141,144,"un"],[145,150,"tosse"],[152,153,"il"],[154,159,"altro"],[160,164,"fila"],[165,171,"sangue"],[172,175,"da"],[176,180,"naso"],[182,185,"chi"],[186,191,"perdere"],[192,195,"il"],[196,203,0],[204,209,"sotto"],[210,212,"il"],[213,218,"banco"],[220,221,"e"],[222,225,"chi"],[226,230,"belare"],[231,237,"perché"],[238,239,"si"],[240,241,"essere"],[242,247,"puntare"],[248,251,"con"],[252,254,"il"],[255,260,"penna"],[262,263,"e"],[264,267,"chi"],[268,274,"piangere"],[275,281,"perché"],[282,284,"avere"],[285,293,"comprare"],[294,296,"un"],[297,305,"quaderno"],[306,312,"numero"],[313,316,"due"],[317,323,"invece"],[324,326,"di"],[327,333,"numero"],[334,337,"un"]]},{"it":"Cinquanta in una classe, che non san nulla, con quei manini di burro, e dover insegnare a scrivere a tutti!","ja":"","t":[[0,9,"cinquanta"],[10,12,"in"],[13,16,"un"],[17,23,"classe"],[25,28,"che"],[29,32,"non"],[33,36,0],[37,42,"nulla"],[44,47,"con"],[48,52,"quello"],[53,59,0],[60,62,"di"],[63,68,"burro"],[70,71,"e"],[72,77,"dovere"],[78,87,"insegnare"],[88,89,"a"],[90,98,"scrivere"],[99,100,"a"],[101,106,"tutto"]]},{"it":"Essi portano in tasca dei pezzi di regolizia, dei bottoni, dei turaccioli di boccetta, del mattone tritato, ogni specie di cose minuscole, e bisogna che la maestra li frughi; ma nascondon gli oggetti fin nelle scarpe.","ja":"","t":[[0,4,"essi"],[5,12,"portare"],[13,15,"in"],[16,21,"tasca"],[22,25,"di"],[26,31,"pezzo"],[32,34,"di"],[35,44,0],[46,49,"di"],[50,57,"bottone"],[59,62,"di"],[63,73,0],[74,76,"di"],[77,85,0],[87,90,"di"],[91,98,"mattone"],[99,106,0],[108,112,"ogni"],[113,119,"specie"],[120,122,"di"],[123,127,"cosa"],[128,137,"minuscolo"],[139,140,"e"],[141,148,"bisognare"],[149,152,"che"],[153,155,"il"],[156,163,"maestra"],[164,166,"li"],[167,173,"frugare"],[175,177,"ma"],[178,187,"nascondere"],[188,191,"il"],[192,199,"oggetto"],[200,203,"fino"],[204,209,"in"],[210,216,"scarpa"]]},{"it":"E non stanno attenti: un moscone che entra per la finestra, mette tutti sottosopra, e l’estate portano in iscuola dell’erba e dei maggiolini, che volano in giro o cascano nei calamai e poi rigano i quaderni d’inchiostro.","ja":"","t":[[0,1,"e"],[2,5,"non"],[6,12,"stare"],[13,20,"attento"],[22,24,"un"],[25,32,0],[33,36,"che"],[37,42,"entrare"],[43,46,"per"],[47,49,"il"],[50,58,"finestra"],[60,65,"mettere"],[66,71,"tutto"],[72,82,0],[84,85,"e"],[86,87,"il"],[88,94,"estate"],[95,102,"portare"],[103,105,"in"],[106,113,0],[114,118,"di"],[119,123,"erba"],[124,125,"e"],[126,129,"di"],[130,140,0],[142,145,"che"],[146,152,"volare"],[153,155,"in"],[156,160,"girare"],[161,162,"o"],[163,170,"cascare"],[171,174,"in"],[175,182,"calamaio"],[183,184,"e"],[185,188,"poi"],[189,195,0],[196,197,"il"],[198,206,"quaderno"],[207,208,"di"],[209,219,"inchiostro"]]},{"it":"La maestra deve far la mamma con loro, aiutarli a vestirsi, fasciare le dita punte, raccattare i berretti che cascano, badare che non si scambino i cappotti, se no poi gnaulano e strillano.","ja":"","t":[[0,2,"il"],[3,10,"maestra"],[11,15,"dovere"],[16,19,"fare"],[20,22,"il"],[23,28,"mamma"],[29,32,"con"],[33,37,"loro"],[39,47,"aiutare"],[48,49,"a"],[50,58,"vestire"],[60,68,0],[69,71,"il"],[72,76,"dito"],[77,82,"punta"],[84,94,"raccattare"],[95,96,"il"],[97,105,"berretto"],[106,109,"che"],[110,117,"cascare"],[119,125,"badare"],[126,129,"che"],[130,133,"non"],[134,136,"si"],[137,145,"scambiare"],[146,147,"il"],[148,156,"cappotto"],[158,160,"se"],[161,163,"no"],[164,167,"poi"],[168,176,0],[177,178,"e"],[179,188,"strillare"]]},{"it":"Povere maestre!","ja":"","t":[[0,6,"povero"],[7,14,"maestra"]]},{"it":"E ancora vengono le mamme a lagnarsi: come va, signorina, che il mio bambino ha perso la penna? com’è che il mio non impara niente? perchè non dà la menzione al mio, che sa tanto? perchè non fa levar quel chiodo dal banco che ha stracciato i calzoni al mio Piero?","ja":"","t":[[0,1,"e"],[2,8,"ancora"],[9,16,"venire"],[17,19,"il"],[20,25,"mamma"],[26,27,"a"],[28,36,"lagnare"],[38,42,"come"],[43,45,"andare"],[47,56,"signorina"],[58,61,"che"],[62,64,"il"],[65,68,"mio"],[69,76,"bambino"],[77,79,"avere"],[80,85,"perdere"],[86,88,"il"],[89,94,"penna"],[96,99,"come"],[100,101,"essere"],[102,105,"che"],[106,108,"il"],[109,112,"mio"],[113,116,"non"],[117,123,"imparare"],[124,130,"niente"],[132,138,"perché"],[139,142,"non"],[143,145,"dare"],[146,148,"il"],[149,157,0],[158,160,"a"],[161,164,"mio"],[166,169,"che"],[170,172,"sapere"],[173,178,"tanto"],[180,186,"perché"],[187,190,"non"],[191,193,"fare"],[194,199,"levare"],[200,204,"quello"],[205,211,"chiodo"],[212,215,"da"],[216,221,"banco"],[222,225,"che"],[226,228,"avere"],[229,239,"stracciare"],[240,241,"il"],[242,249,"calzoni"],[250,252,"a"],[253,256,"mio"],[257,262,0]]},{"it":"Qualche volta s’arrabbia coi ragazzi la maestra di mio fratello, e quando non ne può più, si morde un dito, per non lasciar andare una pacca; perde la pazienza, ma poi si pente, e carezza il bimbo che ha sgridato; scaccia un monello di scuola, ma si ribeve le lacrime, e va in collera coi parenti che fan digiunare i bimbi per castigo.","ja":"","t":[[0,7,"qualche"],[8,13,"volta"],[14,15,"si"],[16,24,"arrabbiarsi"],[25,28,"con"],[29,36,"ragazzo"],[37,39,"il"],[40,47,"maestra"],[48,50,"di"],[51,54,"mio"],[55,63,"fratello"],[65,66,"e"],[67,73,"quando"],[74,77,"non"],[78,80,"ne"],[81,84,"potere"],[85,88,"più"],[90,92,"si"],[93,98,"mordere"],[99,101,"un"],[102,106,"dito"],[108,111,"per"],[112,115,"non"],[116,123,"lasciare"],[124,130,"andare"],[131,134,"un"],[135,140,0],[142,147,"perdere"],[148,150,"il"],[151,159,"pazienza"],[161,163,"ma"],[164,167,"poi"],[168,170,"si"],[171,176,0],[178,179,"e"],[180,187,"carezzare"],[188,190,"il"],[191,196,"bimbo"],[197,200,"che"],[201,203,"avere"],[204,212,"sgridare"],[214,221,0],[222,224,"un"],[225,232,"monello"],[233,235,"di"],[236,242,"scuola"],[244,246,"ma"],[247,249,"si"],[250,256,0],[257,259,"il"],[260,267,"lacrima"],[269,270,"e"],[271,273,"andare"],[274,276,"in"],[277,284,"collera"],[285,288,"con"],[289,296,"parente"],[297,300,"che"],[301,304,0],[305,314,"digiunare"],[315,316,"il"],[317,322,"bimbo"],[323,326,"per"],[327,334,"castigo"]]},{"it":"È giovane e grande la maestra Delcati, e vestita bene, bruna e irrequieta, che fa tutto a scatto di molla, e per un nulla si commove, e allora parla con grande tenerezza.","ja":"","t":[[0,1,"essere"],[2,9,"giovane"],[10,11,"e"],[12,18,"grande"],[19,21,"il"],[22,29,"maestra"],[30,37,0],[39,40,"e"],[41,48,"vestire"],[49,53,"bene"],[55,60,"bruno"],[61,62,"e"],[63,73,0],[75,78,"che"],[79,81,"fare"],[82,87,"tutto"],[88,89,"a"],[90,96,"scatto"],[97,99,"di"],[100,105,0],[107,108,"e"],[109,112,"per"],[113,115,"un"],[116,121,"nulla"],[122,124,"si"],[125,132,0],[134,135,"e"],[136,142,"allora"],[143,148,"parlare"],[149,152,"con"],[153,159,"grande"],[160,169,"tenerezza"]]},{"it":"— Ma almeno le si affezionano i bimbi, — le ha detto mia madre.","ja":"","t":[[2,4,"ma"],[5,11,"almeno"],[12,14,"il"],[15,17,"si"],[18,29,0],[30,31,"il"],[32,37,"bimbo"],[41,43,"il"],[44,46,"avere"],[47,52,"dire"],[53,56,"mio"],[57,62,"madre"]]},{"it":"— Molti sì, — ha risposto, — ma poi, finito l’anno, la maggior parte non ci guardan più.","ja":"","t":[[2,7,"molto"],[8,10,"sì"],[14,16,"avere"],[17,25,"rispondere"],[29,31,"ma"],[32,35,"poi"],[37,43,"finire"],[44,45,"il"],[46,50,"anno"],[52,54,"il"],[55,62,0],[63,68,"parte"],[69,72,"non"],[73,75,"ci"],[76,83,"guardare"],[84,87,"più"]]},{"it":"Quando sono coi maestri, si vergognano quasi d’essere stati da noi, da una maestra.","ja":"","t":[[0,6,"quando"],[7,11,"essere"],[12,15,"con"],[16,23,"maestro"],[25,27,"si"],[28,38,"vergognarsi"],[39,44,"quasi"],[45,46,"di"],[47,53,"essere"],[54,59,"essere"],[60,62,"da"],[63,66,"noi"],[68,70,"da"],[71,74,"un"],[75,82,"maestra"]]},{"it":"Dopo due anni di cure, dopo che s’è amato tanto un bambino, ci fa tristezza separarci da lui, ma si dice: — Oh di quello lì son sicura; quello lì mi vorrà bene.","ja":"","t":[[0,4,"dopo"],[5,8,"due"],[9,13,"anno"],[14,16,"di"],[17,21,"cura"],[23,27,"dopo"],[28,31,"che"],[32,33,"si"],[34,35,"essere"],[36,41,"amare"],[42,47,"tanto"],[48,50,"un"],[51,58,"bambino"],[60,62,"ci"],[63,65,"fare"],[66,75,"tristezza"],[76,85,"separare"],[86,88,"da"],[89,92,"lui"],[94,96,"ma"],[97,99,"si"],[100,104,"dire"],[108,110,"oh"],[111,113,"di"],[114,120,"quello"],[121,123,"lì"],[124,127,"essere"],[128,134,"sicuro"],[136,142,"quello"],[143,145,"lì"],[146,148,"mi"],[149,154,"volere"],[155,159,"bene"]]},{"it":"— Ma passano le vacanze, si rientra alla scuola, gli corriamo incontro: — O bambino, bambino mio!","ja":"","t":[[2,4,"ma"],[5,12,"passare"],[13,15,"il"],[16,23,"vacanza"],[25,27,"si"],[28,35,"rientrare"],[36,40,"a"],[41,47,"scuola"],[49,52,"il"],[53,61,"correre"],[62,70,"incontro"],[74,75,"o"],[76,83,"bambino"],[85,92,"bambino"],[93,96,"mio"]]},{"it":"— E lui volta il capo da un’altra parte.","ja":"","t":[[2,3,"e"],[4,7,"lui"],[8,13,"voltare"],[14,16,"il"],[17,21,"capo"],[22,24,"da"],[25,27,"un"],[28,33,"altro"],[34,39,"parte"]]},{"it":"— Qui la maestra s’è interrotta.","ja":"","t":[[2,5,"qui"],[6,8,"il"],[9,16,"maestra"],[17,18,"si"],[19,20,"essere"],[21,31,"interrompere"]]},{"it":"— Ma tu non farai così, piccino?","ja":"","t":[[2,4,"ma"],[5,7,"tu"],[8,11,"non"],[12,17,"fare"],[18,22,"così"],[24,31,"piccino"]]},{"it":"— ha detto poi, alzandosi con gli occhi umidi, e baciando mio fratello, — tu non la volterai la testa dall’altra parte, non è vero? non la rinnegherai la tua povera amica.","ja":"","t":[[2,4,"avere"],[5,10,"dire"],[11,14,"poi"],[16,25,"alzare"],[26,29,"con"],[30,33,"il"],[34,39,"occhio"],[40,45,"umido"],[47,48,"e"],[49,57,"baciare"],[58,61,"mio"],[62,70,"fratello"],[74,76,"tu"],[77,80,"non"],[81,83,"il"],[84,92,"voltare"],[93,95,"il"],[96,101,"testa"],[102,106,"da"],[107,112,"altro"],[113,118,"parte"],[120,123,"non"],[124,125,"essere"],[126,130,"vero"],[132,135,"non"],[136,138,"il"],[139,150,0],[151,153,"il"],[154,157,"tuo"],[158,164,"povero"],[165,170,"amica"]]}],"q":[],"g":{},"n":606,"w":["a","aiutare","allora","almeno","altro","alzare","amare","amica","anche","ancora","andare","anno","arrabbiarsi","attento","avere","baciare","badare","bambino","banco","belare","bene","berretto","bimbo","bisognare","bottone","bruno","buono","burro","calamaio","calzoni","capo","cappotto","carbonaio","carbone","carezzare","casa","cascare","castigo","che","chi","chiodo","ci","cinquanta","classe","c
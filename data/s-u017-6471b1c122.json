mangiare"],[145,148,"con"],[149,151,"un"],[152,158,"tavolo"],[159,161,"in"],[162,164,"un"],[165,170,"cantare"],[172,176,"dove"],[177,179,"ci"],[180,185,"avere"],[186,187,"il"],[188,193,"libro"],[194,195,"e"],[196,197,"il"],[198,206,"quaderno"],[208,209,"e"],[210,212,"il"],[213,219,"lavoro"],[220,232,"incominciare"]]},{"it":"— Giusto appunto, disse, — ho lasciato la seconda risposta per aria: col cuoio si fanno le calzature, le cinghie...","ja":"","t":[[2,8,"giusto"],[9,16,"appunto"],[18,23,"dire"],[27,29,"avere"],[30,38,"lasciare"],[39,41,"il"],[42,49,"secondo"],[50,58,"risposta"],[59,62,"per"],[63,67,"aria"],[69,72,"con"],[73,78,"cuoio"],[79,81,"si"],[82,87,"fare"],[88,90,"il"],[91,100,0],[102,104,"il"],[105,112,"cinghia"]]},{"it":"Ora ci aggiungo le valigie.","ja":"","t":[[0,3,"ora"],[4,6,"ci"],[7,15,"aggiungere"],[16,18,"il"],[19,26,"valigia"]]},{"it":"— E presa la penna, si mise a scrivere con la sua bella calligrafia.","ja":"","t":[[2,3,"e"],[4,9,"prendere"],[10,12,"il"],[13,18,"penna"],[20,22,"si"],[23,27,"mettere"],[28,29,"a"],[30,38,"scrivere"],[39,42,"con"],[43,45,"il"],[46,49,"suo"],[50,55,"bello"],[56,67,"calligrafia"]]},{"it":"— C’è nessuno?","ja":"","t":[[2,3,"ci"],[4,5,"essere"],[6,13,"nessuno"]]},{"it":"— s’udì gridare in quel momento dalla bottega.","ja":"","t":[[2,3,"si"],[4,7,0],[8,15,"gridare"],[16,18,"in"],[19,23,"quello"],[24,31,"momento"],[32,37,"da"],[38,45,"bottega"]]},{"it":"Era una donna che veniva a comprar fascinotti.","ja":"","t":[[0,3,"essere"],[4,7,"un"],[8,13,"donna"],[14,17,"che"],[18,24,"venire"],[25,26,"a"],[27,34,"comprare"],[35,45,0]]},{"it":"— Eccomi, — rispose Coretti; e saltò di là, pesò i fascinotti, prese i soldi, corse in un angolo a segnar la vendita in uno scartafaccio e ritornò al suo lavoro, dicendo: — Vediamo un po’ se mi riesce di finire il periodo.","ja":"","t":[[2,8,0],[12,19,"rispondere"],[20,27,0],[29,30,"e"],[31,36,"saltare"],[37,39,"di"],[40,42,"là"],[44,48,"pesare"],[49,50,"il"],[51,61,0],[63,68,"prendere"],[69
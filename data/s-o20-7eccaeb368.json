{"id":"o20","title":"オリーブオイルができるまで","lv":3,"kind":"説明文","note":"","lines":[{"it":"L'olio d'oliva è uno dei prodotti più importanti della cucina italiana.","ja":"オリーブオイルはイタリア料理で最も重要な産物の1つです。","t":[[0,1,"il"],[2,6,"olio"],[7,8,"di"],[9,14,"oliva"],[15,16,"essere"],[17,20,"un"],[21,24,"di"],[25,33,"prodotto"],[34,37,"più"],[38,48,"importante"],[49,54,"di"],[55,61,"cucina"],[62,70,"italiano"]]},{"it":"Le olive si raccolgono in autunno, tra ottobre e dicembre.","ja":"オリーブは秋、10月から12月に収穫します。","t":[[0,2,"il"],[3,8,"oliva"],[9,11,"si"],[12,22,"raccogliere"],[23,25,"in"],[26,33,"autunno"],[35,38,"tra"],[39,46,"ottobre"],[47,48,"e"],[49,57,"dicembre"]]},{"it":"Una volta si raccoglievano a mano; oggi si usano spesso macchine che scuotono gli alberi.","ja":"昔は手で摘みましたが、今は木を揺らす機械をよく使います。","t":[[0,3,"un"],[4,9,"volta"],[10,12,"si"],[13,26,"raccogliere"],[27,28,"a"],[29,33,"mano"],[35,39,"oggi"],[40,42,"si"],[43,48,"usare"],[49,55,"spesso"],[56,64,"macchina"],[65,68,"che"],[69,77,"g:scuotono"],[78,81,"il"],[82,88,"albero"]]},{"it":"Le olive devono arrivare al frantoio entro due o tre giorni, altrimenti l'olio diventa peggiore.","ja":"オリーブは2、3日以内に搾油所へ運ばなければ、油の質が落ちます。","t":[[0,2,"il"],[3,8,"oliva"],[9,15,"dovere"],[16,24,"arrivare"],[25,27,"a"],[28,36,"g:frantoio"],[37,42,"entro"],[43,46,"due"],[47,48,"o"],[49,52,"tre"],[53,59,"giorno"],[61,71,"altrimenti"],[72,73,"il"],[74,78,"olio"],[79,86,"diventare"],[87,95,"peggiore"]]},{"it":"Lì vengono lavate e schiacciate, con il nocciolo.","ja":"そこで洗って、種ごとつぶします。","t":[[0,2,"lì"],[3,10,"venire"],[11,17,"lavare"],[18,19,"e"],[20,31,"g:schiacciate"],[33,36,"con"],[37,39,"il"],[40,48,"g:nocciolo"]]},{"it":"Dalla pasta che si forma, si separa l'olio dall'acqua.","ja":"できたペーストから、油を水と分けます。","t":[[0,5,"da"],[6,11,"pasta"],[12,15,"che"],[16,18,"si"],[19,24,"formare"],[26,28,"si"],[29,35,"g:separa"],[36,37,"il"],[38,42,"olio"],[43,47,"da"],[48,53,"acqua"]]},{"it":"Ci vogliono da cinque a dieci chili di olive per fare un litro d'olio.","ja":"油1リットルに、オリーブ5〜10キロが必要です。","t":[[0,2,"ci"],[3,11,"volere"],[12,14,"da"],[15,21,"cinque"],[22,23,"a"],[24,29,"dieci"],[30,35,"chilo"],[36,38,"di"],[39,44,"oliva"],[45,48,"per"],[49,53,"fare"],[54,56,"un"],[57,62,"litro"],[63,64,"di"],[65,69,"olio"]]},{"it":"L'olio migliore si chiama «extravergine».","ja":"最も良い油は「エクストラバージン」と呼ばれます。","t":[[0,1,"il"],[2,6,"olio"],[7,15,"migliore"],[16,18,"si"],[19,25,"chiamare"],[27,39,"g:extravergine"]]},{"it":"La regione che ne produce di più è la Puglia.","ja":"最も多く生産する州はプーリアです。","t":[[0,2,"il"],[3,10,"regione"],[11,14,"che"],[15,17,"ne"],[18,25,"produrre"],[26,28,"di"],[29,32,"più"],[33,34,"essere"],[35,37,"il"],[38,44,0]]}],"q":[{"skill":"order","s":"順序が正しいのは？","o":["収穫→搾油所→つぶす→油を分ける","つぶす→収穫→油を分ける→搾油所","油を分ける→つぶす→収穫→搾油所"],"why":"工程の順です。"},{"skill":"info","s":"油2リットルに必要なオリーブは？","o":["10〜20キロ","5〜10キロ","2キロ"],"why":"1リットルに5〜10キロです。"},{"skill":"match","s":"急いで運ぶ理由は？","o":["遅れると油の質が落ちるから","機械が壊れるから","寒くなるから"],"why":"altrimenti l'olio diventa peggiore."}],"g":{"frantoio":"搾油所","schiacciate":"つぶされる","nocciolo":"種","separa":"分ける","extravergine":"エクストラバージン","scuotono":"揺らす"},"n":104,"w":["a","acqua","albero","altrimenti","arrivare","autunno","che","chiamare","chilo","ci","cinque","con","cucina","da","di","dicembre","dieci","diventare","dovere","due","e","entro","essere","fare","formare","giorno","il","importante","in","italiano","lavare","litro","lì","macchina","mano","migliore","ne","o","oggi","olio","oliva","ottobre","pasta","peggiore","per","più","prodotto","produrre","raccogliere","regione","si","spesso","tra","tre","un","usare","venire","volere","volta"]}
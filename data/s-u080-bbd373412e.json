{"id":"u080","title":"Maggio・I bambini rachitici","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"I BAMBINI RACHITICI","ja":"","t":[[0,1,"il"],[2,9,"bambino"],[10,19,0]]},{"it":"Venerdì, 5","ja":"","t":[[0,7,"venerdì"]]},{"it":"Oggi ho fatto vacanza perché non stavo bene, e mia madre m’ha condotto con sé all’istituto dei ragazzi rachitici, dov’è andata a raccomandare una bimba del portinaio; ma non mi ha lasciato entrar nella scuola...","ja":"","t":[[0,4,"oggi"],[5,7,"avere"],[8,13,"fare"],[14,21,"vacanza"],[22,28,"perché"],[29,32,"non"],[33,38,"stare"],[39,43,"bene"],[45,46,"e"],[47,50,"mio"],[51,56,"madre"],[57,58,"mi"],[59,61,"avere"],[62,70,"condurre"],[71,74,"con"],[75,77,"sé"],[78,81,"a"],[82,90,"istituto"],[91,94,"di"],[95,102,"ragazzo"],[103,112,0],[114,117,"dove"],[118,119,"essere"],[120,126,"andare"],[127,128,"a"],[129,141,"raccomandare"],[142,145,"un"],[146,151,"bimba"],[152,155,"di"],[156,165,"portinaio"],[167,169,"ma"],[170,173,"non"],[174,176,"mi"],[177,179,"avere"],[180,188,"lasciare"],[189,195,"entrare"],[196,201,"in"],[202,208,"scuola"]]},{"it":"Non hai capito perché, Enrico, non ti lasciai entrare?","ja":"","t":[[0,3,"non"],[4,7,"avere"],[8,14,"capire"],[15,21,"perché"],[23,29,0],[31,34,"non"],[35,37,"ti"],[38,45,"lasciare"],[46,53,"entrare"]]},{"it":"Per non mettere davanti a quei disgraziati, lì nel mezzo della scuola, quasi come in mostra, un ragazzo sano e robusto: troppe occasioni hanno già di trovarsi a dei paragoni dolorosi.","ja":"","t":[[0,3,"per"],[4,7,"non"],[8,15,"mettere"],[16,23,"davanti"],[24,25,"a"],[26,30,"quello"],[31,42,"disgraziato"],[44,46,"lì"],[47,50,"in"],[51,56,"mezzo"],[57,62,"di"],[63,69,"scuola"],[71,76,"quasi"],[77,81,"come"],[82,84,"in"],[85,91,"mostra"],[93,95,"un"],[96,103,"ragazzo"],[104,108,"sano"],[109,110,"e"],[111,118,"robusto"],[120,126,"troppo"],[127,136,"occasione"],[137,142,"avere"],[143,146,"già"],[147,149,"di"],[150,158,"trovare"],[159,160,"a"],[161,164,"di"],[165,173,"paragone"],[174,182,"doloroso"]]},{"it":"Che triste cosa!","ja":"","t":[[0,3,"che"],[4,10,"triste"],[11,15,"cosa"]]},{"it":"Mi venne su il pianto dal cuore a entrar là dentro.","ja":"","t":[[0,2,"mi"],[3,8,"venire"],[9,11,"su"],[12,14,"il"],[15,21,"pianto"],[22,25,"da"],[26,31,"cuore"],[32,33,"a"],[34,40,"entrare"],[41,43,"là"],[44,50,"dentro"]]},{"it":"Erano una sessantina, tra bambini e bambine...","ja":"","t":[[0,5,"essere"],[6,9,"un"],[10,20,0],[22,25,"tra"],[26,33,"bambino"],[34,35,"e"],[36,43,"bambina"]]},{"it":"Povere ossa torturate!","ja":"","t":[[0,6,"povero"],[7,11,"osso"],[12,21,0]]},{"it":"Povere mani, poveri piedini rattrappiti e scontorti!","ja":"","t":[[0,6,"povero"],[7,11,"mano"],[13,19,"povero"],[20,27,"piedino"],[28,39,0],[40,41,"e"],[42,51,0]]},{"it":"Poveri corpicini contraffatti!","ja":"","t":[[0,6,"povero"],[7,16,0],[17,29,0]]},{"it":"Subito osservai molti visi graziosi; degli occhi pieni d’intelligenza e di affetto: c’era un visetto di bimba, col naso affilato e il mento aguzzo, che pareva una vecchietta; ma aveva un sorriso d’una soavità celeste.","ja":"","t":[[0,6,"subito"],[7,15,"osservare"],[16,21,"molto"],[22,26,"viso"],[27,35,"grazioso"],[37,42,"di"],[43,48,"occhio"],[49,54,"pieno"],[55,56,"di"],[57,69,"intelligenza"],[70,71,"e"],[72,74,"dire"],[75,82,"affetto"],[84,85,"ci"],[86,89,"essere"],[90,92,"un"],[93,100,0],[101,103,"di"],[104,109,"bimba"],[111,114,"con"],[115,119,"naso"],[120,128,"affilare"],[129,130,"e"],[131,133,"il"],[134,139,"mento"],[140,146,0],[148,151,"che"],[152,158,"parere"],[159,162,"un"],[163,173,"vecchietta"],[175,177,"ma"],[178,183,"avere"],[184,186,"un"],[187,194,"sorriso"],[195,196,"di"],[197,200,"un"],[201,208,0],[209,216,0]]},{"it":"Alcuni, visti davanti, son belli, e paion senza difetti; ma si voltano... e vi danno una stretta all’anima.","ja":"","t":[[0,6,"alcuno"],[8,13,"vedere"],[14,21,"davanti"],[23,26,"essere"],[27,32,"bello"],[34,35,"e"],[36,41,"parere"],[42,47,"senza"],[48,55,"difetto"],[57,59,"ma"],[60,62,"si"],[63,70,"voltare"],[74,75,"e"],[76,78,"vi"],[79,84,"dare"],[85,88,"un"],[89,96,"stretto"],[97,100,"a"],[101,106,"anima"]]},{"it":"C’era il medico, che li visitava.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,8,"il"],[9,15,"medico"],[17,20,"che"],[21,23,"li"],[24,32,"visitare"]]},{"it":"Li metteva ritti sui banchi, e alzava i vestitini per toccare i ventri enfiati e le giunture grosse, ma non si vergognavano punto, povere creature; si vedeva ch’eran bambini assuefatti a essere svestiti, esaminati, rivoltati per tutti i versi.","ja":"","t":[[0,2,"li"],[3,10,"mettere"],[11,16,"ritto"],[17,20,"su"],[21,27,"banco"],[29,30,"e"],[31,37,"alzare"],[38,39,"il"],[40,49,"vestitino"],[50,53,"per"],[54,61,"toccare"],[62,63,"il"],[64,70,0],[71,78,0],[79,80,"e"],[81,83,"il"],[84,92,0],[93,99,"grosso"],[101,103,"ma"],[104,107,"non"],[108,110,"si"],[111,123,"vergognarsi"],[124,129,"punto"],[131,137,"povero"],[138,146,"creatura"],[148,150,"si"],[151,157,"vedere"],[158,160,"che"],[161,165,"essere"],[166,173,"bambino"],[174,184,0],[185,186,"a"],[187,193,"essere"],[194,202,0],[204,213,"esaminare"],[215,224,"rivoltare"],[225,228,"per"],[229,234,"tutto"],[235,236,"il"],[237,242,"versare"]]},{"it":"E pensare che ora son nel periodo migliore della loro malattia, chè quasi non soffron più.","ja":"","t":[[0,1,"e"],[2,9,"pensare"],[10,13,"che"],[14,17,"ora"],[18,21,"essere"],[22,25,"in"],[26,33,"periodo"],[34,42,"migliore"],[43,48,"di"],[49,53,"loro"],[54,62,"malattia"],[64,67,"che"],[68,73,"quasi"],[74,77,"non"],[78,85,"soffrire"],[86,89,"più"]]},{"it":"Ma chi può dire quello che soffrirono durante il primo deformarsi del corpo, quando col crescere della loro infermità, vedevano diminuire l’affetto intorno a sè, poveri bambini, lasciati soli per ore ed ore nell’angolo d’una stanza o d’un cortile, mal nutriti, e a volte anche scherniti, o tormentati per mesi da bendaggi e da apparecchi ortopedici inutili!","ja":"","t":[[0,2,"ma"],[3,6,"chi"],[7,10,"potere"],[11,15,"dire"],[16,22,"quello"],[23,26,"che"],[27,37,"soffrire"],[38,45,"durante"],[46,48,"il"],[49,54,"primo"],[55,65,0],[66,69,"di"],[70,75,"corpo"],[77,83,"quando"],[84,87,"con"],[88,96,"crescere"],[97,102,"di"],[103,107,"loro"],[108,117,"infermità"],[119,127,"vedere"],[128,137,"diminuire"],[138,139,"il"],[140,147,"affetto"],[148,155,"intorno"],[156,157,"a"],[158,160,"sé"],[162,168,"povero"],[169,176,"bambino"],[178,186,"lasciare"],[187,191,"solo"],[192,195,"per"],[196,199,"ora"],[200,202,"e"],[203,206,"ora"],[207,211,"in"],[212,218,"angolo"],[219,220,"di"],[221,224,"un"],[225,231,"stanza"],[232,233,"o"],[234,235,"di"],[236,238,"un"],[239,246,"cortile"],[248,251,"male"],[252,259,"nutrire"],[261,262,"e"],[263,264,"a"],[265,270,"volta"],[271,276,"anche"],[277,286,0],[288,289,"o"],[290,300,"tormentare"],[301,304,"per"],[305,309,"mese"],[310,312,"da"],[313,321,0],[322,323,"e"],[324,326,"da"],[327,337,"apparecchiare"],[338,348,0],[349,356,"inutile"]]},{"it":"Ora però, grazie alle cure, alla buona alimentazione e alla ginnastica, molti migliorano.","ja":"","t":[[0,3,"ora"],[4,8,"però"],[10,16,"grazie"],[17,21,"a"],[22,26,"cura"],[28,32,"a"],[33,38,"buono"],[39,52,"alimentazione"],[53,54,"e"],[55,59,"a"],[60,70,"ginnastica"],[72,77,"molto"],[78,88,"migliorare"]]},{"it":"La maestra fece fare la ginnastica.","ja":"","t":[[0,2,"il"],[3,10,"maestra"],[11,15,"fare"],[16,20,"fare"],[21,23,"il"],[24,34,"ginnastica"]]},{"it":"Era una pietà, a certi comandi, vederli distender sotto i banchi tutte quelle gambe fasciate, strette fra le stecche, nocchierute, sformate, delle gambe che si sarebbero coperte di baci!","ja":"","t":[[0,3,"essere"],[4,7,"un"],[8,13,"pietà"],[15,16,"a"],[17,22,"certo"],[23,30,"comando"],[32,39,"vedere"],[40,49,0],[50,55,"sotto"],[56,57,"il"],[58,64,"banco"],[65,70,"tutto"],[71,77,"quello"],[78,83,"gamba"],[84,92,0],[94,101,"stretto"],[102,105,"fra"],[106,108,"il"],[109,116,0],[118,129,0],[131,139,0],[141,146,"di"],[147,152,"gamba"],[153,156,"che"],[157,159,"si"],[160,169,"essere"],[170,177,"coprire"],[178,180,"di"],[181,185,"bacio"]]},{"it":"Parecchi non potevano alzarsi dal banco, e rimanevan lì, col capo ripiegato sul braccio, accarezzando le stampelle con la mano; altri, facendo la spinta delle braccia, si sentivan mancare il respiro, e ricascavano a sedere, pallidi, ma sorridevano, per dissimulare l’affanno.","ja":"","t":[[0,8,"parecchio"],[9,12,"non"],[13,21,"potere"],[22,29,"alzare"],[30,33,"da"],[34,39,"banco"],[41,42,"e"],[43,52,"rimanere"],[53,55,"lì"],[57,60,"con"],[61,65,"capo"],[66,75,0],[76,79,"su"],[80,87,"braccio"],[89,101,"accarezzare"],[102,104,"il"],[105,114,"stampella"],[115,118,"con"],[119,121,"il"],[122,126,"mano"],[128,133,"altro"],[135,142,"fare"],[143,145,"il"],[146,152,"spingere"],[153,158,"di"],[159,166,"braccio"],[168,170,"si"],[171,179,"sentire"],[180,187,"mancare"],[188,190,"il"],[191,198,"respirare"],[200,201,"e"],[202,213,0],[214,215,"a"],[216,222,"sedere"],[224,231,"pallido"],[233,235,"ma"],[236,247,"sorridere"],[249,252,"per"],[253,264,0],[265,266,"il"],[267,274,"affanno"]]},{"it":"Ah!","ja":"","t":[[0,2,"ah"]]},{"it":"Enrico, voi altri che non pregiate la salute, e vi sembra così poca cosa lo star bene!","ja":"","t":[[0,6,0],[8,11,"voi"],[12,17,"altro"],[18,21,"che"],[22,25,"non"],[26,34,0],[35,37,"il"],[38,44,"salute"],[46,47,"e"],[48,50,"vi"],[51,57,"sembrare"],[58,62,"così"],[63,67,"poco"],[68,72,"cosa"],[73,75,"il"],[76,80,"stare"],[81,85,"bene"]]},{"it":"Io pensavo ai bei ragazzi forti e fiorenti, che le madri portano in giro come in trionfo, superbe della loro bellezza, e mi sarei prese tutte quelle povere teste, me le sarei strette tutte sul cuore, disperatamente, avrei detto, se fossi stata sola: non mi movo più di qui, voglio consacrare la vita a voi, servirvi, farvi da madre a tutti fino al mio ultimo giorno...","ja":"","t":[[0,2,"io"],[3,10,"pensare"],[11,13,"a"],[14,17,"bello"],[18,25,"ragazzo"],[26,31,"forte"],[32,33,"e"],[34,42,0],[44,47,"che"],[48,50,"il"],[51,56,"madre"],[57,64,"portare"],[65,67,"in"],[68,72,"girare"],[73,77,"come"],[78,80,"in"],[81,88,"trionfo"],[90,97,"superbo"],[98,103,"di"],[104,108,"loro"],[109,117,"bellezza"],[119,120,"e"],[121,123,"mi"],[124,129,"essere"],[130,135,"prendere"],[136,141,"tutto"],[142,148,"quello"],[149,155,"povero"],[156,161,"testa"],[163,165,"me"],[166,168,"il"],[169,174,"essere"],[175,182,"stretto"],[183,188,"tutto"],[189,192,"su"],[193,198,"cuore"],[200,214,"disperatamente"],[216,221,"avere"],[222,227,"dire"],[229,231,"se"],[232,237,"essere"],[238,243,"essere"],[244,248,"solo"],[250,253,"non"],[254,256,"mi"],[257,261,0],[262,265,"più"],[266,268,"di"],[269,272,"qui"],[274,280,"volere"],[281,291,0],[292,294,"il"],[295,299,"vita"],[300,301,"a"],[302,305,"voi"],[307,315,"servire"],[317,322,"fare"],[323,325,"da"],[326,331,"madre"],[332,333,"a"],[334,339,"tutto"],[340,344,"fino"],[345,347,"a"],[348,351,"mio"],[352,358,"ultimo"],[359,365,"giorno"]]},{"it":"E intanto cantavano, cantavano con certe vocine esili, dolci, tristi, che andavano all’anima, e la maestra avendoli lodati, si mostraron contenti; e mentre passava tra i banchi, le baciavano le mani e le braccia, perchè senton tanta gratitudine per chi li benefica, e sono molto affettuosi.","ja":"","t":[[0,1,"e"],[2,9,"intanto"],[10,19,"cantare"],[21,30,"cantare"],[31,34,"con"],[35,40,"certo"],[41,47,"vocina"],[48,53,0],[55,60,"dolce"],[62,68,"triste"],[70,73,"che"],[74,82,"andare"],[83,86,"a"],[87,92,"anima"],[94,95,"e"],[96,98,"il"],[99,106,"maestra"],[107,115,"avere"],[116,122,"lodare"],[124,126,"si"],[127,136,"mostrare"],[137,145,"contento"],[147,148,"e"],[149,155,"mentre"],[156,163,"passare"],[164,167,"tra"],[168,169,"il"],[170,176,"banco"],[178,180,"il"],[181,190,"baciare"],[191,193,"il"],[194,198,"mano"],[199,200,"e"],[201,203,"il"],[204,211,"braccio"],[213,219,"perché"],[220,226,"sentire"],[227,232,"tanto"],[233,244,"gratitudine"],[245,248,"per"],[249,252,"chi"],[253,255,"li"],[256,264,0],[266,267,"e"],[268,272,"essere"],[273,278,"molto"],[279,289,"affettuoso"]]},{"it":"E anche hanno ingegno, quegli angioletti; e studiano, mi disse la maestra.","ja":"","t":[[0,1,"e"],[2,7,"anche"],[8,13,"avere"],[14,21,"ingegno"],[23,29,"quello"],[30,40,0],[42,43,"e"],[44,52,"studiare"],[54,56,"mi"],[57,62,"dire"],[63,65,"il"],[66,73,"maestra"]]},{"it":"Una maestra giovane e gentile, che ha sul viso pieno di bontà una certa espressione di mestizia, come un riflesso delle sventure che essa accarezza e consola.","ja":"","t":[[0,3,"un"],[4,11,"maestra"],[12,19,"giovane"],[20,21,"e"],[22,29,"gentile"],[31,34,"che"],[35,37,"avere"],[38,41,"su"],[42,46,"viso"],[47,52,"pieno"],[53,55,"di"],[56,61,"bontà"],[62,65,"un"],[66,71,"certo"],[72,83,"espressione"],[84,86,"di"],[87,95,0],[97,101,"come"],[102,104,"un"],[105,113,0],[114,119,"di"],[120,128,"sventura"],[129,132,"che"],[133,137,"essa"],[138,147,"accarezzare"],[148,149,"e"],[150,157,"consolare"]]},{"it":"Cara ragazza!","ja":"","t":[[0,4,"caro"],[5,12,"ragazza"]]},{"it":"Fra tutte le creature umane che si guadagnan la vita col lavoro, non ce n’è una che se la guadagni più santamente di te, figliuola mia.","ja":"","t":[[0,3,"fra"],[4,9,"tutto"],[10,12,"il"],[13,21,"creatura"],[22,27,"umano"],[28,31,"che"],[32,34,"si"],[35,44,"guadagnare"],[45,47,"il"],[48,52,"vita"],[53,56,"con"],[57,63,"lavoro"],[65,68,"non"],[69,71,"ce"],[72,73,0],[74,75,"essere"],[76,79,"un"],[80,83,"che"],[84,86,"se"],[87,89,"il"],[90,98,"guadagnare"],[99,102,"più"],[103,113,0],[114,116,"di"],[117,119,"te"],[121,130,"figliuola"],[131,134,"mio"]]},{"it":"Tua Madre.","ja":"","t":[[0,3,"tuo"],[4,9,"madre"]]}],"q":[],"g":{},"n":588,"w":["a","accarezzare","affanno","affetto","affettuoso","affilare","ah","alcuno","alimentazione","altro","alzare","anche","andare","angolo","anima","apparecchiare","avere","baciare","bacio","bambina","bambino","banco","bellezza","bello","bene","bimba","bontà","braccio","buono","cantare","capire","capo","caro","ce","certo","che","chi","ci","comando","come","con","condurre","consolare","conten
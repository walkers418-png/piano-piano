{"id":"q03","title":"第3話 レシピのノート","lv":1,"kind":"連載","note":"","lines":[{"it":"Il giorno dopo non piove più.","ja":"次の日、もう雨は降っていません。","t":[[0,2,"il"],[3,9,"giorno"],[10,14,"dopo"],[15,18,"non"],[19,24,"piovere"],[25,28,"più"]]},{"it":"Kenta torna alla trattoria per dire grazie.","ja":"ケンタはお礼を言うために食堂へ戻ります。","t":[[0,5,0],[6,11,"tornare"],[12,16,"a"],[17,26,"trattoria"],[27,30,"per"],[31,35,"dire"],[36,42,"grazie"]]},{"it":"Nonna Rita è in cucina.","ja":"ノンナ・リータは台所にいます。","t":[[0,5,0],[6,10,0],[11,12,"essere"],[13,15,"in"],[16,22,"cucina"]]},{"it":"Sul tavolo c'è un vecchio quaderno nero.","ja":"テーブルの上に古い黒いノートがあります。","t":[[0,3,"su"],[4,10,"tavolo"],[11,12,"ci"],[13,14,"essere"],[15,17,"un"],[18,25,"vecchio"],[26,34,"quaderno"],[35,39,"nero"]]},{"it":"«Che cos'è?» chiede Kenta.","ja":"「それは何ですか？」とケンタが尋ねます。","t":[[1,4,"che"],[5,8,"cosa"],[9,10,"essere"],[13,19,"chiedere"],[20,25,0]]},{"it":"«È il mio tesoro» dice Rita.","ja":"「私の宝物だよ」とリータが言います。","t":[[1,2,"essere"],[3,5,"il"],[6,9,"mio"],[10,16,"tesoro"],[18,22,"dire"],[23,27,0]]},{"it":"«Qui ci sono tutte le ricette della mia famiglia.»","ja":"「ここに家族のレシピが全部あるの」","t":[[1,4,"qui"],[5,7,"ci"],[8,12,"essere"],[13,18,"tutto"],[19,21,"il"],[22,29,"ricetta"],[30,35,"di"],[36,39,"mio"],[40,48,"famiglia"]]},{"it":"«Anche i tortellini?»","ja":"「トルテッリーニもですか？」","t":[[1,6,"anche"],[7,8,"il"],[9,19,"tortellino"]]},{"it":"«Sì, e il ragù di mio marito Aldo.»","ja":"「ええ、それに夫のアルドのラグーも」","t":[[1,3,"sì"],[5,6,"e"],[7,9,"il"],[10,14,"g:ragù"],[15,17,"di"],[18,21,"mio"],[22,28,"marito"],[29,33,0]]},{"it":"Rita chiude il quaderno e lo mette in un cassetto.","ja":"リータはノートを閉じ、引き出しにしまいます。","t":[[0,4,0],[5,11,"chiudere"],[12,14,"il"],[15,23,"quaderno"],[24,25,"e"],[26,28,"il"],[29,34,"mettere"],[35,37,"in"],[38,40,"un"],[41,49,"g:cassetto"]]},{"it":"«Nessuno conosce questi segreti, solo io.»","ja":"「この秘密は誰も知らない、私だけだよ」","t":[[1,8,"nessuno"],[9,16,"conoscere"],[17,23,"questo"],[24,31,"g:segreti"],[33,37,"solo"],[38,40,"io"]]}],"q":[{"skill":"match","
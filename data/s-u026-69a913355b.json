{"id":"u026","title":"Dicembre・La prima nevicata","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LA PRIMA NEVICATA.","ja":"","t":[[0,2,"il"],[3,8,"prima"],[9,17,"nevicare"]]},{"it":"10, sabato.","ja":"","t":[[4,10,"sabato"]]},{"it":"Addio passeggiate a Rivoli.","ja":"","t":[[0,5,"addio"],[6,17,"passeggiata"],[18,19,"a"],[20,26,0]]},{"it":"Ecco la bella amica dei ragazzi!","ja":"","t":[[0,4,"ecco"],[5,7,"il"],[8,13,"bello"],[14,19,"amica"],[20,23,"di"],[24,31,"ragazzo"]]},{"it":"Ecco la prima neve!","ja":"","t":[[0,4,"ecco"],[5,7,"il"],[8,13,"prima"],[14,18,"neve"]]},{"it":"Fin da ieri sera vien giù a fiocchi fitti e larghi come fiori di gelsomino.","ja":"","t":[[0,3,"fino"],[4,6,"da"],[7,11,"ieri"],[12,16,"sera"],[17,21,"venire"],[22,25,"giù"],[26,27,"a"],[28,35,0],[36,41,"fitto"],[42,43,"e"],[44,50,"largo"],[51,55,"come"],[56,61,"fiore"],[62,64,"di"],[65,74,0]]},{"it":"Era un piacere questa mattina alla scuola vederla venire contro le vetrate e ammontarsi sui davanzali; anche il maestro guardava e si fregava le mani, e tutti eran contenti pensando a fare alle palle, e al ghiaccio che verrà dopo, e al focolino di casa.","ja":"","t":[[0,3,"essere"],[4,6,"un"],[7,14,"piacere"],[15,21,"questo"],[22,29,"mattina"],[30,34,"a"],[35,41,"scuola"],[42,49,"vedere"],[50,56,"venire"],[57,63,"contro"],[64,66,"il"],[67,74,0],[75,76,"e"],[77,87,0],[88,91,"su"],[92,101,0],[103,108,"anche"],[109,111,"il"],[112,119,"maestro"],[120,128,"guardare"],[129,130,"e"],[131,133,"si"],[134,141,0],[142,144,"il"],[145,149,"mano"],[151,152,"e"],[153,158,"tutto"],[159,163,"essere"],[164,172,"contento"],[173,181,"pensare"],[182,183,"a"],[184,188,"fare"],[189,193,"a"],[194,199,"palla"],[201,202,"e"],[203,205,"a"],[206,214,"ghiaccio"],[215,218,"che"],[219,224,"venire"],[225,229,"dopo"],[231,232,"e"],[233,235,"a"],[236,244,0],[245,247,"di"],[248,252,"casa"]]},{"it":"Non c’era che Stardi che non ci badasse, tutto assorto nella lezione, coi pugni stretti alle tempie.","ja":"","t":[[0,3,"non"],[4,5,"ci"],[6,9,"essere"],[10,13,"che"],[14,20,0],[21,24,"che"],[25,28,"non"],[29,31,"ci"],[32,39,"badare"],[41,46,"tutto"],[47,54,0],[55,60,"in"],[61,68,"lezione"],[70,73,"con"],[74,79,0],[80,87,"stretto"],[88,92,"a"],[93,99,0]]},{"it":"Che bellezza, che festa fu all’uscita! tutti a scavallar per la strada, gridando e sbracciando, e a pigliar manate di neve e a zampettarci dentro come cagnolini nell’acqua.","ja":"","t":[[0,3,"che"],[4,12,"bellezza"],[14,17,"che"],[18,23,"festa"],[24,26,"essere"],[27,30,"a"],[31,37,"uscita"],[39,44,"tutto"],[45,46,"a"],[47,56,0],[57,60,"per"],[61,63,"il"],[64,70,"strada"],[72,80,"gridare"],[81,82,"e"],[83,94,0],[96,97,"e"],[98,99,"a"],[100,107,0],[108,114,0],[115,117,"di"],[118,122,"neve"],[123,124,"e"],[125,126,"a"],[127,138,0],[139,145,"dentro"],[146,150,"come"],[151,160,"cagnolino"],[161,165,"in"],[166,171,"acqua"]]},{"it":"I parenti che aspettavan fuori avevano gli ombrelli bianchi, la guardia civica aveva l’elmetto bianco, tutti i nostri zaini in pochi momenti furon bianchi.","ja":"","t":[[0,1,"il"],[2,9,"parente"],[10,13,"che"],[14,24,0],[25,30,"fuori"],[31,38,"avere"],[39,42,"il"],[43,51,"ombrello"],[52,59,"bianco"],[61,63,"il"],[64,71,"guardia"],[72,78,0],[79,84,"avere"],[85,86,"il"],[87,94,0],[95,101,"bianco"],[103,108,"tutto"],[109,110,"il"],[111,117,"nostro"],[118,123,"zaino"],[124,126,"in"],[127,132,"poco"],[133,140,"momento"],[141,146,0],[147,154,"bianco"]]},{"it":"Tutti parevan fuor di sé dall’allegrezza, perfino Precossi, il figliuolo del fabbro, quello pallidino che non ride mai, e Robetti, quello che salvò il bimbo dall’omnibus, poverino, che saltellava con le sue stampelle.","ja":"","t":[[0,5,"tutto"],[6,13,"parere"],[14,18,"fuori"],[19,21,"di"],[22,24,"sé"],[25,29,"da"],[30,40,"allegrezza"],[42,49,"perfino"],[50,58,0],[60,62,"il"],[63,72,"figliuolo"],[73,76,"di"],[77,83,"fabbro"],[85,91,"quello"],[92,101,0],[102,105,"che"],[106,109,"non"],[110,114,"ridere"],[115,118,"mai"],[120,121,"e"],[122,129,0],[131,137,"quello"],[138,141,"che"],[142,147,"salvare"],[148,150,"il"],[151,156,"bimbo"],[157,161,"da"],[162,169,0],[171,179,0],[181,184,"che"],[185,195,"saltellare"],[196,199,"con"],[200,202,"il"],[203,206,"suo"],[207,216,"stampella"]]},{"it":"Il Calabrese, che non aveva mai toccato neve, se ne fece una pallottola e si mise a mangiarla come una pesca; Crossi, il figliuolo dell’erbivendola, se n’empì lo zaino; e il muratorino ci fece scoppiar da ridere, quando mio padre lo invitò a venir domani a casa nostra: egli aveva la bocca piena di neve, e non osando né sputarla né mandarla giù, stava lì ingozzato a guardarci, e non rispondeva.","ja":"","t":[[0,2,"il"],[3,12,"calabrese"],[14,17,"che"],[18,21,"non"],[22,27,"avere"],[28,31,"mai"],[32,39,"toccare"],[40,44,"neve"],[46,48,"se"],[49,51,"ne"],[52,56,"fare"],[57,60,"un"],[61,71,0],[72,73,"e"],[74,76,"si"],[77,81,"mettere"],[82,83,"a"],[84,93,"mangiare"],[94,98,"come"],[99,102,"un"],[103,108,"pesca"],[110,116,0],[118,120,"il"],[121,130,"figliuolo"],[131,135,"di"],[136,147,0],[149,151,"se"],[152,153,0],[154,158,0],[159,161,"il"],[162,167,"zaino"],[169,170,"e"],[171,173,"il"],[174,184,0],[185,187,"ci"],[188,192,"fare"],[193,201,0],[202,204,"da"],[205,211,"ridere"],[213,219,"quando"],[220,223,"mio"],[224,229,"padre"],[230,232,"il"],[233,239,"invitare"],[240,241,"a"],[242,247,"venire"],[248,254,"domani"],[255,256,"a"],[257,261,"casa"],[262,268,"nostro"],[270,274,"egli"],[275,280,"avere"],[281,283,"il"],[284,289,"bocca"],[290,295,"pieno"],[296,298,"di"],[299,303,"neve"],[305,306,"e"],[307,310,"non"],[311,317,0],[318,320,"né"],[321,329,"sputare"],[330,332,"né"],[333,341,"mandare"],[342,345,"giù"],[347,352,"stare"],[353,355,"lì"],[356,365,0],[366,367,"a"],[368,377,"guardare"],[379,380,"e"],[381,384,"non"],[385,395,"rispondere"]]},{"it":"Anche le maestre uscivan dalla scuola di corsa, ridendo; anche la mia maestra di prima superiore, poveretta, correva a traverso al nevischio, riparandosi il viso col suo velo verde, e tossiva.","ja":"","t":[[0,5,"anche"],[6,8,"il"],[9,16,"maestra"],[17,24,0],[25,30,"da"],[31,37,"scuola"],[38,40,"di"],[41,46,"corsa"],[48,55,"ridere"],[57,62,"anche"],[63,65,"il"],[66,69,"mio"],[70,77,"maestra"],[78,80,"di"],[81,86,"prima"],[87,96,"superiore"],[98,107,0],[109,116,"correre"],[117,118,"a"],[119,127,0],[128,130,"a"],[131,140,0],[142,153,"riparare"],[154,156,"il"],[157,161,"viso"],[162,165,"con"],[166,169,"suo"],[170,174,"velare"],[175,180,"verde"],[182,183,"e"],[184,191,"tossire"]]},{"it":"E intanto centinaia di ragazze della sezione vicina passavano strillando e galoppando su quel tappeto candido, e i maestri e i bidelli e la guardia gridavano: — A casa!","ja":"","t":[[0,1,"e"],[2,9,"intanto"],[10,19,"centinaio"],[20,22,"di"],[23,30,"ragazza"],[31,36,"di"],[37,44,"sezione"],[45,51,"vicina"],[52,61,"passare"],[62,72,"strillare"],[73,74,"e"],[75,85,0],[86,88,"su"],[89,93,"quello"],[94,101,"tappeto"],[102,109,0],[111,112,"e"],[113,114,"il"],[115,122,"maestro"],[123,124,"e"],[125,126,"il"],[127,134,"bidello"],[135,136,"e"],[137,139,"il"],[140,147,"guardia"],[148,157,"gridare"],[161,162,"a"],[163,167,"casa"]]},{"it":"A casa!","ja":"","t":[[0,1,"a"],[2,6,"casa"]]},{"it":"— ingoiando fiocchi di neve e imbiancandosi i baffi e la barba.","ja":"","t":[[2,11,"ingoiare"],[12,19,0],[20,22,"di"],[23,27,"neve"],[28,29,"e"],[30,43,0],[44,45,"il"],[46,51,"baffi"],[52,53,"e"],[54,56,"il"],[57,62,"barba"]]},{"it":"Ma anch’essi ridevano di quella baldoria di scolari che festeggiavan l’inverno....","ja":"","t":[[0,2,"ma"],[3,7,"anche"],[8,12,"essi"],[13,21,"ridere"],[22,24,"di"],[25,31,"quello"],[32,40,0],[41,43,"di"],[44,51,"scolaro"],[52,55,"che"],[56,68,0],[69,70,"il"],[71,78,"inverno"]]},{"it":"— Voi festeggiate l’inverno....","ja":"","t":[[2,5,"voi"],[6,17,"festeggiare"],[18,19,"il"],[20,27,"inverno"]]},{"it":"Ma ci son dei ragazzi che non hanno nè panni, nè scarpe, nè fuoco.","ja":"","t":[[0,2,"ma"],[3,5,"ci"],[6,9,"essere"],[10,13,"di"],[14,21,"rag
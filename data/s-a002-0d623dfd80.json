ore"],[15,19,"buono"],[20,26,"giorno"],[27,28,"a"],[29,32,"lei"]]},{"it":"Ben arrivato, sor Dottore!","ja":"","t":[[0,3,"bene"],[4,12,"arrivare"],[14,17,0],[18,25,"dottore"]]},{"it":"—","ja":"","t":[]},{"it":"Altri monelli sopraggiunsero strillando:","ja":"","t":[[0,5,"altro"],[6,13,"monello"],[14,28,0],[29,39,"strillare"]]},{"it":"— Guarda che bel cappellone!...","ja":"","t":[[2,8,"guardare"],[9,12,"che"],[13,16,"bello"],[17,27,"cappellone"]]},{"it":"Sor Cappellone, la si rigiri!...","ja":"","t":[[0,3,0],[4,14,"cappellone"],[16,18,"il"],[19,21,"si"],[22,28,0]]},{"it":"Evviva Cappellone!...","ja":"","t":[[0,6,"evviva"],[7,17,"cappellone"]]},{"it":"—","ja":"","t":[]},{"it":"E lì grandi risate, urli, fischi, un baccano indiavolato, da levar di cervello.","ja":"","t":[[0,1,"e"],[2,4,"lì"],[5,11,"grande"],[12,18,"risata"],[20,24,"urlare"],[26,32,"fischiare"],[34,36,"un"],[37,44,"baccano"],[45,56,0],[58,60,"da"],[61,66,"levare"],[67,69,"di"],[70,78,"cervello"]]},{"it":"Il povero Gigino, che avrebbe pagato Dio sa che cosa per aver le ali come un uccello, e tornarsene, volando, a casa dalla sua mamma, si provò più volte a farsi largo e a svignarsela, ma i monelli, riunitisi in cerchio, gli chiudevano ogni via di salvezza.","ja":"","t":[[0,2,"il"],[3,9,"povero"],[10,16,0],[18,21,"che"],[22,29,"avere"],[30,36,"pagare"],[37,40,"Dio"],[41,43,"sapere"],[44,47,"che"],[48,52,"cosa"],[53,56,"per"],[57,61,"avere"],[62,64,"il"],[65,68,"ala"],[69,73,"come"],[74,76,"un"],[77,84,"uccello"],[86,87,"e"],[88,98,0],[100,107,"volare"],[109,110,"a"],[111,115,"casa"],[116,121,"da"],[122,125,"suo"],[126,131,"mamma"],[133,135,"si"],[136,141,"provare"],[142,145,"più"],[146,151,"volta"],[152,153,"a"],[154,159,"fare"],[160,165,"largo"],[166,167,"e"],[168,169,"a"],[170,181,0],[183,185,"ma"],[186,187,"il"],[188,195,"monello"],[197,206,"riunire"],[207,209,"in"],[210,217,"cerchio"],[219,222,"il"],[223,233,"chiudere"],[234,238,"ogni"],[239,242,"via"],[243,245,"di"],[246,254,"salvezza"]]},{"it":"— Mi pa
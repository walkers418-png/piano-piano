rò mia sorella ha avuto dei bei regali da tutte le parti!...","ja":"","t":[[0,4,"però"],[5,8,"mio"],[9,16,"sorella"],[17,19,"avere"],[20,25,"avere"],[26,29,"di"],[30,33,"bello"],[34,40,"regalo"],[41,43,"da"],[44,49,"tutto"],[50,52,"il"],[53,58,"parte"]]},{"it":"Non dico nulla dei dolci che ci son preparati in sala da pranzo!...","ja":"","t":[[0,3,"non"],[4,8,"dire"],[9,14,"nulla"],[15,18,"di"],[19,24,"dolce"],[25,28,"che"],[29,31,"ci"],[32,35,"essere"],[36,45,"preparare"],[46,48,"in"],[49,53,"sala"],[54,56,"da"],[57,63,"pranzo"]]},{"it":"Una cosa da sbalordire!...","ja":"","t":[[0,3,"un"],[4,8,"cosa"],[9,11,"da"],[12,22,0]]},{"it":"Però il migliore è la panna montata coi cialdoni.","ja":"","t":[[0,4,"però"],[5,7,"il"],[8,16,"migliore"],[17,18,"essere"],[19,21,"il"],[22,27,0],[28,35,"montare"],[36,39,"con"],[40,48,0]]},{"it":"Tutti son pronti, e fra pochi minuti si andrà al Municipio.","ja":"","t":[[0,5,"tutto"],[6,9,"essere"],[10,16,"pronto"],[18,19,"e"],[20,23,"fra"],[24,29,"poco"],[30,36,"minuto"],[37,39,"si"],[40,45,"andare"],[46,48,"a"],[49,58,"municipio"]]},{"it":"Ma la zia Bettina non verrà, perché ha deciso invece di ritornare a casa sua col treno che parte tra mezz’ora.","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,9,"zia"],[10,17,0],[18,21,"non"],[22,27,"venire"],[29,35,"perché"],[36,38,"avere"],[39,45,"decidere"],[46,52,"invece"],[53,55,"di"],[56,65,"ritornare"],[66,67,"a"],[68,72,"casa"],[73,76,"suo"],[77,80,"con"],[81,86,"treno"],[87,90,"che"],[91,96,"partire"],[97,100,"tra"],[101,105,"mezzo"],[106,109,"ora"]]},{"it":"Nessuno sa spiegarsi il perché di questa improvvisa decisione essendo stata accolta con tutti i dovuti riguardi; e alla mamma che la pregava di dire francamente se qualcuno le aveva mancato di rispetto senza accorgersene, ella ha risposto a denti stretti:","ja":"","t":[[0,7,"nessuno"],[8,10,"sapere"],[11,20,"spiegare"],[21,23,"il"],[24,30,"perché"],[31,33,"di"],[34,40,"questo"],[41,51,"improvviso"],[52,61,"decisione"],[62,69,"essere"],[70,75,"essere"],[76,83,"accogliere"],[84,87,"con"],[88,93,"tutto"],[94,95,"il"],[96,102,"dovere"],[103,111,"riguardare"],[113,114,"e"],[115,119,"a"],[120,125,"mamma"],[126,129,"che"],[130,132,"il"],[133,140,"pregare"],[141,143,"di"],[144,148,"dire"],[149,160,0],[161,163,"se"],[164,172,"qualcuno"],[173,175,"il"],[176,181,"avere"],[182,189,"mancare"],[190,192,"di"],[193,201,"rispetto"],[202,207,"senza"],[208,220,0],[222,226,"ella"],[227,229,"avere"],[230,238,"rispondere"],[239,240,"a"],[241,246,"dente"],[247,254,"stretto"]]},{"it":"- Vo via, anzi, perché mi si rispetta troppo; e dirai a Luisa che se vuoi rispettarmi anche meglio mi rimandi la coperta di lana che io ho avuto la stupidaggine di farle con le mie mani.","ja":"","t":[[2,4,"andare"],[5,8,"via"],[10,14,"anzi"],[16,22,"perché"],[23,25,"mi"],[26,28,"si"],[29,37,"rispettare"],[38,44,"troppo"],[46,47,"e"],[48,53,"dire"],[54,55,"a"],[56,61,0],[62,65,"che"],[66,68,"se"],[69,73,"volere"],[74,85,"rispettare"],[86,91,"anche"],[92,98,"meglio"],[99,101,"mi"],[102,109,"rimandare"],[110,112,"il"],[113,120,"coperta"],[121,123,"di"],[124,128,"lana"],[129,132,"che"],[133,135,"io"],[136,138,"avere"],[139,144,"avere"],[145,147,"il"],[148,160,0],[161,163,"di"],[164,169,"fare"],[170,173,"con"],[174,176,"il"],[177,180,"mio"],[181,185,"mano"]]},{"it":"E così se n’è andata via senza voler dire altro.","ja":"","t":[[0,1,"e"],[2,6,"così"],[7,9,"se"],[10,11,0],[12,13,"essere"],[14,20,"andare"],[21,24,"via"],[25,30,"senza"],[31,36,"volere"],[37,41,"dire"],[42,47,"altro"]]},{"it":"Il bello è che io solo so il vero motivo della partenza della zia, ma non lo dico per non guastare la bella sorpresa che avrà mia sorella.","ja":"","t":[[0,2,"il"],[3,8,"bello"],[9,10,"essere"],[11,14,"che"],[15,17,"io"],[18,22,"solo"],[23,25,"sapere"],[26,28,"il"],[29,33,"vero"],[34,40,"motivo"],[41,46,"di"],[47,55,"partenza"],[56,61,"di"],[62,65,"zia"],[67,69,"ma"],[70,73,"non"],[74,76,"il"],[77,81,"dire"],[82,85,"per"],[86,89,"non"],[90,98,"guastare"],[99,101,"il"],[
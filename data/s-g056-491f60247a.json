{"id":"g056","title":"28 dicembre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Il mio braccio è molto peggiorato a causa dello sforzo fatto ieri per salire nella rete del compartimento.","ja":"","t":[[0,2,"il"],[3,6,"mio"],[7,14,"braccio"],[15,16,"essere"],[17,22,"molto"],[23,33,0],[34,35,"a"],[36,41,"causa"],[42,47,"di"],[48,54,"sforzo"],[55,60,"fare"],[61,65,"ieri"],[66,69,"per"],[70,76,"salire"],[77,82,"in"],[83,87,"rete"],[88,91,"di"],[92,105,0]]},{"it":"Il Collalto mi ha portato stamani da quel suo amico che fa le cure elettriche, e che si chiama il professor Perussi il quale, dopo avermi visitato, mi ha detto:","ja":"","t":[[0,2,"il"],[3,11,0],[12,14,"mi"],[15,17,"avere"],[18,25,"portare"],[26,33,"stamani"],[34,36,"da"],[37,41,"quello"],[42,45,"suo"],[46,51,"amico"],[52,55,"che"],[56,58,"fare"],[59,61,"il"],[62,66,"cura"],[67,77,"elettrico"],[79,80,"e"],[81,84,"che"],[85,87,"si"],[88,94,"chiamare"],[95,97,"il"],[98,107,0],[108,115,0],[116,118,"il"],[119,124,"quale"],[126,130,"dopo"],[131,137,"avere"],[138,146,"visitare"],[148,150,"mi"],[151,153,"avere"],[154,159,"dire"]]},{"it":"- Ci vorrà una diecina di giorni e anche più...","ja":"","t":[[2,4,"ci"],[5,10,"volere"],[11,14,"un"],[15,22,0],[23,25,"di"],[26,32,"giorno"],[33,34,"e"],[35,40,"anche"],[41,44,"più"]]},{"it":"- Meglio! - ho detto io.","ja":"","t":[[2,8,"meglio"],[12,14,"avere"],[15,20,"dire"],[21,23,"io"]]},{"it":"- O che hai piacer a star male? - ha esclamato il professore sorpreso.","ja":"","t":[[2,3,"o"],[4,7,"che"],[8,11,"avere"],[12,18,"piacere"],[19,20,"a"],[21,25,"stare"],[26,30,"male"],[34,36,"avere"],[37,46,"esclamare"],[47,49,"il"],[50,60,"professore"],[61,69,"sorprendere"]]},{"it":"- No, ma mi piace tanto di stare a Roma, e poi a far la cura elettrica con tutte quelle macchine deve essere molto divertente...","ja":"","t":[[2,4,"no"],[6,8,"ma"],[9,11,"mi"],[12,17,"piacere"],[18,23,"tanto"],[24,26,"di"],[27,32,"stare"],[33,34,"a"],[35,39,0],[41,42,"e"],[43,46,"poi"],[47,48,"a"],[49,52,"fare"],[53,55,"il"],[56,60,"cura"],[61,70,"elettrico"],[71,74,"con"],[75,80,"tutto"],[81,87,"quello"],[88,96,"macchina"],[97,101,"dovere"],[102,108,"essere"],[109,114,"molto"],[115,125,"divertire"]]},{"it":"Il professor Perussi ha incominciato subito a farmi il massaggio elettrico applicandomi la corrente con una macchina motto complicata che mi faceva come un gran formicolìo in tutto il braccio, mentre io ridevo a più non posso.","ja":"","t":[[0,2,"il"],[3,12,0],[13,20,0],[21,23,"avere"],[24,36,"incominciare"],[37,43,"subito"],[44,45,"a"],[46,51,"fare"],[52,54,"il"],[55,64,"massaggio"],[65,74,"elettrico"],[75,87,"applicare"],[88,90,"il"],[91,99,"corrente"],[100,103,"con"],[104,107,"un"],[108,116,"macchina"],[117,122,"motto"],[123,133,"complicato"],[134,137,"che"],[138,140,"mi"],[141,147,"fare"],[148,152,"come"],[153,155,"un"],[156,160,"grande"],[161,171,0],[172,174,"in"],[175,180,"tutto"],[181,183,"il"],[184,191,"braccio"],[193,199,"mentre"],[200,202,"io"],[203,209,"ridere"],[210,211,"a"],[212,215,"più"],[216,219,"non"],[220,225,"potere"]]},{"it":"- Questa - ho detto - è la macchina per fare il solletico...","ja":"","t":[[2,8,"questo"],[11,13,"avere"],[14,19,"dire"],[22,23,"essere"],[24,26,"il"],[27,35,"macchina"],[36,39,"per"],[40,44,"fare"],[45,47,"il"],[48,57,"solletico"]]},{"it":"Ci vorrebbe per il signor Tyrynnanzy che, dopo l’affare del segnale d’allarme, è diventato così serio!","ja":"","t":[[0,2,"ci"],[3,11,"volere"],[12,15,"per"],[16,18,"il"],[19,25,"signore"],[26,36,0],[37,40,"che"],[42,46,"dopo"],[47,48,"il"],[49,55,"affare"],[56,59,"di"],[60,67,"segnale"],[68,69,"di"],[70,77,"allarme"],[79,80,"essere"],[81,90,"diventare"],[91,95,"così"],[96,101,"serio"]]},{"it":"- Vergognati! - ha detto il Collalto; ma l’ha detto ridendo.","ja":"","t":[[2,12,"vergognarsi"],[16,18,"avere"],[19,24,"dire"],[25,27,"il"],[28,36,0],[38,40,"ma"],[41,42,"il"],[43,45,"avere"],[46,51,"dire"],[52,59,"ridere"]]},{"it":"Mia sorella Luisa mi ha fatto grandi raccomandazioni di star buono e quieto in questi giorni che rimarrò presso di lei, perché prima di tutto la sora Matilde che è sua cognata, ossia la sorella di Collalto, è una ragazza invecchiata ed è molto ordinata nelle sue cose e anche un po’ meticolosa, e poi perché il dottor Collalto è specialista per le malattie del naso, della gola e degli orecchi, come è scritto nel cartellino sull’uscio di casa, e dà le consultazioni tutti i giorni, motivo per cui non bisogna far rumore a causa dei clienti che vengono a farsi visitare.","ja":"","t":[[0,3,"mio"],[4,11,"sorella"],[12,17,0],[18,20,"mi"],[21,23,"avere"],[24,29,"fare"],[30,36,"grande"],[37,52,"raccomandazione"],[53,55,"di"],[56,60,"stare"],[61,66,"buono"],[67,68,"e"],[69,75,"quieto"],[76,78,"in"],[79,85,"questo"],[86,92,"giorno"],[93,96,"che"],[97,104,"rimanere"],[105,111,"presso"],[112,114,"di"],[115,118,"lei"],[120,126,"perché"],[127,132,"prima"],[133,135,"Dio"],[136,141,"tutto"],[142,144,"il"],[145,149,0],[150,157,0],[158,161,"che"],[162,163,"essere"],[164,167,"suo"],[168,175,0],[177,182,"ossia"],[183,185,"il"],[186,193,"sorella"],[194,196,"di"],[197,205,0],[207,208,"essere"],[209,212,"un"],[213,220,"ragazza"],[221,232,"invecchiare"],[233,235,"e"],[236,237,"essere"],[238,243,"molto"],[244,252,"ordinato"],[253,258,"in"],[259,262,"suo"],[263,267,"cosa"],[268,269,"e"],[270,275,"anche"],[276,278,"un"],[279,281,"poco"],[283,293,0],[295,296,"e"],[297,300,"poi"],[301,307,"perché"],[308,310,"il"],[311,317,0],[318,326,0],[327,328,"essere"],[329,340,"specialista"],[341,344,"per"],[345,347,"il"],[348,356,"malattia"],[357,360,"di"],[361,365,"naso"],[367,372,"di"],[373,377,"gola"],[378,379,"e"],[380,385,"di"],[386,393,"orecchio"],[395,399,"come"],[400,401,"essere"],[402,409,"scrivere"],[410,413,"in"],[414,424,0],[425,429,"su"],[430,435,"uscio"],[436,438,"di"],[439,443,"casa"],[445,446,"e"],[447,449,"dare"],[450,452,"il"],[453,466,0],[467,472,"tutto"],[473,474,"il"],[475,48
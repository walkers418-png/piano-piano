"],[79,81,"il"],[82,91,"reginotta"],[92,99,"trovare"],[100,106,"ancora"],[107,112,"in"],[113,118,"fasce"]]},{"it":"—","ja":"","t":[]},{"it":"Perciò il Re messe fuori un decreto:","ja":"","t":[[0,6,"perciò"],[7,9,"il"],[10,12,"re"],[13,18,"mettere"],[19,24,"fuori"],[25,27,"un"],[28,35,0]]},{"it":"— Pena la vita a chi non teneva uno o più gatti, secondo che avesse casa o palazzo.","ja":"","t":[[2,6,"pena"],[7,9,"il"],[10,14,"vita"],[15,16,"a"],[17,20,"chi"],[21,24,"non"],[25,31,"tenere"],[32,35,"un"],[36,37,"o"],[38,41,"più"],[42,47,"gatto"],[49,56,"secondo"],[57,60,"che"],[61,67,"avere"],[68,72,"casa"],[73,74,"o"],[75,82,"palazzo"]]},{"it":"Chi ammazzava cento topi, diventava barone.","ja":"","t":[[0,3,"chi"],[4,13,0],[14,19,"cento"],[20,24,"topo"],[26,35,"diventare"],[36,42,0]]},{"it":"—","ja":"","t":[]},{"it":"Il Re diè l’esempio egli il primo; e il palazzo reale fu pieno di gatti, tenuti assai meglio dei cortigiani e anche dei ministri.","ja":"","t":[[0,2,"il"],[3,5,"re"],[6,9,"dare"],[10,11,"il"],[12,19,"esempio"],[20,24,"egli"],[25,27,"il"],[28,33,"primo"],[35,36,"e"],[37,39,"il"],[40,47,"palazzo"],[48,53,"reale"],[54,56,"essere"],[57,62,"pieno"],[63,65,"di"],[66,71,"gatto"],[73,79,"tenere"],[80,85,"assai"],[86,92,"meglio"],[93,96,"di"],[97,107,0],[108,109,"e"],[110,115,"anche"],[116,119,"di"],[120,128,"ministro"]]},{"it":"Inoltre, a tutti gli usci venivano appostate guardie con una granata in mano, invece di sciabola, che dovevano gridare all’armi appena visto un topo.","ja":"","t":[[0,7,"inoltre"],[9,10,"a"],[11,16,"tutto"],[17,20,"il"],[21,25,"uscio"],[26,34,"venire"],[35,44,0],[45,52,"guardia"],[53,56,"con"],[57,60,"un"],[61,68,0],[69,71,"in"],[72,76,"mano"],[78,84,"invece"],[85,87,"di"],[88,96,"sciabola"],[98,101,"che"],[102,110,"dovere"],[111,118,"gridare"],[119,122,"a"],[123,127,"arma"],[128,134,"appena"],[135,140,"vedere"],[141,143,"un"],[144,148,"topo"]]},{"it":"Sulle prime, con quella caccia ai topi per diventare barone, fu uno spasso per tutto il regn
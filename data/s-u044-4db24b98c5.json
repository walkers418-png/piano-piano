":"","t":[[0,2,"oh"],[3,8,"pregare"],[10,19,"pregare"],[21,29,"amare"],[31,36,"essere"],[37,42,"buono"],[44,52,"portare"],[53,59,"quello"],[60,67,0],[68,76,"speranza"],[77,81,"in"],[82,87,"anima"],[89,96,"adorare"],[97,106,"fanciullo"],[107,110,"mio"]]},{"it":"Tua Madre","ja":"","t":[[0,3,"tuo"],[4,9,"madre"]]}],"q":[],"g":{},"n":452,"w":["Dio","a","abbraccio","adorare","affetto","aiutare","allora","alto","altro","amare","anche","anima","ardore","ascoltare","atto","avere","azione","babbo","baciare","bambino","bello","bene","benedetto","bontà","braccio","buono","cancellare","ce","che","chi","ci","coloro","colpa","come","compagno","con","contento","coraggioso","cortese","cosa","coscienza","credere","cui","cuore","da","dare","degno","di","dire","disgrazia","disperare","dolcezza","dolore","domandare","domenica","dopo","dove","dovere","e","essere","eterno","fanciullo","fare","felice","figliuolo","forza","fratello","gentile","gettare","giorno","giungere","grande","guardare","ieri","il","immaginare","immortale","impossibile","in","infinito","innanzi","io","lacrima","lavoro","lodare","ma","macchia","madre","maestro","mai","mamma","mano","mattina","mettere","mi","migliore","mio","molto","mondo","morire","morte","morto","moto","nessuno","nobile","noi","non","o","oggi","ogni","oh","onesto","padre","parere","parola","pensare","pensiero","per","perché","perdere","pianto","pietà","più","portare","potere","pregare","proporre","proposito","provare","qualche","quando","quanto","quello","questo","religione","rendere","risentire","ritrovare","rivedere","saluto","sciogliere","scuola","sempre","sentire","senza","separare","sera","si","signore","sincero","slancio","soffrire","sollevare","speranza","stringere","su","suo","sì","te","terra","ti","tornare","tremendo","tu","tuo","tutto","ultimo","un","vedere","verso","vita","voce","volere"]}
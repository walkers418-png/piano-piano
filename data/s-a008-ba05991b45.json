{"id":"a008","title":"Pipì o lo scimmiottino color di rosa・I","lv":8,"kind":"童話","note":"Carlo Collodi「Storie allegre」（1887年）の原文です。古い語や綴りがあります。","lines":[{"it":"I.","ja":"","t":[[0,1,"il"]]},{"it":"Perchè a Pipì fu dato il soprannome di «Scimmiottino color di rosa.»","ja":"","t":[[0,6,"perché"],[7,8,"a"],[9,13,0],[14,16,"essere"],[17,21,"dare"],[22,24,"il"],[25,35,"soprannome"],[36,38,"di"],[40,52,0],[53,58,"colore"],[59,61,"di"],[62,66,"rosa"]]},{"it":"Nel famosissimo bosco di Vattel’a pesca, c’era una volta una piccola famiglia composta di sette scimmie: il babbo, la mamma e cinque scimmiottini alti quanto un soldo di cacio.","ja":"","t":[[0,3,"in"],[4,15,"famoso"],[16,21,"bosco"],[22,24,"di"],[25,31,0],[32,33,"a"],[34,39,"pesca"],[41,42,"ci"],[43,46,"essere"],[47,50,"un"],[51,56,"volta"],[57,60,"un"],[61,68,"piccolo"],[69,77,"famiglia"],[78,86,"comporre"],[87,89,"di"],[90,95,"sette"],[96,103,"scimmia"],[105,107,"il"],[108,113,"babbo"],[115,117,"il"],[118,123,"mamma"],[124,125,"e"],[126,132,"cinque"],[133,145,0],[146,150,"alto"],[151,157,"quanto"],[158,160,"un"],[161,166,"soldo"],[167,169,"di"],[170,175,"cacio"]]},{"it":"Questa famigliola abitava fra i rami di un albero gigantesco, in mezzo a una foresta, e pagava quindici susine l’anno di pigione a un vecchio gorilla prepotente, che si era messo in capo di essere il padrone di casa.","ja":"","t":[[0,6,"questo"],[7,17,0],[18,25,"abitare"],[26,29,"fra"],[30,31,"il"],[32,36,"ramo"],[37,39,"di"],[40,42,"un"],[43,49,"albero"],[50,60,"gigantesco"],[62,64,"in"],[65,70,"mezzo"],[71,72,"a"],[73,76,"un"],[77,84,"foresta"],[86,87,"e"],[88,94,"pagare"],[95,103,"quindici"],[104,110,0],[111,112,"il"],[113,117,"anno"],[118,120,"di"],[121,128,0],[129,130,"a"],[131,133,"un"],[134,141,"vecchio"],[142,149,0],[150,160,"prepotente"],[162,165,"che"],[166,168,"si"],[169,172,"essere"],[173,178,"mettere"],[179,181,"in"],[182,186,"capo"],[187,189,"di"],[190,196,"essere"],[197,199,"il"],[200,207,"padrone"],[208,210,"di"],[211,215,"casa"]]}
{"id":"g043","title":"9 dicembre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Sono alla diciannovesima minestra di capellini... ma continuo nelle mie vendette.","ja":"","t":[[0,4,"essere"],[5,9,"a"],[10,24,0],[25,33,"minestra"],[34,36,"di"],[37,46,"capellino"],[50,52,"ma"],[53,61,"continuare"],[62,67,"in"],[68,71,"mio"],[72,80,"vendetta"]]},{"it":"Loro non sanno immaginare che cosa possa diventare di cattivo un povero ragazzo obbligato a mangiare fin cinque e sei minestre al giorno, tutte di capellini, ma se n’accorgeranno.","ja":"","t":[[0,4,"loro"],[5,8,"non"],[9,14,"sapere"],[15,25,"immaginare"],[26,29,"che"],[30,34,"cosa"],[35,40,"potere"],[41,50,"diventare"],[51,53,"di"],[54,61,"cattivo"],[62,64,"un"],[65,71,"povero"],[72,79,"ragazzo"],[80,89,"obbligare"],[90,91,"a"],[92,100,"mangiare"],[101,104,"fino"],[105,111,"cinque"],[112,113,"e"],[114,117,"essere"],[118,126,"minestra"],[127,129,"a"],[130,136,"giorno"],[138,143,"tutto"],[144,146,"di"],[147,156,"capellino"],[158,160,"ma"],[161,163,"se"],[164,165,0],[166,178,"accorgersi"]]},{"it":"Intanto stamani sono andato in cucina e ho messo un bel pizzicotto di pepe nel caffè... ed era un divertimento, dopo, il vedere come sputavano tutti quanti!","ja":"","t":[[0,7,"intanto"],[8,15,"stamani"],[16,20,"essere"],[21,27,"andare"],[28,30,"in"],[31,37,"cucina"],[38,39,"e"],[40,42,"avere"],[43,48,"mettere"],[49,51,"un"],[52,55,"bello"],[56,66,0],[67,69,"di"],[70,74,"pepe"],[75,78,"in"],[79,84,"caffè"],[88,90,"e"],[91,94,"essere"],[95,97,"un"],[98,110,"divertimento"],[112,116,"dopo"],[118,120,"il"],[121,127,"vedere"],[128,132,"come"],[133,142,"sputare"],[143,148,"tutto"],[149,155,"quanto"]]},{"it":"Oggi poi c’è stato in casa un viavai di gente, e da ultimo è venuto il garzone del pasticciere con una grande scatola di cartone e un sacchetto pieno che Caterina ha riposto subito nella credenza, chiudendola a chiave.","ja":"","t":[[0,4,"oggi"],[5,8,"poi"],[9,10,"ci"],[11,12,"essere"],[13,18,"essere"],[19,21,"in"],[22,26,"casa"],[27,29,"un"],[30,36,0],[37,39,"di"],[40,45,"gente"],[47,48,"e"],[49,51,"da"],[52,58,"ultimo"],[59,60,"essere"],[61,67,"venire"],[68,70,"il"],[71,78,"garzone"],[79,82,"di"],[83,94,"pasticciere"],[95,98,"con"],[99,102,"un"],[103,109,"grande"],[110,117,"scatola"],[118,120,"di"],[121,128,"cartone"],[129,130,"e"],[131,133,"un"],[134,143,"sacchetto"],[144,149,"pieno"],[150,153,"che"],[154,162,0],[163,165,"avere"],[166,173,0],[174,180,"subito"],[181,186,"in"],[187,195,0],[197,208,"chiudere"],[209,210,"a"],[211,217,"chiave"]]},{"it":"Io però, sapendo che la chiave della camera di Ada apre benissimo anche la credenza, ho colto il momento opportuno e ho voluto vedere che cosa ci fosse in quella scatola e in quel sacchetto.","ja":"","t":[[0,2,"io"],[3,7,"però"],[9,16,"sapere"],[17,20,"che"],[21,23,"il"],[24,30,"chiave"],[31,36,"di"],[37,43,"camera"],[44,46,"di"],[47,50,0],[51,55,"aprire"],[56,65,"bene"],[66,71,"anche"],[72,74,"il"],[75,83,0],[85,87,"avere"],[88,93,"cogliere"],[94,96,"il"],[97,104,"momento"],[105,114,"opportuno"],[115,116,"e"],[117,119,"avere"],[120,126,"volere"],[127,133,"vedere"],[134,137,"che"],[138,142,"cosa"],[143,145,"ci"],[146,151,"essere"],[152,154,"in"],[155,161,"quello"],[162,169,"scatola"],[170,171,"e"],[172,174,"in"],[175,179,"quello"],[180,189,"sacchetto"]]},{"it":"Lo dico subito: la scatola era piena di altre piccole scatole tonde sulle quali era scritto con lettere dorate: Nozze Stoppani- Maralli.","ja":"","t":[[0,2,"il"],[3,7,"dire"],[8,14,"subito"],[16,18,"il"],[19,26,"scatola"],[27,30,"essere"],[31,36,"pieno"],[37,39,"di"],[40,45,"altro"],[46,53,"piccolo"],[54,61,"scatola"],[62,67,"tondo"],[68,73,"su"],[74,79,"quale"],[80,83,"essere"],[84,91,"scrivere"],[92,95,"con"],[96,103,"lettera"],[104,110,0],[112,117,"nozze"],[118,126,0],[128,135,0]]},{"it":"È stata una rivelazione per me.","ja":"","t":[[0,1,"essere"],[2,7,"essere"],[8,11,"un"],[12,23,"rivelazione"],[24,27,"per"],[28,30,"me"]]},{"it":"- Ah! - ho detto - c’è uno sposalizio in casa e non mi si dice nulla?","ja":"","t":[[2,4,"ah"],[8,10,"avere"],[11,16,"dire"],[19,20,"ci"],[21,22,"essere"],[23,26,"un"],[27,37,"sposalizio"],[38,40,"in"],[41,45,"casa"],[46,47,"e"],[48,51,"non"],[52,54,"mi"],[55,57,"si"],[58,62,"dire"],[63,68,"nulla"]]},{"it":"Ah, c’è una festa in famiglia e il povero Giannino si tiene all’oscuro di tutto, condannato a mangiar minestre di capellini dalla mattina alla sera?","ja":"","t":[[0,2,"ah"],[4,5,"ci"],[6,7,"essere"],[8,11,"un"],[12,17,"festa"],[18,20,"in"],[21,29,"famiglia"],[30,31,"e"],[32,34,"il"],[35,41,"povero"],[42,50,0],[51,53,"si"],[54,59,"tenere"],[60,63,"a"],[64,70,"oscuro"],[71,73,"di"],[74,79,"tutto"],[81,91,"condannare"],[92,93,"a"],[94,101,"mangiare"],[102,110,"minestra"],[111,113,"di"],[114,123,"capellino"],[124,129,"da"],[130,137,"mattina"],[138,142,"a"],[143,147,"sera"]]},{"it":"E aperto il sacchetto portato dal pasticciere, e il cui contenuto, dopo aver scoperto quello della scatola, non era più un mistero per me, mi son fatto una bella scorpacciata di confetti esclamando:","ja":"","t":[[0,1,"e"],[2,8,"aprire"],[9,11,"il"],[12,21,"sacchetto"],[22,29,"portare"],[30,33,"da"],[34,45,"pasticciere"],[47,48,"e"],[49,51,"il"],[52,55,"cui"],[56,65,"contenere"],[67,71,"dopo"],[72,76,"avere"],[77,85,"scoprire"],[86,92,"quello"],[93,98,"di"],[99,106,"scatola"],[108,111,"non"],[112,115,"essere"],[116,119,"più"],[120,122,"un"],[123,130,"mistero"],[131,134,"per"],[135,137,"me"],[139,141,"mi"],[142,145,"essere"],[146,151,"fare"],[152,155,"un"],[156,161,"bello"],[162,174,0],[175,177,"di"],[178,186,"confetto"],[187,197,"esclamare"]]},{"it":"- No, cari miei!","ja":"","t":[[2,4,"no"],[6,10,"caro"],[11,15,"mio"]]},{"it":"Deve festeggiare gli sposi anche Giannino, perché Giannino è proprio quello che ha fatto nascere lo sposalizio e sarebbe una vera ingratitudine il non fargli prender parte alla festa!","ja":"","t":[[0,4,"dovere"],[5,16,"festeggiare"],[17,2
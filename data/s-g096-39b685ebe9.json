],[166,169,"essere"],[170,173,"più"],[174,181,"piccino"]]},{"it":"In quanto all’impiego che farò dell’eredità, fra i tanti sogni che ho fatto due specialmente mi stanno fissi alla mente: comperare un automobile, o aprire un negozio di pasticceria come quello del babbo di Gigino Balestra...","ja":"","t":[[0,2,"in"],[3,9,"quanto"],[10,13,"a"],[14,21,"impiego"],[22,25,"che"],[26,30,"fare"],[31,35,"di"],[36,43,"eredità"],[45,48,"fra"],[49,50,"il"],[51,56,"tanto"],[57,62,"sogno"],[63,66,"che"],[67,69,"avere"],[70,75,"fare"],[76,79,"due"],[80,92,"specialmente"],[93,95,"mi"],[96,102,"stare"],[103,108,"fisso"],[109,113,"a"],[114,119,"mentire"],[121,130,"comperare"],[131,133,"un"],[134,144,"automobile"],[146,147,"o"],[148,154,"aprire"],[155,157,"un"],[158,165,"negozio"],[166,168,"di"],[169,180,"pasticceria"],[181,185,"come"],[186,192,"quello"],[193,196,"di"],[197,202,"babbo"],[203,205,"di"],[206,212,0],[213,221,0]]},{"it":"Vedremo!","ja":"","t":[[0,7,"vedere"]]},{"it":"Intanto prendo venti biglietti da cinque lire in tasca e vo a cercare la cassaforte...","ja":"","t":[[0,7,"intanto"],[8,14,"prendere"],[15,20,"venti"],[21,30,"biglietto"],[31,33,"da"],[34,40,"cinque"],[41,45,"lira"],[46,48,"in"],[49,54,"tasca"],[55,56,"e"],[57,59,"andare"],[60,61,"a"],[62,69,"cercare"],[70,72,"il"],[73,83,"cassaforte"]]},{"it":"Ed eccomi di nuovo solo in camera mia mentre tutti dormono: solo col mio tesoro che è qui, finalmente sicuro nel mio armadio...","ja":"","t":[[0,2,"e"],[3,9,0],[10,12,"di"],[13,18,"nuovo"],[19,23,"solo"],[24,26,"in"],[27,33,"camera"],[34,37,"mio"],[38,44,"mentre"],[45,50,"tutto"],[51,58,"dormire"],[60,64,"solo"],[65,68,"con"],[69,72,"mio"],[73,79,"tesoro"],[80,83,"che"],[84,85,"essere"],[86,89,"qui"],[91,101,"finalmente"],[102,108,"sicuro"],[109,112,"in"],[113,116,"mio"],[117,124,"armadio"]]},{"it":"Che bella soddisfazione avere una cassaforte con mille lire dentro!...","ja":"","t":[[0,3,"che"],[4,9,"bello"],[10,23,"soddisfazione"],[24,29,"avere"],[30,33,"un"],[34,44,"cassaforte"],[45,48,"con"],[49,54,"mille"],[55,59,"lira"],[60,66,"dentro"]]},{"it":"Un momento: ora non sono più mille lire, ma settecentotrentuno perché oggi ho speso la somma non indifferente di lire duecentosessantanove!","ja":"","t":[[0,2,"un"],[3,10,"momento"],[12,15,"ora"],[16,19,"non"],[20,24,"essere"],[25,28,"più"],[29,34,"mille"],[35,39,"lira"],[41,43,"ma"],[44,62,0],[63,69,"perché"],[70,74,"oggi"],[75,77,"avere"],[78,83,"spendere"],[84,86,"il"],[87,92,"somma"],[93,96,"non"],[97,109,0],[110,112,"di"],[113,117,"lira"],[118,138,0]]},{"it":"Ma tutte spese giustificate e tutte regolarmente registrate qui nel libro d’entrata e uscita che costa una lira e dal quale risulta il seguente stato di cassa a tutt’oggi.","ja":"","t":[[0,2,"ma"],[3,8,"tutto"],[9,14,"spendere"],[15,27,0],[28,29,"e"],[30,35,"tutto"],[36,48,"regolarmente"],[49,59,"registrare"],[60,63,"qui"],[64,67,"in"],[68,73,"libro"],[74,75,"di"],[76,83,"entrata"],[84,85,"e"],[86,92,"uscire"],[93,96,"che"],[97,102,"costare"],[103,106,"un"],[107,111,"lira"],[112,113,"e"],[114,117,"da"],[118,123,"quale"],[124,131,"risultare"],[132,134,"il"],[135,143,"seguire"],[144,149,"essere"],[150,152,"dire"],[153,158,"cassa"],[159,160,"a"],[161,165,"tutto"],[166,170,"oggi"]]},{"it":"Nel registro che ho comperato c’è anche una colonna per le Osservazioni, ma lì non ho scritto niente, perché l’unica osservazione che potevo metterci era questa: che i quattrini peggio spesi sono stati quelli delle elemosine.","ja":"","t":[[0,3,"in"],[4,12,"registrare"],[13,16,"che"],[17,19,"avere"],[20,29,"comperare"],[30,31,"ci"],[32,33,"essere"],[34,39,"anche"],[40,43,"un"],[44,51,"colonna"],[52,55,"per"],[56,58,"il"],[59,71,"osservazione"],[73,75,"ma"],[76,78,"lì"],[79,82,"non"],[83,85,"avere"],[86,93,"scrivere"],[94,100,"niente"],[102,108,"perché"],[109,110,"il"],[111,116,"unico"],[117,129,"osservazione"],[130,133,"che"],[134,140,"potere"],[141,149,"mettere"],[150,153,"essere"],[154,160,"questo"],[162,165,"che"],[166,167,"il"],[168,177,"q
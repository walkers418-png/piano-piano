,{"it":"Quando entrerà, salutatelo con affetto e seri; nessuno scherzi, nessuno rida con lui, mi raccomando.","ja":"","t":[[0,6,"quando"],[7,14,"entrare"],[16,26,"salutare"],[27,30,"con"],[31,38,"affetto"],[39,40,"e"],[41,45,"serio"],[47,54,"nessuno"],[55,62,"scherzo"],[64,71,"nessuno"],[72,76,"ridere"],[77,80,"con"],[81,84,"lui"],[86,88,"mi"],[89,99,"raccomandare"]]},{"it":"— E questa mattina, un po’ più tardi degli altri, entrò il povero Garrone.","ja":"","t":[[2,3,"e"],[4,10,"questo"],[11,18,"mattina"],[20,22,"un"],[23,25,"poco"],[27,30,"più"],[31,36,"tardi"],[37,42,"di"],[43,48,"altro"],[50,55,"entrare"],[56,58,"il"],[59,65,"povero"],[66,73,0]]},{"it":"Mi sentii un colpo al cuore a vederlo.","ja":"","t":[[0,2,"mi"],[3,9,"sentire"],[10,12,"un"],[13,18,"colpo"],[19,21,"a"],[22,27,"cuore"],[28,29,"a"],[30,37,"vedere"]]},{"it":"Era smorto in viso, aveva gli occhi rossi, e si reggeva male sulle gambe: pareva che fosse stato un mese malato: quasi non si riconosceva più: era vestito tutto di nero: faceva compassione.","ja":"","t":[[0,3,"essere"],[4,10,"smorto"],[11,13,"in"],[14,18,"viso"],[20,25,"avere"],[26,29,"il"],[30,35,"occhio"],[36,41,"rosso"],[43,44,"e"],[45,47,"si"],[48,55,"reggere"],[56,60,"male"],[61,66,"su"],[67,72,"gamba"],[74,80,"parere"],[81,84,"che"],[85,90,"essere"],[91,96,"essere"],[97,99,"un"],[100,104,"mese"],[105,111,"malato"],[113,118,"quasi"],[119,122,"non"],[123,125,"si"],[126,137,"riconoscere"],[138,141,"più"],[143,146,"essere"],[147,154,"vestire"],[155,160,"tutto"],[161,163,"di"],[164,168,"nero"],[170,176,"fare"],[177,188,"compassione"]]},{"it":"Nessuno fiatò; tutti lo guardarono.","ja":"","t":[[0,7,"nessuno"],[8,13,"fiatare"],[15,20,"tutto"],[21,23,"il"],[24,34,"guardare"]]},{"it":"Appena entrato, al primo riveder quella scuola, dove sua madre era venuta a prenderlo quasi ogni giorno, quel banco sul quale s’era tante volte chinata i giorni d’esame a fargli l’ultima raccomandazione, e dove egli aveva tante volte pensato a lei, impaziente d’usci
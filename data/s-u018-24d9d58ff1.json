o"],[65,68,"che"],[69,79,"chiamare"],[80,81,"il"],[83,93,0],[95,101,"perché"],[102,109,"fare"],[110,112,"il"],[113,120,"maestro"],[121,127,"studiare"],[128,130,"da"],[131,139,"avvocato"],[140,141,"e"],[142,147,"prendere"],[148,150,"il"],[151,157,0],[159,160,"e"],[161,165,"fare"],[166,171,"anche"],[172,174,"un"],[175,180,"libro"],[181,184,"per"],[185,194,"insegnare"],[195,196,"a"],[197,204,"scrivere"],[205,207,"il"],[208,215,"lettera"]]},{"it":"Invece quello che c’insegna la ginnastica è un tipo di soldato, è stato con Garibaldi, e ha sul collo la cicatrice d’una ferita di sciabola toccata alla battaglia di Milazzo.","ja":"","t":[[0,6,"invece"],[7,13,"quello"],[14,17,"che"],[18,19,"ci"],[20,27,"insegnare"],[28,30,"il"],[31,41,"ginnastica"],[42,43,"essere"],[44,46,"un"],[47,51,"tipo"],[52,54,"di"],[55,62,"soldato"],[64,65,"essere"],[66,71,"essere"],[72,75,"con"],[76,85,0],[87,88,"e"],[89,91,"avere"],[92,95,"su"],[96,101,"collo"],[102,104,"il"],[105,114,0],[115,116,"di"],[117,120,"un"],[121,127,"ferita"],[128,130,"di"],[131,139,"sciabola"],[140,147,"toccare"],[148,152,"a"],[153,162,"battaglia"],[163,165,"di"],[166,173,0]]},{"it":"Poi c’è il Direttore, alto, calvo con gli occhiali d’oro, con la barba grigia che gli vien sul petto, tutto vestito di nero e sempre abbottonato fin sotto il mento; così buono coi ragazzi, che quando entrano tutti tremanti in Direzione, chiamati per un rimprovero, non li sgrida, ma li piglia per le mani, e dice tante ragioni, che non dovevan far così, e che bisogna che si pentano, e che promettano d’esser buoni, e parla con tanta buona maniera e con una voce così dolce che tutti escono con gli occhi rossi, più confusi che se li avesse puniti.","ja":"","t":[[0,3,"poi"],[4,5,"ci"],[6,7,"essere"],[8,10,"il"],[11,20,"direttore"],[22,26,"alto"],[28,33,"calvo"],[34,37,"con"],[38,41,"il"],[42,50,"occhiali"],[51,52,"di"],[53,56,"oro"],[58,61,"con"],[62,64,"il"],[65,70,"barba"],[71,77,"grigio"],[78,81,"che"],[82,85,"il"],[86,90,"venire"],[91,94,"su"],[
[[2,9,"domandare"],[10,20,0]]},{"it":"— Il babbo, sì; la mamma non l’ho mai conosciuta.","ja":"","t":[[2,4,"il"],[5,10,"babbo"],[12,14,"sì"],[16,18,"il"],[19,24,"mamma"],[25,28,"non"],[29,30,"il"],[31,33,"avere"],[34,37,"mai"],[38,48,"conoscere"]]},{"it":"— Chi lo sa che dispiacere sarebbe per il tuo vecchio padre, se ora ti facessi gettare fra quei carboni ardenti!","ja":"","t":[[2,5,"chi"],[6,8,"il"],[9,11,"sapere"],[12,15,"che"],[16,26,"dispiacere"],[27,34,"essere"],[35,38,"per"],[39,41,"il"],[42,45,"tuo"],[46,53,"vecchio"],[54,59,"padre"],[61,63,"se"],[64,67,"ora"],[68,70,"ti"],[71,78,"fare"],[79,86,"gettare"],[87,90,"fra"],[91,95,"quello"],[96,103,"carbone"],[104,111,"ardente"]]},{"it":"Povero vecchio! lo compatisco.... etcì, etcì, etcì, — e fece altri tre starnuti.","ja":"","t":[[0,6,"povero"],[7,14,"vecchio"],[16,18,"il"],[19,29,0],[34,38,0],[40,44,0],[46,50,0],[54,55,"e"],[56,60,"fare"],[61,66,"altro"],[67,70,"tre"],[71,79,0]]},{"it":"— Felicità!","ja":"","t":[[2,10,"felicità"]]},{"it":"— disse Pinocchio.","ja":"","t":[[2,7,"dire"],[8,17,0]]},{"it":"— Grazie.","ja":"","t":[[2,8,"grazie"]]},{"it":"Del resto bisogna compatire anche me, perchè, come vedi, non ho più legna per finire di cuocere quel montone arrosto, e tu, dico la verità, in questo caso mi avresti fatto un gran comodo!","ja":"","t":[[0,3,"di"],[4,9,"restare"],[10,17,"bisognare"],[18,27,0],[28,33,"anche"],[34,36,"me"],[38,44,"perché"],[46,50,"come"],[51,55,"vedere"],[57,60,"non"],[61,63,"avere"],[64,67,"più"],[68,73,0],[74,77,"per"],[78,84,"finire"],[85,87,"di"],[88,95,"cuocere"],[96,100,"quello"],[101,108,"montone"],[109,116,"arrosto"],[118,119,"e"],[120,122,"tu"],[124,128,"dire"],[129,131,"il"],[132,138,"verità"],[140,142,"in"],[143,149,"questo"],[150,154,"caso"],[155,157,"mi"],[158,165,"avere"],[166,171,"fare"],[172,174,"un"],[175,179,"grande"],[180,186,"comodo"]]},{"it":"Ma oramai mi sono impietosito e ci vuol pazienza.","ja":"","t":[[0,2,"ma"],[3,9,"ormai"],[10,12,"mi"],[13,17,"essere"],[18,2
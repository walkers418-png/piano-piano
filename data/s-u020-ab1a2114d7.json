{"id":"u020","title":"Novembre・Il protettore di Nelli","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL PROTETTORE DI NELLI.","ja":"","t":[[0,2,"il"],[3,13,0],[14,16,"di"],[17,22,0]]},{"it":"23, mercoledì.","ja":"","t":[[4,13,"mercoledì"]]},{"it":"Anche Nelli, ieri, guardava i soldati, povero gobbino, ma con un’aria così, come se pensasse: — Io non potrò esser mai un soldato!","ja":"","t":[[0,5,"anche"],[6,11,0],[13,17,"ieri"],[19,27,"guardare"],[28,29,"il"],[30,37,"soldato"],[39,45,"povero"],[46,53,0],[55,57,"ma"],[58,61,"con"],[62,64,"un"],[65,69,"aria"],[70,74,"così"],[76,80,"come"],[81,83,"se"],[84,92,"pensare"],[96,98,"io"],[99,102,"non"],[103,108,"potere"],[109,114,"essere"],[115,118,"mai"],[119,121,"un"],[122,129,"soldato"]]},{"it":"— Egli è buono, studia; ma è così magrino e smorto, e respira a fatica.","ja":"","t":[[2,6,"egli"],[7,8,"essere"],[9,14,"buono"],[16,22,"studiare"],[24,26,"ma"],[27,28,"essere"],[29,33,"così"],[34,41,0],[42,43,"e"],[44,50,0],[52,53,"e"],[54,61,"respirare"],[62,63,"a"],[64,70,"fatica"]]},{"it":"Porta sempre un lungo grembiale di tela nera lucida.","ja":"","t":[[0,5,"porta"],[6,12,"sempre"],[13,15,"un"],[16,21,"lungo"],[22,31,0],[32,34,"di"],[35,39,0],[40,44,"nero"],[45,51,0]]},{"it":"Sua madre è una signora piccola e bionda, vestita di nero, e vien sempre a prenderlo al finis, perchè non esca nella confusione, con gli altri; e lo accarezza.","ja":"","t":[[0,3,"suo"],[4,9,"madre"],[10,11,"essere"],[12,15,"un"],[16,23,"signora"],[24,31,"piccolo"],[32,33,"e"],[34,40,"biondo"],[42,49,"vestire"],[50,52,"di"],[53,57,"nero"],[59,60,"e"],[61,65,"venire"],[66,72,"sempre"],[73,74,"a"],[75,84,"prendere"],[85,87,"a"],[88,93,0],[95,101,"perché"],[102,105,"non"],[106,110,"uscire"],[111,116,"in"],[117,127,"confusione"],[129,132,"con"],[133,136,"il"],[137,142,"altro"],[144,145,"e"],[146,148,"il"],[149,158,"accarezzare"]]},{"it":"I primi giorni, perchè ha quella disgrazia d’esser gobbo, molti ragazzi lo beffavano e gli picchiavan sulla schiena con gli zaini; ma egli non si rivoltava mai, e non diceva mai nulla a sua madre, per non darle quel dolore di sapere che suo figlio era lo zimbello dei compagni; lo schernivano, ed egli piangeva e taceva, appoggiando la fronte sul banco.","ja":"","t":[[0,1,"il"],[2,7,"primo"],[8,14,"giorno"],[16,22,"perché"],[23,25,"avere"],[26,32,"quello"],[33,42,"disgrazia"],[43,44,"di"],[45,50,"essere"],[51,56,0],[58,63,"molto"],[64,71,"ragazzo"],[72,74,"il"],[75,84,0],[85,86,"e"],[87,90,"il"],[91,101,0],[102,107,"su"],[108,115,"schiena"],[116,119,"con"],[120,123,"il"],[124,129,"zaino"],[131,133,"ma"],[134,138,"egli"],[139,142,"non"],[143,145,"si"],[146,155,0],[156,159,"mai"],[161,162,"e"],[163,166,"non"],[167,173,"dire"],[174,177,"mai"],[178,183,"nulla"],[184,185,"a"],[186,189,"suo"],[190,195,"madre"],[197,200,"per"],[201,204,"non"],[205,210,"dare"],[211,215,"quello"],[216,222,"dolore"],[223,225,"di"],[226,232,"sapere"],[233,236,"che"],[237,240,"suo"],[241,247,"figlio"],[248,251,"essere"],[252,254,"il"],[255,263,0],[264,267,"di"],[268,276,"compagno"],[278,280,"il"],[281,292,0],[294,296,"e"],[297,301,"egli"],[302,310,"piangere"],[311,312,"e"],[313,319,"tacere"],[321,332,"appoggiare"],[333,335,"il"],[336,342,"fronte"],[343,346,"su"],[347,352,"banco"]]},{"it":"Ma una mattina saltò su Garrone e disse: — Il primo che tocca Nelli gli do uno scapaccione che gli faccio far tre giravolte!","ja":"","t":[[0,2,"ma"],[3,6,"un"],[7,14,"mattina"],[15,20,"saltare"],[21,23,"su"],[24,31,0],[32,33,"e"],[34,39,"dire"],[43,45,"il"],[46,51,"primo"],[52,55,"che"],[56,61,"toccare"],[62,67,0],[68,71,"il"],[72,74,"dare"],[75,78,"un"],[79,90,0],[91,94,"che"],[95,98,"il"],[99,105,"fare"],[106,109,"fare"],[110,113,"tre"],[114,123,0]]},{"it":"— Franti non gli badò, lo scapaccione partì, l’amico fece le tre giravolte, e dopo d’allora nessuno toccò più Nelli.","ja":"","t":[[2,8,0],[9,12,"non"],[13,16,"il"],[17,21,"badare"],[23,25,"il"],[26,37,0],[38,43,"partire"],[45,46,"il"],[47,52,"amico"],[53,57,"fare"],[58,60,"il"],[61,64,"tre"],[65,74,0],[76,77,"e"],[78,82,"dopo"],[83,84,"di"],[85,91,"allora"],[92,99,"nessuno"],[100,105,"toccare"],[106,109,"più"],[110,115,0]]},{"it":"Il maestro gli mise Garrone vicino, nello stesso banco.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,14,"il"],[15,19,"mettere"],[20,27,0],[28,34,"vicino"],[36,41,"in"],[42,48,"stesso"],[49,54,"banco"]]},{"it":"Si sono fatti amici.","ja":"","t":[[0,2,"si"],[3,7,"essere"],[8,13,"fare"],[14,19,"amico"]]},{"it":"Nelli s’è affezionato molto a Garrone.","ja":"","t":[[0,5,0],[6,7,"si"],[8,9,"essere"],[10,21,0],[22,27,"molto"],[28,29,"a"],[30,37,0]]},{"it":"Appena entra nella scuola, cerca subito se c’è Garrone.","ja":"","t":[[0,6,"appena"],[7,12,"entrare"],[13,18,"in"],[19,25,"scuola"],[27,32,"cercare"],[33,39,"subito"],[40,42,"se"],[43,44,"ci"],[45,46,"essere"],[47,54,0]]},{"it":"Non va mai via senza dire: — Addio, Garrone.","ja":"","t":[[0,3,"non"],[4,6,"andare"],[7,10,"mai"],[11,14,"via"],[15,20,"senza"],[21,25,"dire"],[29,34,"addio"],[36,43,0]]},{"it":"— E così fa Garrone con lui.","ja":"","t":[[2,3,"e"],[4,8,"così"],[9,11,"fare"],[12,19,0],[20,23,"con"],[24,27,"lui"]]},{"it":"Quando Nelli lascia cascar la penna o un libro sotto il banco, subito, perchè non faccia fatica a chinarsi, Garrone si china e gli porge il libro o la penna; e poi l’aiuta a rimetter la roba nello zaino, e a infilarsi il cappotto.","ja":"","t":[[0,6,"quando"],[7,12,0],[13,19,"lasciare"],[20,26,0],[27,29,"il"],[30,35,"penna"],[36,37,"o"],[38,40,"un"],[41,46,"libro"],[47,52,"sotto"],[53,55,"il"],[56,61,"banco"],[63,69,"subito"],[71,77,"perché"],[78,81,"non"],[82,88,"fare"],[89,95,"fatica"],[96,97,"a"],[98,106,"chinare"],[108,115,0],[116,118,"si"],[119,124,"chinare"],[125,126,"e"],[127,130,"il"],[131,136,"porgere"],[137,139,"il"],[140,145,"libro"],[146,147,"o"],[148,150,"il"],[151,156,"penna"],[158,159,"e"],[160,163,"poi"],[164,165,"il"],[166,171,"aiutare"],[172,173,"a"],[174,182,0],[183
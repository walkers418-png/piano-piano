"],[38,43,"tutto"],[44,50,"quello"],[51,56,"buono"],[57,62,"mamma"],[64,67,"che"],[68,76,"volere"],[77,79,"un"],[80,84,"grande"],[85,89,"bene"],[90,92,"a"],[93,97,"loro"],[98,105,"ragazzo"],[106,107,"e"],[108,111,"non"],[112,114,"li"],[115,122,"perdere"],[123,126,"mai"],[127,128,"di"],[129,135,"occhio"],[137,138,"e"],[139,141,"li"],[142,151,"assistere"],[152,164,"amorosamente"],[165,167,"in"],[168,172,"ogni"],[173,182,"disgrazia"],[184,189,"anche"],[190,196,"quando"],[197,203,"questo"],[204,211,"ragazzo"],[213,216,"per"],[217,219,"il"],[220,224,"loro"],[225,237,0],[238,239,"e"],[240,243,"per"],[244,245,"il"],[246,250,"loro"],[251,258,"cattivo"],[259,269,0],[271,284,"meritare"],[285,287,"di"],[288,294,"essere"],[295,306,"abbandonare"],[307,308,"e"],[309,317,"lasciare"],[318,320,"in"],[321,326,0],[327,328,"a"],[329,331,"sé"],[332,338,"stesso"]]},{"it":"Dicevo, dunque, che la buona Fata, appena mi vide in pericolo di affogare, mandò subito intorno a me un branco infinito di pesci, i quali credendomi davvero un ciuchino bell’e morto, cominciarono a mangiarmi!","ja":"","t":[[0,6,"dire"],[8,14,"dunque"],[16,19,"che"],[20,22,"il"],[23,28,"buono"],[29,33,"fata"],[35,41,"appena"],[42,44,"mi"],[45,49,"vedere"],[50,52,"in"],[53,61,"pericolo"],[62,64,"di"],[65,73,"affogare"],[75,80,"mandare"],[81,87,"subito"],[88,95,"intorno"],[96,97,"a"],[98,100,"me"],[101,103,"un"],[104,110,"branco"],[111,119,"infinito"],[120,122,"di"],[123,128,"pesce"],[130,131,"il"],[132,137,"quale"],[138,148,"credere"],[149,156,"davvero"],[157,159,"un"],[160,168,"ciuchino"],[169,173,"bello"],[174,175,"e"],[176,181,"morire"],[183,195,"cominciare"],[196,197,"a"],[198,207,"mangiare"]]},{"it":"E che bocconi che facevano!","ja":"","t":[[0,1,"e"],[2,5,"che"],[6,13,"boccone"],[14,17,"che"],[18,26,"fare"]]},{"it":"Non avrei mai creduto che i pesci fossero più ghiotti anche dei ragazzi!","ja":"","t":[[0,3,"non"],[4,9,"avere"],[10,13,"mai"],[14,21,"credere"],[22,25,"che"],[26,27,"il"],[28,33,"pesce"],[34,41,"essere"
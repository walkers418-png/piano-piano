 lodava, perchè lo vedeva attento, studioso, intelligente.","ja":"","t":[[0,1,"e"],[2,7,"anche"],[8,10,"il"],[11,18,"maestro"],[19,21,"se"],[22,24,"ne"],[25,31,0],[33,39,"perché"],[40,42,"il"],[43,49,"vedere"],[50,57,"attento"],[59,67,"studioso"],[69,81,"intelligente"]]},{"it":"— Bada, Pinocchio!","ja":"","t":[[2,6,"badare"],[8,17,0]]},{"it":"Quei tuoi compagnacci di scuola finiranno, prima o poi, col farti perdere l’amore allo studio e, forse forse, col tirarti addosso qualche grossa disgrazia.","ja":"","t":[[0,4,"quello"],[5,9,"tuo"],[10,21,0],[22,24,"di"],[25,31,"scuola"],[32,41,"finire"],[43,48,"prima"],[49,50,"o"],[51,54,"poi"],[56,59,"con"],[60,65,"fare"],[66,73,"perdere"],[74,75,"il"],[76,81,"amore"],[82,86,"a"],[87,93,"studio"],[94,95,"e"],[97,102,"forse"],[103,108,"forse"],[110,113,"con"],[114,121,"tirare"],[122,129,"addosso"],[130,137,"qualche"],[138,144,"grosso"],[145,154,"disgrazia"]]},{"it":"― Non c’è pericolo!","ja":"","t":[[2,5,"non"],[6,7,"ci"],[8,9,"essere"],[10,18,"pericolo"]]},{"it":"— rispondeva il burattino, facendo una spallucciata, e toccandosi coll’indice in mezzo alla fronte, come per dire: «C’è tanto giudizio qui dentro!»","ja":"","t":[[2,12,"rispondere"],[13,15,"il"],[16,25,"burattino"],[27,34,"fare"],[35,38,"un"],[39,51,0],[53,54,"e"],[55,65,"toccare"],[66,70,"con"],[71,77,0],[78,80,"in"],[81,86,"mezzo"],[87,91,"a"],[92,98,"fronte"],[100,104,"come"],[105,108,"per"],[109,113,"dire"],[116,117,"ci"],[118,119,"essere"],[120,125,"tanto"],[126,134,"giudizio"],[135,138,"qui"],[139,145,"dentro"]]},{"it":"Ora avvenne che un bel giorno, mentre camminava verso la scuola, incontrò un branco dei soliti compagni, che andandogli incontro, gli dissero:","ja":"","t":[[0,3,"ora"],[4,11,"avvenire"],[12,15,"che"],[16,18,"un"],[19,22,"bello"],[23,29,"giorno"],[31,37,"mentre"],[38,47,"camminare"],[48,53,"verso"],[54,56,"il"],[57,63,"scuola"],[65,73,"incontrare"],[74,76,"un"],[77,83,"branco"],[84,87,"di"],[88,94,"solito"],[95,103,"compagno"],[105,108,"che"],[10
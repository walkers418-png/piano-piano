{"id":"u019","title":"Novembre・I soldati","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"I SOLDATI.","ja":"","t":[[0,1,"il"],[2,9,"soldato"]]},{"it":"22, martedì.","ja":"","t":[[4,11,"martedì"]]},{"it":"Il suo figliuolo era volontario nell’esercito quando morì: per questo il Direttore va sempre sul corso a veder passare i soldati, quando usciamo dalla scuola.","ja":"","t":[[0,2,"il"],[3,6,"suo"],[7,16,"figliuolo"],[17,20,"essere"],[21,31,"volontario"],[32,36,"in"],[37,45,"esercito"],[46,52,"quando"],[53,57,"morire"],[59,62,"per"],[63,69,"questo"],[70,72,"il"],[73,82,"direttore"],[83,85,"andare"],[86,92,"sempre"],[93,96,"su"],[97,102,"corso"],[103,104,"a"],[105,110,"vedere"],[111,118,"passare"],[119,120,"il"],[121,128,"soldato"],[130,136,"quando"],[137,144,"uscire"],[145,150,"da"],[151,157,"scuola"]]},{"it":"Ieri passava un reggimento di fanteria, e cinquanta ragazzi si misero a saltellare intorno alla banda musicale, cantando e battendo il tempo colle righe sugli zaini e sulle cartelle.","ja":"","t":[[0,4,"ieri"],[5,12,"passare"],[13,15,"un"],[16,26,"reggimento"],[27,29,"di"],[30,38,"fanteria"],[40,41,"e"],[42,51,"cinquanta"],[52,59,"ragazzo"],[60,62,"si"],[63,69,"mettere"],[70,71,"a"],[72,82,"saltellare"],[83,90,"intorno"],[91,95,"a"],[96,101,"banda"],[102,110,"musicale"],[112,120,"cantare"],[121,122,"e"],[123,131,"battere"],[132,134,"il"],[135,140,"tempo"],[141,146,"con"],[147,152,"riga"],[153,158,"su"],[159,164,"zaino"],[165,166,"e"],[167,172,"su"],[173,181,"cartella"]]},{"it":"Noi stavamo in un gruppo, sul marciapiede a guardare: Garrone, strizzato nei suoi vestiti troppo stretti, che addentava un gran pezzo di pane; Votini, quello ben vestito, che si leva sempre i peluzzi dai panni; Precossi, il figliolo del fabbro, con la giacchetta di suo padre, e il calabrese, e il “muratorino”, e Crossi con la sua testa rossa, e Franti con la sua faccia tosta, e anche Robetti, il figliuolo del capitano d’artiglieria, quello che salvò un bambino dall’omnibus, e che ora cammina con le stampelle.","ja":"","t":[[0,3,"noi"],[4,11,"stare"],[12,14,"in"],[15,17,"un"],[18,24,"gruppo"],[26,29,"su"],[30,41,"marciapiede"],[42,43,"a"],[44,52,"guardare"],[54,61,0],[63,72,0],[73,76,"in"],[77,81,"suo"],[82,89,"vestito"],[90,96,"troppo"],[97,104,"stretto"],[106,109,"che"],[110,119,0],[120,122,"un"],[123,127,"grande"],[128,133,"pezzo"],[134,136,"di"],[137,141,"pane"],[143,149,0],[151,157,"quello"],[158,161,"bene"],[162,169,"vestito"],[171,174,"che"],[175,177,"si"],[178,182,"levare"],[183,189,"sempre"],[190,191,"il"],[192,199,0],[200,203,"da"],[204,209,"panni"],[211,219,0],[221,223,"il"],[224,232,"figliolo"],[233,236,"di"],[237,243,"fabbro"],[245,248,"con"],[249,251,"il"],[252,262,"giacchetta"],[263,265,"di"],[266,269,"suo"],[270,275,"padre"],[277,278,"e"],[279,281,"il"],[282,291,"calabrese"],[293,294,"e"],[295,297,"il"],[299,309,0],[312,313,"e"],[314,320,0],[321,324,"con"],[325,327,"il"],[328,331,"suo"],[332,337,"testa"],[338,343,"rosso"],[345,346,"e"],[347,353,0],[354,357,"con"],[358,360,"il"],[361,364,"suo"],[365,371,"fare"],[372,377,0],[379,380,"e"],[381,386,"anche"],[387,394,0],[396,398,"il"],[399,408,"figliuolo"],[409,412,"di"],[413,421,"capitano"],[422,423,"di"],[424,435,"artiglieria"],[437,443,"quello"],[444,447,"che"],[448,453,"salvare"],[454,456,"un"],[457,464,"bambino"],[465,469,"da"],[470,477,0],[479,480,"e"],[481,484,"che"],[485,488,"ora"],[489,496,"camminare"],[497,500,"con"],[501,503,"il"],[504,513,"stampella"]]},{"it":"Franti fece una risata in faccia a un soldato che zoppicava.","ja":"","t":[[0,6,0],[7,11,"fare"],[12,15,"un"],[16,22,"risata"],[23,25,"in"],[26,32,"fare"],[33,34,"a"],[35,37,"un"],[38,45,"soldato"],[46,49,"che"],[50,59,"zoppicare"]]},{"it":"Ma subito si sentì la mano d’un uomo sulla spalla: si voltò: era il Direttore.","ja":"","t":[[0,2,"ma"],[3,9,"subito"],[10,12,"si"],[13,18,"sentire"],[19,21,"il"],[22,26,"mano"],[27,28,"di"],[29,31,"un"],[32,36,"uomo"],[37,42,"su"],[43
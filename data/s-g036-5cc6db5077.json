tutto"],[34,36,"in"],[37,41,"coro"]]},{"it":"- È un’anguilla innocente! - ho ripetuto, mettendomi a ridere.","ja":"","t":[[2,3,"essere"],[4,6,"un"],[7,15,"anguilla"],[16,25,"innocente"],[29,31,"avere"],[32,40,"ripetere"],[42,52,"mettere"],[53,54,"a"],[55,61,"ridere"]]},{"it":"Le donne sono proprio sciocche, di buttare all’aria la casa per un’anguilla, che poi mangiano con tanto gusto, quando viene portata a tavola cucinata e condita.","ja":"","t":[[0,2,"il"],[3,8,"donna"],[9,13,"essere"],[14,21,"proprio"],[22,30,"sciocco"],[32,34,"di"],[35,42,"buttare"],[43,46,"a"],[47,51,"aria"],[52,54,"il"],[55,59,"casa"],[60,63,"per"],[64,66,"un"],[67,75,"anguilla"],[77,80,"che"],[81,84,"poi"],[85,93,"mangiare"],[94,97,"con"],[98,103,"tanto"],[104,109,"gusto"],[111,117,"quando"],[118,123,"venire"],[124,131,"portare"],[132,133,"a"],[134,140,"tavola"],[141,149,"cucinare"],[150,151,"e"],[152,159,0]]},{"it":"Mi hanno detto che sono cattivo, per aver fatto spaventare Virginia...","ja":"","t":[[0,2,"mi"],[3,8,"avere"],[9,14,"dire"],[15,18,"che"],[19,23,"essere"],[24,31,"cattivo"],[33,36,"per"],[37,41,"avere"],[42,47,"fare"],[48,58,"spaventare"],[59,67,0]]},{"it":"Si sa; è sempre la medesima storia.","ja":"","t":[[0,2,"si"],[3,5,"sapere"],[7,8,"essere"],[9,15,"sempre"],[16,18,"il"],[19,27,"medesimo"],[28,34,"storia"]]},{"it":"Anche se ho la disgrazia di avere una sorella che non riconosce un’anguilla da una vipera, la colpa dev’essere sempre mia...","ja":"","t":[[0,5,"anche"],[6,8,"se"],[9,11,"avere"],[12,14,"il"],[15,24,"disgrazia"],[25,27,"di"],[28,33,"avere"],[34,37,"un"],[38,45,"sorella"],[46,49,"che"],[50,53,"non"],[54,63,"riconoscere"],[64,66,"un"],[67,75,"anguilla"],[76,78,"da"],[79,82,"un"],[83,89,0],[91,93,"il"],[94,99,"colpa"],[100,103,0],[104,110,"essere"],[111,117,"sempre"],[118,121,"mio"]]}],"q":[],"g":{},"n":243,"w":["a","acchiappare","accorrere","ah","aiuto","allora","altro","anche","anguilla","appena","aria","arrabbiato","avere","avvicinare","balzare","bicicletta","butta
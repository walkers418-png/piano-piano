n"],[119,125,"accusa"],[126,134,"ingiusto"]]},{"it":"E il padre, mentre la gragnuola rinforzava:","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,10,"padre"],[12,18,"mentre"],[19,21,"il"],[22,31,0],[32,42,0]]},{"it":"- Stupido!","ja":"","t":[[2,9,"stupido"]]},{"it":"Rompicollo!","ja":"","t":[[0,10,0]]},{"it":"I ragazzi, non devono impicciarsi nelle cose che non possono capire!","ja":"","t":[[0,1,"il"],[2,9,"ragazzo"],[11,14,"non"],[15,21,"dovere"],[22,33,0],[34,39,"in"],[40,44,"cosa"],[45,48,"che"],[49,52,"non"],[53,60,"potere"],[61,67,"capire"]]},{"it":"Cretino!","ja":"","t":[[0,7,0]]},{"it":"Birbante!","ja":"","t":[[0,8,0]]},{"it":"Sei la rovina di tutta la famiglia!... -","ja":"","t":[[0,3,"essere"],[4,6,"il"],[7,13,"rovina"],[14,16,"di"],[17,22,"tutto"],[23,25,"il"],[26,34,"famiglia"]]},{"it":"E certo il nostro Giannino non poteva capire i misteri della politica per i quali a volte la difesa fatta da un’anima semplice e ingenua può recar più danno di un’offesa lanciata dall’anima più nera e perversa.","ja":"","t":[[0,1,"e"],[2,7,"certo"],[8,10,"il"],[11,17,"nostro"],[18,26,0],[27,30,"non"],[31,37,"potere"],[38,44,"capire"],[45,46,"il"],[47,54,"mistero"],[55,60,"di"],[61,69,"politica"],[70,73,"per"],[74,75,"il"],[76,81,"quale"],[82,83,"a"],[84,89,"volta"],[90,92,"il"],[93,99,"difendere"],[100,105,"fare"],[106,108,"da"],[109,111,"un"],[112,117,"anima"],[118,126,"semplice"],[127,128,"e"],[129,136,"ingenuo"],[137,140,"potere"],[141,146,"recare"],[147,150,"più"],[151,156,"danno"],[157,159,"di"],[160,162,"un"],[163,169,"offendere"],[170,178,"lanciare"],[179,183,"da"],[184,189,"anima"],[190,193,"più"],[194,198,"nero"],[199,200,"e"],[201,209,0]]},{"it":"Il fatto è che la rivelazione ch’egli fece all'Unione Nazionale e che questa fece al pubblico determinò la ribellione contro il Maralli di una frazione del suo stesso partito e i partiti che a quello si erano alleati, e il giorno dell’elezione fu ignominiosamente sconfitto.","ja":"","t":[[0,2,"il"],[3,8,"fare"],[9,10,"essere"],[11,14,"che"],[15,17,"il"],[18,29,"rivelazione"],[30,32,"che"],[33,37,"egli"],[38,42,"fare"],[43,46,"a"],[47,53,"unione"],[54,63,"nazionale"],[64,65,"e"],[66,69,"che"],[70,76,"questo"],[77,81,"fare"],[82,84,"a"],[85,93,"pubblico"],[94,103,"determinare"],[104,106,"il"],[107,117,0],[118,124,"contro"],[125,127,"il"],[128,135,0],[136,138,"di"],[139,142,"un"],[143,151,"frazione"],[152,155,"di"],[156,159,"suo"],[160,166,"stesso"],[167,174,"partire"],[175,176,"e"],[177,178,"il"],[179,186,"partire"],[187,190,"che"],[191,192,"a"],[193,199,"quello"],[200,202,"si"],[203,208,"essere"],[209,216,"alleato"],[218,219,"e"],[220,222,"il"],[223,229,"giorno"],[230,234,"di"],[235,243,"elezione"],[244,246,"essere"],[247,263,0],[264,273,"sconfiggere"]]},{"it":"Ma non basta.","ja":"","t":[[0,2,"ma"],[3,6,"non"],[7,12,"bastare"]]},{"it":"La polemica fra l'Unione Nazionale e il Sole dell’avvenire sì inacerbì al punto che non bastando più tutte le male parole del vocabolario elettorale italiano si passò alle bastonate e un giorno la pasticceria del babbo di Gigino Balestra fu teatro di una zuffa terribile tra moderati e socialisti che si picchiarono di santa ragione, dicendosi le cose più amare su un terreno cosparso delle cose più dolci che si possano immaginare, e riducendosi scambievolmente in uno stato compassionevole e anche appetitoso, col volto ammaccato pieno di bitorzoli e di bioccoli di crema, annerito da ecchimosi e da ditate di cioccolata, gocciolante di sangue e dì alkermes...","ja":"","t":[[0,2,"il"],[3,11,"polemica"],[12,15,"fra"],[16,17,"il"],[18,24,"unione"],[25,34,"nazionale"],[35,36,"e"],[37,39,"il"],[40,44,"sole"],[45,49,"di"],[50,58,"avvenire"],[59,61,"sì"],[62,70,0],[71,73,"a"],[74,79,"punto"],[80,83,"che"],[84,87,"non"],[88,96,"bastare"],[97,100,"più"],[101,106,"tutto"],[107,109,"il"],[110,114,"male"],[115,121,"parola"],[122,125,"di"],[126,137,"vocabolario"],[138,148,0],[149,157,"italiano"],[158,160,"si"],[161,166,"passare"],[167,171,"a"],[172,181,0],[182,183,"e"],[184,186,
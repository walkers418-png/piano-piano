{"id":"u065","title":"Marzo・Litigio","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"LITIGIO","ja":"","t":[[0,7,0]]},{"it":"20, lunedì","ja":"","t":[[4,10,"lunedì"]]},{"it":"Eppure, no, non fu per invidia ch’egli abbia avuto il premio ed io no, che mi bisticciai con Coretti questa mattina.","ja":"","t":[[0,6,"eppure"],[8,10,"no"],[12,15,"non"],[16,18,"essere"],[19,22,"per"],[23,30,"invidia"],[31,33,"che"],[34,38,"egli"],[39,44,"avere"],[45,50,"avere"],[51,53,"il"],[54,60,"premio"],[61,63,"e"],[64,66,"io"],[67,69,"no"],[71,74,"che"],[75,77,"mi"],[78,88,0],[89,92,"con"],[93,100,0],[101,107,"questo"],[108,115,"mattina"]]},{"it":"Non fu per invidia.","ja":"","t":[[0,3,"non"],[4,6,"essere"],[7,10,"per"],[11,18,"invidia"]]},{"it":"Ma ebbi torto.","ja":"","t":[[0,2,"ma"],[3,7,"avere"],[8,13,"torto"]]},{"it":"Il maestro l’aveva messo accanto a me, io scrivevo sul mio quaderno di calligrafia: egli mi urtò col gomito e mi fece fare uno sgorbio e macchiare anche il racconto mensile, Sangue romagnolo, che dovevo copiare per il “muratorino„ che è malato.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,12,"il"],[13,18,"avere"],[19,24,"mettere"],[25,32,"accanto"],[33,34,"a"],[35,37,"me"],[39,41,"io"],[42,50,"scrivere"],[51,54,"su"],[55,58,"mio"],[59,67,"quaderno"],[68,70,"di"],[71,82,0],[84,88,"egli"],[89,91,"mi"],[92,96,0],[97,100,"con"],[101,107,"gomito"],[108,109,"e"],[110,112,"mi"],[113,117,"fare"],[118,122,"fare"],[123,126,"un"],[127,134,0],[135,136,"e"],[137,146,0],[147,152,"anche"],[153,155,"il"],[156,164,"racconto"],[165,172,"mensile"],[174,180,"sangue"],[181,190,"romagnolo"],[192,195,"che"],[196,202,"dovere"],[203,210,0],[211,214,"per"],[215,217,"il"],[219,229,0],[231,234,"che"],[235,236,"essere"],[237,243,"malato"]]},{"it":"Io m’arrabbiai e gli dissi una parolaccia.","ja":"","t":[[0,2,"io"],[3,4,"mi"],[5,14,"arrabbiarsi"],[15,16,"e"],[17,20,"il"],[21,26,"dire"],[27,30,"un"],[31,41,0]]},{"it":"Egli mi rispose sorridendo: — 
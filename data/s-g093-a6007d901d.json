ere"],[138,140,"un"],[141,152,"pasticciere"],[154,156,"ma"],[157,158,"essere"],[159,161,"il"],[162,168,"grande"],[169,177,0],[178,181,"di"],[182,185,"suo"],[186,193,"partire"],[194,195,"e"],[196,200,"dire"],[201,204,"che"],[205,207,"dire"],[208,213,0],[214,215,"o"],[216,218,"di"],[219,224,0],[225,231,"questo"],[232,237,"volta"],[238,240,"il"],[241,249,"collegio"],[250,254,"dovere"],[255,261,"essere"],[262,273,"conquistare"],[274,277,"da"],[278,288,"socialista"],[289,290,"e"],[291,294,"che"],[295,296,"essere"],[297,300,"già"],[301,307,"sicuro"],[308,313,"di"],[314,322,"vittoria"]]},{"it":"Per questo ha messo fuori un giornaletto intitolato Il sole dell’avvenire che è in grande polemica con l'Unione Nazionale che sostiene lo zio di Cecchino.","ja":"","t":[[0,3,"per"],[4,10,"questo"],[11,13,"avere"],[14,19,"mettere"],[20,25,"fuori"],[26,28,"un"],[29,40,0],[41,51,"intitolare"],[52,54,"il"],[55,59,"sole"],[60,64,"di"],[65,73,"avvenire"],[74,77,"che"],[78,79,"essere"],[80,82,"in"],[83,89,"grande"],[90,98,"polemica"],[99,102,"con"],[103,104,"il"],[105,111,"unione"],[112,121,"nazionale"],[122,125,"che"],[126,134,"sostenere"],[135,137,"il"],[138,141,"zio"],[142,144,"di"],[145,153,0]]},{"it":"Gigino Balestra mi ha fatto vedere questi giornali e mi ha detto:","ja":"","t":[[0,6,0],[7,15,0],[16,18,"mi"],[19,21,"avere"],[22,27,"fare"],[28,34,"vedere"],[35,41,"questo"],[42,50,"giornale"],[51,52,"e"],[53,55,"mi"],[56,58,"avere"],[59,64,"dire"]]},{"it":"- Il babbo ora non ripara a dar retta a tutte le commissioni, ed è sempre occupato a scrivere nel giornale...","ja":"","t":[[2,4,"il"],[5,10,"babbo"],[11,14,"ora"],[15,18,"non"],[19,25,"riparare"],[26,27,"a"],[28,31,"dare"],[32,37,"retta"],[38,39,"a"],[40,45,"tutto"],[46,48,"il"],[49,60,"commissione"],[62,64,"e"],[65,66,"essere"],[67,73,"sempre"],[74,82,"occupare"],[83,84,"a"],[85,93,"scrivere"],[94,97,"in"],[98,106,"giornale"]]},{"it":"Domani siamo sicuri che in bottega non viene.","ja":"","t":[[0,6,"domani"],[7,12,"essere"],[13,19,
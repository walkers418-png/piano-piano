{"id":"g062","title":"4 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Stamani Collalto aveva scritto al mio babbo una lettera col pepe e col sale (come ha detto lui) informandolo di tutte le mie birbanterie (son sempre sue parole) e pregandolo di venirmi subito a riprendere; ma poi la lettera non è stata più impostata e anzi mio cognato ha smesso il broncio e mi ha detto sorridendo:","ja":"","t":[[0,7,"stamani"],[8,16,0],[17,22,"avere"],[23,30,"scrivere"],[31,33,"a"],[34,37,"mio"],[38,43,"babbo"],[44,47,"un"],[48,55,"lettera"],[56,59,"con"],[60,64,"pepe"],[65,66,"e"],[67,70,"con"],[71,75,"sale"],[77,81,"come"],[82,84,"avere"],[85,90,"dire"],[91,94,"lui"],[96,108,"informare"],[109,111,"di"],[112,117,"tutto"],[118,120,"il"],[121,124,"mio"],[125,136,0],[138,141,"essere"],[142,148,"sempre"],[149,152,"suo"],[153,159,"parola"],[161,162,"e"],[163,173,"pregare"],[174,176,"di"],[177,184,"venire"],[185,191,"subito"],[192,193,"a"],[194,204,"riprendere"],[206,208,"ma"],[209,212,"poi"],[213,215,"il"],[216,223,"lettera"],[224,227,"non"],[228,229,"essere"],[230,235,"essere"],[236,239,"più"],[240,249,0],[250,251,"e"],[252,256,"anzi"],[257,260,"mio"],[261,268,"cognato"],[269,271,"avere"],[272,278,"smettere"],[279,281,"il"],[282,289,0],[290,291,"e"],[292,294,"mi"],[295,297,"avere"],[298,303,"dire"],[304,314,"sorridere"]]},{"it":"- Via per questa volta ci passeremo sopra, anche per non dare un dispiacere ai tuoi genitori...","ja":"","t":[[2,5,"via"],[6,9,"per"],[10,16,"questo"],[17,22,"volta"],[23,25,"ci"],[26,35,"passare"],[36,41,"sopra"],[43,48,"anche"],[49,52,"per"],[53,56,"non"],[57,61,"dare"],[62,64,"un"],[65,75,"dispiacere"],[76,78,"a"],[79,83,"tuo"],[84,92,"genitore"]]},{"it":"Ma bada bene!","ja":"","t":[[0,2,"ma"],[3,7,"badare"],[8,12,"bene"]]},{"it":"La lettera rimane qui nel cassetto del mio scrittoio, e alla prima che mi fai ancora, io l’aggiungo alle altre e le spedisco tutte insieme a tuo padre...","ja":"","t":[[0,2,"il"],[3,10,"lettera"],[11,17,"rimanere"],[18,21,"qui"],[22,25,"in"],[26,34,"cassetto"],[35,38,"di"],[39,42,"mio"],[43,52,0],[54,55,"e"],[56,60,"a"],[61,66,"prima"],[67,70,"che"],[71,73,"mi"],[74,77,"fare"],[78,84,"ancora"],[86,88,"io"],[89,90,"il"],[91,99,"aggiungere"],[100,104,"a"],[105,110,"altro"],[111,112,"e"],[113,115,"il"],[116,124,"spedire"],[125,130,"tutto"],[131,138,"insieme"],[139,140,"a"],[141,144,"tuo"],[145,150,"padre"]]},{"it":"Règolati!","ja":"","t":[[0,8,0]]},{"it":"Il curioso è che questo cambiamento di scena è avvenuto in seguito a un’altra mia birbanteria - per dir come dice Collalto - ma che pare abbia fatto molto piacere a mio cognato.","ja":"","t":[[0,2,"il"],[3,10,"curioso"],[11,12,"essere"],[13,16,"che"],[17,23,"questo"],[24,35,"cambiamento"],[36,38,"di"],[39,44,"scena"],[45,46,"essere"],[47,55,"avvenire"],[56,58,"in"],[59,66,"seguire"],[67,68,"a"],[69,71,"un"],[72,77,"altro"],[78,81,"mio"],[82,93,0],[96,99,"per"],[100,103,"dire"],[104,108,"come"],[109,113,"dire"],[114,122,0],[125,127,"ma"],[128,131,"che"],[132,136,"parere"],[137,142,"avere"],[143,148,"fare"],[149,154,"molto"],[155,162,"piacere"],[163,164,"a"],[165,168,"mio"],[169,176,"cognato"]]},{"it":"Ed ecco come sta il fatto.","ja":"","t":[[0,2,"e"],[3,7,"ecco"],[8,12,"come"],[13,16,"stare"],[17,19,"il"],[20,25,"fare"]]},{"it":"Oggi, alla solita ora, cioè quando si era a colazione, è venuta la marchesa Sterzi, quella che fa la cura per non parlar più col naso.","ja":"","t":[[0,4,"oggi"],[6,10,"a"],[11,17,"solito"],[18,21,"ora"],[23,27,"cioè"],[28,34,"quando"],[35,37,"si"],[38,41,"essere"],[42,43,"a"],[44,53,"colazione"],[55,56,"essere"],[57,63,"venire"],[64,66,"il"],[67,75,"marchesa"],[76,82,0],[84,90,"quello"],[91,94,"che"],[95,97,"fare"],[98,100,"il"],[101,105,"cura"],[106,109,"per"],[110,113,"non"],[114,120,"parlare"],[121,124,"più"],[125,128,"con"],[129,133,"naso"]]},{"it":"Io allora ho pensato, che, giacché il Collalto aveva scritto al babbo (allora credevo che avesse già impostata la lettera), potevo pigliarmi qualche altro divertimento senza pregiudicare di più la mia situazione: e còlto il momento propizio sono andato di corsa nella sala delle consultazioni.","ja":"","t":[[0,2,"io"],[3,9,"allora"],[10,12,"avere"],[13,20,"pensare"],[22,25,"che"],[27,34,"giacché"],[35,37,"il"],[38,46,0],[47,52,"avere"],[53,60,"scrivere"],[61,63,"a"],[64,69,"babbo"],[71,77,"allora"],[78,85,"credere"],[86,89,"che"],[90,96,"avere"],[97,100,"già"],[101,110,0],[111,113,"il"],[114,121,"lettera"],[124,130,"potere"],[131,140,"pigliare"],[141,148,"qualche"],[149,154,"altro"],[155,167,"divertimento"],[168,173,"senza"],[174,186,0],[187,189,"di"],[190,193,"più"],[194,196,"il"],[197,200,"mio"],[201,211,"situazione"],[213,214,"e"],[215,220,0],[221,223,"il"],[224,231,"momento"],[232,240,0],[241,245,"essere"],[246,252,"andare"],[253,255,"di"],[256,261,"corsa"],[262,267,"in"],[268,272,"sala"],[273,278,"di"],[279,292,0]]},{"it":"La marchesa stava seduta in una poltrona voltando le spalle verso la porta per la quale ero entrato io.","ja":"","t":[[0,2,"il"],[3,11,"marchesa"],[12,17,"stare"],[18,24,"sedere"],[25,27,"in"],[28,31,"un"],[32,40,"poltrona"],[41,49,"voltare"],[50,52,"il"],[53,59,"spalla"],[60,65,"verso"],[66,68,"il"],[69,74,"porta"],[75,78,"per"],[79,81,"il"],[82,87,"quale"],[88,91,"essere"],[92,99,"entrare"],[100,102,"io"]]},{"it":"Mi sono avvicinato piano piano alla poltrona, e, quando le sono stato proprio dietro, mi son chinato perché non mi vedesse e ho gridato:","ja":"","t":[[0,2,"mi"],[3,7,"essere"],[8,18,"avvicinare"],[19,24,"piano"],[25,30,"piano"],[31,35,"a"],[36,44,"poltrona"],[46,47,"e"],[49,55,"quando"],[56,58,"il"],[59,63,"essere"],[64,69,"essere"],[70,77,"proprio"],[78,84,"dietro"],[86,88,"mi"],[89,92,"essere"],[93,100,"chinare"],[101,107,"perché"],[108,111,"non"],[112,114,"mi"],[115,122,"vedere"],[123,124,"e"],[125,127,"avere"],[128,135,"gridare"]]},{"it":"- Maramèo...!","ja":"","t":[[2,9,0]]},{"it":"La marchesa ha fatt
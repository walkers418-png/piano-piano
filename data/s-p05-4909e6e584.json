ante aveva ragione!","ja":"","t":[[2,8,"eppure"],[9,11,"il"],[12,18,"grillo"],[19,27,"parlare"],[28,33,"avere"],[34,41,"ragione"]]},{"it":"Se non fossi scappato di casa e se il mio babbo fosse qui, ora non mi troverei a morire di fame.","ja":"","t":[[0,2,"se"],[3,6,"non"],[7,12,"essere"],[13,21,"scappare"],[22,24,"di"],[25,29,"casa"],[30,31,"e"],[32,34,"se"],[35,37,"il"],[38,41,"mio"],[42,47,"babbo"],[48,53,"essere"],[54,57,"qui"],[59,62,"ora"],[63,66,"non"],[67,69,"mi"],[70,78,"trovare"],[79,80,"a"],[81,87,"morire"],[88,90,"di"],[91,95,"fame"]]},{"it":"Eh! che brutta malattia che è la fame!...","ja":"","t":[[0,2,0],[4,7,"che"],[8,14,"brutto"],[15,23,"malattia"],[24,27,"che"],[28,29,"essere"],[30,32,"il"],[33,37,"fame"]]},{"it":"—","ja":"","t":[]},{"it":"E perchè il corpo gli seguitava a brontolare più che mai, e non sapeva come fare a chetarlo, pensò di uscir di casa e di dare una scappata al paesello vicino, nella speranza di trovare qualche persona caritatevole, che gli facesse l’elemosina di un po’ di pane.","ja":"","t":[[0,1,"e"],[2,8,"perché"],[9,11,"il"],[12,17,"corpo"],[18,21,"il"],[22,31,"seguitare"],[32,33,"a"],[34,44,"brontolare"],[45,48,"più"],[49,52,"che"],[53,56,"mai"],[58,59,"e"],[60,63,"non"],[64,70,"sapere"],[71,75,"come"],[76,80,"fare"],[81,82,"a"],[83,91,0],[93,98,"pensare"],[99,101,"di"],[102,107,"uscire"],[108,110,"di"],[111,115,"casa"],[116,117,"e"],[118,120,"dire"],[121,125,"dare"],[126,129,"un"],[130,138,"scappare"],[139,141,"a"],[142,150,0],[151,157,"vicino"],[159,164,"in"],[165,173,"speranza"],[174,176,"di"],[177,184,"trovare"],[185,192,"qualche"],[193,200,"persona"],[201,213,0],[215,218,"che"],[219,222,"il"],[223,230,"fare"],[231,232,"il"],[233,242,"elemosina"],[243,245,"di"],[246,248,"un"],[249,251,"poco"],[253,255,"di"],[256,260,"pane"]]}],"q":[{"skill":"match","s":"卵を割ると何が起きた？","o":["ひよこが飛び出した","金が出た","腐っていた"],"why":"卵の中のひよこがお礼を言って飛んでいきます。"},{"skill":"infer","s":"この章でピノッキオが気づき始めたことは？","o":["コオロギの言ったことは正しかった","卵はおいしくない","家が広すぎる"],"why":"
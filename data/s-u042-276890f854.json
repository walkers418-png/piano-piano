estro faceva lezione, si mise a scrivere a grossi caratteri sopra un foglietto: — Io non sono invidioso di quelli che guadagnano la prima medaglia con le protezioni e le ingiustizie.","ja":"","t":[[0,3,"poi"],[5,11,"mentre"],[12,14,"il"],[15,22,"maestro"],[23,29,"fare"],[30,37,"lezione"],[39,41,"si"],[42,46,"mettere"],[47,48,"a"],[49,57,"scrivere"],[58,59,"a"],[60,66,"grosso"],[67,76,"carattere"],[77,82,"sopra"],[83,85,"un"],[86,95,"foglietto"],[99,101,"io"],[102,105,"non"],[106,110,"essere"],[111,120,0],[121,123,"di"],[124,130,"quello"],[131,134,"che"],[135,145,"guadagnare"],[146,148,"il"],[149,154,"prima"],[155,163,"medaglia"],[164,167,"con"],[168,170,"il"],[171,181,"protezione"],[182,183,"e"],[184,186,"il"],[187,198,"ingiustizia"]]},{"it":"— Era un biglietto che voleva mandare a Derossi.","ja":"","t":[[2,5,"essere"],[6,8,"un"],[9,18,"biglietto"],[19,22,"che"],[23,29,"volere"],[30,37,"mandare"],[38,39,"a"],[40,47,0]]},{"it":"Ma intanto vedevo che i vicini di Derossi macchinavano fra loro, parlandosi all’orecchio, e uno ritagliava col temperino una gran medaglia di carta, su cui avevan disegnato un serpe nero.","ja":"","t":[[0,2,"ma"],[3,10,"intanto"],[11,17,"vedere"],[18,21,"che"],[22,23,"il"],[24,30,"vicino"],[31,33,"di"],[34,41,0],[42,54,0],[55,58,"fra"],[59,63,"loro"],[65,75,"parlare"],[76,79,"a"],[80,88,"orecchio"],[90,91,"e"],[92,95,"un"],[96,106,"ritagliare"],[107,110,"con"],[111,120,"temperino"],[121,124,"un"],[125,129,"grande"],[130,138,"medaglia"],[139,141,"di"],[142,147,"carta"],[149,151,"su"],[152,155,"cui"],[156,162,"avere"],[163,172,"disegnare"],[173,175,"un"],[176,181,"serpe"],[182,186,"nero"]]},{"it":"E Votini pure se ne accorse.","ja":"","t":[[0,1,"e"],[2,8,0],[9,13,"pure"],[14,16,"se"],[17,19,"ne"],[20,27,"accorgersi"]]},{"it":"Il maestro uscì per pochi minuti.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,15,"uscire"],[16,19,"per"],[20,25,"poco"],[26,32,"minuto"]]},{"it":"Subito i vicini di Derossi s’alzarono per uscir dal banco e venire a presen
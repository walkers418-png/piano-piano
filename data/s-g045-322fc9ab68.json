"],[53,56,"non"],[57,59,"mi"],[60,67,"venire"],[68,70,"da"],[71,77,"ridere"],[79,82,"in"],[83,92,"ripensare"],[93,97,"a"],[98,104,"fare"],[105,108,"di"],[109,116,0],[117,123,"quando"],[124,125,"essere"],[126,135,"scoppiare"],[136,138,"il"],[139,143,"gola"],[144,147,"di"],[148,158,0]]},{"it":"Com’era buffo, con quel barbone che gli tremava tutto dalla paura!","ja":"","t":[[0,3,"come"],[4,7,"essere"],[8,13,"buffo"],[15,18,"con"],[19,23,"quello"],[24,31,"barbone"],[32,35,"che"],[36,39,"il"],[40,47,"tremare"],[48,53,"tutto"],[54,59,"da"],[60,65,"paura"]]},{"it":"Il disastro è stato grande; ed è inutile dire che la causa sono stato io, perché io sono la disperazione dei miei genitori e la rovina della casa... per quanto, alla fin dei conti, la rovina si riduca a una sola stanza e precisamente al salotto di ricevimento.","ja":"","t":[[0,2,"il"],[3,11,"disastro"],[12,13,"essere"],[14,19,"essere"],[20,26,"grande"],[28,30,"e"],[31,32,"essere"],[33,40,"inutile"],[41,45,"dire"],[46,49,"che"],[50,52,"il"],[53,58,"causa"],[59,63,"essere"],[64,69,"essere"],[70,72,"io"],[74,80,"perché"],[81,83,"io"],[84,88,"essere"],[89,91,"il"],[92,104,"disperazione"],[105,108,"di"],[109,113,"mio"],[114,122,"genitore"],[123,124,"e"],[125,127,"il"],[128,134,"rovina"],[135,140,"di"],[141,145,"casa"],[149,152,"per"],[153,159,"quanto"],[161,165,"a"],[166,169,"fino"],[170,173,"di"],[174,179,"conto"],[181,183,"il"],[184,190,"rovina"],[191,193,"si"],[194,200,"ridurre"],[201,202,"a"],[203,206,"un"],[207,211,"solo"],[212,218,"stanza"],[219,220,"e"],[221,233,"precisamente"],[234,236,"a"],[237,244,"salotto"],[245,247,"di"],[248,259,0]]},{"it":"Ecco dunque com’è andato il fatto.","ja":"","t":[[0,4,"ecco"],[5,11,"dunque"],[12,15,"come"],[16,17,"essere"],[18,24,"andare"],[25,27,"il"],[28,33,"fare"]]},{"it":"Quando il Maralli, mia sorella, il babbo, la mamma e tutti gli altri son tornati dal Municipio faceva un gran freddo, ragione per cui uno degli invitati, entrando nella sala da pranzo, ha detto:","ja":"","t":[[0,6,"quando"],[7,9,"il"],[10,17,0],[19,22,"mio"],[23,30,"sorella"],[32,34,"il"],[35,40,"babbo"],[42,44,"il"],[45,50,"mamma"],[51,52,"e"],[53,58,"tutto"],[59,62,"il"],[63,68,"altro"],[69,72,"essere"],[73,80,"tornare"],[81,84,"da"],[85,94,"municipio"],[95,101,"fare"],[102,104,"un"],[105,109,"grande"],[110,116,"freddo"],[118,125,"ragione"],[126,129,"per"],[130,133,"cui"],[134,137,"un"],[138,143,"di"],[144,152,"invitare"],[154,162,"entrare"],[163,168,"in"],[169,173,"sala"],[174,176,"da"],[177,183,"pranzo"],[185,187,"avere"],[188,193,"dire"]]},{"it":"- Siamo tutti intirizziti; se ci date anche il rinfresco, moriremo qui assiderati!","ja":"","t":[[2,7,"essere"],[8,13,"tutto"],[14,25,0],[27,29,"se"],[30,32,"ci"],[33,37,"dare"],[38,43,"anche"],[44,46,"il"],[47,56,0],[58,66,"morire"],[67,70,"qui"],[71,81,0]]},{"it":"Allora Virginia e l’avvocato Maralli hanno chiamato subito Caterina e le han fatto accendere il caminetto nella sala da ricevere.","ja":"","t":[[0,6,"allora"],[7,15,0],[16,17,"e"],[18,19,"il"],[20,28,"avvocato"],[29,36,0],[37,42,"avere"],[43,51,"chiamare"],[52,58,"subito"],[59,67,0],[68,69,"e"],[70,72,"il"],[73,76,"avere"],[77,82,"fare"],[83,92,"accendere"],[93,95,"il"],[96,105,"caminetto"],[106,111,"in"],[112,116,"sala"],[117,119,"da"],[120,128,"ricevere"]]},{"it":"La Caterina, poveretta, ha obbedito e...","ja":"","t":[[0,2,"il"],[3,11,0],[13,22,0],[24,26,"avere"],[27,35,0],[36,37,"e"]]},{"it":"Dio, che bomba!","ja":"","t":[[0,3,"Dio"],[5,8,"che"],[9,14,"bomba"]]},{"it":"È parsa proprio una bomba; e poi lì per lì, tra la polvere, sotto la pioggia dei calcinacci che schizzavano qua e là si è creduto che rovinasse tutta la casa.","ja":"","t":[[0,1,"essere"],[2,7,"parere"],[8,15,"proprio"],[16,19,"un"],[20,25,"bomba"],[27,28,"e"],[29,32,"poi"],[33,35,"lì"],[36,39,"per"],[40,42,"lì"],[44,47,"tra"],[48,50,"il"],[51,58,"polvere"],[60,65,"sotto"],[66,68,"il"],[69,76,"pioggia"],[77,80,"di"],[81,91,0],[92,95,"che"],[96,107,"schizzare"],[108,111,"qua"],[112,113,"e"],[
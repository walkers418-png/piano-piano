"mattina"],[177,183,"quando"],[184,186,"si"],[187,195,"disporre"],[196,197,"a"],[198,208,0],[209,211,"il"],[212,215,"suo"],[216,222,"famoso"],[223,231,"minestra"],[232,236,"a"],[237,246,"casalinga"]]},{"it":"- Ma allora farà un’altra minestra!","ja":"","t":[[2,4,"ma"],[5,11,"allora"],[12,16,"fare"],[17,19,"un"],[20,25,"altro"],[26,34,"minestra"]]},{"it":"- Sicuro: e, dovendo rimediare alla svelta, farà una minestra di riso...","ja":"","t":[[2,8,"sicuro"],[10,11,"e"],[13,20,"dovere"],[21,30,"rimediare"],[31,35,"a"],[36,42,"svelto"],[44,48,"fare"],[49,52,"un"],[53,61,"minestra"],[62,64,"di"],[65,69,"riso2"]]},{"it":"Ebbene: se venerdì non ci sarà la tradizionale minestra di magro alla casalinga, vorrà dire... che questa era proprio fatta col brodo della rigovernatura, e allora noi insorgeremo. -","ja":"","t":[[0,6,"avere"],[8,10,"se"],[11,18,"venerdì"],[19,22,"non"],[23,25,"ci"],[26,30,"essere"],[31,33,"il"],[34,46,"tradizionale"],[47,55,"minestra"],[56,58,"di"],[59,64,"magro"],[65,69,"a"],[70,79,"casalinga"],[81,86,"volere"],[87,91,"dire"],[95,98,"che"],[99,105,"questo"],[106,109,"essere"],[110,117,"proprio"],[118,123,"fare"],[124,127,"con"],[128,133,"brodo"],[134,139,"di"],[140,153,0],[155,156,"e"],[157,163,"allora"],[164,167,"noi"],[168,179,0]]},{"it":"Che ingegno ha il Barozzo!","ja":"","t":[[0,3,"che"],[4,11,"ingegno"],[12,14,"avere"],[15,17,"il"],[18,25,0]]},{"it":"Egli prevede tutto e sa rispondere a tutto, sempre...","ja":"","t":[[0,4,"egli"],[5,12,"prevedere"],[13,18,"tutto"],[19,20,"e"],[21,23,"sapere"],[24,34,"rispondere"],[35,36,"a"],[37,42,"tutto"],[44,50,"sempre"]]},{"it":"Ora, giornalino mio, ti rimetto a posto e...","ja":"","t":[[0,3,"ora"],[5,15,0],[16,19,"mio"],[21,23,"ti"],[24,31,"rimettere"],[32,33,"a"],[34,39,"posto"],[40,41,"e"]]},{"it":"E poi lo sai che cosa fo?","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,8,"il"],[9,12,"sapere"],[13,16,"che"],[17,21,"cosa"],[22,24,"fare"]]},{"it":"Ho qui uno scalpello che ho preso oggi nell’ora di ricreazione giù nel cortile, mentre il muratore che viene da qualche giorno a far dei lavori era uscito...","ja":"","t":[[0,2,"avere"],[3,6,"qui"],[7,10,"un"],[11,20,"scalpello"],[21,24,"che"],[25,27,"avere"],[28,33,"prendere"],[34,38,"oggi"],[39,43,"in"],[44,47,"ora"],[48,50,"di"],[51,62,"ricreazione"],[63,66,"giù"],[67,70,"in"],[71,78,"cortile"],[80,86,"mentre"],[87,89,"il"],[90,98,"muratore"],[99,102,"che"],[103,108,"venire"],[109,111,"da"],[112,119,"qualche"],[120,126,"giorno"],[127,128,"a"],[129,132,"fare"],[133,136,"di"],[137,143,"lavoro"],[144,147,"essere"],[148,154,"uscire"]]},{"it":"E con questo scalpello voglio incominciare piano piano a fare un buco nella parete in fondo all’armadino per vedere di dove vengono le voci che sentii l’altra sera.","ja":"","t":[[0,1,"e"],[2,5,"con"],[6,12,"questo"],[13,22,"scalpello"],[23,29,"volere"],[30,42,"incominciare"],[43,48,"piano"],[49,54,"piano"],[55,56,"a"],[57,61,"fare"],[62,64,"un"],[65,69,"buco"],[70,75,"in"],[76,82,"parete"],[83,85,"in"],[86,91,"fondo"],[92,95,"a"],[96,104,0],[105,108,"per"],[109,115,"vedere"],[116,118,"di"],[119,123,"dove"],[124,131,"venire"],[132,134,"il"],[135,139,"voce"],[140,143,"che"],[144,150,"sentire"],[151,152,"il"],[153,158,"altro"],[159,163,"sera"]]},{"it":"I miei compagni dormono: ora spengo il lume e mi ficco dentro l’armadietto a lavorare...","ja":"","t":[[0,1,"il"],[2,6,"mio"],[7,15,"compagno"],[16,23,"dormire"],[25,28,"ora"],[29,35,"spegnere"],[36,38,"il"],[39,43,"lume"],[44,45,"e"],[46,48,"mi"],[49,54,"ficcare"],[55,61,"dentro"],[62,63,"il"],[64,74,"armadietto"],[75,76,"a"],[77,85,"lavorare"]]}],"q":[],"g":{},"n":412,"w":["Dio","a","accorgersi","affatto","allora","altro","ammettere","anche","andare","appunto","armadietto","aumentare","avere","bastare","bisognare","brodo","buco","capire","casalinga","cena","che","ci","ciascuno","cioè","colore","colorire","come","compagno","con","cortile","cosa","così","credere","cucina","cuoco","da","dentro","di","dieci","dire","disporre","distribuire","domenica","d
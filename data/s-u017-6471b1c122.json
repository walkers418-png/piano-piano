,[171,177,"numero"],[178,179,"e"],[180,182,"il"],[183,190,"persona"]]},{"it":"E poi, buttando giù la legna e accatastandola: — secondo il tempo.... secondo il tempo a cui si riferisce l’azione....","ja":"","t":[[0,1,"e"],[2,5,"poi"],[7,15,"buttare"],[16,19,"giù"],[20,22,"il"],[23,28,"legna"],[29,30,"e"],[31,45,0],[49,56,"secondo"],[57,59,"il"],[60,65,"tempo"],[70,77,"secondo"],[78,80,"il"],[81,86,"tempo"],[87,88,"a"],[89,92,"cui"],[93,95,"si"],[96,105,"riferire"],[106,107,"il"],[108,114,"azione"]]},{"it":"E tornando verso il carro a prendere un’altra bracciata: — secondo il modo in cui l’azione è enunciata.","ja":"","t":[[0,1,"e"],[2,10,"tornare"],[11,16,"verso"],[17,19,"il"],[20,25,"carro"],[26,27,"a"],[28,36,"prendere"],[37,39,"un"],[40,45,"altro"],[46,55,0],[59,66,"secondo"],[67,69,"il"],[70,74,"modo"],[75,77,"in"],[78,81,"cui"],[82,83,"il"],[84,90,"azione"],[91,92,"essere"],[93,102,0]]},{"it":"Era la nostra lezione di grammatica per il giorno dopo.","ja":"","t":[[0,3,"essere"],[4,6,"il"],[7,13,"nostro"],[14,21,"lezione"],[22,24,"di"],[25,35,"grammatica"],[36,39,"per"],[40,42,"il"],[43,49,"giorno"],[50,54,"dopo"]]},{"it":"— Che vuoi?","ja":"","t":[[2,5,"che"],[6,10,"volere"]]},{"it":"— mi disse, — metto il tempo a profitto.","ja":"","t":[[2,4,"mi"],[5,10,"dire"],[14,19,"mettere"],[20,22,"il"],[23,28,"tempo"],[29,30,"a"],[31,39,0]]},{"it":"Mio padre è andato via col garzone per una faccenda.","ja":"","t":[[0,3,"mio"],[4,9,"padre"],[10,11,"essere"],[12,18,"andare"],[19,22,"via"],[23,26,"con"],[27,34,"garzone"],[35,38,"per"],[39,42,"un"],[43,51,"faccenda"]]},{"it":"Mia madre è malata.","ja":"","t":[[0,3,"mio"],[4,9,"madre"],[10,11,"essere"],[12,18,"malato"]]},{"it":"Tocca a me a scaricare.","ja":"","t":[[0,5,"toccare"],[6,7,"a"],[8,10,"me"],[11,12,"a"],[13,22,"scaricare"]]},{"it":"Intanto ripasso la grammatica.","ja":"","t":[[0,7,"intanto"],[8,15,"ripassare"],[16,18,"il"],[19,29,"grammatica"]]},{"it":"È una lezione difficile oggi.","ja":"","t":[[0,1,"essere"],[2,5,"
{"id":"u050","title":"Febbraio・Il prigioniero","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL PRIGIONIERO","ja":"","t":[[0,2,"il"],[3,14,"prigioniero"]]},{"it":"17, venerdì","ja":"","t":[[4,11,"venerdì"]]},{"it":"Ah! questo è certamente il caso più strano di tutto l’anno!","ja":"","t":[[0,2,"ah"],[4,10,"questo"],[11,12,"essere"],[13,23,"certamente"],[24,26,"il"],[27,31,"caso"],[32,35,"più"],[36,42,"strano"],[43,45,"di"],[46,51,"tutto"],[52,53,"il"],[54,58,"anno"]]},{"it":"Mio padre mi condusse ieri mattina nei dintorni di Moncalieri, a vedere una villa da prendere a pigione per l’estate prossima, perchè quest’anno non andiamo più a Chieri; e si trovò che chi aveva le chiavi era un maestro, il quale fa da segretario al padrone.","ja":"","t":[[0,3,"mio"],[4,9,"padre"],[10,12,"mi"],[13,21,"condurre"],[22,26,"ieri"],[27,34,"mattina"],[35,38,"in"],[39,47,"dintorni"],[48,50,"di"],[51,61,0],[63,64,"a"],[65,71,"vedere"],[72,75,"un"],[76,81,"villa"],[82,84,"da"],[85,93,"prendere"],[94,95,"a"],[96,103,0],[104,107,"per"],[108,109,"il"],[110,116,"estate"],[117,125,"prossimo"],[127,133,"perché"],[134,139,"questo"],[140,144,"anno"],[145,148,"non"],[149,156,"andare"],[157,160,"più"],[161,162,"a"],[163,169,0],[171,172,"e"],[173,175,"si"],[176,181,"trovare"],[182,185,"che"],[186,189,"chi"],[190,195,"avere"],[196,198,"il"],[199,205,"chiave"],[206,209,"essere"],[210,212,"un"],[213,220,"maestro"],[222,224,"il"],[225,230,"quale"],[231,233,"fare"],[234,236,"da"],[237,247,"segretario"],[248,250,"a"],[251,258,"padrone"]]},{"it":"Egli ci fece vedere la casa, e poi ci condusse nella sua camera, dove ci diede da bere.","ja":"","t":[[0,4,"egli"],[5,7,"ci"],[8,12,"fare"],[13,19,"vedere"],[20,22,"il"],[23,27,"casa"],[29,30,"e"],[31,34,"poi"],[35,37,"ci"],[38,46,"condurre"],[47,52,"in"],[53,56,"suo"],[57,63,"camera"],[65,69,"dove"],[70,72,"ci"],[73,78,"dare"],[79,81,"da"],[82,86,"bere"]]},{"it":"C’era sul tavolino, in mezzo ai bicchieri, un calamaio di legno, di forma conica, scolpito in una maniera singolare.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,9,"su"],[10,18,"tavolino"],[20,22,"in"],[23,28,"mezzo"],[29,31,"a"],[32,41,"bicchiere"],[43,45,"un"],[46,54,"calamaio"],[55,57,"di"],[58,63,"legno"],[65,67,"di"],[68,73,"forma"],[74,80,0],[82,90,0],[91,93,"in"],[94,97,"un"],[98,105,"maniera"],[106,115,"singolare"]]},{"it":"Vedendo che mio padre lo guardava, il maestro gli disse: — Quel calamaio lì mi è prezioso: se sapesse, signore, la storia di quel calamaio!","ja":"","t":[[0,7,"vedere"],[8,11,"che"],[12,15,"mio"],[16,21,"padre"],[22,24,"il"],[25,33,"guardare"],[35,37,"il"],[38,45,"maestro"],[46,49,"il"],[50,55,"dire"],[59,63,"quello"],[64,72,"calamaio"],[73,75,"lì"],[76,78,"mi"],[79,80,"essere"],[81,89,"prezioso"],[91,93,"se"],[94,101,"sapere"],[103,110,"signore"],[112,114,"il"],[115,121,"storia"],[122,124,"di"],[125,129,"quello"],[130,138,"calamaio"]]},{"it":"— E la raccontò.","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,15,"raccontare"]]},{"it":"Anni sono, egli era maestro a Torino, e andò per tutto un inverno a far lezione ai prigionieri, nelle Carceri giudiziarie.","ja":"","t":[[0,4,"anno"],[5,9,"essere"],[11,15,"egli"],[16,19,"essere"],[20,27,"maestro"],[28,29,"a"],[30,36,0],[38,39,"e"],[40,44,"andare"],[45,48,"per"],[49,54,"tutto"],[55,57,"un"],[58,65,"inverno"],[66,67,"a"],[68,71,"fare"],[72,79,"lezione"],[80,82,"a"],[83,94,"prigioniero"],[96,101,"in"],[102,109,"carcere"],[110,121,0]]},{"it":"Faceva lezione nella chiesa delle carceri, che è un edificio rotondo, e tutt’intorno, nel muri alti e nudi, ci son tanti finestrini quadrati, chiusi da due sbarre di ferro incrociate, a ciascuno dei quali corrisponde di dentro una piccolissima cella.","ja":"","t":[[0,6,"fare"],[7,14,"lezione"],[15,20,"in"],[21,27,"chiesa"],[28,33,"di"],[34,41,"carcere"],[43,46,"che"],[47,48,"essere"],[49,51,"un"],[52,60,"edificio"],[61,68,"rotondo"],[70,71,"e"],[72,76,"tutto"],[77,84,"intorno"],[86,89,"in"],[90,94,"muro"],[95,99,"alto"],[100,101,"e"],[102,106,"nudo"],[108,110,"ci"],[111,114,"essere"],[115,120,"tanto"],[121,131,"finestrino"],[132,140,"quadrato"],[142,148,"chiudere"],[149,151,"da"],[152,155,"due"],[156,162,"sbarra"],[163,165,"di"],[166,171,"ferro"],[172,182,0],[184,185,"a"],[186,194,"ciascuno"],[195,198,"di"],[199,204,"quale"],[205,216,"corrispondere"],[217,219,"di"],[220,226,"dentro"],[227,230,"un"],[231,243,"piccolo"],[244,249,0]]},{"it":"Egli faceva lezione passeggiando per la chiesa fredda e buia, e i suoi scolari stavano affacciati a quelle buche, coi quaderni contro le inferriate, non mostrando altro che i visi nell’ombra, dei visi sparuti e accigliati, delle barbe arruffate e grigie, degli occhi fissi d’omicidi e di ladri.","ja":"","t":[[0,4,"egli"],[5,11,"fare"],[12,19,"lezione"],[20,32,"passeggiare"],[33,36,"per"],[37,39,"il"],[40,46,"chiesa"],[47,53,"freddo"],[54,55,"e"],[56,60,"buio"],[62,63,"e"],[64,65,"il"],[66,70,"suo"],[71,78,"scolaro"],[79,86,"stare"],[87,97,"affacciare"],[98,99,"a"],[100,106,"quello"],[107,112,"buca"],[114,117,"con"],[118,126,"quaderno"],[127,133,"contro"],[134,136,"il"],[137,147,0],[149,152,"non"],[153,162,"mostrare"],[163,168,"altro"],[169,172,"che"],[173,174,"il"],[175,179,"viso"],[180,184,"in"],[185,190,"ombra"],[192,195,"di"],[196,200,"viso"],[201,208,0],[209,210,"e"],[211,221,0],[223,228,"di"],[229,234,"barba"],[235,244,"arruffare"],[245,246,"e"],[247,253,"grigio"],[255,260,"di"],[261,266,"occhio"],[267,272,"fisso"],[273,274,"di"],[275,282,"omicidio"],[283,284,"e"],[285,287,"dire"],[288,293,"ladro"]]},{"it":"Ce n’era uno, fra gli altri, al numero 78, che stava più attento di tutti, e studiava molto, e guardava il maestro con gli occhi pieni di rispetto e di gratitudine.","ja":"","t":[[0,2,"ce"],[3,4,0],[5,8,"essere"],[9,12,"un"],[14,17,"fra"],[18,21,"il"],[22,27,"altro"],[29,31,"a"],[32,38,"numero"],[43,46,"che"],[47,52,"stare"],[53,56,"più"],[57,64,"attento"],[65,67,"di"],[68,73,"tutto"],[75,76,"e"],[77,85,"studiare"],[86,91,"molto"],[93,94,"e"],[95,103,"guardare"],[104,106,"il"],[107,114,"maestro"],[115,118,"con"],[119,122,"il"],[123,128,"occhio"],[129,134,"pieno"],[135,137,"di"],[138,146,"rispetto"],[147,148,"e"],[149,151,"dire"],[152,163,"gratitudine"]]},{"it":"Era un giovane con la barba nera, più disgraziato che malvagio, un ebanista, il quale, in un impeto di collera, aveva scagliato una pialla contro il suo padrone, che da un pezzo lo perseguitava, e l’aveva ferito mortalmente al capo; e per questo era stato condannato a vari anni di reclusione.","ja":"","t":[[0,3,"essere"],[4,6,"un"],[7,14,"giovane"],[15,18,"con"],[19,21,"il"],[22,27,"barba"],[28,32,"nero"],[34,37,"più"],[38,49,"disgraziato"],[50,53,"che"],[54,62,"malvagio"],[64,66,"un"],[67,75,0],[77,79,"il"],[80,85,"quale"],[87,89,"in"],[90,92,"un"],[93,99,"impeto"],[100,102,"di"],[103,110,"collera"],[112,117,"avere"],[118,127,"scagliare"],[128,131,"un"],[132,138,"pialla"],[139,145,"contro"],[146,148,"il"],[149,152,"suo"],[153,160,"padrone"],[162,165,"che"],[166,168,"da"],[169,171,"un"],[172,177,"pezzo"],[178,180,"il"],[181,193,"perseguitare"],[195,196,"e"],[197,198,"il"],[199,204,"avere"],[205,211,"ferire"],[212,223,0],[224,226,"a"],[227,231,"capo"],[233,234,"e"],[235,238,"per"],[239,245,"questo"],[246,249,"essere"],[250,255,"essere"],[256,266,"condannare"],[267,268,"a"],[269,273,"vario"],[274,278,"anno"],[279,281,"di"],[282,292,0]]},{"it":"In tre mesi egli aveva imparato a leggere e a scrivere, e leggeva continuamente, e quanto più imparava, tanto più pareva che diventasse buono e che fosse pentito del suo delitto.","ja":"","t":[[0,2,"in"],[3,6,"tre"],[7,11,"mese"],[12,16,"egli"],[17,22,"avere"],[23,31,"imparare"],[32,33,"a"],[34,41,"leggere"],[42,43,"e"],[44,45,"a"],[46,54,"scrivere"],[56,57,"e"],[58,65,"leggere"],[66,79,"continuamente"],[81,82,"e"],[83,89,"quanto"],[90,93,"più"],[94,102,"imparare"],[104,109,"tanto"],[110,113,"più"],[114,120,"parere"],[121,124,"che"],[125,135,"diventare"],[136,141,"buono"],[142,143,"e"],[144,147,"che"],[148,153,"essere"],[154,161,"pentirsi"],[162,165,"di"],[166,169,"suo"],[170,177,"delitto"]]},{"it":"Un giorno, sul finire della lezione, egli fece cenno al maestro che s’avvicinasse al finestrino, e gli annunziò, con tristezza, che la mattina dopo sarebbe partito da Torino, per andare a scontare la sua pena nelle carceri di Venezia; e dettogli addio, lo pregò con voce umile e commossa che si lasciasse toccare la mano.","ja":"","t":[[0,2,"un"],[3,9,"giorno"],[11,14,"su"],[15,21,"finire"],[22,27,"di"],[28,35,"lezione"],[37,41,"egli"],[42,46,"fare"],[47,52,"cenno"],[53,55,"a"],[56,63,"maestro"],[64,67,"che"],[68,69,"si"],[70,81,"avvicinare"],[82,84,"a"],[85,95,"finestrino"],[97,98,"e"],[99,102,"il"],[103,111,0],[113,116,"con"],[117,126,"tristezza"],[128,131,"che"],[132,134,"il"],[135,142,"mattina"],[143,147,"dopo"],[148,155,"essere"],[156,163,"partire"],[164,166,"da"],[167,173,0],[175,178,"per"],[179,185,"andare"],[186,187,"a"],[188,196,0],[197,199,"il"],[200,203,"suo"],[204,208,"pena"],[209,214,"in"],[215,222,"carcere"],[223,225,"di"],[226,233,0],[235,236,"e"],[237,245,"dire"],[246,251,"addio"],[253,255,"il"],[256,261,"pregare"],[262,265,"con"],[266,270,"voce"],[271,276,0],[277,278,"e"],[279,287,"commosso"],[288,291,"che"],[292,294,"si"],[295,304,"lasciare"],[305,312,"toccare"],[313,315,"il"],[316,320,"mano"]]},{"it":"Il maestro gli porse la mano, ed egli la baciò; poi disse: — Grazie!","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,14,"il"],[15,20,"porgere"],[21,23,"il"],[24,28,"mano"],[30,32,"e"],[33,37,"egli"],[38,40,"il"],[41,46,"baciare"],[48,51,"poi"],[52,57,"dire"],[61,67,"grazie"]]},{"it":"Grazie!","ja":"","t":[[0,6,"grazie"]]},{"it":"— e disparve.","ja":"","t":[[2,3,"e"],[4,12,"disparire"]]},{"it":"Il maestro ritirò la mano: era bagnata di lacrime.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,17,"ritirare"],[18,20,"il"],[21,25,"mano"],[27,30,"essere"],[31,38,"bagnare"],[39,41,"di"],[42,49,"lacrima"]]},{"it":"Dopo d’allora non lo vide più.","ja":"","t":[[0,4,"d
{"id":"a033","title":"Chi non ha coraggio non vada alla guerra・X","lv":8,"kind":"童話","note":"Carlo Collodi「Storie allegre」（1887年）の原文です。古い語や綴りがあります。","lines":[{"it":"X.","ja":"","t":[[0,1,0]]},{"it":"Intanto i cinque cugini, appena alzati da letto, domandarono subito di Leoncino: ma Leoncino non c’era.","ja":"","t":[[0,7,"intanto"],[8,9,"il"],[10,16,"cinque"],[17,23,"cugino"],[25,31,"appena"],[32,38,"alzare"],[39,41,"da"],[42,47,"letto"],[49,60,"domandare"],[61,67,"subito"],[68,70,"di"],[71,79,0],[81,83,"ma"],[84,92,0],[93,96,"non"],[97,98,"ci"],[99,102,"essere"]]},{"it":"Aspettarono un quarto d’ora, mezz’ora, un’ora, e Leoncino non tornava: e già cominciavano a mettersi in pensiero, quand’ecco che finalmente Leoncino tornò.","ja":"","t":[[0,11,"aspettare"],[12,14,"un"],[15,21,"quarto"],[22,23,"di"],[24,27,"ora"],[29,33,"mezzo"],[34,37,"ora"],[39,41,"un"],[42,45,"ora"],[47,48,"e"],[49,57,0],[58,61,"non"],[62,69,"tornare"],[71,72,"e"],[73,76,"già"],[77,89,"cominciare"],[90,91,"a"],[92,100,"mettere"],[101,103,"in"],[104,112,"pensiero"],[114,119,"quando"],[120,124,"ecco"],[125,128,"che"],[129,139,"finalmente"],[140,148,0],[149,154,"tornare"]]},{"it":"― Dove sei stato finora?","ja":"","t":[[2,6,"dove"],[7,10,"essere"],[11,16,"essere"],[17,23,"finora"]]},{"it":"― gli domandarono tutti insieme.","ja":"","t":[[2,5,"il"],[6,17,"domandare"],[18,23,"tutto"],[24,31,"insieme"]]},{"it":"― Sono andato a fare un giro per questi dintorni; e sapete perchè?","ja":"","t":[[2,6,"essere"],[7,13,"andare"],[14,15,"a"],[16,20,"fare"],[21,23,"un"],[24,28,"girare"],[29,32,"per"],[33,39,"questo"],[40,48,"dintorni"],[50,51,"e"],[52,58,"sapere"],[59,65,"perché"]]},{"it":"Per vedere se avevo la fortuna d’incontrare la volpe.","ja":"","t":[[0,3,"per"],[4,10,"vedere"],[11,13,"se"],[14,19,"avere"],[20,22,"il"],[23,30,"fortuna"],[31,32,"di"],[33,43,"incontrare"],[44,46,"il"],[47,52,"volpe"]]},{"it":"― La volpe non c’è più: è sparita da un pezzo ― disse Raffaello.","ja":"","t":[[2,4,"il"],[5,10,"volpe"],[11,14,"non"],[15,16,"ci"],[17,18,"essere"],[19,22,"più"],[24,25,"essere"],[26,33,"sparire"],[34,36,"da"],[37,39,"un"],[40,45,"pezzo"],[48,53,"dire"],[54,63,0]]},{"it":"― Come lo sai?","ja":"","t":[[2,6,"come"],[7,9,"il"],[10,13,"sapere"]]},{"it":"― Sono cinque giorni che non s’è fatta più rivedere, e tutte le galline hanno già ripreso a dormire i loro sonni tranquilli.","ja":"","t":[[2,6,"essere"],[7,13,"cinque"],[14,20,"giorno"],[21,24,"che"],[25,28,"non"],[29,30,"si"],[31,32,"essere"],[33,38,"fare"],[39,42,"più"],[43,51,"rivedere"],[53,54,"e"],[55,60,"tutto"],[61,63,"il"],[64,71,"gallina"],[72,77,"avere"],[78,81,"già"],[82,89,"riprendere"],[90,91,"a"],[92,99,"dormire"],[100,101,"il"],[102,106,"loro"],[107,112,"sonno"],[113,123,"tranquillo"]]},{"it":"― E se la incontravi davvero?","ja":"","t":[[2,3,"e"],[4,6,"se"],[7,9,"il"],[10,20,"incontrare"],[21,28,"davvero"]]},{"it":"― disse Arnolfo.","ja":"","t":[[2,7,"dire"],[8,15,0]]},{"it":"― Se la incontravo? tanto peggio per lei.","ja":"","t":[[2,4,"se"],[5,7,"il"],[8,18,"incontrare"],[20,25,"tanto"],[26,32,"peggio"],[33,36,"per"],[37,40,"lei"]]},{"it":"Che avete paura, voialtri, della volpe?","ja":"","t":[[0,3,"che"],[4,9,"avere"],[10,15,"paura"],[17,25,0],[27,32,"di"],[33,38,"volpe"]]},{"it":"― Noi, sì: dopo che abbiamo visto quelle povere galline sbranate e poi lasciate per i campi....","ja":"","t":[[2,5,"noi"],[7,9,"sì"],[11,15,"dopo"],[16,19,"che"],[20,27,"avere"],[28,33,"vedere"],[34,40,"quello"],[41,47,"povero"],[48,55,"gallina"],[56,64,0],[65,66,"e"],[67,70,"poi"],[71,79,"lasciare"],[80,83,"per"],[84,85,"il"],[86,91,"campo"]]},{"it":"― A me poi, ― disse Leoncino ― la volpe non mi fa paura.","ja":"","t":[[2,3,"a"],[4,6,"me"],[7,10,"poi"],[14,19,"dire"],[20,28,0],[31,33,"il"],[34,39,"volpe"],[40,43,"non"],[44,46,"mi"],[47,49,"fare"],[50,55,"paura"]]},{"it":"― Guarda un po’ quanto coraggio hai messo fuori tutt’a un tratto: o chi te l’ha prestato?","ja":"","t":[[2,8,"guardare"],[9,11,"un"],[12,14,"poco"],[16,22,"quanto"],[23,31,"coraggio"],[32,35,"avere"],[36,41,"mettere"],[42,47,"fuori"],[48,52,"tutto"],[53,54,"a"],[55,57,"un"],[58,64,"tratto"],[66,67,"o"],[68,71,"chi"],[72,74,"te"],[75,76,"il"],[77,79,"avere"],[80,88,"prestare"]]},{"it":"― disse Arnolfo ridendo.","ja":"","t":[[2,7,"dire"],[8,15,0],[16,23,"ridere"]]},{"it":"― Arnolfo, non ricominciare!... se no, ci guastiamo davvero.","ja":"","t":[[2,9,0],[11,14,"non"],[15,27,"ricominciare"],[32,34,"se"],[35,37,"no"],[39,41,"ci"],[42,51,"guastare"],[52,59,"davvero"]]},{"it":"Dunque si va o non si va?","ja":"","t":[[0,6,"dunque"],[7,9,"si"],[10,12,"andare"],[13,14,"o"],[15,18,"non"],[19,21,"si"],[22,24,"andare"]]},{"it":"― Dove?","ja":"","t":[[2,6,"dove"]]},{"it":"― A far la nostra passeggiata militare e il solito rancio.","ja":"","t":[[2,3,"a"],[4,7,"fare"],[8,10,"il"],[11,17,"nostro"],[18,29,"passeggiata"],[30,38,"militare"],[39,40,"e"],[41,43,"il"],[44,50,"solito"],[51,57,0]]},{"it":"― Eccoci pronti!","ja":"","t":[[2,8,0],[9,15,"pronto"]]},{"it":"― Però, come vostro caporale, voglio che oggi il rancio si debba fare lì, al principio del bosco, dov’è quella foltissima macchia, che si chiama.... aiutatemi a dirlo.","ja":"","t":[[2,6,"però"],[8,12,"come"],[13,19,"vostro"],[20,28,"caporale"],[30,36,"volere"],[37,40,"che"],[41,45,"oggi"],[46,48,"il"],[49,55,0],[56,58,"si"],[59,64,"dovere"],[65,69,"fare"],[70,72,"lì"],[74,76,"a"],[77,86,"principio"],[87,90,"di"],[91,96,"bosco"],[98,101,"dove"],[102,103,"essere"],[104,110,"quello"],[111,121,0],[122,129,"macchia"],[131,134,"che"],[135,137,"si"],[138,144,"chiamare"],[149,158,"aiutare"],[159,160,"a"],[161,166,"dire"]]},{"it":"― La macchia di Tentennino ― urlarono i cinque ragazzi.","ja":"","t":[[2,4,"il"],[5,12,"macchia"],[13,15,"di"],[16,26,0],[29,37,"urlare"],[38,39,"il"],[40,46,"cinque"],[47,54,"ragazzo"]]},{"it":"― Bravi! la macchia di Tentennino.","ja":"","t":[[2,7,"bravo"],[9,11,"il"],[12,19,"macchia"],[20,22,"di"],[23,33,0]]},{"it":"Dunque sacco in spalla, e via!","ja":"","t":[[0,6,"dunque"],[7,12,"sacco"],[13,15,"in"],[16,22,"spalla"],[24,25,"e"],[26,29,"via"]]},{"it":"―","ja":"","t":[]},{"it":"Dopo venti minuti di marcia forzata erano già arrivati in vicinanza della macchia, quando, tutt’a un tratto, il caporal Leoncino, fermandosi e voltandosi ai soldati, gridò loro con voce sommessa:","ja":"","t":[[0,4,"dopo"],[5,10,"venti"],[11,17,"minuto"],[18,20,"di"],[21,27,"marcia"],[28,35,0],[36,41,"essere"],[42,45,"già"],[46,54,"arrivare"],[55,57,"in"],[58,67,"vicinanza"],[68,73,"di"],[74,81,"macchia"],[83,89,"quando"],[91,95,"tutto"],[96,97,"a"],[98,100,"un"],[101,107,"tratto"],[109,111,"il"],[112,119,0],[120,128,0],[130,140,"fermare"],[141,142,"e"],[143,153,"voltare"],[154,156,"a"],[157,164,"soldato"],[166,171,"gridare"],[172,176,"loro"],[177,180,"con"],[181,185,"voce"],[186,194,0]]},{"it":"― Alto! e fermi tutti!...","ja":"","t":[[2,6,"alto"],[8,9,"e"],[10,15,"fermare"],[16,21,"tutto"]]},{"it":"― Che cos’è stato?...","ja":"","t":[[2,5,"che"],[6,9,"cosa"],[10,11,"essere"],[12,17,"essere"]]},{"it":"― Guardate là, fra le frasche della macchia non lo vedete quel brutto muso, che sbuca fuori?","ja":"","t":[[2,10,"guardare"],[11,13,"là"],[15,18,"fra"],[19,21,"il"],[22,29,0],[30,35,"di"],[36,43,"macchia"],[44,47,"non"],[48,50,"il"],[51,57,"vedere"],[58,62,"quello"],[63,69,"brutto"],[70,74,"muso"],[76,79,"che"],[80,85,0],[86,91,"fuori"]]},{"it":"― Altro se lo vediamo!","ja":"","t":[[2,7,"altro"],[8,10,"se"],[11,13,"il"],[14,21,"vedere"]]},{"it":"Quella è una volpe!...","ja":"","t":[[0,6,"quello"],[7,8,"essere"],[9,12,"un"],[13,18,"volpe"]]},{"it":"― È una volpe davvero!","ja":"","t":[[2,3,"essere"],[4,7,"un"],[8,13,"volpe"],[14,21,"davvero"]]},{"it":"― Per me, torno subito indietro ― disse Arnolfo impaurito.","ja":"","t":[[2,5,"per"],[6,8,"me"],[10,15,"tornare"],[16,22,"subito"],[23,31,"indietro"],[34,39,"dire"],[40,47,0],[48,57,"impaurito"]]},{"it":"― Anche noi, anche noi!","ja":"","t":[[2,7,"anche"],[8,11,"noi"],[13,18,"anche"],[19,22,"noi"]]},{
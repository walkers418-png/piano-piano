a"],[97,100,"voi"]]},{"it":"Cadde bocconi a terra e coprendo di mille baci quel marmo mortuario, dètte in un grande scoppio di pianto.","ja":"","t":[[0,5,"cadere"],[6,13,"boccone"],[14,15,"a"],[16,21,"terra"],[22,23,"e"],[24,32,"coprire"],[33,35,"di"],[36,41,"mille"],[42,46,"baciare"],[47,51,"quello"],[52,57,"marmo"],[58,67,0],[69,74,"dare"],[75,77,"in"],[78,80,"un"],[81,87,"grande"],[88,95,"scoppiare"],[96,98,"di"],[99,105,"pianto"]]},{"it":"Pianse tutta la notte, e la mattina dopo, sul far del giorno, piangeva sempre, sebbene negli occhi non avesse più lacrime: e le sue grida e i suoi lamenti erano così strazianti ed acuti, che tutte le colline all’intorno ne ripetevano l’eco.","ja":"","t":[[0,6,"piangere"],[7,12,"tutto"],[13,15,"il"],[16,21,"notte"],[23,24,"e"],[25,27,"il"],[28,35,"mattina"],[36,40,"dopo"],[42,45,"su"],[46,49,"fare"],[50,53,"di"],[54,60,"giorno"],[62,70,"piangere"],[71,77,"sempre"],[79,86,"sebbene"],[87,92,"in"],[93,98,"occhio"],[99,102,"non"],[103,109,"avere"],[110,113,"più"],[114,121,"lacrima"],[123,124,"e"],[125,127,"il"],[128,131,"suo"],[132,137,"gridare"],[138,139,"e"],[140,141,"il"],[142,146,"suo"],[147,154,"lamentarsi"],[155,160,"essere"],[161,165,"così"],[166,176,0],[177,179,"e"],[180,185,"acuto"],[187,190,"che"],[191,196,"tutto"],[197,199,"il"],[200,207,"collina"],[208,211,"a"],[212,219,"intorno"],[220,222,"ne"],[223,233,"ripetere"],[234,235,"il"],[236,239,"eco"]]},{"it":"E piangendo diceva:","ja":"","t":[[0,1,"e"],[2,11,"piangere"],[12,18,"dire"]]},{"it":"«O Fatina mia, perchè sei morta?... perchè, invece di te, non sono morto io, che sono tanto cattivo, mentre tu eri tanto buona?...","ja":"","t":[[1,2,"o"],[3,9,"fatina"],[10,13,"mio"],[15,21,"perché"],[22,25,"essere"],[26,31,"morire"],[36,42,"perché"],[44,50,"invece"],[51,53,"di"],[54,56,"te"],[58,61,"non"],[62,66,"essere"],[67,72,"morire"],[73,75,"io"],[77,80,"che"],[81,85,"essere"],[86,91,"tanto"],[92,99,"cattivo"],[101,107,"mentre"],[108,110,"tu"],[111,114,"essere"],[115,120,"tanto"],[121,126,"buono"]]},{"it":"E il mio babbo dove sarà?","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,8,"mio"],[9,14,"babbo"],[15,19,"dove"],[20,24,"essere"]]},{"it":"O Fatina mia, dimmi dove posso trovarlo, chè voglio stare sempre con lui, e non lasciarlo più! più! più!...","ja":"","t":[[0,1,"o"],[2,8,"fatina"],[9,12,"mio"],[14,19,"dire"],[20,24,"dove"],[25,30,"potere"],[31,39,"trovare"],[41,44,"che"],[45,51,"volere"],[52,57,"stare"],[58,64,"sempre"],[65,68,"con"],[69,72,"lui"],[74,75,"e"],[76,79,"non"],[80,89,"lasciare"],[90,93,"più"],[95,98,"più"],[100,103,"più"]]},{"it":"O Fatina mia, dimmi che  non è vero che sei morta!…","ja":"","t":[[0,1,"o"],[2,8,"fatina"],[9,12,"mio"],[14,19,"dire"],[20,23,"che"],[25,28,"non"],[29,30,"essere"],[31,35,"vero"],[36,39,"che"],[40,43,"essere"],[44,49,"morire"]]},{"it":"Se davvero mi vuoi bene… se vuoi bene al tuo fratellino, rivivisci… ritorna viva come prima!","ja":"","t":[[0,2,"se"],[3,10,"davvero"],[11,13,"mi"],[14,18,"volere"],[19,23,"bene"],[25,27,"se"],[28,32,"volere"],[33,37,"bene"],[38,40,"a"],[41,44,"tuo"],[45,55,"fratellino"],[57,66,0],[68,75,"ritornare"],[76,80,"vivere"],[81,85,"come"],[86,91,"prima"]]},{"it":"Non ti dispiace a vedermi solo, abbandonato da tutti?…","ja":"","t":[[0,3,"non"],[4,6,"ti"],[7,15,"dispiacere"],[16,17,"a"],[18,25,"vedere"],[26,30,"solo"],[32,43,"abbandonare"],[44,46,"da"],[47,52,"tutto"]]},{"it":"Se arrivano gli assassini, mi attaccheranno daccapo al ramo","ja":"","t":[[0,2,"se"],[3,11,"arrivare"],[12,15,"il"],[16,25,"assassino"],[27,29,"mi"],[30,43,"attaccare"],[44,51,"daccapo"],[52,54,"a"],[55,59,"ramo"]]},{"it":"― O fatina mia perchè sei morta?","ja":"","t":[[2,3,"o"],[4,10,"fatina"],[11,14,"mio"],[15,21,"perché"],[22,25,"essere"],[26,31,"morire"]]},{"it":"dell’albero… e allora morirò per sempre.","ja":"","t":[[0,4,"di"],[5,11,"albero"],[13,14,"e"],[15,21,"allora"],[22,28,"morire"],[29,32,"per"],[33,39,"sempre"]]},{"it":"Che vuoi che io faccia qui solo in questo mondo?","ja":"","t":[[0,3,"che"],[4,
i?","ja":"","t":[[2,6,"dove"],[7,10,"andare"]]},{"it":"— Lontano, lontano, lontano!","ja":"","t":[[2,9,"lontano"],[11,18,"lontano"],[20,27,"lontano"]]},{"it":"— E io che son venuto a cercarti a casa tre volte!...","ja":"","t":[[2,3,"e"],[4,6,"io"],[7,10,"che"],[11,14,"essere"],[15,21,"venire"],[22,23,"a"],[24,32,"cercare"],[33,34,"a"],[35,39,"casa"],[40,43,"tre"],[44,49,"volta"]]},{"it":"— Che cosa volevi da me?","ja":"","t":[[2,5,"che"],[6,10,"cosa"],[11,17,"volere"],[18,20,"da"],[21,23,"me"]]},{"it":"— Non sai il grande avvenimento?","ja":"","t":[[2,5,"non"],[6,9,"sapere"],[10,12,"il"],[13,19,"grande"],[20,31,0]]},{"it":"Non sai la fortuna che mi è toccata?","ja":"","t":[[0,3,"non"],[4,7,"sapere"],[8,10,"il"],[11,18,"fortuna"],[19,22,"che"],[23,25,"mi"],[26,27,"essere"],[28,35,"toccare"]]},{"it":"— Quale?","ja":"","t":[[2,7,"quale"]]},{"it":"— Domani finisco di essere un burattino e divento un ragazzo come te, e come tutti gli altri.","ja":"","t":[[2,8,"domani"],[9,16,"finire"],[17,19,"di"],[20,26,"essere"],[27,29,"un"],[30,39,"burattino"],[40,41,"e"],[42,49,"diventare"],[50,52,"un"],[53,60,"ragazzo"],[61,65,"come"],[66,68,"te"],[70,71,"e"],[72,76,"come"],[77,82,"tutto"],[83,86,"il"],[87,92,"altro"]]},{"it":"— Buon pro ti faccia.","ja":"","t":[[2,6,"buono"],[7,10,0],[11,13,"ti"],[14,20,"fare"]]},{"it":"— Domani dunque ti aspetto a colazione a casa mia.","ja":"","t":[[2,8,"domani"],[9,15,"dunque"],[16,18,"ti"],[19,26,"aspettare"],[27,28,"a"],[29,38,"colazione"],[39,40,"a"],[41,45,"casa"],[46,49,"mio"]]},{"it":"— Ma se ti dico che parto questa sera.","ja":"","t":[[2,4,"ma"],[5,7,"se"],[8,10,"ti"],[11,15,"dire"],[16,19,"che"],[20,25,"partire"],[26,32,"questo"],[33,37,"sera"]]},{"it":"— A che ora?","ja":"","t":[[2,3,"a"],[4,7,"che"],[8,11,"ora"]]},{"it":"— Fra poco.","ja":"","t":[[2,5,"fra"],[6,10,"poco"]]},{"it":"— E dove vai?","ja":"","t":[[2,3,"e"],[4,8,"dove"],[9,12,"andare"]]},{"it":"— Vado ad abitare in un paese.... che è il più bel paese di questo mondo: una vera cuccagna!...","ja":"","t":[[2,6,"andare"],[7,9,"a"],[10,17,"abitare"],[18,20,"in"],[21,23,"un"],[24,29,"paese"],[34,37,"che"],[38,39,"essere"],[40,42,"il"],[43,46,"più"],[47,50,"bello"],[51,56,"paese"],[57,59,"di"],[60,66,"questo"],[67,72,"mondo"],[74,77,"un"],[78,82,"vero"],[83,91,0]]},{"it":"— E come si chiama?","ja":"","t":[[2,3,"e"],[4,8,"come"],[9,11,"si"],[12,18,"chiamare"]]},{"it":"— Si chiama il «Paese dei Balocchi.","ja":"","t":[[2,4,"si"],[5,11,"chiamare"],[12,14,"il"],[16,21,"paese"],[22,25,"di"],[26,34,"balocco"]]},{"it":"Perchè non vieni anche tu?","ja":"","t":[[0,6,"perché"],[7,10,"non"],[11,16,"venire"],[17,22,"anche"],[23,25,"tu"]]},{"it":"— Io? no davvero!","ja":"","t":[[2,4,"io"],[6,8,"no"],[9,16,"davvero"]]},{"it":"— Hai torto, Pinocchio!","ja":"","t":[[2,5,"avere"],[6,11,"torto"],[13,22,0]]},{"it":"Credilo a me, che se non vieni, te ne pentirai.","ja":"","t":[[0,7,"credere"],[8,9,"a"],[10,12,"me"],[14,17,"che"],[18,20,"se"],[21,24,"non"],[25,30,"venire"],[32,34,"te"],[35,37,"ne"],[38,46,"pentirsi"]]},{"it":"Dove vuoi trovare un paese più sano per noialtri ragazzi?","ja":"","t":[[0,4,"dove"],[5,9,"volere"],[10,17,"trovare"],[18,20,"un"],[21,26,"paese"],[27,30,"più"],[31,35,"sano"],[36,39,"per"],[40,48,0],[49,56,"ragazzo"]]},{"it":"Lì non vi sono scuole: lì non vi sono maestri; lì non vi sono libri.","ja":"","t":[[0,2,"lì"],[3,6,"non"],[7,9,"vi"],[10,14,"essere"],[15,21,"scuola"],[23,25,"lì"],[26,29,"non"],[30,32,"vi"],[33,37,"essere"],[38,45,"maestro"],[47,49,"lì"],[50,53,"non"],[54,56,"vi"],[57,61,"essere"],[62,67,"libro"]]},{"it":"In quel paese benedetto non si studia mai.","ja":"","t":[[0,2,"in"],[3,7,"quello"],[8,13,"paese"],[14,23,"benedetto"],[24,27,"non"],[28,30,"si"],[31,37,"studiare"],[38,41,"mai"]]},{"it":"Il giovedì non si fa scuola: e ogni settimana è composta di sei giovedì e di una domenica.","ja":"","t":[[0,2,"il"],[3,10,"giovedì"],[11,14,"non"],[15,17,"si"],[18,20,"fare"],[21,27,"scuola"],[29,30,"e"],[31,35,"ogni"],[36,45,"setti
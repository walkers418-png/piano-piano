discorrevo più col naso come la prima volta che mi aveva incontrato, mi credeva guarito e non finiva di domandarmi:","ja":"","t":[[0,10,"finalmente"],[11,13,"avere"],[14,20,"capire"],[21,23,"il"],[24,30,"motivo"],[31,33,"di"],[34,39,"tanto"],[40,50,"allegrezza"],[52,54,"il"],[55,63,"marchesa"],[64,72,"sentire"],[73,76,"che"],[77,80,"non"],[81,91,"discorrere"],[92,95,"più"],[96,99,"con"],[100,104,"naso"],[105,109,"come"],[110,112,"il"],[113,118,"prima"],[119,124,"volta"],[125,128,"che"],[129,131,"mi"],[132,137,"avere"],[138,148,"incontrare"],[150,152,"mi"],[153,160,"credere"],[161,168,"guarire"],[169,170,"e"],[171,174,"non"],[175,181,"finire"],[182,184,"di"],[185,195,"domandare"]]},{"it":"- E quanto tempo è durata la cura?","ja":"","t":[[2,3,"e"],[4,10,"quanto"],[11,16,"tempo"],[17,18,"essere"],[19,25,"durare"],[26,28,"il"],[29,33,"cura"]]},{"it":"E quando hai cominciato a sentire il miglioramento?","ja":"","t":[[0,1,"e"],[2,8,"quando"],[9,12,"avere"],[13,23,"cominciare"],[24,25,"a"],[26,33,"sentire"],[34,36,"il"],[37,50,"miglioramento"]]},{"it":"E quante inalazioni facevi al giorno?","ja":"","t":[[0,1,"e"],[2,8,"quanto"],[9,19,0],[20,26,"fare"],[27,29,"a"],[30,36,"giorno"]]},{"it":"E quanti sciacqui?","ja":"","t":[[0,1,"e"],[2,8,"quanto"],[9,17,0]]},{"it":"Io da principio le rispondevo quel che mi veniva alla bocca; ma poi, siccome cominciavo a seccarmi, l’ho piantata li, e soltanto quando sono stato sulla porta, le ho ripetuto, sempre per farle piacere:","ja":"","t":[[0,2,"io"],[3,5,"da"],[6,15,"principio"],[16,18,"il"],[19,29,"rispondere"],[30,34,"quello"],[35,38,"che"],[39,41,"mi"],[42,48,"venire"],[49,53,"a"],[54,59,"bocca"],[61,63,"ma"],[64,67,"poi"],[69,76,"siccome"],[77,87,"cominciare"],[88,89,"a"],[90,98,"seccare"],[100,101,"il"],[102,104,"avere"],[105,113,"piantare"],[114,116,"li"],[118,119,"e"],[120,128,"soltanto"],[129,135,"quando"],[136,140,"essere"],[141,146,"essere"],[147,152,"su"],[153,158,"porta"],[160,162,"il"],[163,165,"avere"],[166,174,"ripetere"],[176,182,"sempre"],[183,186,"per"],[187,192,"fare"],[193,200,"piacere"]]},{"it":"- Marameo!","ja":"","t":[[2,9,0]]},{"it":"Ma proprio in quel momento stava per entrare il dottor Collalto il quale, avendo sentito quella parola, mi ha allungato una pedata nel corridoio che son riuscito a scansare per miracolo, e ha borbottato fremendo:","ja":"","t":[[0,2,"ma"],[3,10,"proprio"],[11,13,"in"],[14,18,"quello"],[19,26,"momento"],[27,32,"stare"],[33,36,"per"],[37,44,"entrare"],[45,47,"il"],[48,54,0],[55,63,0],[64,66,"il"],[67,72,"quale"],[74,80,"avere"],[81,88,"sentire"],[89,95,"quello"],[96,102,"parola"],[104,106,"mi"],[107,109,"avere"],[110,119,"allungare"],[120,123,"un"],[124,130,"pedata"],[131,134,"in"],[135,144,"corridoio"],[145,148,"che"],[149,152,"essere"],[153,161,"riuscire"],[162,163,"a"],[164,172,0],[173,176,"per"],[177,185,"miracolo"],[187,188,"e"],[189,191,"avere"],[192,202,"borbottare"],[203,211,"fremere"]]},{"it":"- Canaglia, ti avevo proibito di venir qui!...","ja":"","t":[[2,10,"canaglia"],[12,14,"ti"],[15,20,"avere"],[21,29,"proibire"],[30,32,"di"],[33,38,"venire"],[39,42,"qui"]]},{"it":"Poi è entrato nella sala di consultazione, e io, ritornando indietro per il corridoio con l’intenzione di andare in camera mia e chiudermici dentro a scanso di altre pedate, ho sentito che diceva alla marchesa Sterzi:","ja":"","t":[[0,3,"poi"],[4,5,"essere"],[6,13,"entrare"],[14,19,"in"],[20,24,"sala"],[25,27,"di"],[28,41,0],[43,44,"e"],[45,47,"io"],[49,59,"ritornare"],[60,68,"indietro"],[69,72,"per"],[73,75,"il"],[76,85,"corridoio"],[86,89,"con"],[90,91,"il"],[92,102,"intenzione"],[103,105,"di"],[106,112,"andare"],[113,115,"in"],[116,122,"camera"],[123,126,"mio"],[127,128,"e"],[129,140,0],[141,147,"dentro"],[148,149,"a"],[150,156,0],[157,159,"di"],[160,165,"altro"],[166,172,"pedata"],[174,176,"avere"],[177,184,"sentire"],[185,188,"che"],[189,195,"dire"],[196,200,"a"],[201,209,"marchesa"],[210,216,0]]},{"it":"- Perdonerà, signora marchesa, se quel ragazzaccio maleducato...
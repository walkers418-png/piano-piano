ina"],[45,48,"che"],[49,55,"dire"],[56,71,"raccomandare"]]},{"it":"― Sor assassino, che mi darebbe un chicco d’uva, o una ciliegia, o anche una mezza pera solamente?","ja":"","t":[[2,5,0],[6,15,"assassino"],[17,20,"che"],[21,23,"mi"],[24,31,"dare"],[32,34,"un"],[35,41,"chicco"],[42,43,"di"],[44,47,"uva"],[49,50,"o"],[51,54,"un"],[55,63,"ciliegia"],[65,66,"o"],[67,72,"anche"],[73,76,"un"],[77,82,"mezzo"],[83,87,"pera"],[88,97,"solamente"]]},{"it":"Sono digiuno da tanti giorni, e sento che lo stomaco mi va via.","ja":"","t":[[0,4,"essere"],[5,12,"digiunare"],[13,15,"da"],[16,21,"tanto"],[22,28,"giorno"],[30,31,"e"],[32,37,"sentire"],[38,41,"che"],[42,44,"il"],[45,52,"stomaco"],[53,55,"mi"],[56,58,"andare"],[59,62,"via"]]},{"it":"Lo creda, sor assassino, ho una fame così grande, che la vedo anche al buio!...","ja":"","t":[[0,2,"il"],[3,8,"credere"],[10,13,0],[14,23,"assassino"],[25,27,"avere"],[28,31,"un"],[32,36,"fame"],[37,41,"così"],[42,48,"grande"],[50,53,"che"],[54,56,"il"],[57,61,"vedere"],[62,67,"anche"],[68,70,"a"],[71,75,"buio"]]},{"it":"― Se hai fame ― rispose Golasecca, ― ridendo di un riso sguaiato e canzonatore ― fruga nella mia tasca, e ci troverai tante ghiottonerie, da prendere un’indigestione.","ja":"","t":[[2,4,"se"],[5,8,"avere"],[9,13,"fame"],[16,23,"rispondere"],[24,33,0],[37,44,"ridere"],[45,47,"di"],[48,50,"un"],[51,55,"riso2"],[56,64,0],[65,66,"e"],[67,78,0],[81,86,"frugare"],[87,92,"in"],[93,96,"mio"],[97,102,"tasca"],[104,105,"e"],[106,108,"ci"],[109,117,"trovare"],[118,123,"tanto"],[124,136,0],[138,140,"da"],[141,149,"prendere"],[150,152,"un"],[153,165,0]]},{"it":"― Sono tre giorni che frugo: ma non mi riesce di trovarci nulla.","ja":"","t":[[2,6,"essere"],[7,10,"tre"],[11,17,"giorno"],[18,21,"che"],[22,27,"frugare"],[29,31,"ma"],[32,35,"non"],[36,38,"mi"],[39,45,"riuscire"],[46,48,"di"],[49,57,"trovare"],[58,63,"nulla"]]},{"it":"― Allora mangia la fodera della tasca.","ja":"","t":[[2,8,"allora"],[9,15,"mangiare"],[16,18,"il"],[19,25,"fodera"
,"lì"],[13,16,"non"],[17,19,"avere"],[20,26,"sapere"],[27,36,"resistere"],[37,41,"a"],[42,52,"tentazione"],[53,55,"di"],[56,63,0],[64,66,"il"],[67,72,"verso"],[74,75,"e"],[76,78,"avere"],[79,87,"rispondere"],[88,99,"discorrere"],[100,103,"con"],[104,108,"naso"]]},{"it":"- Io sto bene, e lei?","ja":"","t":[[2,4,"io"],[5,8,"stare"],[9,13,"bene"],[15,16,"e"],[17,20,"lei"]]},{"it":"Nel sentirmi discorrer col naso si è turbata, poi mi ha guardato, e vedendo che stavo serio, mi ha detto:","ja":"","t":[[0,3,"in"],[4,12,"sentire"],[13,22,"discorrere"],[23,26,"con"],[27,31,"naso"],[32,34,"si"],[35,36,"essere"],[37,44,"turbare"],[46,49,"poi"],[50,52,"mi"],[53,55,"avere"],[56,64,"guardare"],[66,67,"e"],[68,75,"vedere"],[76,79,"che"],[80,85,"stare"],[86,91,"serio"],[93,95,"mi"],[96,98,"avere"],[99,104,"dire"]]},{"it":"- Ah! forse anche tu hai la mia malattia?","ja":"","t":[[2,4,"ah"],[6,11,"forse"],[12,17,"anche"],[18,20,"tu"],[21,24,"avere"],[25,27,"il"],[28,31,"mio"],[32,40,"malattia"]]},{"it":"E io, parlando col naso più che mai:","ja":"","t":[[0,1,"e"],[2,4,"io"],[6,14,"parlare"],[15,18,"con"],[19,23,"naso"],[24,27,"più"],[28,31,"che"],[32,35,"mai"]]},{"it":"- Sissignora!","ja":"","t":[[2,12,0]]},{"it":"- Forse - ha seguitato la marchesa - fai anche tu la cura del professor Collalto?","ja":"","t":[[2,7,"forse"],[10,12,"avere"],[13,22,"seguitare"],[23,25,"il"],[26,34,"marchesa"],[37,40,"fare"],[41,46,"anche"],[47,49,"tu"],[50,52,"il"],[53,57,"cura"],[58,61,"di"],[62,71,0],[72,80,0]]},{"it":"E io daccapo:","ja":"","t":[[0,1,"e"],[2,4,"io"],[5,12,"daccapo"]]},{"it":"- Sissignora!...","ja":"","t":[[2,12,0]]},{"it":"Allora mi ha abbracciato e baciato, e poi ha detto:","ja":"","t":[[0,6,"allora"],[7,9,"mi"],[10,12,"avere"],[13,24,"abbracciare"],[25,26,"e"],[27,34,"baciare"],[36,37,"e"],[38,41,"poi"],[42,44,"avere"],[45,50,"dire"]]},{"it":"- Il professor Collalto è molto bravo, è uno specialista e, vedrai, ci guarirà tutti e due...","ja":"","t":[[2,4,"il"],[5,14,0],[15,23,0],[24,2
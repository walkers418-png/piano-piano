oi... ma non voglio scrivere di quel che abbiamo progettato e complottato.","ja":"","t":[[0,1,"e"],[2,5,"poi"],[9,10,"e"],[11,14,"poi"],[18,20,"ma"],[21,24,"non"],[25,31,"volere"],[32,40,"scrivere"],[41,43,"di"],[44,48,"quello"],[49,52,"che"],[53,60,"avere"],[61,71,0],[72,73,"e"],[74,85,0]]},{"it":"Dirò solo che se quel che abbiamo pensato di fare riuscirà noi saremo finalmente vendicati di tanti bocconi amari che abbiam dovuto ingozzare... compresi quelli della famosa minestra di magro fatta con la rigovernatura dei nostri piatti, e quel che è peggio di quelli del signor Stanislao e della signora Geltrude.","ja":"","t":[[0,4,"dire"],[5,9,"solo"],[10,13,"che"],[14,16,"se"],[17,21,"quello"],[22,25,"che"],[26,33,"avere"],[34,41,"pensare"],[42,44,"di"],[45,49,"fare"],[50,58,"riuscire"],[59,62,"noi"],[63,69,"essere"],[70,80,"finalmente"],[81,90,0],[91,93,"di"],[94,99,"tanto"],[100,107,"boccone"],[108,113,"amaro"],[114,117,"che"],[118,124,0],[125,131,"dovere"],[132,141,0],[145,153,"comprendere"],[154,160,"quello"],[161,166,"di"],[167,173,"famoso"],[174,182,"minestra"],[183,185,"di"],[186,191,"magro"],[192,197,"fare"],[198,201,"con"],[202,204,"il"],[205,218,0],[219,222,"di"],[223,229,"nostro"],[230,236,"piatto"],[238,239,"e"],[240,244,"quello"],[245,248,"che"],[249,250,"essere"],[251,257,"peggio"],[258,260,"di"],[261,267,"quello"],[268,271,"di"],[272,278,"signore"],[279,288,0],[289,290,"e"],[291,296,"di"],[297,304,"signora"],[305,313,0]]}],"q":[],"g":{},"n":325,"w":["Dio","a","amaro","amicizia","anche","approvare","avere","berretto","boccone","buono","camera","carta","ce","cercare","che","ci","ciascuno","collegio","come","comprendere","con","conoscenza","cosa","da","dare","di","dire","direttore","direttrice","discutere","domani","dopo","dovere","due","durante","e","effetto","egli","eleggere","elezione","essere","famoso","fare","febbraio","finalmente","giorno","già","guardare","idea","ieri","il","in","io","lavoro","lentamente","loro","lui","là","ma","magro","mandare","mang
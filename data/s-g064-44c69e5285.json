{"id":"g064","title":"6 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Evviva la Befana!","ja":"","t":[[0,6,"evviva"],[7,9,"il"],[10,16,"befana"]]},{"it":"Stamani Luisa mi ha portato in camera una bella calza piena di dolci con un bel pulcinella in cima, e Collalto mi ha regalato un bel portamonete di pelle di coccodrillo.","ja":"","t":[[0,7,"stamani"],[8,13,0],[14,16,"mi"],[17,19,"avere"],[20,27,"portare"],[28,30,"in"],[31,37,"camera"],[38,41,"un"],[42,47,"bello"],[48,53,"calza"],[54,59,"pieno"],[60,62,"di"],[63,68,"dolce"],[69,72,"con"],[73,75,"un"],[76,79,"bello"],[80,90,0],[91,93,"in"],[94,98,"cima"],[100,101,"e"],[102,110,0],[111,113,"mi"],[114,116,"avere"],[117,125,"regalare"],[126,128,"un"],[129,132,"bello"],[133,144,0],[145,147,"di"],[148,153,"pelle"],[154,156,"di"],[157,168,"coccodrillo"]]},{"it":"Da casa mia poi mi hanno scritto di avermi preparato altre liete sorprese per quando ritornerò...","ja":"","t":[[0,2,"da"],[3,7,"casa"],[8,11,"mio"],[12,15,"poi"],[16,18,"mi"],[19,24,"avere"],[25,32,"scrivere"],[33,35,"di"],[36,42,"avere"],[43,52,"preparare"],[53,58,"altro"],[59,64,0],[65,73,"sorprendere"],[74,77,"per"],[78,84,"quando"],[85,94,"ritornare"]]},{"it":"Per me oggi è una bellissima giornata.","ja":"","t":[[0,3,"per"],[4,6,"me"],[7,11,"oggi"],[12,13,"essere"],[14,17,"un"],[18,28,"bello"],[29,37,"giornata"]]},{"it":"Viva la Befana!...","ja":"","t":[[0,4,"vivere"],[5,7,"il"],[8,14,"befana"]]}],"q":[],"g":{},"n":60,"w":["altro","avere","befana","bello","calza","camera","casa","cima","coccodrillo","con","da","di","dolce","e","essere","evviva","giornata","il","in","me","mi","mio","oggi","pelle","per","pieno","poi","portare","preparare","quando","regalare","ritornare","scrivere","sorprendere","stamani","un","vivere"]}
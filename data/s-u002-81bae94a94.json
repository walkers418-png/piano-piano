{"id":"u002","title":"Ottobre・Il nostro maestro","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL NOSTRO MAESTRO.","ja":"","t":[[0,2,"il"],[3,9,"nostro"],[10,17,"maestro"]]},{"it":"18, martedì.","ja":"","t":[[4,11,"martedì"]]},{"it":"Anche il mio nuovo maestro mi piace, dopo questa mattina.","ja":"","t":[[0,5,"anche"],[6,8,"il"],[9,12,"mio"],[13,18,"nuovo"],[19,26,"maestro"],[27,29,"mi"],[30,35,"piacere"],[37,41,"dopo"],[42,48,"questo"],[49,56,"mattina"]]},{"it":"Durante l’entrata, mentre egli era già seduto al suo posto, s’affacciava di tanto in tanto alla porta della classe qualcuno dei suoi scolari dell’anno scorso, per salutarlo; s’affacciavano, passando, e lo salutavano: — Buon giorno, signor maestro.","ja":"","t":[[0,7,"durante"],[8,9,"il"],[10,17,"entrata"],[19,25,"mentre"],[26,30,"egli"],[31,34,"essere"],[35,38,"già"],[39,45,"sedere"],[46,48,"a"],[49,52,"suo"],[53,58,"posto"],[60,61,"si"],[62,72,"affacciare"],[73,75,"di"],[76,81,"tanto"],[82,84,"in"],[85,90,"tanto"],[91,95,"a"],[96,101,"porta"],[102,107,"di"],[108,114,"classe"],[115,123,"qualcuno"],[124,127,"di"],[128,132,"suo"],[133,140,"scolaro"],[141,145,"di"],[146,150,"anno"],[151,157,"scorso"],[159,162,"per"],[163,172,"salutare"],[174,175,"si"],[176,188,"affacciare"],[190,198,"passare"],[200,201,"e"],[202,204,"il"],[205,215,"salutare"],[219,223,"buono"],[224,230,"giorno"],[232,238,"signore"],[239,246,"maestro"]]},{"it":"— Buon giorno, signor Perboni; — alcuni entravano, gli toccavan la mano e scappavano.","ja":"","t":[[2,6,"buono"],[7,13,"giorno"],[15,21,"signore"],[22,29,0],[33,39,"alcuno"],[40,49,"entrare"],[51,54,"il"],[55,63,"toccare"],[64,66,"il"],[67,71,"mano"],[72,73,"e"],[74,84,"scappare"]]},{"it":"Si vedeva che gli volevan bene e che avrebbero voluto tornare con lui.","ja":"","t":[[0,2,"si"],[3,9,"vedere"],[10,13,"che"],[14,17,"il"],[18,25,"volere"],[26,30,"bene"],[31,32,"e"],[33,36,"che"],[37,46,"avere"],[47,53,"volere"],[54,61,"tornare"],[6
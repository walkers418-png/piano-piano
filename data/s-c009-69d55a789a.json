{"id":"c009","title":"La vecchina","lv":5,"kind":"童話","note":"Luigi Capuana「C'era una volta...」（1882年）の原文です。古い語や綴りがあります。","lines":[{"it":"LA VECCHINA","ja":"","t":[[0,2,"il"],[3,11,0]]},{"it":"C’era una volta un Re molto giovane, che voleva prender moglie, ma voleva sposare la più bella ragazza del mondo.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,9,"un"],[10,15,"volta"],[16,18,"un"],[19,21,"re"],[22,27,"molto"],[28,35,"giovane"],[37,40,"che"],[41,47,"volere"],[48,55,0],[56,62,"moglie"],[64,66,"ma"],[67,73,"volere"],[74,81,"sposare"],[82,84,"il"],[85,88,"più"],[89,94,"bello"],[95,102,"ragazza"],[103,106,"di"],[107,112,"mondo"]]},{"it":"— E se non è di sangue reale?","ja":"","t":[[2,3,"e"],[4,6,"se"],[7,10,"non"],[11,12,"essere"],[13,15,"dire"],[16,22,"sangue"],[23,28,"reale"]]},{"it":"— gli domandarono i ministri.","ja":"","t":[[2,5,"il"],[6,17,"domandare"],[18,19,"il"],[20,28,"ministro"]]},{"it":"— Non me n’importa nulla.","ja":"","t":[[2,5,"non"],[6,8,"me"],[9,10,0],[11,18,"importare"],[19,24,"nulla"]]},{"it":"— Allora sappiate, Maestà, che la più bella ragazza del mondo è la figliuola di un ciaba.","ja":"","t":[[2,8,"allora"],[9,17,"sapere"],[19,25,0],[27,30,"che"],[31,33,"il"],[34,37,"più"],[38,43,"bello"],[44,51,"ragazza"],[52,55,"di"],[56,61,"mondo"],[62,63,"essere"],[64,66,"il"],[67,76,0],[77,79,"di"],[80,82,"un"],[83,88,0]]},{"it":"Ma il popolo, che è maligno, potrebbe chiamarla: la regina Ciabatta...","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,12,"popolo"],[14,17,"che"],[18,19,"essere"],[20,27,0],[29,37,"potere"],[38,47,"chiamare"],[49,51,"il"],[52,58,"regina"],[59,67,0]]},{"it":"Maestà, non sta bene: rifletteteci meglio.","ja":"","t":[[0,6,0],[8,11,"non"],[12,15,"stare"],[16,20,"bene"],[22,34,"riflettere"],[35,41,"meglio"]]},{"it":"—","ja":"","t":[]},{"it":"Il Re rispose:","ja":"","t":[[0,2,"il"],[3,5,"re"],[6,13,"rispondere"]]},{"it":"— La figliuola del ciaba è la più bella ragazza del mondo?","ja":"","t":[[2,4,"il"],[5,14,0],[15,18,"di"],[19,24,0],[25,26,"ess
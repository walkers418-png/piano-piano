{"id":"u088","title":"Giugno・L'esercito","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"L'ESERCITO","ja":"","t":[[0,1,"il"],[2,10,"esercito"]]},{"it":"Siamo andati in piazza Castello a veder la rassegna dei soldati, che sfilarono davanti al Comandante del Corpo d’esercito, in mezzo a due grandi ali di popolo.","ja":"","t":[[0,5,"essere"],[6,12,"andare"],[13,15,"in"],[16,22,"piazza"],[23,31,"castello"],[32,33,"a"],[34,39,"vedere"],[40,42,"il"],[43,51,"rassegnare"],[52,55,"di"],[56,63,"soldato"],[65,68,"che"],[69,78,0],[79,86,"davanti"],[87,89,"a"],[90,100,"comandante"],[101,104,"di"],[105,110,"corpo"],[111,112,"di"],[113,121,"esercito"],[123,125,"in"],[126,131,"mezzo"],[132,133,"a"],[134,137,"due"],[138,144,"grande"],[145,148,"ala"],[149,151,"di"],[152,158,"popolo"]]},{"it":"Via via che sfilavano, al suono delle fanfare e delle bande, mio padre mi accennava i Corpi e le glorie delle bandiere.","ja":"","t":[[0,3,"via"],[4,7,"via"],[8,11,"che"],[12,21,0],[23,25,"a"],[26,31,"suono"],[32,37,"di"],[38,45,0],[46,47,"e"],[48,53,"di"],[54,59,"banda"],[61,64,"mio"],[65,70,"padre"],[71,73,"mi"],[74,83,"accennare"],[84,85,"il"],[86,91,"corpo"],[92,93,"e"],[94,96,"il"],[97,103,0],[104,109,"di"],[110,118,"bandiera"]]},{"it":"Primi gli allievi dell’Accademia, quelli che saranno ufficiali del Genio e dell’Artiglieria, circa trecento, vestiti di nero, passarono con una eleganza ardita e sciolta di soldati e di studenti.","ja":"","t":[[0,5,"primo"],[6,9,"il"],[10,17,0],[18,22,"di"],[23,32,0],[34,40,"quello"],[41,44,"che"],[45,52,"essere"],[53,62,"ufficiale"],[63,66,"di"],[67,72,"genio"],[73,74,"e"],[75,79,"di"],[80,91,"artiglieria"],[93,98,"circa"],[99,107,0],[109,116,"vestito"],[117,119,"di"],[120,124,"nero"],[126,135,"passare"],[136,139,"con"],[140,143,"un"],[144,152,0],[153,159,0],[160,161,"e"],[162,169,"sciogliere"],[170,172,"di"],[173,180,"soldato"],[181,182,"e"],[183,185,"dire"],[186,194,"studente"]]},{"it":"Dopo di loro sfilò la fanteria: la brigata Aosta che combatté a Goito e a San Martino, e la brigata Bergamo che combatté a Castelfidardo, quattro reggimenti, compagnie dietro compagnie, migliaia di nappine rosse, che parevan tante doppie ghirlande lunghissime di fiori color di sangue, tese e scosse pei due capi, e portate a traverso alla folla.","ja":"","t":[[0,4,"dopo"],[5,7,"di"],[8,12,"loro"],[13,18,0],[19,21,"il"],[22,30,0],[32,34,"il"],[35,42,0],[43,48,0],[49,52,"che"],[53,61,"combattere"],[62,63,"a"],[64,69,0],[70,71,"e"],[72,73,"a"],[74,77,0],[78,85,0],[87,88,"e"],[89,91,"il"],[92,99,0],[100,107,0],[108,111,"che"],[112,120,"combattere"],[121,122,"a"],[123,136,0],[138,145,"quattro"],[146,156,0],[158,167,"compagnia"],[168,174,"dietro"],[175,184,"compagnia"],[186,194,"migliaio"],[195,197,"di"],[198,205,0],[206,211,"rosso"],[213,216,"che"],[217,224,"parere"],[225,230,"tanto"],[231,237,"doppio"],[238,247,0],[248,259,"lungo"],[260,262,"di"],[263,268,"fiore"],[269,274,"colore"],[275,277,"di"],[278,284,"sangue"],[286,290,"tendere"],[291,292,"e"],[293,299,"scuotere"],[300,303,"per"],[304,307,"due"],[308,312,"capo"],[314,315,"e"],[316,323,"portare"],[324,325,"a"],[326,334,0],[335,339,"a"],[340,345,"folla"]]},{"it":"Dopo la fanteria s’avanzarono i soldati del Genio, gli operai della guerra, coi pennacchi di crini neri e i galloni cremisini; e mentre questi sfilavano, si vedevan venire innanzi dietro di loro centinaia di lunghe penne diritte, che sorpassavano le teste degli spettatori: erano gli alpini, i difensori delle porte d’Italia, tutti alti, rosei, e forti, coi capelli alla calabrese e le mostre di un bel verde vivo, color dell’erba delle loro montagne.","ja":"","t":[[0,4,"dopo"],[5,7,"il"],[8,16,0],[17,18,"si"],[19,29,"avanzare"],[30,31,"il"],[32,39,"soldato"],[40,43,"di"],[44,49,"genio"],[51,54,"il"],[55,61,"operaio"],[62,67,"di"],[68,74,"guerra"],[76,79,"con"],[80,89,0],[90,92,"di"],[93,98,0],[99,103,"nero"],[104,105,"e"],[106,107,"il"],[108,115,0],[116,125,0],[127,128,"e"],[129,135,"mentre"],[136,142,"questo"],[143,152,0],[154,156,"si"],[157,164,0],[165,171,"venire"],[172,179,"innanzi"],[180,186,"dietro"],[187,189,"di"],[190,194,"loro"],[195,204,"centinaio"],[205,207,"di"],[208,214,"lungo"],[215,220,"penna"],[221,228,0],[230,233,"che"],[234,246,0],[247,249,"il"],[250,255,"testa"],[256,261,"di"],[262,272,0],[274,279,"essere"],[280,283,"il"],[284,290,0],[292,293,"il"],[294,303,0],[304,309,"di"],[310,315,"porta"],[316,317,"di"],[318,324,0],[326,331,"tutto"],[332,336,"alto"],[338,343,0],[345,346,"e"],[347,352,"forte"],[354,357,"con"],[358,365,"capello"],[366,370,"a"],[371,380,"calabrese"],[381,382,"e"],[383,385,"il"],[386,392,"mostra"],[393,395,"di"],[396,398,"un"],[399,402,"bello"],[403,408,"verde"],[409,413,"vivo"],[415,420,"colore"],[421,425,"di"],[426,430,"erba"],[431,436,"di"],[437,441,"loro"],[442,450,"montagna"]]},{"it":"Sfilavano ancor gli alpini, che corse un fremito nella folla, e i bersaglieri, l’antico dodicesimo battaglione, i primi che entrarono in Roma per la breccia di Porta Pia, bruni, lesti, vivi, coi pennacchi sventolanti, passarono come un’ondata d’un torrente nero, facendo echeggiare la piazza di squilli acuti di tromba che sembravan grida d’allegrezza.","ja":"","t":[[0,9,0],[10,15,"ancora"],[16,19,"il"],[20,26,0],[28,31,"che"],[32,37,"correre"],[38,40,"un"],[41,48,0],[49,54,"in"],[55,60,"folla"],[62,63,"e"],[64,65,"il"],[66,77,"bersagliere"],[79,80,"il"],[81,87,"antico"],[88,98,0],[99,110,0],[112,113,"il"],[114,119,"primo"],[120,123,"che"],[124,133,"entrare"],[134,136,"in"],[137,141,0],[142,145,"per"],[146,148,"il"],[149,156,0],[157,159,"di"],[160,165,"porta"],[166,169,0],[171,176,"bruno"],[178,183,"lesto"],[185,189,"vivere"],[191,194,"con"],[195,204,0],[205,216,0],[218,227,"passare"],[228,232,"come"],[233,235,"un"],[236,242,0],[243,244,"di"],[245,247,"un"],[248,256,0],[257,261,"nero"],[263,270,"fare"],[271,281,0],[282,284,"il"],[285,291,"piazza"],[292,294,"di"],[295,302,0],[303,308,0],[309,311,"di"],[312,318,0],[319,322,"che"],[323,332,0],[333,338,"gridare"],[339,340,"di"],[341,351,"allegrezza"]]},{"it":"Ma la loro fanfara fu coperta da uno strepito rotto e cupo che annunziò l’artiglieria di campagna; e allora passarono superbamente, seduti sugli alti cassoni, tirati da trecento coppie di cavalli impetuosi i bei soldati dai cordoni gialli e i lunghi cannoni di bronzo e d’acciaio, scintillanti sugli affusti leggieri, che saltavano e risuonavano, e ne tremava la terra.","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,10,"loro"],[11,18,0],[19,21,"essere"],[22,29,"coperta"],[30,32,"da"],[33,36,"un"],[37,45,0],[46,51,"rompere"],[52,53,"e"],[54,58,0],[59,62,"che"],[63,71,0],[72,73,"il"],[74,85,"artiglieria"],[86,88,"di"],[89,97,"campagna"],[99,100,"e"],[101,107,"allora"],[108,117,"passare"],[118,130,0],[132,138,"sedere"],[139,144,"su"],[145,149,"alto"],[150,157,0],[159,165,"tirare"],[166,168,"da"],[169,177,0],[178,184,"coppia"],[185,187,"di"],[188,195,"cavallo"],[196,205,0],[206,207,"il"],[208,211,"bello"],[212,219,"soldato"],[220,223,"da"],[224,231,0],[232,238,"giallo"],[239,240,"e"],[241,242,"il"],[243,249,"lungo"],[250,257,0],[258,260,"di"],[261,267,"bronzo"],[268,269,"e"],[270,271,"di"],[272,279,0],[281,293,0],[294,299,"su"],[300,307,0],[308,316,0],[318,321,"che"],[322,331,"saltare"],[332,333,"e"],[334,345,0],[347,348,"e"],[349,351,"ne"],[352,359,"tremare"],[360,362,"il"],[363,368,"terra"]]},{"it":"E poi venne su lenta, grave, bella nella sua apparenza faticosa e rude, coi suoi grandi soldati, coi suoi muli potenti, l’artiglieria di montagna, che porta lo sgomento e la morte fin dove sale il piede dell’uomo.","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,11,"venire"],[12,14,"su"],[15,20,"lento"],[22,27,"grave"],[29,34,"bello"],[35,40,"in"],[41,44,"suo"],[45,54,0],[55,63,"faticoso"],[64,65,"e"],[66,70,0],[72,75,"con"],[76,80,"suo"],[81,87,"grande"],[88,95,"soldato"],[97,100,"con"],[101,105,"suo"],[106,110,0],[111,118,0],[120,121,"il"],[122,133,"artiglieria"],[134,136,"di"],[137,145,"montagna"],[147,150,"che"],[151,156,"portare"],[157,159,"il"],[160,168,0],[169,170,"e"],[171,173,"il"],[174,179,"morto"],[180,183,"fino"],[184,188,"dove"],[189,193,"sale"],[194,196,"il"],[197,202,"piede"],[203,207,"di"],[208,212,"uomo"]]},{"it":"E infine passò di galoppo, con gli elmi al sole, con le lancie erette, con le bandiere al vento, sfavillando d’argento e d’oro, empiendo l’aria di tintinni e di nitriti, il bel reggimento Genova cavalleria, che turbinò su dieci campi di battaglia, da Santa Lucia a Villafranca.","ja":"","t":[[0,1,"e"],[2,8,"infine"],[9,14,"passare"],[15,17,"di"],[18,25,0],[27,30,"con"],[31,34,"il"],[35,39,0],[40,42,"a"],[43,47,"sole"],[49,52,"con"],[53,55,"il"],[56,62,0],[63,69,0],[71,74,"con"],[75,77,"il"],[78,86,"bandiera"],[87,89,"a"],[90,95,"vento"],[97,108,0],[109,110,"di"],[111,118,"argento"],[119,120,"e"],[121,122,"di"],[123,126,"oro"],[128,136,0],[137,138,"il"],[139,143,"aria"],[144,146,"di"],[147,155,0],[156,157,"e"],[158,160,"dire"],[161,168,"nitrire"],[170,172,"il"],[173,176,"bello"],[177,187,0],[188,194,0],[195,205,0],[207,210,"che"],[211,218,0],[219,221,"su"],[222,227,"dieci"],[228,233,"campo"],[234,236,"di"],[237,246,"battaglia"],[248,250,"da"],[251,256,0],[257,262,0],[263,264,"a"],[265,276,0]]},{"it":"— Come è bello!","ja":"","t":[[2,6,"come"],[7,8,"essere"],[9,14,"bello"]]},{"it":"— io esclamai.","ja":"","t":[[2,4,"io"],[5,13,"esclamare"]]},{"it":"Ma mio padre mi fece quasi un rimprovero di quella parola, e mi disse: — Non considerare l’esercito come un bello spettacolo.","ja":"","t":[[0,2,"ma"],[3,6,"mio"],[7,12,"padre"],[13,15,"mi"],[16,20,"fare"],[21,26,"quasi"],[27,29,"un"],[30,40,"rimproverare"],[41,43,"di"],[44,50,"quello"],[51,57,"parola"],[59,60,"e"],[61,63,"mi"],[64,69,"dire"],[73,76,"non"],[77,88,"considerare"],[89,90,"il"],[91,99,"esercito"],[100,104,"come"],[105,107,"un"],[108,113,"bello"],[114,124,"spettacolo"]]},{"it":"Tutti questi giovani pieni di forza e di speranze possono da un giorno all’altro essere chiamati a difendere il nostro paese, e in poche ore essere sfracellati tutti dalle palle e dalla mitraglia.","ja":"","t":[[0,5,"tutto"],[6,12,"questo"],[13,20,"giovane"],[21,26,"pieno"],[27,29,"di"],[30,35,"forza"],[36,37,"e"],[38,40,"dire"],[41,49,"speranza"],[50,57,"potere"],[58,60,"da"],[61,63,"un"],[64,70,"giorno"],[71,74,"a"],[75,80,"altro"],[81,87,"essere"],[88,96,"chiamare"],[97,98,"a"],[99,108,"difendere"],[109,111,"il"],[112,118,"nostro"],[119,124,"paese"],[126,127,"e"],[128,130,"in"],[131,136,"poco"],[137,140,"ora"],[141,147,"essere"],[148,159,0],[160,165,"tutto"],[166,171,"da"],[172,177,"palla"],[178,179,"e"],[180,185,"da"],[186,195,0]]},{"it":"Ogni volta che senti gridare in una festa: Viva l’esercito, viva l’Italia, raffigurati, di là dai reggimenti che passano, una campagna coperta di cadaveri e allagata di sangue, e allora l’evviva all’esercito t’escirà più dal profondo del cuore, e l’immagine dell’Italia t’apparirà più severa e più grande.","ja":"","t":[[0,4,"ogni"],[5,10,"volta"],[11,14,"che"],[15,20,"sentire"],[21,28,"gridare"],[29,31,"in"],[32,35,"un"],[36,41,"festa"],[43,47,"vivere"],[48,49,"il"],[50,58,"esercito"],[60,64,"vivere"],[65,66,"il"],[67,73,0],[75,86,0],[88,90,"di"],[91,93,"là"],[94,97,"da"],[98,108,0],[109,112,"che"],[113,120,"passare"],[122,125,"un"],[126,134,"campagna"],[135,142,"coperta"],[143,145,"di"],[146,154,0],[155,156,"e"],[157,165,0],[166,168,"di"],[169,175,"sangue"],[177,178,"e"],[179,185,"allora"],[186,187,"il"],[188,194,"evviva"],[195,198,"a"],[199,207,"esercito"],[208,209,"ti"],[210,216,0],[217,220,"più"],[221,224,"da"],[225,233,"profondo"],[234,237,"di"],[238,243,"cuore"],[245,246,"e"],[247,248,"il"],[249,257,"immagine"],[258,262,"di"],[263,269,0],[270,271,"ti"],[272,280,"apparire"],[281,284,"più"],[285,291,0],[292,293,"e"],[294,297,"più"],[298,304,"grande"]]}],"q":[],"g":{},"n":539,"w":["a","accennare","ala","allegrezza","allora","alto","altro","ancora","andare","antico","apparire","argento","aria","artiglieria","avanzare","banda","bandiera",
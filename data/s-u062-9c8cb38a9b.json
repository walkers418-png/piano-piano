{"id":"u062","title":"Marzo・Un piccolo morto","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"UN PICCOLO MORTO","ja":"","t":[[0,2,"un"],[3,10,"piccolo"],[11,16,"morto"]]},{"it":"13, lunedì","ja":"","t":[[4,10,"lunedì"]]},{"it":"Il bimbo che sta nel cortile dell’erbivendola, quello della prima superiore, compagno di mio fratello, è morto.","ja":"","t":[[0,2,"il"],[3,8,"bimbo"],[9,12,"che"],[13,16,"stare"],[17,20,"in"],[21,28,"cortile"],[29,33,"di"],[34,45,0],[47,53,"quello"],[54,59,"di"],[60,65,"prima"],[66,75,"superiore"],[77,85,"compagno"],[86,88,"di"],[89,92,"mio"],[93,101,"fratello"],[103,104,"essere"],[105,110,"morire"]]},{"it":"La maestra Delcati venne sabato sera, tutta afflitta, a dar la notizia al maestro; e subito Garrone e Coretti si offersero di aiutare a portar la cassa.","ja":"","t":[[0,2,"il"],[3,10,"maestra"],[11,18,0],[19,24,"venire"],[25,31,"sabato"],[32,36,"sera"],[38,43,"tutto"],[44,52,0],[54,55,"a"],[56,59,"dare"],[60,62,"il"],[63,70,"notizia"],[71,73,"a"],[74,81,"maestro"],[83,84,"e"],[85,91,"subito"],[92,99,0],[100,101,"e"],[102,109,0],[110,112,"si"],[113,122,"offrire"],[123,125,"di"],[126,133,"aiutare"],[134,135,"a"],[136,142,"portare"],[143,145,"il"],[146,151,"cassa"]]},{"it":"Era un bravo ragazzino, aveva guadagnato la medaglia la settimana scorsa; voleva bene a mio fratello, e gli aveva regalato un salvadanaio rotto, mia madre lo carezzava sempre, quando lo incontrava.","ja":"","t":[[0,3,"essere"],[4,6,"un"],[7,12,"bravo"],[13,22,"ragazzino"],[24,29,"avere"],[30,40,"guadagnare"],[41,43,"il"],[44,52,"medaglia"],[53,55,"il"],[56,65,"settimana"],[66,72,"scorso"],[74,80,"volere"],[81,85,"bene"],[86,87,"a"],[88,91,"mio"],[92,100,"fratello"],[102,103,"e"],[104,107,"il"],[108,113,"avere"],[114,122,"regalare"],[123,125,"un"],[126,137,0],[138,143,"rompere"],[145,148,"mio"],[149,154,"madre"],[155,157,"il"],[158,167,0],[168,174,"sempre"],[176,182,"quando"],[183,185,"il"],[186,196,"incontrare"]]},{"it":"Portava un berretto con due strisce di panno rosso.","ja":"","t":[[0,7,"portare"],[8,10,"un"],[11,19,"berretto"],[20,23,"con"],[24,27,"due"],[28,35,"striscia"],[36,38,"di"],[39,44,"panno"],[45,50,"rosso"]]},{"it":"Suo padre è facchino alla strada ferrata.","ja":"","t":[[0,3,"suo"],[4,9,"padre"],[10,11,"essere"],[12,20,0],[21,25,"a"],[26,32,"strada"],[33,40,0]]},{"it":"Ieri sera, domenica, alle quattro e mezzo siano andati a casa sua, per far l’accompagnamento alla chiesa.","ja":"","t":[[0,4,"ieri"],[5,9,"sera"],[11,19,"domenica"],[21,25,"a"],[26,33,"quattro"],[34,35,"e"],[36,41,"mezzo"],[42,47,"essere"],[48,54,"andare"],[55,56,"a"],[57,61,"casa"],[62,65,"suo"],[67,70,"per"],[71,74,"fare"],[75,76,"il"],[77,92,0],[93,97,"a"],[98,104,"chiesa"]]},{"it":"Stanno al pian terreno.","ja":"","t":[[0,6,"stare"],[7,9,"a"],[10,14,0],[15,22,"terreno"]]},{"it":"Nel cortile c’eran già molti ragazzi della prima superiore, con le loro madri, e con le candele; cinque o sei maestre, alcuni vicini.","ja":"","t":[[0,3,"in"],[4,11,"cortile"],[12,13,"ci"],[14,18,"essere"],[19,22,"già"],[23,28,"molto"],[29,36,"ragazzo"],[37,42,"di"],[43,48,"prima"],[49,58,"superiore"],[60,63,"con"],[64,66,"il"],[67,71,"loro"],[72,77,"madre"],[79,80,"e"],[81,84,"con"],[85,87,"il"],[88,95,"candela"],[97,103,"cinque"],[104,105,"o"],[106,109,"essere"],[110,117,"maestra"],[119,125,"alcuno"],[126,132,"vicino"]]},{"it":"La maestra della penna rossa e la Delcati erano entrate dentro, e le vedevamo da una finestra aperta, che piangevano: si sentiva la mamma del bimbo che singhiozzava forte.","ja":"","t":[[0,2,"il"],[3,10,"maestra"],[11,16,"di"],[17,22,"penna"],[23,28,"rosso"],[29,30,"e"],[31,33,"il"],[34,41,0],[42,47,"essere"],[48,55,"entrare"],[56,62,"dentro"],[64,65,"e"],[66,68,"il"],[69,77,"vedere"],[78,80,"da"],[81,84,"un"],[85,93,"finestra"],[94,100,"aprire"],[102,105,"che"],[106,116,"piangere"],[118,120,"si"],[121,128,"sentire"],[129,131,"il"],[132,137,"mamma"],[138,141,"di"],[142,147,"bimbo"],[148,151,"che"],[152,164,"singhiozzare"],[165,170,"forte"]]},{"it":"Due signore, madri di due compagni di scuola del morto, avevano portato due ghirlande di fiori.","ja":"","t":[[0,3,"due"],[4,11,"signore"],[13,18,"madre"],[19,21,"di"],[22,25,"due"],[26,34,"compagno"],[35,37,"di"],[38,44,"scuola"],[45,48,"di"],[49,54,"morto"],[56,63,"avere"],[64,71,"portare"],[72,75,"due"],[76,85,0],[86,88,"di"],[89,94,"fiore"]]},{"it":"Alle cinque in punto ci mettemmo in cammino.","ja":"","t":[[0,4,"a"],[5,11,"cinque"],[12,14,"in"],[15,20,"punto"],[21,23,"ci"],[24,32,"mettere"],[33,35,"in"],[36,43,"camminare"]]},{"it":"Andava innanzi un ragazzo che portava la croce, poi un prete, poi la cassa, una cassa piccola piccola, povero bimbo! coperta d’un panno nero, e c’erano strette intorno le ghirlande di fiori delle due signore.","ja":"","t":[[0,6,"andare"],[7,14,"innanzi"],[15,17,"un"],[18,25,"ragazzo"],[26,29,"che"],[30,37,"portare"],[38,40,"il"],[41,46,"croce"],[48,51,"poi"],[52,54,"un"],[55,60,0],[62,65,"poi"],[66,68,"il"],[69,74,"cassa"],[76,79,"un"],[80,85,"cassa"],[86,93,"piccolo"],[94,101,"piccolo"],[103,109,"povero"],[110,115,"bimbo"],[117,124,"coperta"],[125,126,"di"],[127,129,"un"],[130,135,"panno"],[136,140,"nero"],[142,143,"e"],[144,145,"ci"],[146,151,"essere"],[152,159,"stringere"],[160,167,"intorno"],[168,170,"il"],[171,180,0],[181,183,"di"],[184,189,"fiore"],[190,195,"di"],[196,199,"due"],[200,207,"signore"]]},{"it":"Al panno nero, da una parte, ci avevano attaccato la medaglia, e tre menzioni onorevoli, che il ragazzino s’era guadagnate lungo l’anno.","ja":"","t":[[0,2,"a"],[3,8,"panno"],[9,13,"nero"],[15,17,"da"],[18,21,"un"],[22,27,"parte"],[29,31,"ci"],[32,39,"avere"],[40,49,"attaccare"],[50,52,"il"],[53,61,"medaglia"],[63,64,"e"],[65,68,"tre"],[69,77,0],[78,87,0],[89,92,"che"],[93,95,"il"],[96,105,"ragazzino"],[106,107,"si"],[108,111,"essere"],[112,122,"guadagnare"],[123,128,"lungo"],[129,130,"il"],[131,135,"anno"]]},{"it":"Portavan la cassa Garrone, Coretti e due ragazzi del cor
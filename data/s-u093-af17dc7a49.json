 delle mani grosse, intozzite dal lavoro!","ja":"","t":[[0,2,"io"],[3,5,"mi"],[6,13,"sentire"],[14,17,"non"],[18,20,"sapere"],[21,24,"che"],[25,29,"cosa"],[30,33,"in"],[34,39,"cuore"],[41,45,"come"],[46,48,"un"],[49,55,"grande"],[56,63,"affetto"],[64,65,"e"],[66,68,"un"],[69,75,"grande"],[76,84,"rispetto"],[86,87,"a"],[88,95,"pensare"],[96,102,"quanto"],[103,107,"essere"],[108,115,"costare"],[116,120,"quello"],[121,126,"premio"],[127,128,"a"],[129,134,"tutto"],[135,139,"quello"],[140,150,"lavoratore"],[152,157,"padre"],[158,160,"di"],[161,169,"famiglia"],[171,176,"pieno"],[177,179,"di"],[180,188,"pensiero"],[190,196,"quanto"],[197,204,"fatica"],[205,213,"aggiungere"],[214,218,"a"],[219,223,"loro"],[224,231,"fatica"],[233,239,"quanto"],[240,243,"ora"],[244,249,"togliere"],[250,252,"a"],[253,258,"sonno"],[260,262,"di"],[263,266,"cui"],[267,272,"avere"],[273,278,"tanto"],[279,286,"bisogno"],[288,289,"e"],[290,295,"anche"],[296,302,"quanto"],[303,309,"sforzo"],[310,314,"di"],[315,327,"intelligenza"],[328,331,"non"],[332,340,0],[341,345,"a"],[346,352,"studio"],[353,354,"e"],[355,360,"di"],[361,365,"mano"],[366,372,"grosso"],[374,383,0],[384,387,"da"],[388,394,"lavoro"]]},{"it":"Passò un ragazzo d’officina, a cui si vedeva che suo padre aveva imprestata la giacchetta per quell’occasione, e gli penzolavan le maniche, tanto che se le dovette rimboccare lì sul palco per poter prendere il suo premio; e molti risero; ma il riso fu subito soffocato dai battimani.","ja":"","t":[[0,5,"passare"],[6,8,"un"],[9,16,"ragazzo"],[17,18,"di"],[19,27,0],[29,30,"a"],[31,34,"cui"],[35,37,"si"],[38,44,"vedere"],[45,48,"che"],[49,52,"suo"],[53,58,"padre"],[59,64,"avere"],[65,75,"imprestare"],[76,78,"il"],[79,89,"giacchetta"],[90,93,"per"],[94,99,"quello"],[100,109,"occasione"],[111,112,"e"],[113,116,"il"],[117,127,0],[128,130,"il"],[131,138,0],[140,145,"tanto"],[146,149,"che"],[150,152,"se"],[153,155,"il"],[156,163,"dovere"],[164,174,0],[175,177,"lì"],[178,181,"su"],[182,187,"palco"],[188,191
{"id":"a026","title":"Chi non ha coraggio non vada alla guerra・III","lv":8,"kind":"童話","note":"Carlo Collodi「Storie allegre」（1887年）の原文です。古い語や綴りがあります。","lines":[{"it":"III.","ja":"","t":[[0,3,0]]},{"it":"Un giorno, per altro, avvenne un caso orribile e spaventoso; ed ecco come andò.","ja":"","t":[[0,2,"un"],[3,9,"giorno"],[11,14,"per"],[15,20,"altro"],[22,29,"avvenire"],[30,32,"un"],[33,37,"caso"],[38,46,"orribile"],[47,48,"e"],[49,59,"spaventoso"],[61,63,"e"],[64,68,"ecco"],[69,73,"come"],[74,78,"andare"]]},{"it":"Il piccolo esercito, secondo il solito, si avanzava a marcia forzata dentro il bosco, in cerca del solito nemico.","ja":"","t":[[0,2,"il"],[3,10,"piccolo"],[11,19,"esercito"],[21,28,"secondo"],[29,31,"il"],[32,38,"solito"],[40,42,"si"],[43,51,"avanzare"],[52,53,"a"],[54,60,"marcia"],[61,68,0],[69,75,"dentro"],[76,78,"il"],[79,84,"bosco"],[86,88,"in"],[89,94,"cercare"],[95,98,"di"],[99,105,"solito"],[106,112,"nemico"]]},{"it":"Quando, tutt’a un tratto, il general Leoncino, che camminava fieramente avanti una ventina di passi, si fermò esterrefatto, e cacciando un grido acutissimo di terrore, si dètte a scappare verso casa.","ja":"","t":[[0,6,"quando"],[8,12,"tutto"],[13,14,"a"],[15,17,"un"],[18,24,"tratto"],[26,28,"il"],[29,36,0],[37,45,0],[47,50,"che"],[51,60,"camminare"],[61,71,0],[72,78,"avanti"],[79,82,"un"],[83,90,"ventina"],[91,93,"di"],[94,99,"passo"],[101,103,"si"],[104,109,"fermare"],[110,122,0],[124,125,"e"],[126,135,"cacciare"],[136,138,"un"],[139,144,"gridare"],[145,155,"acuto"],[156,158,"di"],[159,166,"terrore"],[168,170,"si"],[171,176,"dare"],[177,178,"a"],[179,187,"scappare"],[188,193,"verso"],[194,198,"casa"]]},{"it":"La sua fuga fu così precipitosa e disordinata, che per la strada perse gli sproni di latta e il berretto di generale, col gallone che pareva d’argento.","ja":"","t":[[0,2,"il"],[3,6,"suo"],[7,11,"fuga"],[12,14,"essere"],[15,19,"così"],[20,31,0],[32,33,"e"],[34,45,0],[47,50,"che"],[51,54,"per"],[55,57,"il"],[58,64,"strada"],[65,70,"perdere"],[71,74,"il"],[75,81,0],[82,84,"di"],[85,90,"latta"],[91,92,"e"],[93,95,"il"],[96,104,"berretto"],[105,107,"di"],[108,116,"generale"],[118,121,"con"],[122,129,"gallone"],[130,133,"che"],[134,140,"parere"],[141,142,"di"],[143,150,"argento"]]},{"it":"Che cosa era mai accaduto di strano?...","ja":"","t":[[0,3,"che"],[4,8,"cosa"],[9,12,"essere"],[13,16,"mai"],[17,25,"accadere"],[26,28,"di"],[29,35,"strano"]]},{"it":"Quando Leoncino arrivò alla villa, era ansante, boccheggiante e tutto paonazzo in viso, come un cocomero troppo maturo.","ja":"","t":[[0,6,"quando"],[7,15,0],[16,22,"arrivare"],[23,27,"a"],[28,33,"villa"],[35,38,"essere"],[39,46,"ansare"],[48,61,0],[62,63,"e"],[64,69,"tutto"],[70,78,0],[79,81,"in"],[82,86,"viso"],[88,92,"come"],[93,95,"un"],[96,104,0],[105,111,"troppo"],[112,118,"maturo"]]},{"it":"E per l’appunto la prima persona, in cui s’imbatté, fu lo zio.","ja":"","t":[[0,1,"e"],[2,5,"per"],[6,7,"il"],[8,15,"appunto"],[16,18,"il"],[19,24,"prima"],[25,32,"persona"],[34,36,"in"],[37,40,"cui"],[41,42,"si"],[43,50,0],[52,54,"essere"],[55,57,"il"],[58,61,"zio"]]},{"it":"Conoscete, per caso, lo zio di Leoncino?","ja":"","t":[[0,9,"conoscere"],[11,14,"per"],[15,19,"caso"],[21,23,"il"],[24,27,"zio"],[28,30,"di"],[31,39,0]]},{"it":"Lo dovete conoscere di certo, perchè chi sa quante volte lo avete incontrato per la strada: ma ora forse non ve lo rammentate più.","ja":"","t":[[0,2,"il"],[3,9,"dovere"],[10,19,"conoscere"],[20,22,"di"],[23,28,"certo"],[30,36,"perché"],[37,40,"chi"],[41,43,"sapere"],[44,50,"quanto"],[51,56,"volta"],[57,59,"il"],[60,65,"avere"],[66,76,"incontrare"],[77,80,"per"],[81,83,"il"],[84,90,"strada"],[92,94,"ma"],[95,98,"ora"],[99,104,"forse"],[105,108,"non"],[109,111,"ve"],[112,114,"il"],[115,125,"rammentare"],[126,129,"più"]]},{"it":"Figuratevi, dunque, un omone lungo lungo, grosso grosso, con un faccione largo come la luna, e con un nasone tutto pieno di nasini, da parere un grappolo d’uva.","ja":"","t":[[0,10,"figurare"],[12,18,"dunque"],[20,22,"un"],[23,28,"omone"],[29,34,"lungo"],[35,40,"lungo"],[42,48,"grosso"],[49,55,"grosso"],[57,60,"con"],[61,63,"un"],[64,72,"fare"],[73,78,"largo"],[79,83,"come"],[84,86,"il"],[87,91,"luna"],[93,94,"e"],[95,98,"con"],[99,101,"un"],[102,108,0],[109,114,"tutto"],[115,120,"pieno"],[121,123,"di"],[124,130,0],[132,134,"da"],[135,141,"parere"],[142,144,"un"],[145,153,"grappolo"],[154,155,"di"],[156,159,"uva"]]},{"it":"Di nome si chiama Giandomenico: ma tutti nel paese lo conoscono col soprannome di Nasobello.","ja":"","t":[[0,2,"di"],[3,7,"nome"],[8,10,"si"],[11,17,"chiamare"],[18,30,0],[32,34,"ma"],[35,40,"tutto"],[41,44,"in"],[45,50,"paese"],[51,53,"il"],[54,63,"conoscere"],[64,67,"con"],[68,78,"soprannome"],[79,81,"di"],[82,91,0]]},{"it":"Vedendolo la prima volta e giudicandolo dalla fisonomia burbera e accigliata, c’è da scambiarlo per un orco, per un tiranno, per un mangia-bambini, e invece.... invece, è una bonissima pasta d’uomo, burlone, allegro, e tutt’amore per i figliuoli e tutto premure e attenzioni per il suo nipotino.","ja":"","t":[[0,9,"vedere"],[10,12,"il"],[13,18,"prima"],[19,24,"volta"],[25,26,"e"],[27,39,"giudicare"],[40,45,"da"],[46,55,0],[56,63,"burbero"],[64,65,"e"],[66,76,0],[78,79,"ci"],[80,81,"essere"],[82,84,"da"],[85,95,"scambiare"],[96,99,"per"],[100,102,"un"],[103,107,"orco"],[109,112,"per"],[113,115,"un"],[116,123,"tiranno"],[125,128,"per"],[129,131,"un"],[132,138,"mangiare"],[139,146,"bambino"],[148,149,"e"],[150,156,"invece"],[161,167,"invece"],[169,170,"essere"],[171,174,"un"],[175,184,0],[185,190,"pasta"],[191,192,"di"],[193,197,"uomo"],[199,206,0],[208,215,"allegro"],[217,218,"e"],[219,223,"tutto"],[224,229,"amore"],[230,233,"per"],[234,235,"il"],[236,245,"figliuolo"],[246,247,"e"],[248,253,"tutto"],[254,261,0],[262,263,"e"],[264,274,"attenzione"],[275,278,"per"],[279,281,"il"],[282,285,"suo"],[286,294,"nipotino"]]},{"it":"Tant’è vero, che appena gli capitò davanti Leoncino scalmanato e impaurito a quel modo, il sangue gli fece un gran rimescolone e gridò subito:","ja":"","t":[[0,4,0],[5,6,"essere"],[7,11,"vero"],[13,16,"che"],[17,23,"appena"],[24,27,"il"],[28,34,"capitare"],[35,42,"davanti"],[43,51,0],[52,62,0],[63,64,"e"],[65,74,"impaurito"],[75,76,"a"],[77,81,"quello"],[82,86,"modo"],[88,90,"il"],[91,97,"sangue"],[98,101,"il"],[102,106,"fare"],[107,109,"un"],[110,114,"grande"],[115,126,0],[127,128,"e"],[129,134,"gridare"],[135,141,"subito"]]},{"it":"― Che cos’è stato?","ja":"","t":[[2,5,"che"],[6,9,"cosa"],[10,11,"essere"],[12,17,"essere"]]},{"it":"Perchè hai il viso così acceso?...","ja":"","t":[[0,6,"perché"],[7,10,"avere"],[11,13,"il"],[14,18,"viso"],[19,23,"così"],[24,30,"accendere"]]},{"it":"Dove sono rimasti i tuoi cugini?","ja":"","t":[[0,4,"dove"],[5,9,"essere"],[10,17,"rimanere"],[18,19,"il"],[20,24,"tuo"],[25,31,"cugino"]]},{"it":"―","ja":"","t":[]},{"it":"Il ragazzo stintignava a rispondere: pareva quasi che si vergognasse.","ja":"","t":[[0,2,"il"],[3,10,"ragazzo"],[11,22,0],[23,24,"a"],[25,35,"rispondere"],[37,43,"parere"],[44,49,"quasi"],[50,53,"che"],[54,56,"si"],[57,68,"vergognarsi"]]},{"it":"― Dunque?...","ja":"","t":[[2,8,"dunque"]]},{"it":"― insisté lo zio, alzando sempre più la voce.","ja":"","t":[[2,9,"insistere"],[10,12,"il"],[13,16,"zio"],[18,25,"alzare"],[26,32,"sempre"],[33,36,"più"],[37,39,"il"],[40,44,"voce"]]},{"it":"― Ecco.... dirò.... una bestia così brutta....","ja":"","t":[[2,6,"ecco"],[11,15,"dire"],[20,23,"un"],[24,30,"bestia"],[31,35,"così"],[36,42,"brutto"]]},{"it":"― Quale bestia?...","ja":"","t":[[2,7,"quale"],[8,14,"bestia"]]},{"it":"― Io....","ja":"","t":[[2,4,"io"]]},{"it":"― Come? tu sei una bestia?...","ja":"","t":[[2,6,"come"],[8,10,"tu"],[11,14,"essere"],[15,18,"un"],[19,25,"bestia"]]},{"it":"― Io, no: quell’altra, che ho trovata nel bosco....","ja":"","t":[[2,4,"io"],[6,8,"no"],[10,15,"quello"],[16,21,"altro"],[23,26,"che"],[27,29,"avere"],[30,37,"trovare"],[38,41,"in"],[42,47,"bosco"]]},{"it":"― Non capisco nulla: ma spiegati, per carità!...","ja":"","t":[[2,5,"non"],[6,13,"capire"],[14,19,"nulla"],[21,23,"ma"],[24,32,"spiegare"],[34,37,"per"],[38,44,"carità"]]},{"it":"Dov’hai lasciato i tuoi cugini?","ja":"","t":[[0,3,"dove"],[4,7,"avere"],[8,16,"lasciare"],[17,18,"il"],[19,23,"tuo"],[24,30,"cugino"]]},{"it":"― Fra poco verranno....","ja":"","t":[[2,5,"fra"],[6,10,"poco"],[11,19,"venire"]]},{"it":"― Eccoci qui! eccoci qui!","ja":"","t":[[2,8,0],[9,12,"qui"],[14,20,0],[21,24,"qui"]]},{"it":"― gridarono di fuori cinque voci argentine e squillanti, come tanti campanelli.","ja":"","t":[[2,11,"gridare"],[12,14,"di"],[15,20,"fuori"],[21,27,"cinque"],[28,32,"voce"],[33,42,"Argentina"],[43,44,"e"],[45,55,0],[57,61,"come"],[62,67,"tanto"],[68,78,"campanello"]]},{"it":"E nel tempo stesso entrarono in sala i cinque ragazzi, che si buttavano via dalle matte risate.","ja":"","t":[[0,1,"e"],[2,5,"in"],[6,11,"tempo"],[12,18,"stesso"],[19,28,"entrare"],[29,31,"in"],[32,36,"sala"],[37,38,"il"],[39,45,"cinque"],[46,53,"ragazzo"],[55,58,"che"],[59,61,"si"],[62,71,"buttare"],[72,75,"via"],[76,81,"da"],[82,87,"matto"],[88,94,"risata"]]},{"it":"Il babbo, che non sapeva il motivo di questo gran buon umore, disse allora con accento risentito:","ja":"","t":[[0,2,"il"],[3,8,"babbo"],[10,13,"che"],[14,17,"non"],[18,24,"sapere"],[25,27,"il"],[28,34,"motivo"],[35,37,"di"],[38,44,"questo"],[45,49,"grande"],[50,54,"buono"],[55,60,"umore"],[62,67,"dire"],[68,74,"allora"],[75,78,"con"],[79,86,"accento"],[87,96,"risentire"]]},{"it":"― Finitela una volta!","ja":"","t":[[2,10,"finire"],[11,14,"un"],[15,20,"volta"]]},{"it":"Si potrebbe sapere almeno di chi ridete?","ja":"","t":[[0,2,"si"],[3,11,"potere"],[12,18,"sapere"],[19,25,"almeno"],[26,28,"di"],[29,32,"chi"],[33,39,"ridere"]]},{"it":"― Si ride di lui!...","ja":"","t":[[2,4,"si"],[5,9,"ridere"],[10,12,"di"],[13,16,"lui"]]},{"it":"E accennando Leoncino, dettero in una risata più forte.","ja":"","t":[[0,1,"e"],[2,12,"accennare"],[13,21,0],[23,30,"dare"],[31,33,"in"],[34,37,"un"
"],[126,127,"e"],[128,131,"non"],[132,134,"ti"],[135,140,"venire"],[141,144,"mai"],[145,146,"il"],[147,152,0],[153,155,"di"],[156,164,"abbaiare"],[165,166,"e"],[167,169,"dire"],[170,179,"svegliare"],[180,182,"il"],[183,192,"contadino"]]},{"it":"— E Melampo faceva proprio così?","ja":"","t":[[2,3,"e"],[4,11,0],[12,18,"fare"],[19,26,"proprio"],[27,31,"così"]]},{"it":"— domandò Pinocchio.","ja":"","t":[[2,9,"domandare"],[10,19,0]]},{"it":"— Faceva così, e fra noi e lui, siamo andati sempre d’accordo.","ja":"","t":[[2,8,"fare"],[9,13,"così"],[15,16,"e"],[17,20,"fra"],[21,24,"noi"],[25,26,"e"],[27,30,"lui"],[32,37,"essere"],[38,44,"andare"],[45,51,"sempre"],[52,53,"di"],[54,61,"accordo"]]},{"it":"Dormi dunque tranquillamente, e stai sicuro che prima di partire di qui ti lasceremo sul casotto una gallina bell’e pelata per la colazione di domani.","ja":"","t":[[0,5,"dormire"],[6,12,"dunque"],[13,28,"tranquillamente"],[30,31,"e"],[32,36,"stare"],[37,43,"sicuro"],[44,47,"che"],[48,53,"prima"],[54,56,"Dio"],[57,64,"partire"],[65,67,"di"],[68,71,"qui"],[72,74,"ti"],[75,84,"lasciare"],[85,88,"su"],[89,96,"casotto"],[97,100,"un"],[101,108,"gallina"],[109,113,"bello"],[114,115,"e"],[116,122,0],[123,126,"per"],[127,129,"il"],[130,139,"colazione"],[140,142,"di"],[143,149,"domani"]]},{"it":"Ci siamo intesi bene?","ja":"","t":[[0,2,"ci"],[3,8,"essere"],[9,15,"intendere"],[16,20,"bene"]]},{"it":"— Anche troppo bene!…","ja":"","t":[[2,7,"anche"],[8,14,"troppo"],[15,19,"bene"]]},{"it":"— rispose Pinocchio: e tentennò il capo in un certo modo minaccioso, come se avesse voluto dire: — Fra poco ci riparleremo!…","ja":"","t":[[2,9,"rispondere"],[10,19,0],[21,22,"e"],[23,31,0],[32,34,"il"],[35,39,"capo"],[40,42,"in"],[43,45,"un"],[46,51,"certo"],[52,56,"modo"],[57,67,0],[69,73,"come"],[74,76,"se"],[77,83,"avere"],[84,90,"volere"],[91,95,"dire"],[99,102,"fra"],[103,107,"poco"],[108,110,"ci"],[111,122,0]]},{"it":"—","ja":"","t":[]},{"it":"Quando le quattro faine si credettero sicure del fatto loro, andarono difilato al pollaio, che rimaneva appunto vicinissimo al casotto del cane; e aperta a furia di denti e di unghioli la porticina di legno, che ne chiudeva l’entrata, vi sgusciarono dentro, una dopo l’altra.","ja":"","t":[[0,6,"quando"],[7,9,"il"],[10,17,"quattro"],[18,23,"fare"],[24,26,"si"],[27,37,"credere"],[38,44,"sicuro"],[45,48,"di"],[49,54,"fare"],[55,59,"loro"],[61,69,"andare"],[70,78,0],[79,81,"a"],[82,89,"pollaio"],[91,94,"che"],[95,103,"rimanere"],[104,111,"appunto"],[112,123,"vicino"],[124,126,"a"],[127,134,"casotto"],[135,138,"di"],[139,143,"cane"],[145,146,"e"],[147,153,"aprire"],[154,155,"a"],[156,161,"furia"],[162,164,"di"],[165,170,"dente"],[171,172,"e"],[173,175,"dire"],[176,184,0],[185,187,"il"],[188,197,0],[198,200,"di"],[201,206,"legno"],[208,211,"che"],[212,214,"ne"],[215,223,"chiudere"],[224,225,"il"],[226,233,"entrata"],[235,237,"vi"],[238,249,0],[250,256,"dentro"],[258,261,"un"],[262,266,"dopo"],[267,268,"il"],[269,274,"altro"]]},{"it":"Ma non erano ancora finite d’entrare, che sentirono la porticina richiudersi con grandissima violenza.","ja":"","t":[[0,2,"ma"],[3,6,"non"],[7,12,"essere"],[13,19,"ancora"],[20,26,"finire"],[27,28,"di"],[29,36,"entrare"],[38,41,"che"],[42,51,"sentire"],[52,54,"il"],[55,64,0],[65,76,"richiudere"],[77,80,"con"],[81,92,"grande"],[93,101,"violenza"]]},{"it":"Quello che l’aveva richiusa era Pinocchio; il quale, non contento di averla richiusa, vi passò davanti per maggior sicurezza una grossa pietra, a guisa di puntello.","ja":"","t":[[0,6,"quello"],[7,10,"che"],[11,12,"il"],[13,18,"avere"],[19,27,"richiudere"],[28,31,"essere"],[32,41,0],[43,45,"il"],[46,51,"quale"],[53,56,"non"],[57,65,"contento"],[66,68,"di"],[69,75,"avere"],[76,84,"richiudere"],[86,88,"vi"],[89,94,"passare"],[95,102,"davanti"],[103,106,"per"],[107,114,0],[115,124,"sicurezza"],[125,128,"un"],[129,135,"grosso"],[136,142,"pietra"],[144,145,"a"],[146,151,0],[152,154,"di"],[155,163,0]]},{"it":"E poi cominciò ad abbaiare: e, abbaiando pr
{"id":"u010","title":"Ottobre・Il piccolo patriotta padovano","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL PICCOLO PATRIOTTA PADOVANO","ja":"","t":[[0,2,"il"],[3,10,"piccolo"],[11,20,0],[21,29,0]]},{"it":"(Racconto mensile)","ja":"","t":[[1,9,"racconto"],[10,17,"mensile"]]},{"it":"29, sabato.","ja":"","t":[[4,10,"sabato"]]},{"it":"Non sarò un soldato codardo, no; ma ci andrei molto più volentieri alla scuola, se il maestro ci facesse ogni giorno un racconto come quello di questa mattina.","ja":"","t":[[0,3,"non"],[4,8,"essere"],[9,11,"un"],[12,19,"soldato"],[20,27,0],[29,31,"no"],[33,35,"ma"],[36,38,"ci"],[39,45,"andare"],[46,51,"molto"],[52,55,"più"],[56,66,"volentieri"],[67,71,"a"],[72,78,"scuola"],[80,82,"se"],[83,85,"il"],[86,93,"maestro"],[94,96,"ci"],[97,104,"fare"],[105,109,"ogni"],[110,116,"giorno"],[117,119,"un"],[120,128,"racconto"],[129,133,"come"],[134,140,"quello"],[141,143,"di"],[144,150,"questo"],[151,158,"mattina"]]},{"it":"Ogni mese, disse, ce ne farà uno, ce lo darà scritto, e sarà sempre il racconto d’un atto bello e vero, compiuto da un ragazzo.","ja":"","t":[[0,4,"ogni"],[5,9,"mese"],[11,16,"dire"],[18,20,"ce"],[21,23,"ne"],[24,28,"fare"],[29,32,"un"],[34,36,"ce"],[37,39,"il"],[40,44,"dare"],[45,52,"scrivere"],[54,55,"e"],[56,60,"essere"],[61,67,"sempre"],[68,70,"il"],[71,79,"racconto"],[80,81,"di"],[82,84,"un"],[85,89,"atto"],[90,95,"bello"],[96,97,"e"],[98,102,"vero"],[104,112,"compiere"],[113,115,"da"],[116,118,"un"],[119,126,"ragazzo"]]},{"it":"Il piccolo patriotta padovano s’intitola questo.","ja":"","t":[[0,2,"il"],[3,10,"piccolo"],[11,20,0],[21,29,0],[30,31,"si"],[32,40,"intitolare"],[41,47,"questo"]]},{"it":"Ecco il fatto.","ja":"","t":[[0,4,"ecco"],[5,7,"il"],[8,13,"fare"]]},{"it":"Un piroscafo francese partì da Barcellona, città della Spagna, per Genova, e c’erano a bordo francesi, italiani, spagnuoli, svizzeri.","ja":"","t":[[0,2,"un"],[3,12,"piroscafo"],[13,21,"francese"],[22,27
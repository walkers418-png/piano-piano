{"id":"g016","title":"26 ottobre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Ricordo perfettamente che tagliai con un temperino i lenzuoli del letto in tante strisce, che le annodai insieme, che le fermai da un lato a una gamba del tavolino, e che afferrandomi ad esse, mi calai arditamente fuor della finestra.","ja":"","t":[[0,7,"ricordo"],[8,21,"perfettamente"],[22,25,"che"],[26,33,"tagliare"],[34,37,"con"],[38,40,"un"],[41,50,"temperino"],[51,52,"il"],[53,61,"lenzuolo"],[62,65,"di"],[66,71,"letto"],[72,74,"in"],[75,80,"tanto"],[81,88,"striscia"],[90,93,"che"],[94,96,"il"],[97,104,0],[105,112,"insieme"],[114,117,"che"],[118,120,"il"],[121,127,"fermare"],[128,130,"da"],[131,133,"un"],[134,138,"lato"],[139,140,"a"],[141,144,"un"],[145,150,"gamba"],[151,154,"di"],[155,163,"tavolino"],[165,166,"e"],[167,170,"che"],[171,183,"afferrare"],[184,186,"a"],[187,191,0],[193,195,"mi"],[196,201,"calare"],[202,213,"arditamente"],[214,218,"fuori"],[219,224,"di"],[225,233,"finestra"]]},{"it":"Ma a questo punto i ricordi mi si confondono...","ja":"","t":[[0,2,"ma"],[3,4,"a"],[5,11,"questo"],[12,17,"punto"],[18,19,"il"],[20,27,"ricordo"],[28,30,"mi"],[31,33,"si"],[34,44,"confondere"]]},{"it":"Battei la testa, questo è certo, ma dove?","ja":"","t":[[0,6,"battere"],[7,9,"il"],[10,15,"testa"],[17,23,"questo"],[24,25,"essere"],[26,31,"certo"],[33,35,"ma"],[36,40,"dove"]]},{"it":"Mi pare nel canale della doccia...","ja":"","t":[[0,2,"mi"],[3,7,"parere"],[8,11,"in"],[12,18,"canale"],[19,24,"di"],[25,31,"doccia"]]},{"it":"Poi battei un fianco in terra...","ja":"","t":[[0,3,"poi"],[4,10,"battere"],[11,13,"un"],[14,20,"fianco"],[21,23,"in"],[24,29,"terra"]]},{"it":"Forse le strisce del lenzuolo si strapparono...","ja":"","t":[[0,5,"forse"],[6,8,"il"],[9,16,"striscia"],[17,20,"di"],[21,29,"lenzuolo"],[30,32,"si"],[33,44,"strappare"]]},{"it":"Forse non eran fermate bene al tavolino...","ja":"","t":[[0,5,"forse"],[6,9,"non"],[10,14,"essere"],[15,22,"fermare"],[23,27,"bene"],[28,30,"a"],[31,39,"tavolino"]]},{"it":"Non so...","ja":"","t":[[0,3,"non"],[4,6,"sapere"]]},{"it":"Il fatto è che a un tratto vidi tutte le stelle... e poi buio pesto!","ja":"","t":[[0,2,"il"],[3,8,"fare"],[9,10,"essere"],[11,14,"che"],[15,16,"a"],[17,19,"un"],[20,26,"tratto"],[27,31,"vedere"],[32,37,"tutto"],[38,40,"il"],[41,47,"stella"],[51,52,"e"],[53,56,"poi"],[57,61,"buio"],[62,67,"pestare"]]},{"it":"Ah! rammento che quando riaprii gli occhi mi trovai qui in letto, e vidi il babbo che girava in su e in giù e si dava i pugni in testa dicendo:","ja":"","t":[[0,2,"ah"],[4,12,"rammentare"],[13,16,"che"],[17,23,"quando"],[24,31,"riaprire"],[32,35,"il"],[36,41,"occhio"],[42,44,"mi"],[45,51,"trovare"],[52,55,"qui"],[56,58,"in"],[59,64,"letto"],[66,67,"e"],[68,72,"vedere"],[73,75,"il"],[76,81,"babbo"],[82,85,"che"],[86,92,"girare"],[93,95,"in"],[96,98,"su"],[99,100,"e"],[101,103,"in"],[104,107,"giù"],[108,109,"e"],[110,112,"si"],[113,117,"dare"],[118,119,"il"],[120,125,"pugno"],[126,128,"in"],[129,134,"testa"],[135,142,"dire"]]},{"it":"- È impossibile!","ja":"","t":[[2,3,"essere"],[4,15,"impossibile"]]},{"it":"È impossibile!","ja":"","t":[[0,1,"essere"],[2,13,"impossibile"]]},{"it":"Questo ragazzo è la mia disperazione!","ja":"","t":[[0,6,"questo"],[7,14,"ragazzo"],[15,16,"essere"],[17,19,"il"],[20,23,"mio"],[24,36,"disperazione"]]},{"it":"Sarà la mia rovina!...","ja":"","t":[[0,4,"essere"],[5,7,"il"],[8,11,"mio"],[12,18,"rovina"]]},{"it":"Io avrei voluto chiedergli perdono di essermi rotto la testa, ma non potevo parlare...","ja":"","t":[[0,2,"io"],[3,8,"avere"],[9,15,"volere"],[16,26,"chiedere"],[27,34,"perdere"],[35,37,"di"],[38,45,"essere"],[46,51,"rompere"],[52,54,"il"],[55,60,"testa"],[62,64,"ma"],[65,68,"non"],[69,75,"potere"],[76,83,"parlare"]]},{"it":"Poi è venuto il dottore, mi ha fasciato ben bene, e alla mamma che piangeva ha detto:","ja":"","t":[[0,3,"poi"],[4,5,"essere"],[6,12,"venire"],[13,15
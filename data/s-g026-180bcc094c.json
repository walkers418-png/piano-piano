cipii e senza religione, e che lei non avrebbe mai e poi mai dato il suo consenso.","ja":"","t":[[0,2,"il"],[3,8,"mamma"],[10,16,"appena"],[17,18,"il"],[19,21,"avere"],[22,28,"sapere"],[29,30,"si"],[31,32,"essere"],[33,38,"mettere"],[39,40,"a"],[41,47,"urlare"],[48,51,"che"],[52,59,"essere"],[60,65,"essere"],[66,68,"un"],[69,76,"delitto"],[77,79,"il"],[80,91,"sacrificare"],[92,95,"un"],[96,102,"povero"],[103,112,"figliuola"],[113,118,"in"],[119,123,"mano"],[124,126,"di"],[127,132,"quello"],[133,137,"uomo"],[138,143,"senza"],[144,153,0],[154,155,"e"],[156,161,"senza"],[162,171,"religione"],[173,174,"e"],[175,178,"che"],[179,182,"lei"],[183,186,"non"],[187,194,"avere"],[195,198,"mai"],[199,200,"e"],[201,204,"poi"],[205,208,"mai"],[209,213,"dare"],[214,216,"il"],[217,220,"suo"],[221,229,"consenso"]]},{"it":"Il babbo, invece, sostiene che il Maralli è un ottimo partito per Virginia, sotto tutti gli aspetti, perché è un giovane molto avveduto e che farà carriera e che bisogna adattarsi ai tempi, molto più che oggi l’essere socialista non è una cosa brutta come venti anni sono.","ja":"","t":[[0,2,"il"],[3,8,"babbo"],[10,16,"invece"],[18,26,"sostenere"],[27,30,"che"],[31,33,"il"],[34,41,0],[42,43,"essere"],[44,46,"un"],[47,53,"ottimo"],[54,61,"partire"],[62,65,"per"],[66,74,0],[76,81,"sotto"],[82,87,"tutto"],[88,91,"il"],[92,99,"aspetto"],[101,107,"perché"],[108,109,"essere"],[110,112,"un"],[113,120,"giovane"],[121,126,"molto"],[127,135,0],[136,137,"e"],[138,141,"che"],[142,146,"fare"],[147,155,"carriera"],[156,157,"e"],[158,161,"che"],[162,169,"bisognare"],[170,179,"adattare"],[180,182,"a"],[183,188,"tempo"],[190,195,"molto"],[196,199,"più"],[200,203,"che"],[204,208,"oggi"],[209,210,"il"],[211,217,"essere"],[218,228,"socialista"],[229,232,"non"],[233,234,"essere"],[235,238,"un"],[239,243,"cosa"],[244,250,"brutto"],[251,255,"come"],[256,261,"venti"],[262,266,"anno"],[267,271,"essere"]]},{"it":"Virginia dà ragione al babbo, e ha detto che il Maralli è quel che si può deside
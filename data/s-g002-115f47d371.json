etto; Ada mi ha portato una tazza di brodo caldo bollente; e tutti, anche le persone di servizio, sono stati intorno a me, fino all’ora di andare a desinare.","ja":"","t":[[0,5,0],[6,8,"mi"],[9,11,"avere"],[12,17,"mettere"],[18,24,"subito"],[25,26,"a"],[27,32,"letto"],[34,37,0],[38,40,"mi"],[41,43,"avere"],[44,51,"portare"],[52,55,"un"],[56,61,"tazza"],[62,64,"di"],[65,70,"brodo"],[71,76,"caldo"],[77,85,"bollente"],[87,88,"e"],[89,94,"tutto"],[96,101,"anche"],[102,104,"il"],[105,112,"persona"],[113,115,"di"],[116,124,"servizio"],[126,130,"essere"],[131,136,"essere"],[137,144,"intorno"],[145,146,"a"],[147,149,"me"],[151,155,"fino"],[156,159,"a"],[160,163,"ora"],[164,166,"di"],[167,173,"andare"],[174,175,"a"],[176,184,0]]},{"it":"Poi, lasciandomi così infagottato nelle coperte, da farmi davvero morire di soffocazione, sono andati giù, raccomandandomi di star buono e di non muovermi.","ja":"","t":[[0,3,"poi"],[5,16,"lasciare"],[17,21,"così"],[22,33,0],[34,39,"in"],[40,47,"coperta"],[49,51,"da"],[52,57,"fare"],[58,65,"davvero"],[66,72,"morire"],[73,75,"di"],[76,88,0],[90,94,"essere"],[95,101,"andare"],[102,105,"giù"],[107,122,"raccomandare"],[123,125,"di"],[126,130,"stare"],[131,136,"buono"],[137,138,"e"],[139,141,"dire"],[142,145,"non"],[146,154,"muovere"]]},{"it":"Ma era possibile questo, per un ragazzo della mia età?","ja":"","t":[[0,2,"ma"],[3,6,"essere"],[7,16,"possibile"],[17,23,"questo"],[25,28,"per"],[29,31,"un"],[32,39,"ragazzo"],[40,45,"di"],[46,49,"mio"],[50,53,"età"]]},{"it":"Che cosa ho fatto appena son rimasto solo?","ja":"","t":[[0,3,"che"],[4,8,"cosa"],[9,11,"avere"],[12,17,"fare"],[18,24,"appena"],[25,28,"essere"],[29,36,"rimanere"],[37,41,"solo"]]},{"it":"Mi sono levato, ho tirato fuori dall’armadio il mio vestitino buono a quadrettini, mi son vestito, e scendendo pian piano le scale per non farmi sentire, sono andato a nascondermi sotto la tenda della finestra, in salotto.","ja":"","t":[[0,2,"mi"],[3,7,"essere"],[8,14,"levare"],[16,18,"avere"],[19,25,
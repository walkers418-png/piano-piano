{"id":"g084","title":"6 febbraio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"6 febbraio.","ja":"","t":[[2,10,"febbraio"]]},{"it":"È vicina la sveglia, giornalino mio, e io ho molti fatti da registrare.","ja":"","t":[[0,1,"essere"],[2,8,"vicina"],[9,11,"il"],[12,19,"svegliare"],[21,31,0],[32,35,"mio"],[37,38,"e"],[39,41,"io"],[42,44,"avere"],[45,50,"molto"],[51,56,"fare"],[57,59,"da"],[60,70,"registrare"]]},{"it":"Prima di tutto una lieta notizia: i convittori del collegio Pierpaoli non mangeranno più minestra di riso per un pezzo!","ja":"","t":[[0,5,"prima"],[6,8,"Dio"],[9,14,"tutto"],[15,18,"un"],[19,24,0],[25,32,"notizia"],[34,35,"il"],[36,46,0],[47,50,"di"],[51,59,"collegio"],[60,69,0],[70,73,"non"],[74,84,"mangiare"],[85,88,"più"],[89,97,"minestra"],[98,100,"di"],[101,105,"riso2"],[106,109,"per"],[110,112,"un"],[113,118,"pezzo"]]},{"it":"Iersera, quando tutti dormivano, io che stavo sull’attenti sentii nella porta del dormitorio un lieve sgretolo a più riprese, come quello di un tarlo.","ja":"","t":[[0,7,"iersera"],[9,15,"quando"],[16,21,"tutto"],[22,31,"dormire"],[33,35,"io"],[36,39,"che"],[40,45,"stare"],[46,50,"su"],[51,58,"attento"],[59,65,"sentire"],[66,71,"in"],[72,77,"porta"],[78,81,"di"],[82,92,"dormitorio"],[93,95,"un"],[96,101,0],[102,110,0],[111,112,"a"],[113,116,"più"],[117,124,"riprendere"],[126,130,"come"],[131,137,"quello"],[138,140,"di"],[141,143,"un"],[144,149,0]]},{"it":"Era il segnale convenuto: il Michelozzi raschiava la porta con l’unghia per avvertirmi di portar fuori il bottiglione pieno di petrolio, ciò che io feci in un batter d’occhio.","ja":"","t":[[0,3,"essere"],[4,6,"il"],[7,14,"segnale"],[15,24,"convenire"],[26,28,"il"],[29,39,0],[40,49,0],[50,52,"il"],[53,58,"porta"],[59,62,"con"],[63,64,"il"],[65,71,"unghia"],[72,75,"per"],[76,86,"avvertire"],[87,89,"di"],[90,96,"portare"],[97,102,"fuori"],[103,105,"il"],[106,117,0],[118,123,"pieno"],[124,126,"di"],
a del gabinetto di fisica e apre benissimo anche questa porta...","ja":"","t":[[0,1,"essere"],[2,8,"quello"],[9,12,"di"],[13,22,"gabinetto"],[23,25,"di"],[26,32,"fisico"],[33,34,"e"],[35,39,"aprire"],[40,49,"bene"],[50,55,"anche"],[56,62,"questo"],[63,68,"porta"]]},{"it":"Fa’ piano... -","ja":"","t":[[0,2,"fare"],[4,9,"piano"]]},{"it":"Presi la chiave, la introdussi pian piano e la girai nella serratura adagino adagino...","ja":"","t":[[0,5,"prendere"],[6,8,"il"],[9,15,"chiave"],[17,19,"il"],[20,30,"introdurre"],[31,35,0],[36,41,"piano"],[42,43,"e"],[44,46,"il"],[47,52,"girare"],[53,58,"in"],[59,68,"serratura"],[69,76,0],[77,84,0]]},{"it":"La porticina si aprì ed entrammo.","ja":"","t":[[0,2,"il"],[3,12,"porticina"],[13,15,"si"],[16,20,"aprire"],[21,23,"e"],[24,32,"entrare"]]},{"it":"Il magazzino era fiocamente illuminato dal chiarore che veniva da un finestrino aperto sulla parete difaccia alla porta, in alto; e a quella luce incerta vedemmo da un lato una fila di balle aperte, con della roba bianca...","ja":"","t":[[0,2,"il"],[3,12,"magazzino"],[13,16,"essere"],[17,27,0],[28,38,"illuminare"],[39,42,"da"],[43,51,"chiarore"],[52,55,"che"],[56,62,"venire"],[63,65,"da"],[66,68,"un"],[69,79,"finestrino"],[80,86,"aperto"],[87,92,"su"],[93,99,"parete"],[100,108,0],[109,113,"a"],[114,119,"porta"],[121,123,"in"],[124,128,"alto"],[130,131,"e"],[132,133,"a"],[134,140,"quello"],[141,145,"luce"],[146,153,"incerto"],[154,161,"vedere"],[162,164,"da"],[165,167,"un"],[168,172,"lato"],[173,176,"un"],[177,181,"fila"],[182,184,"di"],[185,190,0],[191,197,"aprire"],[199,202,"con"],[203,208,"di"],[209,213,"roba"],[214,220,"bianco"]]},{"it":"Vi misi le mani; era il riso, quell’odiato riso che nel collegio Pierpaoli ci era servito a tutti i pasti, tutti i giorni, meno il Venerdi e la domenica...","ja":"","t":[[0,2,"vi"],[3,7,"mettere"],[8,10,"il"],[11,15,"mano"],[17,20,"essere"],[21,23,"il"],[24,28,"riso2"],[30,35,"quello"],[36,42,"odiare"],[43,47,"riso2"],[48,51,"che"],[52,55,"in"],[56,6
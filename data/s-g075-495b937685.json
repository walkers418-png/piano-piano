{"id":"g075","title":"20 gennaio","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"20 gennaio.","ja":"","t":[[3,10,"gennaio"]]},{"it":"Stamani Virginia s’è intromessa nella questione tra me e il Maralli e pare che egli non mi riporti a casa mia come aveva minacciato di fare.","ja":"","t":[[0,7,"stamani"],[8,16,0],[17,18,"si"],[19,20,"essere"],[21,31,0],[32,37,"in"],[38,47,"questione"],[48,51,"tra"],[52,54,"me"],[55,56,"e"],[57,59,"il"],[60,67,0],[68,69,"e"],[70,74,"parere"],[75,78,"che"],[79,83,"egli"],[84,87,"non"],[88,90,"mi"],[91,98,"riportare"],[99,100,"a"],[101,105,"casa"],[106,109,"mio"],[110,114,"come"],[115,120,"avere"],[121,131,"minacciare"],[132,134,"di"],[135,139,"fare"]]},{"it":"- Che badi bene, però, - ha detto a mia sorella - che badi di rigar diritto!","ja":"","t":[[2,5,"che"],[6,10,"badare"],[11,15,"bene"],[17,21,"però"],[25,27,"avere"],[28,33,"dire"],[34,35,"a"],[36,39,"mio"],[40,47,"sorella"],[50,53,"che"],[54,58,"badare"],[59,61,"di"],[62,67,0],[68,75,"diritto"]]},{"it":"Io mi son già pentito di quel che ho fatto per lui, e ormai basta una goccia per far traboccare il vaso!... -","ja":"","t":[[0,2,"io"],[3,5,"mi"],[6,9,"essere"],[10,13,"già"],[14,21,"pentirsi"],[22,24,"di"],[25,29,"quello"],[30,33,"che"],[34,36,"avere"],[37,42,"fare"],[43,46,"per"],[47,50,"lui"],[52,53,"e"],[54,59,"ormai"],[60,65,"bastare"],[66,69,"un"],[70,76,"goccia"],[77,80,"per"],[81,84,"fare"],[85,95,0],[96,98,"il"],[99,103,"vaso"]]}],"q":[],"g":{},"n":64,"w":["a","avere","badare","bastare","bene","casa","che","come","di","dire","diritto","e","egli","essere","fare","gennaio","già","goccia","il","in","io","lui","me","mi","minacciare","mio","non","ormai","parere","pentirsi","per","però","quello","questione","riportare","si","sorella","stamani","tra","un","vaso"]}
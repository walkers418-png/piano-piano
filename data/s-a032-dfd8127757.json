{"id":"a032","title":"Chi non ha coraggio non vada alla guerra・IX","lv":8,"kind":"童話","note":"Carlo Collodi「Storie allegre」（1887年）の原文です。古い語や綴りがあります。","lines":[{"it":"IX.","ja":"","t":[[0,2,0]]},{"it":"Sentendo parlar tanto di quella volpe, Leoncino domandò al guardaboschi dello zio:","ja":"","t":[[0,8,"sentire"],[9,15,"parlare"],[16,21,"tanto"],[22,24,"di"],[25,31,"quello"],[32,37,"volpe"],[39,47,0],[48,55,"domandare"],[56,58,"a"],[59,71,0],[72,77,"di"],[78,81,"zio"]]},{"it":"― Dimmi, Tonio, come sono grosse le volpi?","ja":"","t":[[2,7,"dire"],[9,14,0],[16,20,"come"],[21,25,"essere"],[26,32,"grosso"],[33,35,"il"],[36,41,"volpe"]]},{"it":"― Le volpi ― rispose il guardaboschi ― somigliano molto ai cani; con questa differenza, che hanno la coda assai più grossa, un codone che pare una spazzola.","ja":"","t":[[2,4,"il"],[5,10,"volpe"],[13,20,"rispondere"],[21,23,"il"],[24,36,0],[39,49,"somigliare"],[50,55,"molto"],[56,58,"a"],[59,63,"cane"],[65,68,"con"],[69,75,"questo"],[76,86,"differenza"],[88,91,"che"],[92,97,"avere"],[98,100,"il"],[101,105,"coda"],[106,111,"assai"],[112,115,"più"],[116,122,"grosso"],[124,126,"un"],[127,133,0],[134,137,"che"],[138,142,"parere"],[143,146,"un"],[147,155,"spazzola"]]},{"it":"Non le ha mai vedute, lei, le volpi?","ja":"","t":[[0,3,"non"],[4,6,"il"],[7,9,"avere"],[10,13,"mai"],[14,20,"vedere"],[22,25,"lei"],[27,29,"il"],[30,35,"volpe"]]},{"it":"― Mai.","ja":"","t":[[2,5,"mai"]]},{"it":"― Vuol vederne una?","ja":"","t":[[2,6,"volere"],[7,14,"vedere"],[15,18,"un"]]},{"it":"― Una volpe viva?...","ja":"","t":[[2,5,"un"],[6,11,"volpe"],[12,16,"vivere"]]},{"it":"― No, morta.","ja":"","t":[[2,4,"no"],[6,11,"morire"]]},{"it":"La trovai cinque anni fa nel bosco, l’ammazzai con una schioppettata, e poi la volli impagliare.... ossia, riempire da me: ma non lo dico per vantazione, l’è impagliata così bene, che c’è da scambiarla per una volpe viva.","ja":"","t":[[0,2,"il"],[3,9,"trovare"],[10,16,"cinque"],[17,21,"anno"],[22,24,"fa2"],[25,28,"in"],[29,34,"bosco"],[36,37,"il"],[38,46,0],[47,50,"con"],[51,54,"un"],[55,68,0],[70,71,"e"],[72,75,"poi"],[76,78,"il"],[79,84,"volere"],[85,95,0],[100,105,"ossia"],[107,115,"riempire"],[116,118,"da"],[119,121,"me"],[123,125,"ma"],[126,129,"non"],[130,132,"il"],[133,137,"dire"],[138,141,"per"],[142,152,0],[154,155,"il"],[156,157,"essere"],[158,168,0],[169,173,"così"],[174,178,"bene"],[180,183,"che"],[184,185,"ci"],[186,187,"essere"],[188,190,"da"],[191,201,"scambiare"],[202,205,"per"],[206,209,"un"],[210,215,"volpe"],[216,220,"vivere"]]},{"it":"Se lei vuol vederla, venga a casa mia e potrà levarsi questa curiosità.","ja":"","t":[[0,2,"se"],[3,6,"lei"],[7,11,"volere"],[12,19,"vedere"],[21,26,"venire"],[27,28,"a"],[29,33,"casa"],[34,37,"mio"],[38,39,"e"],[40,45,"potere"],[46,53,"levare"],[54,60,"questo"],[61,70,"curiosità"]]},{"it":"― Quando posso venire?","ja":"","t":[[2,8,"quando"],[9,14,"potere"],[15,21,"venire"]]},{"it":"― Anche domattina.","ja":"","t":[[2,7,"anche"],[8,17,"domattina"]]},{"it":"― A che ora?","ja":"","t":[[2,3,"a"],[4,7,"che"],[8,11,"ora"]]},{"it":"― Di prima levata, avanti che io vada al bosco.","ja":"","t":[[2,4,"di"],[5,10,"prima"],[11,17,"levare"],[19,25,"avanti"],[26,29,"che"],[30,32,"io"],[33,37,"andare"],[38,40,"a"],[41,46,"bosco"]]},{"it":"―","ja":"","t":[]},{"it":"Leoncino non intese a sordo.","ja":"","t":[[0,8,0],[9,12,"non"],[13,19,"intendere"],[20,21,"a"],[22,27,"sordo"]]},{"it":"La mattina dopo si alzò di buonissim’ora e senza dir nulla ai suoi cugini, che erano sempre a letto, andò difilato a casa del guardaboschi.","ja":"","t":[[0,2,"il"],[3,10,"mattina"],[11,15,"dopo"],[16,18,"si"],[19,23,"alzare"],[24,26,"di"],[27,36,0],[37,40,"ora"],[41,42,"e"],[43,48,"senza"],[49,52,"dire"],[53,58,"nulla"],[59,61,"a"],[62,66,"suo"],[67,73,"cugino"],[75,78,"che"],[79,84,"essere"],[85,91,"sempre"],[92,93,"a"],[94,99,"letto"],[101,105,"andare"],[106,114,0],[115,116,"a"],[117,121,"casa"],[122,125,"di"],[126,138,0]]},{"it":"Quando fu là, l’amico Tonio lo condusse in una stanzuccia terrena, che serviva per le legna: e in un angolo di questo bugigattolo c’era una bella volpe accovacciata con la testa alta e minacciosa, con gli occhi di vetro, che parevano vivi e veri, con la bocca aperta in atto di ringhiare e di mostrare rabbiosamente i denti.","ja":"","t":[[0,6,"quando"],[7,9,"essere"],[10,12,"là"],[14,15,"il"],[16,21,"amico"],[22,27,0],[28,30,"il"],[31,39,"condurre"],[40,42,"in"],[43,46,"un"],[47,57,0],[58,65,0],[67,70,"che"],[71,78,"servire"],[79,82,"per"],[83,85,"il"],[86,91,"legna"],[93,94,"e"],[95,97,"in"],[98,100,"un"],[101,107,"angolo"],[108,110,"di"],[111,117,"questo"],[118,129,0],[130,131,"ci"],[132,135,"essere"],[136,139,"un"],[140,145,"bello"],[146,151,"volpe"],[152,164,0],[165,168,"con"],[169,171,"il"],[172,177,"testa"],[178,182,"alto"],[183,184,"e"],[185,195,"minaccioso"],[197,200,"con"],[201,204,"il"],[205,210,"occhio"],[211,213,"di"],[214,219,"vetro"],[221,224,"che"],[225,233,"parere"],[234,238,"vivere"],[239,240,"e"],[241,245,"vero"],[247,250,"con"],[251,253,"il"],[254,259,"bocca"],[260,266,"aprire"],[267,269,"in"],[270,274,"atto"],[275,277,"di"],[278,287,"ringhiare"],[288,289,"e"],[290,292,"dire"],[293,301,"mostrare"],[302,315,"rabbiosamente"],[316,317,"il"],[318,323,"dente"]]},{"it":"Alla vista di quella volpe, Leoncino ebbe, come chi dicesse, una specie d’ispirazione improvvisa.... e voltandosi al guardaboschi, gli disse:","ja":"","t":[[0,4,"a"],[5,10,"vista"],[11,13,"di"],[14,20,"quello"],[21,26,"volpe"],[28,36,0],[37,41,"avere"],[43,47,"come"],[48,51,"chi"],[52,59,"dire"],[61,64,"un"],[65,71,"specie"],[72,73,"di"],[74,85,0],[86,96,"improvviso"],[101,102,"e"],[103,113,"voltare"],[114,116,"a"],[117,129,0],[131,134,"il"],[135,140,"dire"]]},{"it":"― Come è bella!","ja":"","t":[[2,6,"come"],[7,8,"essere"],[9,14,"bello"]]},{"it":"Me la puoi vendere?","ja":"","t":[[0,2,"me"],[3,5,"il"],[6,10,"potere"],[11,18,"vendere"]]},{"it":"― Vendere?","ja":"","t":[[2,9,"vendere"]]},{"it":"Che le pare!","ja":"","t":[[0,3,"che"],[4,6,"il"],[7,11,"parere"]]},{"it":"Piuttosto gliela regalo.","ja":"","t":[[0,9,"piuttosto"],[10,16,0],[17,23,"regalo"]]},{"it":"― Davvero?","ja":"","t":[[2,9,"davvero"]]},{"it":"― E gliela regalo volentieri: tanto più che starà meglio in casa di lor signori, che in questa stanzuccia umida e senza luce, dove c’è il caso che, una volta o l’altra, me la mangino i topi.","ja":"","t":[[2,3,"e"],[4,10,0],[11,17,"regalo"],[18,28,"volentieri"],[30,35,"tanto"],[36,39,"più"],[40,43,"che"],[44,49,"stare"],[50,56,"meglio"],[57,59,"in"],[60,64,"casa"],[65,67,"di"],[68,71,0],[72,79,"signore"],[81,84,"che"],[85,87,"in"],[88,94,"questo"],[95,105,0],[106,111,"umido"],[112,113,"e"],[114,119,"senza"],[120,124,"luce"],[126,130,"dove"],[131,132,"ci"],[133,134,"essere"],[135,137,"il"],[138,142,"caso"],[143,146,"che"],[148,151,"un"],[152,157,"volta"],[158,159,"o"],[160,161,"il"],[162,167,"altro"],[169,171,"me"],[172,174,"il"],[175,182,"mangiare"],[183,184,"il"],[185,189,"topo"]]},{"it":"― Dunque la posso prendere?","ja":"","t":[[2,8,"dunque"],[9,11,"il"],[12,17,"potere"],[18,26,"prendere"]]},{"it":"― La prenda pure: ma che la vuole portare da sẻ, alla villa?","ja":"","t":[[2,4,"il"],[5,11,"prendere"],[12,16,"pure"],[18,20,"ma"],[21,24,"che"],[25,27,"il"],[28,33,"volere"],[34,41,"portare"],[42,44,"da"],[45,46,"si"],[49,53,"a"],[54,59,"villa"]]},{"it":"― Sicuro, che la voglio portare da me.","ja":"","t":[[2,8,"sicuro"],[10,13,"che"],[14,16,"il"],[17,23,"volere"],[24,31,"portare"],[32,34,"da"],[35,37,"me"]]},{"it":"La villa dello zio è così vicina!","ja":"","t":[[0,2,"il"],[3,8,"villa"],[9,14,"di"],[15,18,"zio"],[19,20,"essere"],[21,25,"così"],[26,32,"vicina"]]},{"it":"― Gua’: faccia lei.","ja":"","t":[[2,5,0],[8,14,"fare"],[15,18,"lei"]]},{"it":"―","ja":"","t":[]},{"it":"Leoncino, con l’aiuto del guardaboschi, si caricò sulle spalle la volpe, ripetè i suoi ringraziamenti, e se ne andò.","ja":"","t":[[0,8,0],[10,13,"con"],[14,15,"il"],[16,21,"aiuto"],[22,25,"di"],[26,38,0],[40,42,
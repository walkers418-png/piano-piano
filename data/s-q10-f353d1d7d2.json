{"id":"q10","title":"第10話 ルチアの秘密","lv":1,"kind":"連載","note":"","lines":[{"it":"Kenta mostra il foglio a Lucia.","ja":"ケンタはその紙をルチアに見せます。","t":[[0,5,0],[6,12,"mostrare"],[13,15,"il"],[16,22,"foglio"],[23,24,"a"],[25,30,0]]},{"it":"Lucia diventa rossa.","ja":"ルチアは赤くなります。","t":[[0,5,0],[6,13,"diventare"],[14,19,"rosso"]]},{"it":"Prende il foglio dalle mani di Kenta e lo mette nella borsa.","ja":"ルチアはケンタの手から紙を取り、かばんに入れます。","t":[[0,6,"prendere"],[7,9,"il"],[10,16,"foglio"],[17,22,"da"],[23,27,"mano"],[28,30,"di"],[31,36,0],[37,38,"e"],[39,41,"il"],[42,47,"mettere"],[48,53,"in"],[54,59,"borsa"]]},{"it":"«Da dove viene?» chiede subito.","ja":"「どこから来たの？」とすぐに尋ねます。","t":[[1,3,"da"],[4,8,"dove"],[9,14,"venire"],[17,23,"chiedere"],[24,30,"subito"]]},{"it":"«Sotto la scala. Sai qualcosa?»","ja":"「階段の下で。何か知ってるの？」","t":[[1,6,"sotto"],[7,9,"il"],[10,15,"scala"],[17,20,"sapere"],[21,29,"qualcosa"]]},{"it":"«No! Niente!»","ja":"「いいえ！何も！」","t":[[1,3,"no"],[5,11,"niente"]]},{"it":"Lucia prende la borsa e va verso la porta.","ja":"ルチアはかばんを取り、ドアの方へ行きます。","t":[[0,5,0],[6,12,"prendere"],[13,15,"il"],[16,21,"borsa"],[22,23,"e"],[24,26,"andare"],[27,32,"verso"],[33,35,"il"],[36,41,"porta"]]},{"it":"Nella borsa Kenta vede un biglietto del treno per Milano.","ja":"かばんの中に、ミラノ行きの切符が見えます。","t":[[0,5,"in"],[6,11,"borsa"],[12,17,0],[18,22,"vedere"],[23,25,"un"],[26,35,"biglietto"],[36,39,"di"],[40,45,"treno"],[46,49,"per"],[50,56,0]]},{"it":"«Vai a Milano?»","ja":"「ミラノに行くの？」","t":[[1,4,"andare"],[5,6,"a"],[7,13,0]]},{"it":"«Non sono cose tue» risponde Lucia.","ja":"「あなたには関係ないでしょ」とルチアが答えます。","t":[[1,4,"non"],[5,9,"essere"],[10,14,"cosa"],[15,18,"tuo"],[20,28,"rispondere"],[29,34,0]]},{"it":"Esce e chiude la porta con forza.","ja":"出て行って、ドアを強く閉めます。","t":[[0,4,"uscire"],[5,6,"e"],[7,13,"chiudere"],[14,16,"il"],[17,22,"porta"],[23,26,"con"],[27,32,"forza"]]},{"it":"Kenta rimane solo. Ha molte domande e nessuna risposta.","ja":"ケンタはひとり残ります。質問はたくさんあるのに、答えはひとつもありません。","t":[[0,5,0],[6,12,"rimanere"],[13,17,"solo"],[19,21,"avere"],[22,27,"molto"],[28,35,"domanda"],[36,37,"e"],[38,45,"nessuno"],[46,54,"risposta"]]}],"q":[{"skill":"match","s":"ルチアのかばんに見えたものは？","o":["ミラノ行きの切符","ノート","鍵"],"why":"un biglietto del treno per Milano."},{"skill":"infer","s":"Lucia diventa rossa からわかることは？","o":["ルチアは何かを隠しているかもしれない","ルチアは暑がっている","ルチアは料理中だ"],"why":"紙を見て動揺しています。"},{"skill":"vocab","s":"Non sono cose tue. の意味は？","o":["あなたには関係ない","それはあなたの物だ","あなたに言いたい"],"why":"直訳は「あなたのことではない」です。"}],"g":{},"n":77,"w":["a","andare","avere","biglietto","borsa","chiedere","chiudere","con","cosa","da","di","diventare","domanda","dove","e","essere","foglio","forza","il","in","mano","mettere","molto","mostrare","nessuno","niente","no","non","per","porta","prendere","qualcosa","rimanere","rispondere","risposta","rosso","sapere","scala","solo","sotto","subito","treno","tuo","un","uscire","vedere","venire","verso"]}
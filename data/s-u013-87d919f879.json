,"un"],[6,14,"coltello"],[15,18,"con"],[19,25,"manico"],[26,28,"di"],[29,39,0],[40,43,"che"],[44,49,"trovare"],[50,51,"il"],[52,56,"anno"],[57,64,"passato"],[65,67,"in"],[68,74,"piazza"],[75,76,"di"],[77,81,"arma"],[83,84,"e"],[85,87,"un"],[88,94,"giorno"],[95,97,"si"],[98,104,"tagliare"],[105,107,"un"],[108,112,"dito"],[113,117,"fino"],[118,121,"a"],[122,126,"osso"],[128,130,"ma"],[131,138,"nessuno"],[139,141,"in"],[142,149,0],[150,152,"se"],[153,154,0],[155,161,0],[163,164,"e"],[165,166,"a"],[167,171,"casa"],[172,175,"non"],[176,183,0],[184,187,"per"],[188,191,"non"],[192,202,"spaventare"],[203,204,"il"],[205,212,"parente"]]},{"it":"Qualunque cosa si lascia dire per celia e mai non se n’ha per male; ma guai se gli dicono: — Non è vero, — quando afferma una cosa: getta fuoco dagli occhi allora, e martella pugni da spaccare il banco.","ja":"","t":[[0,9,"qualunque"],[10,14,"cosa"],[15,17,"si"],[18,24,"lasciare"],[25,29,"dire"],[30,33,"per"],[34,39,0],[40,41,"e"],[42,45,"mai"],[46,49,"non"],[50,52,"se"],[53,54,0],[55,57,"avere"],[58,61,"per"],[62,66,"male"],[68,70,"ma"],[71,75,"guaio"],[76,78,"se"],[79,82,"il"],[83,89,"dire"],[93,96,"non"],[97,98,"essere"],[99,103,"vero"],[107,113,"quando"],[114,121,"affermare"],[122,125,"un"],[126,130,"cosa"],[132,137,"gettare"],[138,143,"fuoco"],[144,149,"da"],[150,155,"occhio"],[156,162,"allora"],[164,165,"e"],[166,174,0],[175,180,0],[181,183,"da"],[184,192,0],[193,195,"il"],[196,201,"banco"]]},{"it":"Sabato mattina diede un soldo a uno della prima superiore, che piangeva in mezzo alla strada, perchè gli avevan preso il suo, e non poteva più comprare il quaderno.","ja":"","t":[[0,6,"sabato"],[7,14,"mattina"],[15,20,"dare"],[21,23,"un"],[24,29,"soldo"],[30,31,"a"],[32,35,"un"],[36,41,"di"],[42,47,"prima"],[48,57,"superiore"],[59,62,"che"],[63,71,"piangere"],[72,74,"in"],[75,80,"mezzo"],[81,85,"a"],[86,92,"strada"],[94,100,"perché"],[101,104,"il"],[105,111,"avere"],[112,117,"prendere"],[118,120,"il"],[121,124,"suo"],[126,127,"e"],[12
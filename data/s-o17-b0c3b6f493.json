{"id":"o17","title":"森の中の学校","lv":3,"kind":"記事","note":"架空の記事です。","lines":[{"it":"In alcune scuole dell'infanzia del Trentino i bambini passano quasi tutta la giornata all'aperto.","ja":"トレンティーノの一部の幼稚園では、子どもたちが1日のほとんどを屋外で過ごします。","t":[[0,2,"in"],[3,9,"alcuno"],[10,16,"scuola"],[17,21,"di"],[22,30,"g:infanzia"],[31,34,"di"],[35,43,0],[44,45,"il"],[46,53,"bambino"],[54,61,"passare"],[62,67,"quasi"],[68,73,"tutto"],[74,76,"il"],[77,85,"giornata"],[86,89,"a"],[90,96,"aperto"]]},{"it":"Anche quando piove o nevica, si mettono gli stivali e vanno nel bosco.","ja":"雨や雪の日も、長靴をはいて森へ行きます。","t":[[0,5,"anche"],[6,12,"quando"],[13,18,"piovere"],[19,20,"o"],[21,27,"nevicare"],[29,31,"si"],[32,39,"mettere"],[40,43,"il"],[44,51,"g:stivali"],[52,53,"e"],[54,59,"andare"],[60,63,"in"],[64,69,"bosco"]]},{"it":"Costruiscono capanne, osservano gli insetti e imparano a riconoscere le piante.","ja":"小屋を作り、虫を観察し、植物を見分けることを学びます。","t":[[0,12,"costruire"],[13,20,"capanna"],[22,31,"osservare"],[32,35,"il"],[36,43,"insetto"],[44,45,"e"],[46,54,"imparare"],[55,56,"a"],[57,68,"riconoscere"],[69,71,"il"],[72,78,"pianta"]]},{"it":"Secondo le maestre, questi bambini si ammalano di meno e litigano di meno.","ja":"先生たちによれば、この子たちは病気もけんかも少ないそうです。","t":[[0,7,"secondo"],[8,10,"il"],[11,18,"maestra"],[20,26,"questo"],[27,34,"bambino"],[35,37,"si"],[38,46,"g:ammalano"],[47,49,"di"],[50,54,"meno"],[55,56,"e"],[57,65,"litigare"],[66,68,"di"],[69,73,"meno"]]},{"it":"Non tutti sono d'accordo.","ja":"全員が賛成なわけではありません。","t":[[0,3,"non"],[4,9,"tutto"],[10,14,"essere"],[15,16,"di"],[17,24,"accordo"]]},{"it":"«Mia figlia torna a casa sporca e stanca» dice Marta, una madre. «È felice, ma ho paura che impari poco.»","ja":"「娘は汚れて疲れて帰ります」と母親のマルタは言います。「幸せそうですが、あまり学べないのではと心配です」","t":[[1,4,"mio"],[5,11,"figlia"],[12,17,"tornare"],[18,19,"a"],[20,24,"casa"],[25,31,"sporco"],[32,33,"e"],[34,40,"stanco"],[42,46,"dire"],[47,52,0],[54,57,"un"],[58,63,"madre"],[66,67,"essere"],[68,74,"felice"],[76,78,"ma"],[79,81,"avere"],[82,87,"paura"],[88,91,"che"],[92,98,"imparare"],[99,103,"poco"]]},{"it":"Alcuni studi, però, dicono che in prima elementare questi bambini non sono indietro rispetto agli altri.","ja":"しかし一部の研究によれば、この子たちは小1で他の子に遅れていません。","t":[[0,6,"alcuno"],[7,12,"studio"],[14,18,"però"],[20,26,"dire"],[27,30,"che"],[31,33,"in"],[34,39,"prima"],[40,50,"elementare"],[51,57,"questo"],[58,65,"bambino"],[66,69,"non"],[70,74,"essere"],[75,83,"g:indietro"],[84,92,"rispetto"],[93,97,"a"],[98,103,"altro"]]},{"it":"Serviranno altre ricerche per capire gli effetti a lungo termine.","ja":"長期的な影響を知るには、さらに研究が必要です。","t":[[0,10,"servire"],[11,16,"altro"],[17,25,"ricerca"],[26,29,"per"],[30,36,"capire"],[37,40,"il"],[41,48,"effetto"],[49,50,"a"],[51,56,"lungo"],[57,64,"g:termine"]]}],"q":[{"skill":"fact","s":"«si ammalano di meno» は誰の考え？","o":["先生たち","マルタ","研究者全員"],"why":"Secondo le maestre."},{"skill":"match","s":"マルタの心配は？","o":["あまり学べないのでは","寒すぎる","高すぎる"],"why":"ho paura che impari poco."},{"skill":"main","s":"記事の態度は？","o":["賛否を紹介し、結論はまだと述べている","完全に賛成している","禁止すべきだと言っている"],"why":"Serviranno altre ricerche."}],"g":{"infanzia":"幼児期","stivali":"長靴（複数）","ammalano":"病気になる","indietro":"遅れて","termine":"期間"},"n":104,"w":["a","accordo","alcuno","altro","anche","andare","aperto","avere","bambino","bosco","capanna","capire","casa","che","costruire","di","dire","e","effetto","elementare","essere","felice","figlia","giornata","il","imparare","in","insetto","litigare","lungo","ma","madre","maestra","meno","mettere","mio","nevicare","non","o","osservare","passare","paura","per","però","pianta","piovere","poco","prima","quando","quasi","questo","ricerca","riconoscere","rispetto","scuola","secondo","servire","si","sporco","stanco","studio","tornare","tutto","un"]}
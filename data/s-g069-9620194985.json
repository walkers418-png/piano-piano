,"che"],[146,153,"avere"],[154,159,"fare"],[160,166,"presto"]]},{"it":"- Lei stia qui finché torno io: e chiunque venga lo faccia aspettare...","ja":"","t":[[2,5,"lei"],[6,10,"stare"],[11,14,"qui"],[15,21,"finché"],[22,27,"tornare"],[28,30,"io"],[32,33,"e"],[34,42,"chiunque"],[43,48,"venire"],[49,51,"il"],[52,58,"fare"],[59,68,"aspettare"]]},{"it":"Mi raccomando però; non si muova di qui...","ja":"","t":[[0,2,"mi"],[3,13,"raccomandare"],[14,18,"però"],[20,23,"non"],[24,26,"si"],[27,32,"muovere"],[33,35,"di"],[36,39,"qui"]]},{"it":"Posso star sicuro, sor Giannino? -","ja":"","t":[[0,5,"potere"],[6,10,"stare"],[11,17,"sicuro"],[19,22,0],[23,31,0]]},{"it":"L’ho rassicurato e mi son messo a sedere dove sta lui, con lo scaldino tra le gambe e la penna in mano.","ja":"","t":[[0,1,"il"],[2,4,"avere"],[5,16,0],[17,18,"e"],[19,21,"mi"],[22,25,"essere"],[26,31,"mettere"],[32,33,"a"],[34,40,"sedere"],[41,45,"dove"],[46,49,"stare"],[50,53,"lui"],[55,58,"con"],[59,61,"il"],[62,70,"scaldare"],[71,74,"tra"],[75,77,"il"],[78,83,"gamba"],[84,85,"e"],[86,88,"il"],[89,94,"penna"],[95,97,"in"],[98,102,"mano"]]},{"it":"Di lì a poco è entrato un contadino, un tipo buffo con un ombrellone verde sotto il braccio, e che, rigirandosi il cappello tra le mani ha detto:","ja":"","t":[[0,2,"di"],[3,5,"lì"],[6,7,"a"],[8,12,"poco"],[13,14,"essere"],[15,22,"entrare"],[23,25,"un"],[26,35,"contadino"],[37,39,"un"],[40,44,"tipo"],[45,50,"buffo"],[51,54,"con"],[55,57,"un"],[58,68,0],[69,74,"verde"],[75,80,"sotto"],[81,83,"il"],[84,91,"braccio"],[93,94,"e"],[95,98,"che"],[100,111,0],[112,114,"il"],[115,123,"cappello"],[124,127,"tra"],[128,130,"il"],[131,135,"mano"],[136,138,"avere"],[139,144,"dire"]]},{"it":"- Che è qui che ho a venire?","ja":"","t":[[2,5,"che"],[6,7,"essere"],[8,11,"qui"],[12,15,"che"],[16,18,"avere"],[19,20,"a"],[21,27,"venire"]]},{"it":"- Chi cercate? - gli ho domandato.","ja":"","t":[[2,5,"chi"],[6,13,"cercare"],[17,20,"il"],[21,23,"avere"],[24,33,"domandare"]]},{"it":"- Del sor avvocato Maralli...","ja":"","t":[[2,5,"di"],[6,9,0],[10,18,"avvocato"],[19,26,0]]},{"it":"- L’avvocato è fuori... ma io sono il suo cognato e potete parlare liberamente...","ja":"","t":[[2,3,"il"],[4,12,"avvocato"],[13,14,"essere"],[15,20,"fuori"],[24,26,"ma"],[27,29,"io"],[30,34,"essere"],[35,37,"il"],[38,41,"suo"],[42,49,"cognato"],[50,51,"e"],[52,58,"potere"],[59,66,"parlare"],[67,78,0]]},{"it":"È come se ci fosse lui in persona.","ja":"","t":[[0,1,"essere"],[2,6,"come"],[7,9,"se"],[10,12,"ci"],[13,18,"essere"],[19,22,"lui"],[23,25,"in"],[26,33,"persona"]]},{"it":"E voi chi siete?","ja":"","t":[[0,1,"e"],[2,5,"voi"],[6,9,"chi"],[10,15,"essere"]]},{"it":"- Chi sono io?","ja":"","t":[[2,5,"chi"],[6,10,"essere"],[11,13,"io"]]},{"it":"Io son Gosto contadino del Pian dell’Olmo, dove mi conoscono tutti, e anzi mi chiamano Gosto grullo per distinguermi da un altro Gosto che sta nel podere accanto, e sono, come lei saprà, ascritto alla Lega dove pago due soldi tutte le settimane che Dio mette in terra, e il sor Ernesto lo può dire che è il nostro segretario e sa far di conto perché lui non è un contadino come noialtri disgraziati...","ja":"","t":[[0,2,"io"],[3,6,"essere"],[7,12,0],[13,22,"contadino"],[23,26,"di"],[27,31,0],[32,36,"di"],[37,41,0],[43,47,"dove"],[48,50,"mi"],[51,60,"conoscere"],[61,66,"tutto"],[68,69,"e"],[70,74,"anzi"],[75,77,"mi"],[78,86,"chiamare"],[87,92,0],[93,99,0],[100,103,"per"],[104,116,"distinguere"],[117,119,"da"],[120,122,"un"],[123,128,"altro"],[129,134,0],[135,138,"che"],[139,142,"stare"],[143,146,"in"],[147,153,"podere"],[154,161,"accanto"],[163,164,"e"],[165,169,"essere"],[171,175,"come"],[176,179,"lei"],[180,185,"sapere"],[187,195,0],[196,200,"a"],[201,205,"legare"],[206,210,"dove"],[211,215,"pagare"],[216,219,"due"],[220,225,"soldi"],[226,231,"tutto"],[232,234,"il"],[235,244,"settimana"],[245,248,"che"],[249,252,"Dio"],[253,258,"mettere"],[259,261,"in"],[262,267,"terra"],[269,270,"e"],[271,273,"il"],[274,277,0],[278,285,0],[286,288,"il"],[2
,5,"il"],[6,9,"più"],[10,15,"bello"],[16,18,"di"],[19,24,"tutto"],[26,32,"quello"],[33,36,"che"],[37,39,"avere"],[40,43,"più"],[44,51,"ingegno"],[53,56,"che"],[57,61,"essere"],[62,64,"il"],[65,70,"primo"],[71,73,"Dio"],[74,80,"sicuro"],[81,86,"anche"],[87,92,"questo"],[93,97,"anno"],[99,100,"essere"],[101,108,0],[110,111,"e"],[112,114,"il"],[115,122,"maestro"],[124,127,"che"],[128,129,"il"],[130,132,"avere"],[133,136,"già"],[137,143,"capire"],[145,147,"il"],[148,157,0],[158,164,"sempre"]]},{"it":"Io però voglio bene a Precossi, il figliuolo del fabbro ferraio, quello della giacchetta lunga, che pare un malatino; dicono che suo padre lo batte; è molto timido, e ogni volta che interroga o tocca qualcuno dice: — Scusami, — e guarda con gli occhi buoni e tristi.","ja":"","t":[[0,2,"io"],[3,7,"però"],[8,14,"volere"],[15,19,"bene"],[20,21,"a"],[22,30,0],[32,34,"il"],[35,44,"figliuolo"],[45,48,"di"],[49,55,"fabbro"],[56,63,0],[65,71,"quello"],[72,77,"di"],[78,88,"giacchetta"],[89,94,"lungo"],[96,99,"che"],[100,104,"parere"],[105,107,"un"],[108,116,0],[118,124,"dire"],[125,128,"che"],[129,132,"suo"],[133,138,"padre"],[139,141,"il"],[142,147,"battere"],[149,150,"essere"],[151,156,"molto"],[157,163,"timido"],[165,166,"e"],[167,171,"ogni"],[172,177,"volta"],[178,181,"che"],[182,191,0],[192,193,"o"],[194,199,"toccare"],[200,208,"qualcuno"],[209,213,"dire"],[217,224,"scusare"],[228,229,"e"],[230,236,"guardare"],[237,240,"con"],[241,244,"il"],[245,250,"occhio"],[251,256,"buono"],[257,258,"e"],[259,265,"triste"]]},{"it":"Ma Garrone è il più grande e il più buono.","ja":"","t":[[0,2,"ma"],[3,10,0],[11,12,"essere"],[13,15,"il"],[16,19,"più"],[20,26,"grande"],[27,28,"e"],[29,31,"il"],[32,35,"più"],[36,41,"buono"]]}],"q":[],"g":{},"n":531,"w":["America","Dio","a","abilità","accanto","allegro","altro","anche","andare","anno","appendere","aria","arrivare","attento","attorno","avere","banco","battere","becco","bello","bene","berretto","braccio","buono","calabrese","calcio","capello","cap
{"id":"g049","title":"16 dicembre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Oggi ho avuto una gran soddisfazione.","ja":"","t":[[0,4,"oggi"],[5,7,"avere"],[8,13,"avere"],[14,17,"un"],[18,22,"grande"],[23,36,"soddisfazione"]]},{"it":"Era stato stabilito che appena tornato da scuola dovessi andare con la mamma e l’Ada dalla signora Olga a confessare quella che chiamano la mia colpa e a chieder perdono.","ja":"","t":[[0,3,"essere"],[4,9,"essere"],[10,19,"stabilire"],[20,23,"che"],[24,30,"appena"],[31,38,"tornare"],[39,41,"da"],[42,48,"scuola"],[49,56,"dovere"],[57,63,"andare"],[64,67,"con"],[68,70,"il"],[71,76,"mamma"],[77,78,"e"],[79,80,"il"],[81,84,0],[85,90,"da"],[91,98,"signora"],[99,103,0],[104,105,"a"],[106,116,"confessare"],[117,123,"quello"],[124,127,"che"],[128,136,"chiamare"],[137,139,"il"],[140,143,"mio"],[144,149,"colpa"],[150,151,"e"],[152,153,"a"],[154,161,"chiedere"],[162,169,"perdere"]]},{"it":"Infatti siamo andati da lei, e io, tutto confuso, ho incominciato subito a raccontarle il fatto del gioco di prestigio, che la signora Olga ha ascoltato con molta curiosità.","ja":"","t":[[0,7,"infatti"],[8,13,"essere"],[14,20,"andare"],[21,23,"da"],[24,27,"lei"],[29,30,"e"],[31,33,"io"],[35,40,"tutto"],[41,48,"confuso"],[50,52,"avere"],[53,65,"incominciare"],[66,72,"subito"],[73,74,"a"],[75,86,"raccontare"],[87,89,"il"],[90,95,"fare"],[96,99,"di"],[100,105,"gioco"],[106,108,"di"],[109,118,"prestigio"],[120,123,"che"],[124,126,"il"],[127,134,"signora"],[135,139,0],[140,142,"avere"],[143,152,"ascoltare"],[153,156,"con"],[157,162,"molto"],[163,172,"curiosità"]]},{"it":"Poi ha detto:","ja":"","t":[[0,3,"poi"],[4,6,"avere"],[7,12,"dire"]]},{"it":"- Ma vedete un po’ che testa ho io!","ja":"","t":[[2,4,"ma"],[5,11,"vedere"],[12,14,"un"],[15,17,"poco"],[19,22,"che"],[23,28,"testa"],[29,31,"avere"],[32,34,"io"]]},{"it":"Ho tenuto per tanto tempo un orologio che non è mio senza neppure ac
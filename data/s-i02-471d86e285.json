{"id":"i02","title":"イタリアの20の州","lv":1,"kind":"説明文","note":"","lines":[{"it":"L'Italia ha venti regioni.","ja":"イタリアには20の州があります。","t":[[0,1,"il"],[2,8,0],[9,11,"avere"],[12,17,"venti"],[18,25,"g:regioni"]]},{"it":"Sulla carta sembra uno stivale nel mare.","ja":"地図の上では、海の中のブーツのように見えます。","t":[[0,5,"su"],[6,11,"carta"],[12,18,"sembrare"],[19,22,"un"],[23,30,"g:stivale"],[31,34,"in"],[35,39,"mare"]]},{"it":"Al nord ci sono le montagne più alte, le Alpi.","ja":"北には最も高い山々、アルプスがあります。","t":[[0,2,"a"],[3,7,"nord"],[8,10,"ci"],[11,15,"essere"],[16,18,"il"],[19,27,"montagna"],[28,31,"più"],[32,36,"alto"],[38,40,"il"],[41,45,"g:alpi"]]},{"it":"Al centro c'è Roma, la capitale.","ja":"中部には首都ローマがあります。","t":[[0,2,"a"],[3,9,"centro"],[10,11,"ci"],[12,13,"essere"],[14,18,0],[20,22,"il"],[23,31,"g:capitale"]]},{"it":"Al sud fa più caldo e il mare è molto bello.","ja":"南はより暑く、海がとてもきれいです。","t":[[0,2,"a"],[3,6,"sud"],[7,9,"fare"],[10,13,"più"],[14,19,"caldo"],[20,21,"e"],[22,24,"il"],[25,29,"mare"],[30,31,"essere"],[32,37,"molto"],[38,43,"bello"]]},{"it":"Ci sono anche due grandi isole: la Sicilia e la Sardegna.","ja":"2つの大きな島もあります。シチリアとサルデーニャです。","t":[[0,2,"ci"],[3,7,"essere"],[8,13,"anche"],[14,17,"due"],[18,24,"grande"],[25,30,"isola"],[32,34,"il"],[35,42,"g:sicilia"],[43,44,"e"],[45,47,"il"],[48,56,"g:sardegna"]]},{"it":"Ogni regione ha piatti diversi.","ja":"州ごとに違う料理があります。","t":[[0,4,"ogni"],[5,12,"regione"],[13,15,"avere"],[16,22,"piatto"],[23,30,"diverso"]]},{"it":"A Bologna si mangiano i tortellini, a Napoli la pizza.","ja":"ボローニャではトルテッリーニ、ナポリではピザを食べます。","t":[[0,1,"a"],[2,9,0],[10,12,"si"],[13,21,"mangiare"],[22,23,"il"],[24,34,"g:tortellini"],[36,37,"a"],[38,44,0],[45,47,"il"],[48,53,"pizza"]]}],"q":[{"skill":"match","s":"イタリアの首都は？","o":["ローマ","ミラノ","ナポリ"],"why":"Roma, la capitale."},{"skill":"match","s":"州の数は？","o":["20","5","100"],"why":"venti regioni."},{"skill":"info","s":"アルプスがあるのは？","o":["北","南","島"],"why":"Al nord ci sono le montagne più alte."}],"g":{"regioni":"州（複数）","p
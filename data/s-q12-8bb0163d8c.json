{"id":"q12","title":"第12話 正体","lv":1,"kind":"連載","note":"","lines":[{"it":"«Lucia!» dice Kenta.","ja":"「ルチア！」とケンタが言います。","t":[[1,6,0],[9,13,"dire"],[14,19,0]]},{"it":"Lucia ha paura e grida.","ja":"ルチアは怖くなって叫びます。","t":[[0,5,0],[6,8,"avere"],[9,14,"paura"],[15,16,"e"],[17,22,"gridare"]]},{"it":"Totò salta dal tavolo e scappa.","ja":"トトがテーブルから飛び降りて逃げます。","t":[[0,4,0],[5,10,"saltare"],[11,14,"da"],[15,21,"tavolo"],[22,23,"e"],[24,30,"g:scappa"]]},{"it":"«Che cosa fai qui?»","ja":"「ここで何をしているの？」","t":[[1,4,"che"],[5,9,"cosa"],[10,13,"fare"],[14,17,"qui"]]},{"it":"«E tu, che cosa fai qui?»","ja":"「あなたこそ、ここで何をしてるの？」","t":[[1,2,"e"],[3,5,"tu"],[7,10,"che"],[11,15,"cosa"],[16,19,"fare"],[20,23,"qui"]]},{"it":"Kenta apre il cassetto.","ja":"ケンタは引き出しを開けます。","t":[[0,5,0],[6,10,"aprire"],[11,13,"il"],[14,22,"g:cassetto"]]},{"it":"Dentro non c'è il quaderno. C'è solo una pagina.","ja":"中にノートはありません。ページが1枚あるだけです。","t":[[0,6,"dentro"],[7,10,"non"],[11,12,"ci"],[13,14,"essere"],[15,17,"il"],[18,26,"quaderno"],[28,29,"ci"],[30,31,"essere"],[32,36,"solo"],[37,40,"un"],[41,47,"pagina"]]},{"it":"«Dov'è il quaderno, Lucia?»","ja":"「ノートはどこ、ルチア？」","t":[[1,4,"dove"],[5,6,"essere"],[7,9,"il"],[10,18,"quaderno"],[20,25,0]]},{"it":"Lucia guarda il pavimento e non risponde.","ja":"ルチアは床を見つめ、答えません。","t":[[0,5,0],[6,12,"guardare"],[13,15,"il"],[16,25,"g:pavimento"],[26,27,"e"],[28,31,"non"],[32,40,"rispondere"]]},{"it":"Poi dice piano: «Domani. Domani ti spiego tutto.»","ja":"それから小さな声で言います。「明日。明日、全部説明する」","t":[[0,3,"poi"],[4,8,"dire"],[9,14,"piano"],[17,23,"domani"],[25,31,"domani"],[32,34,"ti"],[35,41,"spiegare"],[42,47,"tutto"]]},{"it":"«Ma Nonna Rita sta male!»","ja":"「でもノンナ・リータは具合が悪いんだよ！」","t":[[1,3,"ma"],[4,9,0],[10,14,0],[15,18,"stare"],[19,23,"male"]]},{"it":"«Lo so» dice Lucia. Nei suoi occhi ci sono lacrime.","ja":"「知ってる」とルチアは言います。目に涙があります。","t":[[1,3,"il"],[4,6,"sapere"],[8,12,"dire"],[13,18,0],[20,23,"in"],[24,28,"suo"],[29,34,"occhio"],[35,37,"ci"],[38,42,"essere"],[43,50,"g:lacrime"]]}],"q":[{"skill":"match","s":"夜に入ってきたのは誰？","o":["ルチア","ブルーニ","トト"],"why":"«Lucia!» とあります。"},{"skill":"match","s":"引き出しに入っていたものは？","o":["ページ1枚","ノート全部","切符"],"why":"C'è solo una pagina."},{"skill":"infer","s":"ルチアの涙からわかることは？","o":["悪意で盗んだのではないかもしれない","喜んでいる","ケンタを憎んでいる"],"why":"リータを心配している様子です。"}],"g":{"scappa":"逃げる","pavimento":"床","cassetto":"引き出し","lacrime":"涙"},"n":74,"w":["aprire","avere","che","ci","cosa","da","dentro","dire","domani","dove","e","essere","fare","gridare","guardare","il","in","ma","male","non","occhio","pagina","paura","piano","poi","quaderno","qui","rispondere","saltare","sapere","solo","spiegare","stare","suo","tavolo","ti","tu","tutto","un"]}
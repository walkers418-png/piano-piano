{"id":"u076","title":"Aprile・Gli amici operai","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"GLI AMICI OPERAI","ja":"","t":[[0,3,"il"],[4,9,"amico"],[10,16,"operaio"]]},{"it":"Giovedì, 20.ì","ja":"","t":[[0,7,"giovedì"],[12,13,0]]},{"it":"Perchè, Enrico, mai più?","ja":"","t":[[0,6,"perché"],[8,14,0],[16,19,"mai"],[20,23,"più"]]},{"it":"Questo dipenderà da te.","ja":"","t":[[0,6,"questo"],[7,16,"dipendere"],[17,19,"da"],[20,22,"te"]]},{"it":"Finita la quarta, tu andrai al Ginnasio ed essi faranno gli operai, ma rimarrete nella stessa città, forse per molti anni.","ja":"","t":[[0,6,"finire"],[7,9,"il"],[10,16,"quarto"],[18,20,"tu"],[21,27,"andare"],[28,30,"a"],[31,39,0],[40,42,"e"],[43,47,"essi"],[48,55,"fare"],[56,59,"il"],[60,66,"operaio"],[68,70,"ma"],[71,80,"rimanere"],[81,86,"in"],[87,93,"stesso"],[94,99,"città"],[101,106,"forse"],[107,110,"per"],[111,116,"molto"],[117,121,"anno"]]},{"it":"E perchè, allora, non v’avrete più a rivedere?","ja":"","t":[[0,1,"e"],[2,8,"perché"],[10,16,"allora"],[18,21,"non"],[22,23,0],[24,30,"avere"],[31,34,"più"],[35,36,"a"],[37,45,"rivedere"]]},{"it":"Quando tu sarai all’Università o al Liceo, li andrai a cercare nelle loro botteghe o nelle loro officine, e ti sarà un grande piacere il ritrovare i tuoi compagni d’infanzia, — uomini, — al lavoro.","ja":"","t":[[0,6,"quando"],[7,9,"tu"],[10,15,"essere"],[16,19,"a"],[20,30,"università"],[31,32,"o"],[33,35,"a"],[36,41,0],[43,45,"li"],[46,52,"andare"],[53,54,"a"],[55,62,"cercare"],[63,68,"in"],[69,73,"loro"],[74,82,"bottega"],[83,84,"o"],[85,90,"in"],[91,95,"loro"],[96,104,0],[106,107,"e"],[108,110,"ti"],[111,115,"essere"],[116,118,"un"],[119,125,"grande"],[126,133,"piacere"],[134,136,"il"],[137,146,"ritrovare"],[147,148,"il"],[149,153,"tuo"],[154,162,"compagno"],[163,164,"di"],[165,173,"infanzia"],[177,183,"uomo"],[187,189,"a"],[190,196,"lavoro"]]},{"it":"Vorrei vedere che tu non andassi a cercar Coretti e Precossi; dovunque fossero.","ja":"","t":[[0,6,"volere"],[7,13,"vedere"],[14,17,"che"],[18,20,"tu"],[21,24,"non"],[25,32,"andare"],[33,34,"a"],[35,41,0],[42,49,0],[50,51,"e"],[52,60,0],[62,70,0],[71,78,"essere"]]},{"it":"Tu ci andrai, e passerai delle ore in loro compagnia, e vedrai, studiando la vita e il mondo, quante cose potrai imparare da loro, che nessun altri ti saprà insegnare, e sulle loro arti e sulla loro società e sul tuo paese.","ja":"","t":[[0,2,"tu"],[3,5,"ci"],[6,12,"andare"],[14,15,"e"],[16,24,"passare"],[25,30,"di"],[31,34,"ora"],[35,37,"in"],[38,42,"loro"],[43,52,"compagnia"],[54,55,"e"],[56,62,"vedere"],[64,73,"studiare"],[74,76,"il"],[77,81,"vita"],[82,83,"e"],[84,86,"il"],[87,92,"mondo"],[94,100,"quanto"],[101,105,"cosa"],[106,112,"potere"],[113,121,"imparare"],[122,124,"da"],[125,129,"loro"],[131,134,"che"],[135,141,"nessuno"],[142,147,"altro"],[148,150,"ti"],[151,156,"sapere"],[157,166,"insegnare"],[168,169,"e"],[170,175,"su"],[176,180,"loro"],[181,185,"arte"],[186,187,"e"],[188,193,"su"],[194,198,"loro"],[199,206,"società"],[207,208,"e"],[209,212,"su"],[213,216,"tuo"],[217,222,"paese"]]},{"it":"E bada che se non conserverai queste amicizie, sarà ben difficile che tu ne acquisti altre simili in avvenire, delle amicizie, voglio dire, fuori della classe a cui appartieni; e così vivrai in una classe sola, e l’uomo che pratica una sola classe sociale, è come lo studioso che non legge altro che un libro.","ja":"","t":[[0,1,"e"],[2,6,"badare"],[7,10,"che"],[11,13,"se"],[14,17,"non"],[18,29,"conservare"],[30,36,"questo"],[37,45,"amicizia"],[47,51,"essere"],[52,55,"bene"],[56,65,"difficile"],[66,69,"che"],[70,72,"tu"],[73,75,"ne"],[76,84,"acquistare"],[85,90,"altro"],[91,97,"simile"],[98,100,"in"],[101,109,"avvenire"],[111,116,"di"],[117,125,"amicizia"],[127,133,"volere"],[134,138,"dire"],[140,145,"fuori"],[146,151,"di"],[152,158,"classe"],[159,160,"a"],[161,164,"cui"],[165,175,"appartenere"],[177,178,"e"],[179,183,"così"],[184,190,"vivere"],[191,193,"in"],[194,197,"un"],[198,204,"classe"],[205,209,"solo"],[211,212,"e"],[213,214,"il"],[215,219,"uomo"],[220,223,"che"],[224,231,"pratica"],[232,235,"un"],[236,240,"solo"],[241,247,"classe"],[248,255,"sociale"],[257,258,"essere"],[259,263,"come"],[264,266,"il"],[267,275,"studioso"],[276,279,"che"],[280,283,"non"],[284,289,"leggere"],[290,295,"altro"],[296,299,"che"],[300,302,"un"],[303,308,"libro"]]},{"it":"Proponiti quindi fin d’ora di conservarti quei buoni amici anche dopo che sarete divisi; e coltivali fin d’ora di preferenza, appunto perché son figliuoli d’operai.","ja":"","t":[[0,9,"proporre"],[10,16,"quindi"],[17,20,"fino"],[21,22,"di"],[23,26,"ora"],[27,29,"di"],[30,41,"conservare"],[42,46,"quello"],[47,52,"buono"],[53,58,"amico"],[59,64,"anche"],[65,69,"dopo"],[70,73,"che"],[74,80,"essere"],[81,87,"dividere"],[89,90,"e"],[91,100,"coltivare"],[101,104,"fino"],[105,106,"di"],[107,110,"ora"],[111,113,"di"],[114,124,0],[126,133,"appunto"],[134,140,"perché"],[141,144,"essere"],[145,154,"figliuolo"],[155,156,"di"],[157,163,"operaio"]]},{"it":"Vedi: gli uomini delle classi superiori sono gli ufficiali, e gli operai sono i soldati del lavoro; ma così nella società come nell’esercito, non solo il soldato non è men nobile dell’ufficiale, perché la nobiltà sta nel lavoro e non nel guadagno, nel valore e non nel grado; ma se c’è una superiorità di merito è dalla parte del soldato, dell’operaio, i quali ricavan dall’opera propria minor profitto.","ja":"","t":[[0,4,"vedere"],[6,9,"il"],[10,16,"uomo"],[17,22,"di"],[23,29,"classe"],[30,39,"superiore"],[40,44,"essere"],[45,48,"il"],[49,58,"ufficiale"],[60,61,"e"],[62,65,"il"],[66,72,"operaio"],[73,77,"essere"],[78,79,"il"],[80,87,"soldato"],[88,91,"di"],[92,98,"lavoro"],[100,102,"ma"],[103,107,"così"],[108,113,"in"],[114,121,"società"],[122,126,"come"],[127,131,"in"],[132,140,"esercito"],[142,145,"non"],[146,150,"solo"],[151,153,"il"],[154,161,"soldato"],[162,165,"non"],[166,167,"essere"],[168,171,0],[172,178,"nobile"],[179,183,"di"],[184,193,"ufficiale"],[195,201,"perché"],[202,204,"il"],[205,212,0],[213,216,"stare"],[217,220,"in"],[221,227,"lavoro"],[228,229,"e"],[230,233,"non"],[234,237,"in"],[238,246,"guadagnare"],[248,251,"in"],[252,258,"valore"],[259,260,"e"],[261,264,"non"],[265,268,"in"],[269,274,"grado"],[276,278,"ma"],[279,281,"se"],[282,283,"ci"],[284,285,"essere"],[286,289,"un"],[290,301,0],[302,304,"di"],[305,311,"meritare"],[312,313,"essere"],[314,319,"da"],[320,325,"parte"],[326,329,"di"],[330,337,"soldato"],[339,343,"di"],[344,351,"operaio"],[353,354,"il"],[355,360,"quale"],[361,368,0],[369,373,"da"],[374,379,"opera"],[380,387,0],[388,393,0],[394,402,0]]},{"it":"Ama dunque, rispetta sopra tutti, fra i tuoi compagni, i figliuoli dei soldati del lavoro; onora in essi le fatiche e i sacrifici dei loro parenti; disprezza le differenze di fortuna e di classe, sulle quali i vili soltanto regolano i sentimenti e la cortesia; pensa che uscì quasi tutto dalle vene dei lavoratori delle officine e dei campi il sangue benedetto che ci ha redento la patria, ama Garrone, ama Precossi, ama Coretti, ama il tuo «muratorino» che nei loro petti di piccoli operai chiudono dei cuori di principi, e giura a te medesimo che nessun cangiamento di fortuna potrà mai strappare queste sante amicizie infantili dall’anima tua.","ja":"","t":[[0,3,"amare"],[4,10,"dunque"],[12,20,"rispettare"],[21,26,"sopra"],[27,32,"tutto"],[34,37,"fra"],[38,39,"il"],[40,44,"tuo"],[45,53,"compagno"],[55,56,"il"],[57,66,"figliuolo"],[67,70,"di"],[71,78,"soldato"],[79,82,"di"],[83,89,"lavoro"],[91,96,0],[97,99,"in"],[100,104,"essi"],[105,107,"il"],[108,115,"fatica"],[116,117,"e"],[118,119,"il"],[120,129,"sacrificio"],[130,133,"di"],[134,138,"loro"],[139,146,"parente"],[148,157,0],[158,160,"il"],[161,171,"differenza"],[172,174,"di"],[175,182,"fortuna"],[183,184,"e"],[185,187,"dire"],[188,194,"classe"],[196,201,"su"],[202,207,"quale"],[208,209,"il"],[210,214,0],[215,223,"soltanto"],[224,232,0],[233,234,"il"],[235,245,"sentimento"],[246,247,"e"],[2
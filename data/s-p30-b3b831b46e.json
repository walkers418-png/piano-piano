{"id":"p30","title":"原文30：ルチニョーロ","lv":4,"kind":"原文","note":"要約：友人ルチニョーロに誘われ、学校のないおもちゃの国へ行ってしまう。 原文（1883年）なので古い語や綴りがあります。わからない語は飛ばして読み進めましょう。","lines":[{"it":"— Va’ pure a invitare i tuoi compagni per la colazione di domani: ma ricordati di tornare a casa prima che faccia notte.","ja":"","t":[[2,4,"andare"],[6,10,"pure"],[11,12,"a"],[13,21,"invitare"],[22,23,"il"],[24,28,"tuo"],[29,37,"compagno"],[38,41,"per"],[42,44,"il"],[45,54,"colazione"],[55,57,"di"],[58,64,"domani"],[66,68,"ma"],[69,78,"ricordare"],[79,81,"di"],[82,89,"tornare"],[90,91,"a"],[92,96,"casa"],[97,102,"prima"],[103,106,"che"],[107,113,"fare"],[114,119,"notte"]]},{"it":"Hai capito?","ja":"","t":[[0,3,"avere"],[4,10,"capire"]]},{"it":"— Fra un’ora prometto di essere bell’ e ritornato — replicò il burattino.","ja":"","t":[[2,5,"fra"],[6,8,"un"],[9,12,"ora"],[13,21,"promettere"],[22,24,"di"],[25,31,"essere"],[32,36,"bello"],[38,39,"e"],[40,49,"ritornare"],[52,59,"replicare"],[60,62,"il"],[63,72,"burattino"]]},{"it":"— Bada, Pinocchio!","ja":"","t":[[2,6,"badare"],[8,17,0]]},{"it":"I ragazzi fanno presto a promettere, ma il più delle volte, fanno tardi a mantenere.","ja":"","t":[[0,1,"il"],[2,9,"ragazzo"],[10,15,"fare"],[16,22,"presto"],[23,24,"a"],[25,35,"promettere"],[37,39,"ma"],[40,42,"il"],[43,46,"più"],[47,52,"di"],[53,58,"volta"],[60,65,"fare"],[66,71,"tardi"],[72,73,"a"],[74,83,"mantenere"]]},{"it":"— Ma io non sono come gli altri: io, quando dico una cosa, la mantengo.","ja":"","t":[[2,4,"ma"],[5,7,"io"],[8,11,"non"],[12,16,"essere"],[17,21,"come"],[22,25,"il"],[26,31,"altro"],[33,35,"io"],[37,43,"quando"],[44,48,"dire"],[49,52,"un"],[53,57,"cosa"],[59,61,"il"],[62,70,"mantenere"]]},{"it":"— Vedremo.","ja":"","t":[[2,9,"vedere"]]},{"it":"Caso poi tu disubbidissi, tanto peggio per te.","ja":"","t":[[0,4,"caso"],[5,8,"poi"],[9,11,"tu"],[12,24,0],[26,31,"tanto"],[32,38,"peggio"],[39,42,"per"],[43,45,"te"]]},{"it":"— Perchè?","ja":"","t":[[2,8,"perché"]]},{"it":"— Perchè i ragazzi che non dànno retta ai consigli di chi ne sa più di loro, vanno sempre incontro a qualche disgrazia.","ja":"","t":[[2,8,"perché"],[9,10,"il"],[11,18,"ragazzo"],[19,22,"che"],[23,26,"non"],[27,32,0],[33,38,"retta"],[39,41,"a"],[42,50,"consiglio"],[51,53,"di"],[54,57,"chi"],[58,60,"ne"],[61,63,"sapere"],[64,67,"più"],[68,70,"di"],[71,75,"loro"],[77,82,"andare"],[83,89,"sempre"],[90,98,"incontrare"],[99,100,"a"],[101,108,"qualche"],[109,118,"disgrazia"]]},{"it":"— E io l’ho provato!","ja":"","t":[[2,3,"e"],[4,6,"io"],[7,8,"il"],[9,11,"avere"],[12,19,"provare"]]},{"it":"— disse Pinocchio.","ja":"","t":[[2,7,"dire"],[8,17,0]]},{"it":"— Ma ora non ci ricasco più!","ja":"","t":[[2,4,"ma"],[5,8,"ora"],[9,12,"non"],[13,15,"ci"],[16,23,0],[24,27,"più"]]},{"it":"— Vedremo se dici il vero.—","ja":"","t":[[2,9,"vedere"],[10,12,"se"],[13,17,"dire"],[18,20,"il"],[21,25,"vero"]]},{"it":"Senza aggiungere altre parole, il burattino salutò la sua buona Fata, che era per lui una specie di mamma, e cantando e ballando uscì fuori dalla porta di casa.","ja":"","t":[[0,5,"senza"],[6,16,"aggiungere"],[17,22,"altro"],[23,29,"parola"],[31,33,"il"],[34,43,"burattino"],[44,50,"salutare"],[51,53,"il"],[54,57,"suo"],[58,63,"buono"],[64,68,"fata"],[70,73,"che"],[74,77,"essere"],[78,81,"per"],[82,85,"lui"],[86,89,"un"],[90,96,"specie"],[97,99,"di"],[100,105,"mamma"],[107,108,"e"],[109,117,"cantare"],[118,119,"e"],[120,128,"ballare"],[129,133,"uscire"],[134,139,"fuori"],[140,145,"da"],[146,151,"porta"],[152,154,"di"],[155,159,"casa"]]},{"it":"In poco più d’un’ora tutti i suoi amici furono invitati.","ja":"","t":[[0,2,"in"],[3,7,"poco"],[8,11,"più"],[12,13,"di"],[14,16,"un"],[17,20,"ora"],[21,26,"tutto"],[27,28,"il"],[29,33,"suo"],[34,39,"amico"],[40,46,"essere"],[47,55,"invitare"]]},{"it":"Alcuni accettarono subito e di gran cuore, altri, da principio, si fecero un po’ pregare; ma quando seppero che i panini da inzuppare nel caffè-e-latte sarebbero stati imburrati anche dalla parte di fuori, finirono tutti col dire: — Verremo anche noi, per farti piacere.","ja":"","t":[[0,6,"alcuno"],[7,18,"accettare"],[19,25,"subito"],[26,27,"e"],[28,30,"dire"],[31,35,"grande"],[36,41,"cuore"],[43,48,"altro"],[50,52,"da"],[53,62,"principio"],[64,66,"si"],[67,73,"fare"],[74,76,"un"],[77,79,"poco"],[81,88,"pregare"],[90,92,"ma"],[93,99,"quando"],[100,107,"sapere"],[108,111,"che"],[112,113,"il"],[114,120,"panino"],[121,123,"da"],[124,133,0],[134,137,"in"],[138,143,"caffè"],[144,145,"e"],[146,151,"latte"],[152,161,"essere"],[162,167,"essere"],[168,177,0],[178,183,"anche"],[184,189,"da"],[190,195,"parte"],[196,198,"di"],[199,204,"fuori"],[206,214,"finire"],[215,220,"tutto"],[221,224,"con"],[225,229,"dire"],[233,240,"venire"],[241,246,"anche"],[247,250,"noi"],[252,255,"per"],[256,261,"fare"],[262,269,"piacere"]]},{"it":"—","ja":"","t":[]},{"it":"Ora bisogna sapere che Pinocchio, fra i suoi amici e compagni di scuola, ne aveva uno prediletto e carissimo, il quale si chiamava di nome Romeo; ma tutti lo chiamavano col soprannome di Lucignolo, per via del suo personalino asciutto, secco e allampanato, tale e quale come il lucignuolo nuovo di un lumino da notte.","ja":"","t":[[0,3,"ora"],[4,11,"bisognare"],[12,18,"sapere"],[19,22,"che"],[23,32,0],[34,37,"fra"],[38,39,"il"],[40,44,"suo"],[45,50,"amico"],[51,52,"e"],[53,61,"compagno"],[62,64,"di"],[65,71,"scuola"],[73,75,"ne"],[76,81,"avere"],[82,85,"un"],[86,96,0],[97,98,"e"],[99,108,"caro"],[110,112,"il"],[113,118,"quale"],[119,121,"si"],[122,130,"chiamare"],[131,133,"di"],[134,138,"nome"],[139,144,0],[146,148,"ma"],[149,154,"tutto"],[155,157,"il"],[158,168,"chiamare"],[169,172,"con"],[173,183,0],[184,186,"di"],[187,196,0],[198,201,"per"],[202,205,"via"],[206,209,"di"],[210,213,"suo"],[214,225,0],[226,234,"asciutto"],[236,241,"secco"],[242,243,"e"],[244,255,0],[257,261,"tale"],[262,263,"e"],[264,269,"quale"],[270,274,"come"],[275,277,"il"],[278,288,0],[289,294,"nuovo"],[295,297,"Dio"],[298,300,"un"],[301,307,0],[308,310,"da"],[311,316,"notte"]]},{"it":"
quello"],[9,14,"scena"],[15,18,"lei"],[19,20,"e"],[21,23,"il"],[24,29,"altro"],[30,36,"vicino"],[37,45,"presentare"],[46,54,"ridere"],[56,58,"il"],[59,70,0],[71,73,"in"],[74,80,"questo"],[81,87,"mentre"],[88,96,0],[97,99,"il"],[100,109,0],[110,111,"e"],[112,119,"sparire"]]},{"it":"Corri, cerca, chiama...","ja":"","t":[[0,5,"correre"],[7,12,"cercare"],[14,20,"chiamare"]]},{"it":"L’avete più visto?","ja":"","t":[[0,1,"il"],[2,7,"avere"],[8,11,"più"],[12,17,"vedere"]]},{"it":"Figuriamoci che pianto, quella povera mamma, quando apprese la sua disgrazia!","ja":"","t":[[0,11,0],[12,15,"che"],[16,22,"piangere"],[24,30,"quello"],[31,37,"povero"],[38,43,"mamma"],[45,51,"quando"],[52,59,0],[60,62,"il"],[63,66,"suo"],[67,76,"disgrazia"]]},{"it":"Corse subito dal Re:","ja":"","t":[[0,5,"correre"],[6,12,"subito"],[13,16,"da"],[17,19,"re"]]},{"it":"— Giustizia, Maestà!...","ja":"","t":[[2,11,"giustizia"],[13,19,"maestà"]]},{"it":"Mi han rapito il bambino!","ja":"","t":[[0,2,"mi"],[3,6,"avere"],[7,13,"rapire"],[14,16,"il"],[17,24,"bambino"]]},{"it":"— Bimbo mio, tu sarai Re!","ja":"","t":[[2,7,"bimbo"],[8,11,"mio"],[13,15,"tu"],[16,21,"essere"],[22,24,"re"]]},{"it":"— le rispose il Re facendole il verso, per canzonarla.","ja":"","t":[[2,4,"il"],[5,12,"rispondere"],[13,15,"il"],[16,18,"re"],[19,28,"fare"],[29,31,"il"],[32,37,"verso"],[39,42,"per"],[43,53,0]]},{"it":"E la mandò via, tutto contento che quel malaugurio per la sua discendenza fosse sparito.","ja":"","t":[[0,1,"e"],[2,4,"il"],[5,10,"mandare"],[11,14,"via"],[16,21,"tutto"],[22,30,"contento"],[31,34,"che"],[35,39,"quello"],[40,50,0],[51,54,"per"],[55,57,"il"],[58,61,"suo"],[62,73,0],[74,79,"essere"],[80,87,"sparire"]]},{"it":"Gli occhi della povera donna parevano un fiume.","ja":"","t":[[0,3,"il"],[4,9,"occhio"],[10,15,"di"],[16,22,"povero"],[23,28,"donna"],[29,37,"parere"],[38,40,"un"],[41,46,"fiume"]]},{"it":"Andava attorno tutta la giornata, fermando la gente:","ja":"","t":[[0,6,"andare"],[7,14,"attorno"],[15,20,"tutto
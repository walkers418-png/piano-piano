"],[78,84,"dietro"],[86,92,"finché"],[93,95,"mi"],[96,107,"raggiungere"],[108,109,"e"],[110,111,"mi"],[112,123,"impiccare"],[124,125,"a"],[126,128,"un"],[129,133,"ramo"],[134,136,"di"],[137,143,"quello"],[144,151,"quercia"],[156,157,"e"],[158,167,0],[168,175,"accennare"],[176,178,"il"],[179,186,"quercia"],[187,193,"grande"],[195,198,"che"],[199,202,"essere"],[203,205,"lì"],[206,207,"a"],[208,211,"due"],[212,217,"passo"]]},{"it":"— Si può sentir di peggio?","ja":"","t":[[2,4,"si"],[5,8,"potere"],[9,15,"sentire"],[16,18,"di"],[19,25,"peggio"]]},{"it":"— disse la Volpe.","ja":"","t":[[2,7,"dire"],[8,10,"il"],[11,16,"volpe"]]},{"it":"— In che mondo siamo condannati a vivere?","ja":"","t":[[2,4,"in"],[5,8,"che"],[9,14,"mondo"],[15,20,"essere"],[21,31,"condannare"],[32,33,"a"],[34,40,"vivere"]]},{"it":"Dove troveremo un rifugio sicuro noi altri galantuomini?…","ja":"","t":[[0,4,"dove"],[5,14,"trovare"],[15,17,"un"],[18,25,"rifugio"],[26,32,"sicuro"],[33,36,"noi"],[37,42,"altro"],[43,55,0]]},{"it":"―","ja":"","t":[]},{"it":"Nel tempo che parlavano così, Pinocchio si accòrse che il Gatto era zoppo dalla gamba destra davanti, perchè gli mancava in fondo tutto lo zampetto cogli unghioli: per cui gli domandò:","ja":"","t":[[0,3,"in"],[4,9,"tempo"],[10,13,"che"],[14,23,"parlare"],[24,28,"così"],[30,39,0],[40,42,"si"],[43,50,"accorgere"],[51,54,"che"],[55,57,"il"],[58,63,"gatto"],[64,67,"essere"],[68,73,"zoppo"],[74,79,"da"],[80,85,"gamba"],[86,92,"destra"],[93,100,"davanti"],[102,108,"perché"],[109,112,"il"],[113,120,"mancare"],[121,123,"in"],[124,129,"fondo"],[130,135,"tutto"],[136,138,"il"],[139,147,0],[148,153,"con"],[154,162,0],[164,167,"per"],[168,171,"cui"],[172,175,"il"],[176,183,"domandare"]]},{"it":"— Che cosa hai fatto del tuo zampetto?","ja":"","t":[[2,5,"che"],[6,10,"cosa"],[11,14,"avere"],[15,20,"fare"],[21,24,"di"],[25,28,"tuo"],[29,37,0]]},{"it":"―","ja":"","t":[]},{"it":"Il Gatto voleva rispondere qualche cosa, ma s’imbrogliò.","ja":"","t":[[0,2,"il"],[3,8,"gatt
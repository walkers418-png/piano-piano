re"],[16,25,"crescere"],[27,29,"il"],[30,40,"bastimento"],[41,48,0],[49,59,"fortemente"]]},{"it":"Ma i due ragazzi, che non pativano il mal di mare, non ci badavano.","ja":"","t":[[0,2,"ma"],[3,4,"il"],[5,8,"due"],[9,16,"ragazzo"],[18,21,"che"],[22,25,"non"],[26,34,"patire"],[35,37,"il"],[38,41,"male"],[42,44,"di"],[45,49,"mare"],[51,54,"non"],[55,57,"ci"],[58,66,"badare"]]},{"it":"La ragazzina sorrideva.","ja":"","t":[[0,2,"il"],[3,12,"ragazzina"],[13,22,"sorridere"]]},{"it":"Aveva presso a poco l’età del suo compagno, ma era assai più alta: bruna di viso, sottile, un po’ patita, e vestita più che modestamente.","ja":"","t":[[0,5,"avere"],[6,12,"presso"],[13,14,"a"],[15,19,"poco"],[20,21,"il"],[22,25,"età"],[26,29,"di"],[30,33,"suo"],[34,42,"compagno"],[44,46,"ma"],[47,50,"essere"],[51,56,"assai"],[57,60,"più"],[61,65,"alto"],[67,72,"bruno"],[73,75,"di"],[76,80,"viso"],[82,89,"sottile"],[91,93,"un"],[94,96,"poco"],[98,104,"patire"],[106,107,"e"],[108,115,"vestire"],[116,119,"più"],[120,123,"che"],[124,136,0]]},{"it":"Aveva i capelli tagliati corti e ricciuti, un fazzoletto rosso intorno al capo e due cerchiolini d’argento alle orecchie.","ja":"","t":[[0,5,"avere"],[6,7,"il"],[8,15,"capello"],[16,24,"tagliare"],[25,30,"corto"],[31,32,"e"],[33,41,0],[43,45,"un"],[46,56,"fazzoletto"],[57,62,"rosso"],[63,70,"intorno"],[71,73,"a"],[74,78,"capo"],[79,80,"e"],[81,84,"due"],[85,96,0],[97,98,"di"],[99,106,"argento"],[107,111,"a"],[112,120,"orecchio"]]},{"it":"Mangiando, si raccontarono i fatti loro.","ja":"","t":[[0,9,"mangiare"],[11,13,"si"],[14,26,"raccontare"],[27,28,"il"],[29,34,"fare"],[35,39,"loro"]]},{"it":"Il ragazzo non aveva più nè padre nè madre.","ja":"","t":[[0,2,"il"],[3,10,"ragazzo"],[11,14,"non"],[15,20,"avere"],[21,24,"più"],[25,27,"né"],[28,33,"padre"],[34,36,"né"],[37,42,"madre"]]},{"it":"Il padre, operaio, gli era morto a Liverpool pochi dì prima, lasciandolo solo, e il console italiano aveva rimandato lui al suo paese, a Palermo, dove gli restavan dei p
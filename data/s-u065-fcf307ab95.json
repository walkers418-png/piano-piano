are"],[72,75,"un"],[76,84,"spingere"],[85,90,"in"],[91,97,"spalla"],[99,100,"e"],[101,103,"mi"],[104,110,"trovare"],[111,114,"tra"],[115,117,"il"],[118,121,"suo"],[122,129,"braccio"]]},{"it":"Egli mi baciò e disse: — Mai più baruffe tra di noi, non è vero?","ja":"","t":[[0,4,"egli"],[5,7,"mi"],[8,13,"baciare"],[14,15,"e"],[16,21,"dire"],[25,28,"mai"],[29,32,"più"],[33,40,0],[41,44,"tra"],[45,47,"Dio"],[48,51,"noi"],[53,56,"non"],[57,58,"essere"],[59,63,"vero"]]},{"it":"— Mai più! mai più!","ja":"","t":[[2,5,"mai"],[6,9,"più"],[11,14,"mai"],[15,18,"più"]]},{"it":"— risposi.","ja":"","t":[[2,9,"rispondere"]]},{"it":"E ci separammo, contenti.","ja":"","t":[[0,1,"e"],[2,4,"ci"],[5,14,0],[16,24,"contento"]]},{"it":"Ma quando arrivai a casa e raccontai tutto a mio padre, credendo di fargli piacere, egli si rabbruscò e disse: — Dovevi esser tu il primo a tendergli la mano, poichè avevi torto.","ja":"","t":[[0,2,"ma"],[3,9,"quando"],[10,17,"arrivare"],[18,19,"a"],[20,24,"casa"],[25,26,"e"],[27,36,"raccontare"],[37,42,"tutto"],[43,44,"a"],[45,48,"mio"],[49,54,"padre"],[56,64,"credere"],[65,67,"di"],[68,74,"fare"],[75,82,"piacere"],[84,88,"egli"],[89,91,"si"],[92,101,0],[102,103,"e"],[104,109,"dire"],[113,119,"dovere"],[120,125,"essere"],[126,128,"tu"],[129,131,"il"],[132,137,"primo"],[138,139,"a"],[140,149,"tendere"],[150,152,"il"],[153,157,"mano"],[159,165,0],[166,171,"avere"],[172,177,"torto"]]},{"it":"— Poi soggiunse: — Non dovevi alzar la riga sopra un compagno migliore di te, sopra il figliuolo d’un soldato!","ja":"","t":[[2,5,"poi"],[6,15,"dire"],[19,22,"non"],[23,29,"dovere"],[30,35,0],[36,38,"il"],[39,43,"riga"],[44,49,"sopra"],[50,52,"un"],[53,61,"compagno"],[62,70,"migliore"],[71,73,"di"],[74,76,"te"],[78,83,"sopra"],[84,86,"il"],[87,96,"figliuolo"],[97,98,"di"],[99,101,"un"],[102,109,"soldato"]]},{"it":"— E strappatami la riga di mano, la fece in due pezzi e la sbatté nel muro.","ja":"","t":[[2,3,"e"],[4,15,"strappare"],[16,18,"il"],[19,23,"riga"],[24,26,"di"],[27
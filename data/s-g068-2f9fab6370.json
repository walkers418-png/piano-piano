ro"],[168,178,0],[179,182,"un"],[183,188,"parte"],[189,194,"di"],[195,198,"mio"],[199,209,0],[211,213,"mi"],[214,220,"parere"],[221,224,"un"],[225,229,"cosa"],[230,235,"fare"],[236,240,"male"],[241,242,"e"],[243,245,"mi"],[246,252,"fare"],[253,255,"un"],[256,260,"grande"],[261,271,"dispiacere"]]},{"it":"Il Maralli, dunque, ha strappato le pagine del suo sposalizio a San Francesco al Monte, ne ha fatto una palla e l’ha buttata nel caminetto.","ja":"","t":[[0,2,"il"],[3,10,0],[12,18,"dunque"],[20,22,"avere"],[23,32,"strappare"],[33,35,"il"],[36,42,"pagina"],[43,46,"di"],[47,50,"suo"],[51,61,"sposalizio"],[62,63,"a"],[64,67,0],[68,77,0],[78,80,"a"],[81,86,"monte"],[88,90,"ne"],[91,93,"avere"],[94,99,"fare"],[100,103,"un"],[104,109,"palla"],[110,111,"e"],[112,113,"il"],[114,116,"avere"],[117,124,"buttare"],[125,128,"in"],[129,138,"caminetto"]]},{"it":"Quand’ho visto che il fuoco s’è attaccato a un angolo di una pagina che era rimasto arricciato sulla palla di carta fatta da mio cognato, mi son sentito una stretta dolorosa al cuore; ma ne ho sentita subito un’altra, e questa volta era di gioia, vedendo che la fiamma appena lambito quel pezzo di carta accartocciata s’è spenta rispettando la palla che era stata molto compressa ed era perciò assai resistente; e da quel punto, quanti palpiti a ogni minaccia del fuoco contro le pagine del mio giornalino!","ja":"","t":[[0,5,"quando"],[6,8,"avere"],[9,14,"vedere"],[15,18,"che"],[19,21,"il"],[22,27,"fuoco"],[28,29,"si"],[30,31,"essere"],[32,41,"attaccare"],[42,43,"a"],[44,46,"un"],[47,53,"angolo"],[54,56,"di"],[57,60,"un"],[61,67,"pagina"],[68,71,"che"],[72,75,"essere"],[76,83,"rimanere"],[84,94,0],[95,100,"su"],[101,106,"palla"],[107,109,"di"],[110,115,"carta"],[116,121,"fare"],[122,124,"da"],[125,128,"mio"],[129,136,"cognato"],[138,140,"mi"],[141,144,"essere"],[145,152,"sentire"],[153,156,"un"],[157,164,"stretto"],[165,173,"doloroso"],[174,176,"a"],[177,182,"cuore"],[184,186,"ma"],[187,189,"ne"],[190,192,"avere"],[193,200,"sen
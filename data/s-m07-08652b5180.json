{"id":"m07","title":"第7話 嵐","lv":3,"kind":"連載","note":"","lines":[{"it":"Il giorno dopo il cielo era grigio, ma non pioveva ancora.","ja":"翌日、空は灰色でしたが、まだ雨は降っていませんでした。","t":[[0,2,"il"],[3,9,"giorno"],[10,14,"dopo"],[15,17,"il"],[18,23,"cielo"],[24,27,"essere"],[28,34,"grigio"],[36,38,"ma"],[39,42,"non"],[43,50,"piovere"],[51,57,"ancora"]]},{"it":"Elisa e Matteo hanno detto alla nonna che andavano a fare una passeggiata.","ja":"エリーザとマッテオは、散歩に行くと祖母に言いました。","t":[[0,5,0],[6,7,"e"],[8,14,0],[15,20,"avere"],[21,26,"dire"],[27,31,"a"],[32,37,"nonna"],[38,41,"che"],[42,50,"andare"],[51,52,"a"],[53,57,"fare"],[58,61,"un"],[62,73,"passeggiata"]]},{"it":"Non era proprio una bugia.","ja":"まったくのうそではありませんでした。","t":[[0,3,"non"],[4,7,"essere"],[8,15,"proprio"],[16,19,"un"],[20,25,"bugia"]]},{"it":"Hanno preso l'acqua, due panini e una pila e sono partiti sul sentiero.","ja":"水とパニーニ2つと懐中電灯を持って、小道を歩き出しました。","t":[[0,5,"avere"],[6,11,"prendere"],[12,13,"il"],[14,19,"acqua"],[21,24,"due"],[25,31,"panino"],[32,33,"e"],[34,37,"un"],[38,42,"g:pila"],[43,44,"e"],[45,49,"essere"],[50,57,"partire"],[58,61,"su"],[62,70,"sentiero"]]},{"it":"Dopo un'ora il vento è diventato forte.","ja":"1時間後、風が強くなりました。","t":[[0,4,"dopo"],[5,7,"un"],[8,11,"ora"],[12,14,"il"],[15,20,"vento"],[21,22,"essere"],[23,32,"diventare"],[33,38,"forte"]]},{"it":"Poi sono arrivati i tuoni.","ja":"それから雷が来ました。","t":[[0,3,"poi"],[4,8,"essere"],[9,17,"arrivare"],[18,19,"il"],[20,25,"g:tuoni"]]},{"it":"La pioggia è cominciata all'improvviso, fredda e pesante.","ja":"雨が突然、冷たく激しく降り始めました。","t":[[0,2,"il"],[3,10,"pioggia"],[11,12,"essere"],[13,23,"cominciare"],[24,27,"a"],[28,38,"improvviso"],[40,46,"freddo"],[47,48,"e"],[49,56,"pesare"]]},{"it":"Non si vedeva quasi niente.","ja":"ほとんど何も見えませんでした。","t":[[0,3,"non"],[4,6,"si"],[7,13,"vedere"],[14,19,"quasi"],[20,26,"niente"]]},{"it":"«Dobbiamo tornare!» ha gridato Elisa.","ja":"「戻らなきゃ！」とエリーザが叫びました。","t":[[1,9,"dovere"],[10,17,"tornare"],[20,22,"avere"],[23,30,"gridare"],[31,36,0]]},{"i
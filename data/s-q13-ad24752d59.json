{"id":"q13","title":"第13話 昨日の夜のこと","lv":2,"kind":"連載","note":"","lines":[{"it":"La mattina dopo Kenta è andato da Nonna Rita.","ja":"翌朝、ケンタはノンナ・リータのところへ行きました。","t":[[0,2,"il"],[3,10,"mattina"],[11,15,"dopo"],[16,21,0],[22,23,"essere"],[24,30,"andare"],[31,33,"da"],[34,39,0],[40,44,0]]},{"it":"Le ha raccontato tutto.","ja":"すべてを話しました。","t":[[0,2,"il"],[3,5,"avere"],[6,16,"raccontare"],[17,22,"tutto"]]},{"it":"«Ieri sera mi sono nascosto in cucina.","ja":"「昨日の夜、台所に隠れました。","t":[[1,5,"ieri"],[6,10,"sera"],[11,13,"mi"],[14,18,"essere"],[19,27,"nascondere"],[28,30,"in"],[31,37,"cucina"]]},{"it":"Ho visto Lucia. Ha messo una pagina nel cassetto.»","ja":"ルチアを見ました。引き出しにページを入れました」","t":[[0,2,"avere"],[3,8,"vedere"],[9,14,0],[16,18,"avere"],[19,24,"mettere"],[25,28,"un"],[29,35,"pagina"],[36,39,"in"],[40,48,"g:cassetto"]]},{"it":"Rita non ha detto niente per molto tempo.","ja":"リータは長い間、何も言いませんでした。","t":[[0,4,0],[5,8,"non"],[9,11,"avere"],[12,17,"dire"],[18,24,"niente"],[25,28,"per"],[29,34,"molto"],[35,40,"tempo"]]},{"it":"Poi ha chiuso gli occhi.","ja":"それから目を閉じました。","t":[[0,3,"poi"],[4,6,"avere"],[7,13,"chiuso"],[14,17,"il"],[18,23,"occhio"]]},{"it":"«Lucia è cresciuta in questa cucina» ha detto.","ja":"「ルチアはこの台所で育ったんだよ」と言いました。","t":[[1,6,0],[7,8,"essere"],[9,18,"crescere"],[19,21,"in"],[22,28,"questo"],[29,35,"cucina"],[37,39,"avere"],[40,45,"dire"]]},{"it":"«Non ruba alla sua famiglia.»","ja":"「家族から盗むような子じゃない」","t":[[1,4,"non"],[5,9,"g:ruba"],[10,14,"a"],[15,18,"suo"],[19,27,"famiglia"]]},{"it":"«Allora perché ha preso il quaderno?»","ja":"「では、どうしてノートを取ったんでしょう？」","t":[[1,7,"allora"],[8,14,"perché"],[15,17,"avere"],[18,23,"prendere"],[24,26,"il"],[27,35,"quaderno"]]},{"it":"«Non lo so» ha risposto Rita. «Ma aspetto. Lei tornerà.»","ja":"「わからない」とリータは答えました。「でも待つよ。あの子は帰ってくる」","t":[[1,4,"non"],[5,7,"il"],[8,10,"sapere"],[12,14,"avere"],[15,23,"rispondere"],[24,28,0],[31,33,"ma"],[34,41,"aspettare"],[43,46,"lei"],[47,54,"g:tornerà"]]},{"it":"Quel giorno Lucia non è venuta al lavoro.","ja":"その日、ルチアは仕事に来ませんでした。","t":[[0,4,"quello"],[5,11,"giorno"],[12,17,0],[18,21,"non"],[22,23,"essere"],[24,30,"venire"],[31,33,"a"],[34,40,"lavoro"]]}],"q":[{"skill":"match","s":"ケンタがリータに話したことは？","o":["昨夜ルチアを見たこと","ブルーニの店のこと","ミラノへ行くこと"],"why":"Ho visto Lucia."},{"skill":"infer","s":"リータのルチアへの気持ちは？","o":["信じている","憎んでいる","何も感じていない"],"why":"Non ruba alla sua famiglia. Lei tornerà."},{"skill":"vocab","s":"ha detto, ha risposto の時制は？","o":["近過去","現在","未来"],"why":"終わった出来事を表します。"}],"g":{"ruba":"盗む","cassetto":"引き出し","tornerà":"帰ってくる（未来）"},"n":79,"w":["a","allora","andare","aspettare","avere","chiuso","crescere","cucina","da","dire","dopo","essere","famiglia","giorno","ieri","il","in","lavoro","lei","ma","mattina","mettere","mi","molto","nascondere","niente","non","occhio","pagina","per","perché","poi","prendere","quaderno","quello","questo","raccontare","rispondere","sapere","sera","suo","tempo","tutto","un","vedere","venire"]}
{"id":"m03","title":"第3話 地図","lv":3,"kind":"連載","note":"","lines":[{"it":"Per due giorni hanno aperto tutti i cassetti della casa.","ja":"2日間、家中の引き出しを開けました。","t":[[0,3,"per"],[4,7,"due"],[8,14,"giorno"],[15,20,"avere"],[21,27,"aprire"],[28,33,"tutto"],[34,35,"il"],[36,44,"cassetto"],[45,50,"di"],[51,55,"casa"]]},{"it":"Hanno trovato bottoni, lettere, vecchie monete e perfino un dente d'oro.","ja":"ボタン、手紙、古い硬貨、金歯まで見つかりました。","t":[[0,5,"avere"],[6,13,"trovare"],[14,21,"bottone"],[23,30,"lettera"],[32,39,"vecchio"],[40,46,"moneta"],[47,48,"e"],[49,56,"perfino"],[57,59,"un"],[60,65,"dente"],[66,67,"di"],[68,71,"oro"]]},{"it":"Ma la chiave non c'era.","ja":"でも鍵はありませんでした。","t":[[0,2,"ma"],[3,5,"il"],[6,12,"chiave"],[13,16,"non"],[17,18,"ci"],[19,22,"essere"]]},{"it":"Il terzo giorno Matteo ha aperto un libro della nonna per guardare le figure.","ja":"3日目、マッテオは絵を見ようと祖母の本を開きました。","t":[[0,2,"il"],[3,8,"terzo"],[9,15,"giorno"],[16,22,0],[23,25,"avere"],[26,32,"aprire"],[33,35,"un"],[36,41,"libro"],[42,47,"di"],[48,53,"nonna"],[54,57,"per"],[58,66,"guardare"],[67,69,"il"],[70,76,"g:figure"]]},{"it":"Dentro il libro c'era un buco, tagliato nelle pagine.","ja":"本の中には、ページをくり抜いた穴がありました。","t":[[0,6,"dentro"],[7,9,"il"],[10,15,"libro"],[16,17,"ci"],[18,21,"essere"],[22,24,"un"],[25,29,"buco"],[31,39,"tagliare"],[40,45,"in"],[46,52,"pagina"]]},{"it":"Nel buco c'era una catena con una piccola chiave!","ja":"その穴に、小さな鍵のついた鎖がありました！","t":[[0,3,"in"],[4,8,"buco"],[9,10,"ci"],[11,14,"essere"],[15,18,"un"],[19,25,"catena"],[26,29,"con"],[30,33,"un"],[34,41,"piccolo"],[42,48,"chiave"]]},{"it":"I bambini sono corsi in soffitta.","ja":"子どもたちは屋根裏へ走りました。","t":[[0,1,"il"],[2,9,"bambino"],[10,14,"essere"],[15,20,"correre"],[21,23,"in"],[24,32,"g:soffitta"]]},{"it":"Le mani di Elisa tremavano.","ja":"エリーザの手は震えていました。","t":[[0,2,"il"],[3,7,"mano"],[8,10,"di"],[11,16,0],[17,26,"tremare"]]},{"it":"La chiave è entrata e la scatola si è aperta.","ja":"鍵が入り、箱が開きました。","t":[[0,2,"il"],[3,9,"chiave"],[10,11,"e
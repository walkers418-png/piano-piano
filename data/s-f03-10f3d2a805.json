{"id":"f03","title":"ウサギとカメ","lv":1,"kind":"昔話","note":"大昔から伝わるイソップの話を、やさしく書き直したものです。","lines":[{"it":"Una lepre ride di una tartaruga.","ja":"野ウサギがカメを笑います。","t":[[0,3,"un"],[4,9,"g:lepre"],[10,14,"ridere"],[15,17,"di"],[18,21,"un"],[22,31,"tartaruga"]]},{"it":"«Sei così lenta! Io sono l'animale più veloce del bosco!»","ja":"「君はなんて遅いんだ！僕は森でいちばん速い動物だよ！」","t":[[1,4,"essere"],[5,9,"così"],[10,15,"lento"],[17,19,"io"],[20,24,"essere"],[25,26,"il"],[27,34,"animale"],[35,38,"più"],[39,45,"veloce"],[46,49,"di"],[50,55,"bosco"]]},{"it":"La tartaruga risponde: «Facciamo una gara.»","ja":"カメは答えます。「競走しよう」","t":[[0,2,"il"],[3,12,"tartaruga"],[13,21,"rispondere"],[24,32,"fare"],[33,36,"un"],[37,41,"g:gara"]]},{"it":"La gara comincia.","ja":"競走が始まります。","t":[[0,2,"il"],[3,7,"g:gara"],[8,16,"cominciare"]]},{"it":"La lepre corre, corre e presto è molto lontana.","ja":"ウサギは走りに走って、すぐにずっと先へ行きます。","t":[[0,2,"il"],[3,8,"g:lepre"],[9,14,"correre"],[16,21,"correre"],[22,23,"e"],[24,30,"presto"],[31,32,"essere"],[33,38,"molto"],[39,46,"lontano"]]},{"it":"Si ferma sotto un albero.","ja":"木の下で止まります。","t":[[0,2,"si"],[3,8,"fermare"],[9,14,"sotto"],[15,17,"un"],[18,24,"albero"]]},{"it":"«Ho tanto tempo» pensa, e si addormenta.","ja":"「時間はたっぷりある」と思い、眠ってしまいます。","t":[[1,3,"avere"],[4,9,"tanto"],[10,15,"tempo"],[17,22,"pensare"],[24,25,"e"],[26,28,"si"],[29,39,"addormentare"]]},{"it":"La tartaruga cammina piano piano, ma non si ferma mai.","ja":"カメはゆっくりと歩きますが、決して止まりません。","t":[[0,2,"il"],[3,12,"tartaruga"],[13,20,"camminare"],[21,26,"piano"],[27,32,"piano"],[34,36,"ma"],[37,40,"non"],[41,43,"si"],[44,49,"fermare"],[50,53,"mai"]]},{"it":"Quando la lepre si sveglia, corre più veloce che può.","ja":"ウサギは目を覚ますと、全速力で走ります。","t":[[0,6,"quando"],[7,9,"il"],[10,15,"g:lepre"],[16,18,"si"],[19,26,"svegliare"],[28,33,"correre"],[34,37,"più"],[38,44,"veloce"],[45,48,"che"],[49,52,"potere"]]},{"it":"Ma la tartaruga è già al traguardo.","ja":"でもカメはもうゴールにいます。","t":[[0,2,"ma"],[3,5,"il"],[6,15,"tartaruga"],[16,17,"essere"],[18,21,"già"],[22,24,"a"],[25,34,"traguardo"]]}],"q":[{"skill":"match","s":"ウサギが負けた理由は？","o":["途中で眠ったから","足をけがしたから","道に迷ったから"],"why":"si addormenta."},{"skill":"main","s":"この話の教訓に近いのは？","o":["ゆっくりでも続ければ勝てる","速い者が必ず勝つ","眠ることは大切だ"],"why":"Piano piano, ma non si ferma mai."},{"skill":"vocab","s":"piano piano の意味は？","o":["少しずつ、ゆっくり","ピアノの音","とても速く"],"why":"このアプリの名前の由来です。"}],"g":{"lepre":"野ウサギ","gara":"競走","si addormenta":"眠り込む"},"n":74,"w":["a","addormentare","albero","animale","avere","bosco","camminare","che","cominciare","correre","così","di","e","essere","fare","fermare","già","il","io","lento","lontano","ma","mai","molto","non","pensare","piano","più","potere","presto","quando","ridere","rispondere","si","sotto","svegliare","tanto","tartaruga","tempo","traguardo","un","veloce"]}
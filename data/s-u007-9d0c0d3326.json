e quando facevamo buona figura, buona sempre e amorosa come una madre.","ja":"","t":[[0,5,"anche"],[6,12,"quando"],[13,17,"essere"],[18,24,"grande"],[26,28,"mi"],[29,38,"ricordare"],[39,45,"ancora"],[46,48,"di"],[49,51,"te"],[52,53,"e"],[54,59,"andare"],[60,61,"a"],[62,70,"trovare"],[71,74,"fra"],[75,76,"il"],[77,81,"tuo"],[82,89,"ragazzo"],[91,92,"e"],[93,97,"ogni"],[98,103,"volta"],[104,107,"che"],[108,115,"passare"],[116,122,"vicino"],[123,124,"a"],[125,128,"un"],[129,135,"scuola"],[136,137,"e"],[138,145,"sentire"],[146,148,"il"],[149,153,"voce"],[154,155,"di"],[156,159,"un"],[160,167,"maestra"],[169,171,"mi"],[172,177,"parere"],[178,180,"di"],[181,187,"sentire"],[188,190,"il"],[191,194,"tuo"],[195,199,"voce"],[201,202,"e"],[203,212,"ripensare"],[213,215,"a"],[216,219,"due"],[220,224,"anno"],[225,228,"che"],[229,235,"passare"],[236,241,"in"],[242,248,"scuola"],[249,252,"tuo"],[254,258,"dove"],[259,266,"imparare"],[267,272,"tanto"],[273,277,"cosa"],[279,283,"dove"],[284,286,"ti"],[287,291,"vedere"],[292,297,"tanto"],[298,303,"volta"],[304,310,"malato"],[311,312,"e"],[313,319,"stanco"],[321,323,"ma"],[324,330,"sempre"],[331,340,0],[342,348,"sempre"],[349,359,"indulgente"],[361,370,"disperare"],[371,377,"quando"],[378,381,"un"],[382,390,"pigliare"],[391,393,"un"],[394,397,"male"],[398,403,0],[404,409,"di"],[410,414,"dito"],[415,416,"a"],[417,425,"scrivere"],[427,435,"tremare"],[436,442,"quando"],[443,446,"il"],[447,456,0],[457,458,"ci"],[459,472,"interrogare"],[474,480,"felice"],[481,487,"quando"],[488,496,"fare"],[497,502,"buono"],[503,509,"figura"],[511,516,"buono"],[517,523,"sempre"],[524,525,"e"],[526,533,0],[534,538,"come"],[539,542,"un"],[543,548,"madre"]]},{"it":"Mai, mai non mi scorderò di te, maestra mia.","ja":"","t":[[0,3,"mai"],[5,8,"mai"],[9,12,"non"],[13,15,"mi"],[16,24,"scordare"],[25,27,"di"],[28,30,"te"],[32,39,"maestra"],[40,43,"mio"]]}],"q":[],"g":{},"n":516,"w":["Dio","a","abbastanza","affannare","allegro","anche","ancora","andare","anno","aritme
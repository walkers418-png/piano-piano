[[0,1,"e"],[2,5,"in"],[6,11,"tempo"],[12,15,"che"],[16,18,"si"],[19,26,"fingere"],[27,39,"addormentare"],[41,49,0],[50,53,"con"],[54,56,"un"],[57,59,"poco"],[61,63,"di"],[64,69,"con"],[70,77,"sciogliere"],[78,80,"in"],[81,83,"un"],[84,90,"guscio"],[91,92,"di"],[93,97,"uovo"],[98,101,"il"],[102,111,"appiccicare"],[112,113,"il"],[114,117,"due"],[118,123,"piede"],[124,126,"a"],[127,131,"loro"]]},{"it":"Principiò a fare mille sgambetti.","ja":"","t":[[0,9,"cominciare"],[10,11,"a"],[12,16,"fare"],[17,22,"mille"],[23,32,0]]},{"it":"posto, e glieli appiccicò così bene, che non si vedeva nemmeno il segno dell’attaccatura.","ja":"","t":[[0,5,"posto"],[7,8,"e"],[9,15,0],[16,25,"appiccicare"],[26,30,"così"],[31,35,"bene"],[37,40,"che"],[41,44,"non"],[45,47,"si"],[48,54,"vedere"],[55,62,"nemmeno"],[63,65,"il"],[66,71,"segno"],[72,76,"di"],[77,88,0]]},{"it":"Appena il burattino si accorse di avere i piedi, saltò giù dalla tavola dove stava disteso, e principiò a fare mille sgambetti e mille capriòle, come se fosse ammattito dalla gran contentezza.","ja":"","t":[[0,6,"appena"],[7,9,"il"],[10,19,"burattino"],[20,22,"si"],[23,30,"accorgersi"],[31,33,"di"],[34,39,"avere"],[40,41,"il"],[42,47,"piede"],[49,54,"saltare"],[55,58,"giù"],[59,64,"da"],[65,71,"tavola"],[72,76,"dove"],[77,82,"stare"],[83,90,"disteso"],[92,93,"e"],[94,103,"cominciare"],[104,105,"a"],[106,110,"fare"],[111,116,"mille"],[117,126,0],[127,128,"e"],[129,134,"mille"],[135,143,0],[145,149,"come"],[150,152,"se"],[153,158,"essere"],[159,168,0],[169,174,"da"],[175,179,"grande"],[180,191,"contentezza"]]},{"it":"— Per ricompensarvi di quanto avete fatto per me — disse Pinocchio al suo babbo — voglio subito andare a scuola.","ja":"","t":[[2,5,"per"],[6,19,0],[20,22,"di"],[23,29,"quanto"],[30,35,"avere"],[36,41,"fare"],[42,45,"per"],[46,48,"me"],[51,56,"dire"],[57,66,0],[67,69,"a"],[70,73,"suo"],[74,79,"babbo"],[82,88,"volere"],[89,95,"subito"],[96,102,"andare"],[103,104,"a"],[105,111,"scuola"]]},{"it":"— Bravo ragazzo.","ja":"","t":[[2,7,"bravo"],[8,15,"ragazzo"]]},{"it":"— Ma per andare a scuola ho bisogno d’un po’ di vestito.","ja":"","t":[[2,4,"ma"],[5,8,"per"],[9,15,"andare"],[16,17,"a"],[18,24,"scuola"],[25,27,"avere"],[28,35,"bisogno"],[36,37,"di"],[38,40,"un"],[41,43,"poco"],[45,47,"di"],[48,55,"vestito"]]},{"it":"—","ja":"","t":[]},{"it":"Gli fece.... un berrettino di midolla di pane.","ja":"","t":[[0,3,"il"],[4,8,"fare"],[13,15,"un"],[16,26,0],[27,29,"di"],[30,37,0],[38,40,"di"],[41,45,"pane"]]},{"it":"Geppetto, che era povero e non aveva in tasca nemmeno un centesimo, gli fece allora un vestituccio di carta fiorita, un paio di scarpe di scorza d’albero e un berrettino di midolla di pane.","ja":"","t":[[0,8,0],[10,13,"che"],[14,17,"essere"],[18,24,"povero"],[25,26,"e"],[27,30,"non"],[31,36,"avere"],[37,39,"in"],[40,45,"tasca"],[46,53,"nemmeno"],[54,56,"un"],[57,66,"centesimo"],[68,71,"il"],[72,76,"fare"],[77,83,"allora"],[84,86,"un"],[87,98,0],[99,101,"di"],[102,107,"carta"],[108,115,"fiorire"],[117,119,"un"],[120,124,"paio"],[125,127,"di"],[128,134,"scarpa"],[135,137,"di"],[138,144,"scorza"],[145,146,"di"],[147,153,"albero"],[154,155,"e"],[156,158,"un"],[159,169,0],[170,172,"di"],[173,180,0],[181,183,"di"],[184,188,"pane"]]},{"it":"Pinocchio corse subito a specchiarsi in una catinella piena d’acqua e rimase così contento di sè, che disse pavoneggiandosi:","ja":"","t":[[0,9,0],[10,15,"correre"],[16,22,"subito"],[23,24,"a"],[25,36,0],[37,39,"in"],[40,43,"un"],[44,53,0],[54,59,"pieno"],[60,61,"di"],[62,67,"acqua"],[68,69,"e"],[70,76,"rimanere"],[77,81,"così"],[82,90,"contento"],[91,93,"di"],[94,96,"sé"],[98,101,"che"],[102,107,"dire"],[108,123,0]]},{"it":"— Paio proprio un signore!","ja":"","t":[[2,6,"paio"],[7,14,"proprio"],[15,17,"un"],[18,25,"signore"]]},{"it":"— Davvero; — replicò Geppetto, — perchè, tienlo a mente, non è il vestito bello che fa il signore, ma è piuttosto il vestito pulito.","ja":"","t":[[2,9,"davvero"],[13,20,"replicare"],[21,29,0],[33,39,"perché"],[41,47
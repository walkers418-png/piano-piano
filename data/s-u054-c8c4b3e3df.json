n carro magnifico, tirato da quattro cavalli coperti di gualdrappe ricamate d’oro, e tutto inghirlandato di rose finte, sul quale c’erano quattordici o quindici signori, mascherati da gentiluomini della corte di Francia, tutti luccicanti di seta, col parruccone bianco, un cappello piumato sotto il braccio e lo spadino, e un arruffio di nastri e di trine sul petto; bellissimi.","ja":"","t":[[0,6,"quando"],[7,9,"il"],[10,16,"nostro"],[17,25,"carrozza"],[26,31,"entrare"],[32,37,"in"],[38,44,"piazza"],[46,52,"andare"],[53,60,"dinanzi"],[61,62,"a"],[63,66,"noi"],[67,69,"un"],[70,75,"carro"],[76,85,"magnifico"],[87,93,"tirare"],[94,96,"da"],[97,104,"quattro"],[105,112,"cavallo"],[113,120,"coprire"],[121,123,"di"],[124,134,0],[135,143,"ricamare"],[144,145,"di"],[146,149,"oro"],[151,152,"e"],[153,158,"tutto"],[159,172,0],[173,175,"di"],[176,180,"rodere"],[181,186,"finta"],[188,191,"su"],[192,197,"quale"],[198,199,"ci"],[200,205,"essere"],[206,217,"quattordici"],[218,219,"o"],[220,228,"quindici"],[229,236,"signore"],[238,248,0],[249,251,"da"],[252,264,0],[265,270,"di"],[271,276,"corto"],[277,279,"di"],[280,287,"Francia"],[289,294,"tutto"],[295,305,0],[306,308,"di"],[309,313,"seta"],[315,318,"con"],[319,329,0],[330,336,"bianco"],[338,340,"un"],[341,349,"cappello"],[350,357,0],[358,363,"sotto"],[364,366,"il"],[367,374,"braccio"],[375,376,"e"],[377,379,"il"],[380,387,0],[389,390,"e"],[391,393,"un"],[394,402,0],[403,405,"di"],[406,412,"nastro"],[413,414,"e"],[415,417,"dire"],[418,423,0],[424,427,"su"],[428,433,"petto"],[435,445,"bello"]]},{"it":"Cantavano tutti insieme una canzonetta francese, e gettavan dolci alla gente, e la gente batteva le mani e gridava.","ja":"","t":[[0,9,"cantare"],[10,15,"tutto"],[16,23,"insieme"],[24,27,"un"],[28,38,0],[39,47,"francese"],[49,50,"e"],[51,59,"gettare"],[60,65,"dolce"],[66,70,"a"],[71,76,"gente"],[78,79,"e"],[80,82,"il"],[83,88,"gente"],[89,96,"battere"],[97,99,"il"],[100,104,"mano"],[105,106,"e"],[107,114,"gridare"]]},{"it":"Quando a un tratto, sulla nostra sinistra, vedemmo un uomo sollevare sopra le teste della folla una bambina di cinque o sei anni, una poverella che piangeva disperatamente, agitando le braccia, come presa dalle convulsioni.","ja":"","t":[[0,6,"quando"],[7,8,"a"],[9,11,"un"],[12,18,"tratto"],[20,25,"su"],[26,32,"nostro"],[33,41,"sinistra"],[43,50,"vedere"],[51,53,"un"],[54,58,"uomo"],[59,68,"sollevare"],[69,74,"sopra"],[75,77,"il"],[78,83,"testa"],[84,89,"di"],[90,95,"folla"],[96,99,"un"],[100,107,"bambina"],[108,110,"di"],[111,117,"cinque"],[118,119,"o"],[120,123,"essere"],[124,128,"anno"],[130,133,"un"],[134,143,0],[144,147,"che"],[148,156,"piangere"],[157,171,"disperatamente"],[173,181,"agitare"],[182,184,"il"],[185,192,"braccio"],[194,198,"come"],[199,204,"prendere"],[205,210,"da"],[211,222,0]]},{"it":"L’uomo si fece largo verso il carro dei signori, uno di questi si chinò, e quell’altro disse forte: — Prenda questa bimba, ha perduto sua madre nella folla, la tenga in braccio; la madre non può essere lontana, e la vedrà, non c’è altra maniera.","ja":"","t":[[0,1,"il"],[2,6,"uomo"],[7,9,"si"],[10,14,"fare"],[15,20,"largo"],[21,26,"verso"],[27,29,"il"],[30,35,"carro"],[36,39,"di"],[40,47,"signore"],[49,52,"un"],[53,55,"Dio"],[56,62,"questo"],[63,65,"si"],[66,71,"chinare"],[73,74,"e"],[75,80,"quello"],[81,86,"altro"],[87,92,"dire"],[93,98,"forte"],[102,108,"prendere"],[109,115,"questo"],[116,121,"bimba"],[123,125,"avere"],[126,133,"perdere"],[134,137,"suo"],[138,143,"madre"],[144,149,"in"],[150,155,"folla"],[157,159,"il"],[160,165,"tenere"],[166,168,"in"],[169,176,"braccio"],[178,180,"il"],[181,186,"madre"],[187,190,"non"],[191,194,"potere"],[195,201,"essere"],[202,209,"lontano"],[211,212,"e"],[213,215,"il"],[216,221,"vedere"],[223,226,"non"],[227,228,"ci"],[229,230,"essere"],[231,236,"altro"],[237,244,"maniera"]]},{"it":"— Il signore prese la bimba in braccio; tutti gli altri cessarono di cantare, la bimba urlava e si dibatteva, il signore si tolse la maschera; il carro continuò a andare lentamente.","ja":"","t":[[2,4,"il"],[5,12,"signore"],[13,18,"prendere"],[19,21,"il"],[22,27,"bimba"],[28,30,"in"],[31,38,"braccio"],[40,45,"tutto"],[46,49,"il"],[50,55,"altro"],[56,65,"cessare"],[66,68,"di"],[69,76,"cantare"],[78,80,"il"],[81,86,"bimba"],[87,93,"urlare"],[94,95,"e"],[96,98,"si"],[99,108,0],[110,112,"il"],[113,120,"signore"],[121,123,"si"],[124,129,"togliere"],[130,132,"il"],[133,141,"maschera"],[143,145,"il"],[146,151,"carro"],[152,160,"continuare"],[161,162,"a"],[163,169,"andare"],[170,180,"lentamente"]]},{"it":"In quel mentre, come ci fu detto poi, all’estremità opposta della piazza, una povera donna mezzo impazzita rompeva la calca a gomitate e a spintoni, urlando: — Maria!","ja":"","t":[[0,2,"in"],[3,7,"quello"],[8,14,"mentre"],[16,20,"come"],[21,23,"ci"],[24,26,"essere"],[27,32,"dire"],[33,36,"poi"],[38,41,"a"],[42,51,0],[52,59,"opposto"],[60,65,"di"],[66,72,"piazza"],[74,77,"un"],[78,84,"povero"],[85,90,"donna"],[91,96,"mezzo"],[97,106,"impazzire"],[107,114,"rompere"],[115,117,"il"],[118,123,0],[124,125,"a"],[126,134,0],[135,136,"e"],[137,138,"a"],[139,147,0],[149,156,"urlare"],[160,165,0]]},{"it":"Maria!","ja":"","t":[[0,5,0]]},{"it":"Maria!","ja":"","t":[[0,5,0]]},{"it":"Ho perduto la mia figliuola!","ja":"","t":[[0,2,"avere"],[3,10,"perdere"],[11,13,"il"],[14,17,"mio"],[18,27,"figliuola"]]},{"it":"Me l’hanno rubata!","ja":"","t":[[0,2,"me"],[3,4,"il"],[5,10,"avere"],[11,17,"rubare"]]},{"it":"Mi hanno soffocato la mia bambina!","ja":"","t":[[0,2,"mi"],[3,8,"avere"],[9,18,"soffocare"],[19,21,"il"],[22,25,"mio"],[26,33,"bambina"]]},{"it":"— E da un quarto d’ora smaniava, si disperava a quel modo, andando un po’ di qua e un po’ di là, oppressa dalla folla, che stentava ad aprirle il passo.","ja":"","t":[[2,3,"e"],[4,6,"da"],[7,9,"un"],[10,16,"quarto"],[17,18,"di"],[19,22,"ora"],[23,31,0],[33,35,"si"],[36,45,"disperare"],[46,47,"a"],[48,52,"quello"],[53,57,"modo"],[59,66,"andare"],[67,69,"un"],[70,72,"poco"],[74,76,"di"],[77,80,"qua"],[81,82,"e"],[83,85,"un"],[86,88,"poco"],[90,92,"di"],[93,95,"là"],[97,105,0],[106,111,"da"],[112,117,"folla"],[119,122,"che"],[123,131,"stentare"],[132,134,"a"],[135,142,"aprire"],[143,145,"il"],[146,151,"passo"]]},{"it":"Il signore del carro, intanto, si teneva la bimba stretta contro i nastri e le trine del petto, girando lo sguardo per la piazza, e cercando di quietare la povera creatura, che si copriva il viso con le mani, non sapendo dove fosse, e singhiozzava da schiantarsi il cuore.","ja":"","t":[[0,2,"il"],[3,10,"signore"],[11,14,"di"],[15,20,"carro"],[22,29,"intanto"],[31,33,"si"],[34,40,"tenere"],[41,43,"il"],[44,49,"bimba"],[50,57,"stretto"],[58,64,"contro"],[65,66,"il"],[67,73,"nastro"],[74,75,"e"],[76,78,"il"],[79,84,0],[85,88,"di"],[89,94,"petto"],[96,103,"girare"],[104,106,"il"],[107,114,"sguardo"],[115,118,"per"],[119,121,"il"],[122,128,"piazza"],[130,131,"e"],[132,140,"cercare"],[141,143,"di"],[144,152,0],[153,155,"il"],[156,162,"povero"],[163,171,"creatura"],[173,176,"che"],[177,179,"si"],[180,187,"coprire"],[188,190,"il"],[191,195,"viso"],[196,199,"con"],[200,202,"il"],[203,207,"mano"],[209,212,"non"],[213,220,"sapere"],[221,225,"dove"],[226,231,"essere"],[233,234,"e"],[235,247,"singhiozzare"],[248,250,"da"],[251,262,0],[263,265,"il"],[266,271,"cuore"]]},{"it":"Il signore era commosso, si vedeva che quelle grida gli andavano all’anima; tutti gli altri offrivano alla bimba arancie e confetti; ma quella respingeva tutto, sempre più spaventata e convulsa.","ja":"","t":[[0,2,"il"],[3,10,"signore"],[11,14,"essere"],[15,23,"commosso"],[25,27,"si"],[28,34,"vedere"],[35,38,"che"],[39,45,"quello"],[46,51,"gridare"],[52,55,"il"],[56,64,"andare"],[65,68,"a"],[69,74,"anima"],[76,81,"tutto"],[82,85,"il"],[86,91,"altro"],[92,101,"offrire"],[102,106,"a"],[107,112,"bimba"],[113,120,"arancia"],[121,122,"e"],[123,131,"confetto"],[133,135,"ma"],[136,142,"quello"],[143,153,"respingere"],[154,159,"tutto"],[161,167,"sempre"],[168,171,"più"],[172,182,"spaventato"],[183,184,"e"],[185,193,"convulso"]]},{"it":"— Cercate la madre! gridava il signore alla folla, — cercate la madre!","ja":"","t":[[2,9,"cercare"],[10,12,"il"],[13,18,"madre"],[20,27,"gridare"],[28,30,"il"],[31,38,"signore"],[39,43,"a"],[44,49,"folla"],[53,60,"cercare"],[61,63,"il"],[64,69,"madre"]]},{"it":"— E tutti si voltavano a destra e a sinistra; ma la madre non si trovava.","ja":"","t":[[2,3,"e"],[4,9,"tutto"],[10,12,"si"],[13,22,"voltare"],[23,24,"a"],[25,31,"destra"],[32,33,"e"],[34,35,"a"],[36,44,"sinistra"],[46,48,"ma"],[49,51,"il"],[52,57,"madre"],[58,61,"non"],[62,64,"si"],[65,72,"trovare"]]},{"it":"Finalmente, a pochi passi dall’imboccatura di via Roma, si vide una donna slanciarsi verso il carro...","ja":"","t":[[0,10,"finalmente"],[12,13,"a"],[14,19,"poco"],[20,25,"passo"],[26,30,"da"],[31,42,0],[43,45,"di"],[46,49,"via"],[50,54,0],[56,58,"si"],[59,63,"vedere"],[64,67,"un"],[68,73,"donna"],[74,84,0],[85,90,"verso"],[91,93,"il"],[94,99,"carro"]]},{"it":"Ah! mai più la dimenticherò!","ja":"","t":[[0,2,"ah"],[4,7,"mai"],[8,11,"più"],[12,14,"il"],[15,27,"dimenticare"]]},{"it":"Non pareva più una creatura umana, aveva i capelli sciolti, la faccia sformata, le vesti lacere, si slanciò avanti mettendo un rantolo che non si capì se fosse di gioia, d’angoscia o di rabbia, e avventò le mani come due artigli per afferrar la figliuola.","ja":"","t":[[0,3,"non"],[4,10,"parere"],[11,14,"più"],[15,18,"un"],[19,27,"creatura"],[28,33,"umano"],[35,40,"avere"],[41,42,"il"],[43,50,"capello"],[51,58,"sciogliere"],[60,62,"il"],[63,69,"fare"],[70,78,0],[80,82,"il"],[83,88,"vestire"],[89,95,"lacero"],[97,99,"si"],[100,107,0],[108,114,"avanti"],[115,123,"mettere"],[124,126,"un"],[127,134,0],[135,138,"che"],[139,142,"non"],[143,145,"si"],[146,150,"capire"],[151,153,"se"],[154,159,"essere"],[160,162,"di"],[163,168,"gioia"],[170,171,"di"],[172,180,"angoscia"],[181,182,"o"],[183,185,"di"],[186,192,"rabbia"],[194,195,"e"],[196,203,"avventare"],[204,206,"il"],[207,211,"mano"],[212,216,
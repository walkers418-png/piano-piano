.","ja":"","t":[[0,3,"non"],[4,10,"volere"],[11,15,"avere"],[16,18,"da"],[19,25,"punire"],[26,33,"nessuno"]]},{"it":"Mostratemi che siete ragazzi di cuore; la nostra scuola sarà una famiglia e voi sarete la mia consolazione e la mia alterezza.","ja":"","t":[[0,10,"mostrare"],[11,14,"che"],[15,20,"essere"],[21,28,"ragazzo"],[29,31,"di"],[32,37,"cuore"],[39,41,"il"],[42,48,"nostro"],[49,55,"scuola"],[56,60,"essere"],[61,64,"un"],[65,73,"famiglia"],[74,75,"e"],[76,79,"voi"],[80,86,"essere"],[87,89,"il"],[90,93,"mio"],[94,106,"consolazione"],[107,108,"e"],[109,111,"il"],[112,115,"mio"],[116,125,0]]},{"it":"Non vi domando una promessa a parole; son certo che, nel vostro cuore, m’avete già detto di sì.","ja":"","t":[[0,3,"non"],[4,6,"vi"],[7,14,"domandare"],[15,18,"un"],[19,27,"promettere"],[28,29,"a"],[30,36,"parola"],[38,41,"essere"],[42,47,"certo"],[48,51,"che"],[53,56,"in"],[57,63,"vostro"],[64,69,"cuore"],[71,72,"mi"],[73,78,"avere"],[79,82,"già"],[83,88,"dire"],[89,91,"di"],[92,94,"sì"]]},{"it":"E vi ringrazio.","ja":"","t":[[0,1,"e"],[2,4,"vi"],[5,14,"ringraziare"]]},{"it":"— In quel punto entrò il bidello a dare il finis.","ja":"","t":[[2,4,"in"],[5,9,"quello"],[10,15,"punto"],[16,21,"entrare"],[22,24,"il"],[25,32,"bidello"],[33,34,"a"],[35,39,"dare"],[40,42,"il"],[43,48,0]]},{"it":"Uscimmo tutti dai banchi zitti zitti.","ja":"","t":[[0,7,"uscire"],[8,13,"tutto"],[14,17,"da"],[18,24,"banco"],[25,30,"zitto"],[31,36,"zitto"]]},{"it":"Il ragazzo che s’era rizzato sul banco s’accostò al maestro, e gli disse con voce tremante: — Signor maestro, mi perdoni.","ja":"","t":[[0,2,"il"],[3,10,"ragazzo"],[11,14,"che"],[15,16,"si"],[17,20,"essere"],[21,28,"rizzare"],[29,32,"su"],[33,38,"banco"],[39,40,"si"],[41,48,"accostare"],[49,51,"a"],[52,59,"maestro"],[61,62,"e"],[63,66,"il"],[67,72,"dire"],[73,76,"con"],[77,81,"voce"],[82,90,"tremare"],[94,100,"signore"],[101,108,"maestro"],[110,112,"mi"],[113,120,"perdonare"]]},{"it":"— Il maestro lo baciò in fronte e gli disse: — Va, f
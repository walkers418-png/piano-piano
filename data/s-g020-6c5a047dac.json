,8,"il"],[9,16,"signora"],[17,21,0],[23,26,"che"],[27,28,"essere"],[29,32,"un"],[33,40,"persona"],[41,46,"molto"],[47,55,"istruire"],[56,57,"e"],[58,61,"che"],[62,68,"scrivere"],[69,70,"il"],[71,76,"libro"],[78,80,"avere"],[81,86,"dire"],[87,90,"che"],[91,93,"il"],[94,101,"vittima"],[102,105,"essere"],[106,108,"da"],[109,121,0],[123,125,"ma"],[126,129,"che"],[130,133,"essere"],[134,139,"essere"],[140,143,"un"],[144,153,"disgrazia"],[155,156,"e"],[157,159,"io"],[160,162,"avere"],[163,171,"aggiungere"],[172,178,"subito"]]},{"it":"- Sicuro: e una disgrazia voluta, perché se l’avvocato fosse stato fermo come dicevo io, non avrei sbagliato la mira...","ja":"","t":[[2,8,"sicuro"],[10,11,"e"],[12,15,"un"],[16,25,"disgrazia"],[26,32,"volere"],[34,40,"perché"],[41,43,"se"],[44,45,"il"],[46,54,"avvocato"],[55,60,"essere"],[61,66,"essere"],[67,72,"fermare"],[73,77,"come"],[78,84,"dire"],[85,87,"io"],[89,92,"non"],[93,98,"avere"],[99,108,"sbagliare"],[109,111,"il"],[112,116,"mirare"]]},{"it":"Dopo molti discorsi la signora Olga ha tirato fuori l’orologio e ha detto:","ja":"","t":[[0,4,"dopo"],[5,10,"molto"],[11,19,"discorso"],[20,22,"il"],[23,30,"signora"],[31,35,0],[36,38,"avere"],[39,45,"tirare"],[46,51,"fuori"],[52,53,"il"],[54,62,"orologio"],[63,64,"e"],[65,67,"avere"],[68,73,"dire"]]},{"it":"- Mio Dio!","ja":"","t":[[2,5,"mio"],[6,9,"Dio"]]},{"it":"Già le quattro!","ja":"","t":[[0,3,"già"],[4,6,"il"],[7,14,"quattro"]]},{"it":"La mamma allora ha osservato:","ja":"","t":[[0,2,"il"],[3,8,"mamma"],[9,15,"allora"],[16,18,"avere"],[19,28,"osservare"]]},{"it":"- Curiosa!","ja":"","t":[[2,9,"curioso"]]},{"it":"Lei ha un orologio che somiglia perfettamente al mio...","ja":"","t":[[0,3,"lei"],[4,6,"avere"],[7,9,"un"],[10,18,"orologio"],[19,22,"che"],[23,31,"somigliare"],[32,45,"perfettamente"],[46,48,"a"],[49,52,"mio"]]},{"it":"- Ah, sì? - ha risposto la signora Olga, e se l’è riposto in seno, mentre Virginia che le stava di dietro faceva dei cenni con le mani alla mamma che non capiva niente.","ja":"","t":[[2,4,"ah"],[6,8,"sì"],[12,14,"avere"],[15,23,"rispondere"],[24,26,"il"],[27,34,"signora"],[35,39,0],[41,42,"e"],[43,45,"se"],[46,47,"il"],[48,49,"essere"],[50,57,0],[58,60,"in"],[61,65,"seno"],[67,73,"mentre"],[74,82,0],[83,86,"che"],[87,89,"il"],[90,95,"stare"],[96,98,"di"],[99,105,"dietro"],[106,112,"fare"],[113,116,"di"],[117,122,"cenno"],[123,126,"con"],[127,129,"il"],[130,134,"mano"],[135,139,"a"],[140,145,"mamma"],[146,149,"che"],[150,153,"non"],[154,160,"capire"],[161,167,"niente"]]},{"it":"Quando poi la signora Olga se n’è andata, Virginia che ha sempre il vizio di chiacchierare e di ficcare il naso nelle cose che non le appartengono, ha esclamato:","ja":"","t":[[0,6,"quando"],[7,10,"poi"],[11,13,"il"],[14,21,"signora"],[22,26,0],[27,29,"se"],[30,31,0],[32,33,"essere"],[34,40,"andare"],[42,50,0],[51,54,"che"],[55,57,"avere"],[58,64,"sempre"],[65,67,"il"],[68,73,"vizio"],[74,76,"di"],[77,90,"chiacchierare"],[91,92,"e"],[93,95,"dire"],[96,103,"ficcare"],[104,106,"il"],[107,111,"naso"],[112,117,"in"],[118,122,"cosa"],[123,126,"che"],[127,130,"non"],[131,133,"il"],[134,146,"appartenere"],[148,150,"avere"],[151,160,"esclamare"]]},{"it":"- Ma, mamma!","ja":"","t":[[2,4,"ma"],[6,11,"mamma"]]},{"it":"Non hai visto che, oltre all’orologio, aveva anche un ciondolo preciso al tuo?...","ja":"","t":[[0,3,"non"],[4,7,"avere"],[8,13,"vedere"],[14,17,"che"],[19,24,"oltre"],[25,28,"a"],[29,37,"orologio"],[39,44,"avere"],[45,50,"anche"],[51,53,"un"],[54,62,0],[63,70,"preciso"],[71,73,"a"],[74,77,"tuo"]]},{"it":"È una cosa strana!...","ja":"","t":[[0,1,"essere"],[2,5,"un"],[6,10,"cosa"],[11,17,"strano"]]},{"it":"E son salite tutte in camera della mamma per pigliar l’orologio...","ja":"","t":[[0,1,"e"],[2,5,"essere"],[6,12,"salire"],[13,18,"tutto"],[19,21,"in"],[22,28,"camera"],[29,34,"di"],[35,40,"mamma"],[41,44,"per"],[45,52,"pigliare"],[53,54,"il"],[55,63,"orologio"]]},{"it":"Ma l’orologio non c’era, perché l’avevo preso io l’altro giorno per fare i giuochi di prestigio nel giardino.","ja":"","t":[[0,2,"ma"],[3,4,"il"],[5,13,"orologio"],[14,17,"non"],[18,19,"ci"],[20,23,"essere"],[25,31,"perché"],[32,33,"il"],[34,39,"avere"],[40,45,"prendere"],[46,48,"io"],[49,50,"il"],[51,56,"altro"],[57,63,"giorno"],[64,67,"per"],[68,72,"fare"],[73,74,"il"],[75,82,"giocare"],[83,85,"di"],[86,95,"prestigio"],[96,99,"in"],[100,108,"giardino"]]},{"it":"È impossibile descrivere come son rimaste la mamma, l’Ada e Virginia.","ja":"","t":[[0,1,"essere"],[2,13,"impossibile"],[14,24,"descrivere"],[25,29,"come"],[30,33,"essere"],[34,41,"rimanere"],[42,44,"il"],[45,50,"mamma"],[52,53,"il"],[54,57,0],[58,59,"e"],[60,68,0]]},{"it":"L’Ada è corsa subito in camera sua, ed è tornata dicendo:","ja":"","t":[[0,1,"il"],[2,5,0],[6,7,"essere"],[8,13,"correre"],[14,20,"subito"],[21,23,"in"],[24,30,"camera"],[31,34,"suo"],[36,38,"e"],[39,40,"essere"],[41,48,"tornare"],[49,56,"dire"]]},{"it":"- Ma io ve ne dirò un’altra... un’altra che è anche più straordinaria, tanto che, prima di dirla, ho voluto sincerarmi.","ja":"","t":[[2,4,"ma"],[5,7,"io"],[8,10,"ve"],[11,13,"ne"],[14,18,"dire"],[19,21,"un"],[22,27,"altro"],[31,33,"un"],[34,39,"altro"],[40,43,"che"],[44,45,"essere"],[46,51,"anche"],[52,55,"più"],[56,69,"straordinario"],[71,76,"tanto"],[77,80,"che"],[82,87,"prima"],[88,90,"Dio"],[91,96,"dire"],[98,100,"avere"],[101,107,"volere"],[108,118,0]]},{"it":"Quando la signora Olga si è soffiata il naso ho osservato che aveva un fazzoletto di tela batista col ricamo come quello che mi regalasti tu, mamma, per la mia festa.","ja":"","t":[[0,6,"quando"],[7,9,"il"],[10,17,"signora"],[18,22,0],[23,25,"si"],[26,27,"essere"],[28,36,"soffiare"],[37,39,"il"],[40,44,"naso"],[45,47,"avere"],[48,57,"osservare"],[58,61,"che"],[62,67,"avere"],[68,70,"un"],[71,81,"fazzoletto"],[82,84,"di"],[85,89,"tela"],[90,97,0],[98,101,"con"],[102,108,"ricamare"],[109,113,"come"],[114,120,"quello"],[121,124,"che"],[125,127,"mi"],[128,137,"regalare"],[138,140,"tu"],[142,147,"mamma"
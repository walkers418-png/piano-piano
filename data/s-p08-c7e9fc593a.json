"],[55,59,"fare"],[60,66,0],[67,72,"anche"],[73,76,"lui"],[78,84,"perché"],[85,87,"il"],[88,95,"miseria"],[97,103,"quando"],[104,105,"essere"],[106,113,"miseria"],[114,121,"davvero"],[123,125,"il"],[126,135,"intendere"],[136,141,"tutto"],[143,148,"anche"],[149,150,"il"],[151,158,"ragazzo"]]},{"it":"— Pazienza!","ja":"","t":[[2,10,"pazienza"]]},{"it":"— gridò Geppetto tutt’a un tratto rizzandosi in piedi; e infilatasi la vecchia casacca di fustagno, tutta toppe e rimendi, uscì correndo di casa.","ja":"","t":[[2,7,"gridare"],[8,16,0],[17,21,"tutto"],[22,23,"a"],[24,26,"un"],[27,33,"trattare"],[34,44,0],[45,47,"in"],[48,53,"piede"],[55,56,"e"],[57,67,"infilare"],[68,70,"il"],[71,78,"vecchio"],[79,86,"casacca"],[87,89,"di"],[90,98,0],[100,105,"tutto"],[106,111,0],[112,113,"e"],[114,121,0],[123,127,"uscire"],[128,136,"correre"],[137,139,"di"],[140,144,"casa"]]},{"it":"Dopo poco tornò: e quando tornò aveva in mano l’Abbecedario per il figliuolo, ma la casacca non l’aveva più.","ja":"","t":[[0,4,"dopo"],[5,9,"poco"],[10,15,"tornare"],[17,18,"e"],[19,25,"quando"],[26,31,"tornare"],[32,37,"avere"],[38,40,"in"],[41,45,"mano"],[46,47,"il"],[48,59,"abbecedario"],[60,63,"per"],[64,66,"il"],[67,76,"figliuolo"],[78,80,"ma"],[81,83,"il"],[84,91,"casacca"],[92,95,"non"],[96,97,"il"],[98,103,"avere"],[104,107,"più"]]},{"it":"Il pover’uomo era in maniche di camicia, e fuori nevicava.","ja":"","t":[[0,2,"il"],[3,8,"povero"],[9,13,"uomo"],[14,17,"essere"],[18,20,"in"],[21,28,0],[29,31,"di"],[32,39,"camicia"],[41,42,"e"],[43,48,"fuori"],[49,57,"nevicare"]]},{"it":"— E la casacca, babbo?","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,14,"casacca"],[16,21,"babbo"]]},{"it":"— L’ho venduta.","ja":"","t":[[2,3,"il"],[4,6,"avere"],[7,14,"vendere"]]},{"it":"— Perchè l’avete venduta?","ja":"","t":[[2,8,"perché"],[9,10,"il"],[11,16,"avere"],[17,24,"vendere"]]},{"it":"— Perchè mi faceva caldo.―","ja":"","t":[[2,8,"perché"],[9,11,"mi"],[12,18,"fare"],[19,24,"caldo"]]},{"it":"Pinocchio capì questa risposta a
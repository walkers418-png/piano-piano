{"id":"u008","title":"Ottobre・In una soffitta","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IN UNA SOFFITTA.","ja":"","t":[[0,2,"in"],[3,6,"un"],[7,15,"soffitta"]]},{"it":"28, venerdì.","ja":"","t":[[4,11,"venerdì"]]},{"it":"Ieri sera con mia madre e con mia sorella Silvia andammo a portar la biancheria alla donna povera raccomandata dal giornale: io portai il pacco, Silvia aveva il giornale, con le iniziali del nome e l’indirizzo.","ja":"","t":[[0,4,"ieri"],[5,9,"sera"],[10,13,"con"],[14,17,"mio"],[18,23,"madre"],[24,25,"e"],[26,29,"con"],[30,33,"mio"],[34,41,"sorella"],[42,48,0],[49,56,"andare"],[57,58,"a"],[59,65,"portare"],[66,68,"il"],[69,79,0],[80,84,"a"],[85,90,"donna"],[91,97,"povero"],[98,110,0],[111,114,"da"],[115,123,"giornale"],[125,127,"io"],[128,134,"portare"],[135,137,"il"],[138,143,"pacco"],[145,151,0],[152,157,"avere"],[158,160,"il"],[161,169,"giornale"],[171,174,"con"],[175,177,"il"],[178,186,"iniziale"],[187,190,"di"],[191,195,"nome"],[196,197,"e"],[198,199,"il"],[200,209,"indirizzo"]]},{"it":"Salimmo fin sotto il tetto d’una casa alta, in un corridoio lungo, dov’erano molti usci.","ja":"","t":[[0,7,"salire"],[8,11,"fino"],[12,17,"sotto"],[18,20,"il"],[21,26,"tetto"],[27,28,"di"],[29,32,"un"],[33,37,"casa"],[38,42,"alto"],[44,46,"in"],[47,49,"un"],[50,59,"corridoio"],[60,65,"lungo"],[67,70,"dove"],[71,76,"essere"],[77,82,"molto"],[83,87,"uscio"]]},{"it":"Mia madre picchiò all’ultimo: ci aperse una donna ancora giovane, bionda e macilenta, che subito mi parve d’aver già visto altre volte, con quel medesimo fazzoletto turchino che aveva in capo.","ja":"","t":[[0,3,"mio"],[4,9,"madre"],[10,17,"picchiare"],[18,21,"a"],[22,28,"ultimo"],[30,32,"ci"],[33,39,"aprire"],[40,43,"un"],[44,49,"donna"],[50,56,"ancora"],[57,64,"giovane"],[66,72,"biondo"],[73,74,"e"],[75,84,0],[86,89,"che"],[90,96,"subito"],[97,99,"mi"],[100,105,"parere"],[106,107,"di"],[108,112,"avere"],[113,116,"già"],[117,122,"vedere"],[123,128,"altro"],[129,134,"volta"],[136,139,"con"],[140,144,"quello"],[145,153,"medesimo"],[154,164,"fazzoletto"],[165,173,0],[174,177,"che"],[178,183,"avere"],[184,186,"in"],[187,191,"capo"]]},{"it":"— Siete voi quella del giornale, così e così?","ja":"","t":[[2,7,"essere"],[8,11,"voi"],[12,18,"quello"],[19,22,"di"],[23,31,"giornale"],[33,37,"così"],[38,39,"e"],[40,44,"così"]]},{"it":"— domandò mia madre.","ja":"","t":[[2,9,"domandare"],[10,13,"mio"],[14,19,"madre"]]},{"it":"— Sì, signora, son io.","ja":"","t":[[2,4,"sì"],[6,13,"signora"],[15,18,"essere"],[19,21,"io"]]},{"it":"— Ebbene, v’abbiamo portato un poco di biancheria.","ja":"","t":[[2,8,"avere"],[10,11,0],[12,19,"avere"],[20,27,"portare"],[28,30,"un"],[31,35,"poco"],[36,38,"Dio"],[39,49,0]]},{"it":"— E quella a ringraziare e a benedire, che non finiva più.","ja":"","t":[[2,3,"e"],[4,10,"quello"],[11,12,"a"],[13,24,"ringraziare"],[25,26,"e"],[27,28,"a"],[29,37,0],[39,42,"che"],[43,46,"non"],[47,53,"finire"],[54,57,"più"]]},{"it":"Io intanto vidi in un angolo della stanza nuda e scura un ragazzo inginocchiato davanti a una seggiola, con la schiena volta verso di noi, che parea che scrivesse: e proprio scriveva, con la carta sopra la seggiola, e aveva il calamaio sul pavimento.","ja":"","t":[[0,2,"io"],[3,10,"intanto"],[11,15,"vedere"],[16,18,"in"],[19,21,"un"],[22,28,"angolo"],[29,34,"di"],[35,41,"stanza"],[42,46,"nudo"],[47,48,"e"],[49,54,"scuro"],[55,57,"un"],[58,65,"ragazzo"],[66,79,"inginocchiare"],[80,87,"davanti"],[88,89,"a"],[90,93,"un"],[94,102,0],[104,107,"con"],[108,110,"il"],[111,118,"schiena"],[119,124,"volta"],[125,130,"verso"],[131,133,"di"],[134,137,"noi"],[139,142,"che"],[143,148,"parere"],[149,152,"che"],[153,162,"scrivere"],[164,165,"e"],[166,173,"proprio"],[174,182,"scrivere"],[184,187,"con"],[188,190,"il"],[191,196,"carta"],[197,202,"sopra"],[203,205,"il"],[206,214,0],[216,217,"e"],[218,223,"avere"],[224,226,"il"],[227,235,"calamaio"],[236,239,"su"],[240,249,"pavimento"]]},{"it":"Come faceva
re"],[261,270,"ritrovare"],[272,275,"non"],[276,278,"se"],[279,281,"il"],[282,289,"essere"],[290,297,"rimettere"],[298,300,"di"],[301,306,"certo"],[309,310,"e"],[311,314,"con"],[315,320,"quello"],[321,327,"occhio"],[328,334,"grosso"],[336,344,0],[345,346,"e"],[347,356,0],[357,361,"come"],[362,364,"un"],[365,369,"uovo"],[370,372,"a"],[373,381,0],[382,386,"poco"],[387,392,"cuocere"]]},{"it":"- Pare un becchino turco! - disse piano Maurizio Del Ponte alludendo a quel turbante nero che gli copriva la testa.","ja":"","t":[[2,6,"parere"],[7,9,"un"],[10,18,"beccare"],[19,24,0],[28,33,"dire"],[34,39,"piano"],[40,48,0],[49,52,"di"],[53,58,"ponte"],[59,68,0],[69,70,"a"],[71,75,"quello"],[76,84,"turbare"],[85,89,"nero"],[90,93,"che"],[94,97,"il"],[98,105,"coprire"],[106,108,"il"],[109,114,"testa"]]},{"it":"Più tardi si seppe che a uno a uno i collegiali erano chiamati in Direzione per subire un interrogatorio.","ja":"","t":[[0,3,"più"],[4,9,"tardi"],[10,12,"si"],[13,18,"sapere"],[19,22,"che"],[23,24,"a"],[25,28,"un"],[29,30,"a"],[31,34,"un"],[35,36,"il"],[37,47,"collegiale"],[48,53,"essere"],[54,62,"chiamare"],[63,65,"in"],[66,75,"direzione"],[76,79,"per"],[80,86,"subire"],[87,89,"un"],[90,104,"interrogatorio"]]},{"it":"- Che t’hanno domandato? - chiesi a uno che incontrai nel corridoio grande mentre usciva di Direzione.","ja":"","t":[[2,5,"che"],[6,7,"ti"],[8,13,"avere"],[14,23,"domandare"],[27,33,"chiedere"],[34,35,"a"],[36,39,"un"],[40,43,"che"],[44,53,"incontrare"],[54,57,"in"],[58,67,"corridoio"],[68,74,"grande"],[75,81,"mentre"],[82,88,"uscire"],[89,91,"di"],[92,101,"direzione"]]},{"it":"- Nulla - mi rispose.","ja":"","t":[[2,7,"nulla"],[10,12,"mi"],[13,20,"rispondere"]]},{"it":"Verso sera ne acchiappai un altro:","ja":"","t":[[0,5,"verso"],[6,10,"sera"],[11,13,"ne"],[14,24,"acchiappare"],[25,27,"un"],[28,33,"altro"]]},{"it":"- Che t’ha detto il Direttore?","ja":"","t":[[2,5,"che"],[6,7,"ti"],[8,10,"avere"],[11,16,"dire"],[17,19,"il"],[20,29,"direttore"]]},{"it":"- Nulla. -","ja":"","t":[[2,7,"nulla"]]},{"it":"Capii allora perfettamente che il signor Stanislao doveva avere nel suoi interrogatori intimiditi i ragazzi in un modo addirittura feroce con chi sa quali minacce se avessero rivelato una parola.","ja":"","t":[[0,5,"capire"],[6,12,"allora"],[13,26,"perfettamente"],[27,30,"che"],[31,33,"il"],[34,40,"signore"],[41,50,0],[51,57,"dovere"],[58,63,"avere"],[64,67,"in"],[68,72,"suo"],[73,86,"interrogatorio"],[87,97,0],[98,99,"il"],[100,107,"ragazzo"],[108,110,"in"],[111,113,"un"],[114,118,"modo"],[119,130,"addirittura"],[131,137,"feroce"],[138,141,"con"],[142,145,"chi"],[146,148,"sapere"],[149,154,"quale"],[155,162,0],[163,165,"se"],[166,174,"avere"],[175,183,"rivelare"],[184,187,"un"],[188,194,"parola"]]},{"it":"In questa idea mi confermò più tardi Mario Michelozzi, il quale passandomi accanto, mi disse rapidamente:","ja":"","t":[[0,2,"in"],[3,9,"questo"],[10,14,"idea"],[15,17,"mi"],[18,26,"confermare"],[27,30,"più"],[31,36,"tardi"],[37,42,0],[43,53,0],[55,57,"il"],[58,63,"quale"],[64,74,"passare"],[75,82,"accanto"],[84,86,"mi"],[87,92,"dire"],[93,104,"rapidamente"]]},{"it":"- All’erta!","ja":"","t":[[2,5,"a"],[6,10,0]]},{"it":"Calpurnio ha mangiato la foglia! -","ja":"","t":[[0,9,0],[10,12,"avere"],[13,21,"mangiare"],[22,24,"il"],[25,31,"foglia"]]},{"it":"Ma in camerata mi aspettava la terribile rivelazione della nostra completa rovina...","ja":"","t":[[0,2,"ma"],[3,5,"in"],[6,14,"camerata"],[15,17,"mi"],[18,27,"aspettare"],[28,30,"il"],[31,40,"terribile"],[41,52,"rivelazione"],[53,58,"di"],[59,65,"nostro"],[66,74,"completo"],[75,81,"rovina"]]},{"it":"- Sei stato in Direzione? - sussurrai a Gigino Balestra mentre mi passava dinanzi.","ja":"","t":[[2,5,"essere"],[6,11,"essere"],[12,14,"in"],[15,24,"direzione"],[28,37,"sussurrare"],[38,39,"a"],[40,46,0],[47,55,0],[56,62,"mentre"],[63,65,"mi"],[66,73,"passare"],[74,81,"dinanzi"]]},{"it":"- No, - rispose.","ja":"","t":[[2,4,"no"],[8,15,"rispondere"]]},{"it":"Come mai erano stati interrogati tutti i collegiali più piccoli e noi due no?","ja":"","t":[[0,4,"come"],[5,8,"mai"],[9,14,"essere"],[15,20,"essere"],[21,32,"interrogare"],[33,38,"tutto"],[39,40,"il"],[41,51,"collegiale"],[52,55,"più"],[56,63,"piccolo"],[64,65,"e"],[66,69,"noi"],[70,73,"due"],[74,76,"no"]]},{"it":"Questa esclusione mi dava molto da pensare e andai a letto deciso di non avventurarmi nel mio osservatorio, temendo di una vigilanza speciale notturna.","ja":"","t":[[0,6,"questo"],[7,17,0],[18,20,"mi"],[21,25,"dare"],[26,31,"molto"],[32,34,"da"],[35,42,"pensare"],[43,44,"e"],[45,50,"andare"],[51,52,"a"],[53,58,"letto"],[59,65,"decidere"],[66,68,"di"],[69,72,"non"],[73,85,0],[86,89,"in"],[90,93,"mio"],[94,106,"osservatorio"],[108,115,"temere"],[116,118,"di"],[119,122,"un"],[123,132,0],[133,141,"speciale"],[142,150,"notturno"]]},{"it":"Non so quanto tempo stetti così sveglio, riflettendo sui casi della giornata, architettando deduzioni su deduzioni; ma la tentazione di salire sull’armadietto mi si riaffacciava sempre, ostinata, a traverso a tutte le mie riflessioni, finché da ultimo mi vinse e mi fece abbandonare ogni saggio consiglio di prudenza.","ja":"","t":[[0,3,"non"],[4,6,"sapere"],[7,13,"quanto"],[14,19,"tempo"],[20,26,"stare"],[27,31,"così"],[32,39,"svegliare"],[41,52,"riflettere"],[53,56,"su"],[57,61,"caso"],[62,67,"di"],[68,76,"giornata"],[78,91,0],[92,101,0],[102,104,"su"],[105,114,0],[116,118,"ma"],[119,121,"il"],[122,132,"tentazione"],[133,135,"di"],[136,142,"salire"],[143,147,"su"],[148,158,"armadietto"],[159,161,"mi"],[162,164,"si"],[165,177,0],[178,184,"sempre"],[186,194,"ostinare"],[196,197,"a"],[198,206,"traverso"],[207,208,"a"],[209,214,"tutto"],[215,217,"il"],[218,221,"mio"],[222,233,"riflessione"],[235,241,"finché"],[242,244,"da"],[245,251,"ultimo"],[252,254,"mi"],[255,260,"vincere"],[261,262,"e"],[263,265,"mi"],[266,270,"fare"],[271,282,"abbandonare"],[283,287,"ogni"],[288,294,"saggio"],[295,304,"consiglio"],[305,307,"di"],[308,316,"prudenza"]]},{"it":"Mi assic
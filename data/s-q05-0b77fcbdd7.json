{"id":"q05","title":"第5話 朝の市場","lv":1,"kind":"連載","note":"","lines":[{"it":"Sono le sette di mattina.","ja":"朝の7時です。","t":[[0,4,"essere"],[5,7,"il"],[8,13,"sette"],[14,16,"di"],[17,24,"mattina"]]},{"it":"Kenta va al mercato con Nonna Rita.","ja":"ケンタはノンナ・リータと市場へ行きます。","t":[[0,5,0],[6,8,"andare"],[9,11,"a"],[12,19,"mercato"],[20,23,"con"],[24,29,0],[30,34,0]]},{"it":"Ci sono molti colori: pomodori rossi, limoni gialli, insalata verde.","ja":"たくさんの色があります。赤いトマト、黄色いレモン、緑のサラダ。","t":[[0,2,"ci"],[3,7,"essere"],[8,13,"molto"],[14,20,"colore"],[22,30,"pomodoro"],[31,36,"rosso"],[38,44,"limone"],[45,51,"giallo"],[53,61,"insalata"],[62,67,"verde"]]},{"it":"«Buongiorno, Rita! Come stai?» dice un uomo.","ja":"「おはよう、リータ！元気？」と男の人が言います。","t":[[1,11,"buongiorno"],[13,17,0],[19,23,"come"],[24,28,"stare"],[31,35,"dire"],[36,38,"un"],[39,43,"uomo"]]},{"it":"Tutti conoscono Rita.","ja":"みんながリータを知っています。","t":[[0,5,"tutto"],[6,15,"conoscere"],[16,20,0]]},{"it":"Rita prende un pomodoro e lo guarda bene.","ja":"リータはトマトを手に取り、よく見ます。","t":[[0,4,0],[5,11,"prendere"],[12,14,"un"],[15,23,"pomodoro"],[24,25,"e"],[26,28,"il"],[29,35,"guardare"],[36,40,"bene"]]},{"it":"«Questo no. Questo sì.»","ja":"「これはだめ。これはいい」","t":[[1,7,"questo"],[8,10,"no"],[12,18,"questo"],[19,21,"sì"]]},{"it":"«Come lo sa?» chiede Kenta.","ja":"「どうしてわかるんですか？」とケンタが尋ねます。","t":[[1,5,"come"],[6,8,"il"],[9,11,"sapere"],[14,20,"chiedere"],[21,26,0]]},{"it":"«Con il naso e con le mani, non con gli occhi.»","ja":"「鼻と手でだよ。目じゃない」","t":[[1,4,"con"],[5,7,"il"],[8,12,"naso"],[13,14,"e"],[15,18,"con"],[19,21,"il"],[22,26,"mano"],[28,31,"non"],[32,35,"con"],[36,39,"il"],[40,45,"occhio"]]},{"it":"Kenta porta due borse molto pesanti.","ja":"ケンタはとても重いかばんを2つ運びます。","t":[[0,5,0],[6,11,"porta"],[12,15,"due"],[16,21,"borsa"],[22,27,"molto"],[28,35,"pesante"]]},{"it":"È stanco, ma è contento.","ja":"疲れていますが、満足しています。","t":[[0,1,"essere"],[2,8,"stanco"],[10,12,"ma"],[13,14,"essere"],[15,23,"contento"]]}],"q":[{"skill":"match","s":"リータは何でトマトの良し悪しを判断する？
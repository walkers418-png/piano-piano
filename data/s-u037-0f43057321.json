{"id":"u037","title":"Gennaio・Una bella visita","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"UNA BELLA VISITA.","ja":"","t":[[0,3,"un"],[4,9,"bello"],[10,16,"visita"]]},{"it":"12, giovedì.","ja":"","t":[[4,11,"giovedì"]]},{"it":"Ecco uno dei giovedì più belli dell’anno, per me.","ja":"","t":[[0,4,"ecco"],[5,8,"un"],[9,12,"di"],[13,20,"giovedì"],[21,24,"più"],[25,30,"bello"],[31,35,"di"],[36,40,"anno"],[42,45,"per"],[46,48,"me"]]},{"it":"Alle due in punto vennero a casa Derossi e Coretti, con Nelli, il gobbino; Precossi, suo padre non lo lasciò venire.","ja":"","t":[[0,4,"a"],[5,8,"due"],[9,11,"in"],[12,17,"punto"],[18,25,"venire"],[26,27,"a"],[28,32,"casa"],[33,40,0],[41,42,"e"],[43,50,0],[52,55,"con"],[56,61,0],[63,65,"il"],[66,73,0],[75,83,0],[85,88,"suo"],[89,94,"padre"],[95,98,"non"],[99,101,"il"],[102,108,"lasciare"],[109,115,"venire"]]},{"it":"Derossi e Coretti ridevano ancora chè avevano incontrato per strada Crossi, il figliuolo dell’erbivendola, — quello del braccio morto e dei capelli rossi, — che portava a vendere un grossissimo cavolo, e col soldo del cavolo doveva poi andar a comperare una penna; ed era tutto contento perchè suo padre ha scritto dall’America che lo aspettassero di giorno in giorno.","ja":"","t":[[0,7,0],[8,9,"e"],[10,17,0],[18,26,"ridere"],[27,33,"ancora"],[34,37,"che"],[38,45,"avere"],[46,56,"incontrare"],[57,60,"per"],[61,67,"strada"],[68,74,0],[76,78,"il"],[79,88,"figliuolo"],[89,93,"di"],[94,105,0],[109,115,"quello"],[116,119,"di"],[120,127,"braccio"],[128,133,"morto"],[134,135,"e"],[136,139,"di"],[140,147,"capello"],[148,153,"rosso"],[157,160,"che"],[161,168,"portare"],[169,170,"a"],[171,178,"vendere"],[179,181,"un"],[182,193,"grosso"],[194,200,"cavolo"],[202,203,"e"],[204,207,"con"],[208,213,"soldo"],[214,217,"di"],[218,224,"cavolo"],[225,231,"dovere"],[232,235,"poi"],[236,241,"andare"],[242,243,"a"],[244,253,0],[254,257,"un"],[258,263,"penna"],[265,267,"e"],[268,271,"essere"],
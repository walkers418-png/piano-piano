,[162,167,"punta"],[168,171,"di"],[172,176,"naso"]]},{"it":"Ma non fece a tempo: perchè Pinocchio stese la gamba sotto la tavola, e gli consegnò una pedata negli stinchi.","ja":"","t":[[0,2,"ma"],[3,6,"non"],[7,11,"fare"],[12,13,"a"],[14,19,"tempo"],[21,27,"perché"],[28,37,0],[38,43,"stendere"],[44,46,"il"],[47,52,"gamba"],[53,58,"sotto"],[59,61,"il"],[62,68,"tavola"],[70,71,"e"],[72,75,"il"],[76,84,"consegnare"],[85,88,"un"],[89,95,0],[96,101,"in"],[102,109,0]]},{"it":"— Ohi! che piedi duri!","ja":"","t":[[2,5,"ohi"],[7,10,"che"],[11,16,"piede"],[17,21,"durare"]]},{"it":"— urlò il ragazzo stropicciandosi il livido che gli aveva fatto il burattino.","ja":"","t":[[2,6,"urlare"],[7,9,"il"],[10,17,"ragazzo"],[18,33,0],[34,36,"il"],[37,43,0],[44,47,"che"],[48,51,"il"],[52,57,"avere"],[58,63,"fare"],[64,66,"il"],[67,76,"burattino"]]},{"it":"— E che gomiti!… anche più duri dei piedi!","ja":"","t":[[2,3,"e"],[4,7,"che"],[8,14,"gomito"],[17,22,"anche"],[23,26,"più"],[27,31,"durare"],[32,35,"di"],[36,41,"piede"]]},{"it":"— disse un altro che, per i suoi scherzi sguaiati, s’era beccata una gomitata nello stomaco.","ja":"","t":[[2,7,"dire"],[8,10,"un"],[11,16,"altro"],[17,20,"che"],[22,25,"per"],[26,27,"il"],[28,32,"suo"],[33,40,"scherzo"],[41,49,0],[51,52,"si"],[53,56,"essere"],[57,64,0],[65,68,"un"],[69,77,0],[78,83,"in"],[84,91,"stomaco"]]},{"it":"Fatto sta che dopo quel calcio e quella gomitata, Pinocchio acquistò subito la stima e la simpatia di tutti i ragazzi di scuola: e tutti gli facevano mille carezze e tutti gli volevano un bene dell’anima.","ja":"","t":[[0,5,"fare"],[6,9,"stare"],[10,13,"che"],[14,18,"dopo"],[19,23,"quello"],[24,30,"calcio"],[31,32,"e"],[33,39,"quello"],[40,48,0],[50,59,0],[60,68,"acquistare"],[69,75,"subito"],[76,78,"il"],[79,84,"stima"],[85,86,"e"],[87,89,"il"],[90,98,0],[99,101,"di"],[102,107,"tutto"],[108,109,"il"],[110,117,"ragazzo"],[118,120,"di"],[121,127,"scuola"],[129,130,"e"],[131,136,"tutto"],[137,140,"il"],[141,149,"fare"],[150,155,"mil
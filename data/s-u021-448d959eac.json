{"id":"u021","title":"Novembre・Il primo della classe","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL PRIMO DELLA CLASSE.","ja":"","t":[[0,2,"il"],[3,8,"primo"],[9,14,"di"],[15,21,"classe"]]},{"it":"25, venerdì.","ja":"","t":[[4,11,"venerdì"]]},{"it":"Garrone s’attira l’affetto di tutti; Derossi, l’ammirazione.","ja":"","t":[[0,7,0],[8,9,"si"],[10,16,"attirare"],[17,18,"il"],[19,26,"affetto"],[27,29,"di"],[30,35,"tutto"],[37,44,0],[46,47,"il"],[48,59,0]]},{"it":"Ha preso la prima medaglia, sarà sempre il primo anche quest’anno, nessuno può competer con lui, tutti riconoscono la sua superiorità in tutte le materie.","ja":"","t":[[0,2,"avere"],[3,8,"prendere"],[9,11,"il"],[12,17,"prima"],[18,26,"medaglia"],[28,32,"essere"],[33,39,"sempre"],[40,42,"il"],[43,48,"primo"],[49,54,"anche"],[55,60,"questo"],[61,65,"anno"],[67,74,"nessuno"],[75,78,"potere"],[79,87,0],[88,91,"con"],[92,95,"lui"],[97,102,"tutto"],[103,114,"riconoscere"],[115,117,"il"],[118,121,"suo"],[122,133,0],[134,136,"in"],[137,142,"tutto"],[143,145,"il"],[146,153,"materia"]]},{"it":"È il primo in aritmetica, in grammatica, in composizione, in disegno, capisce ogni cosa a volo, ha una memoria meravigliosa, riesce in tutto senza sforzo, pare che lo studio sia un gioco per lui.","ja":"","t":[[0,1,"essere"],[2,4,"il"],[5,10,"primo"],[11,13,"in"],[14,24,"aritmetica"],[26,28,"in"],[29,39,"grammatica"],[41,43,"in"],[44,56,0],[58,60,"in"],[61,68,"disegno"],[70,77,"capire"],[78,82,"ogni"],[83,87,"cosa"],[88,89,"a"],[90,94,"volare"],[96,98,"avere"],[99,102,"un"],[103,110,"memoria"],[111,123,"meraviglioso"],[125,131,"riuscire"],[132,134,"in"],[135,140,"tutto"],[141,146,"senza"],[147,153,"sforzo"],[155,159,"parere"],[160,163,"che"],[164,166,"il"],[167,173,"studio"],[174,177,"essere"],[178,180,"un"],[181,186,"gioco"],[187,190,"per"],[191,194,"lui"]]},{"it":"Il maestro gli disse ieri: — Hai avuto dei grandi doni da Dio, non hai altro da fare che non sciuparli.","ja":"","t":[[0,2,"il"],[3,10,"maestro"],[11,14,"il"],[15,20,"dire"],[21,25,"ieri"],[29,32,"avere"],[33,38,"avere"],[39,42,"di"],[43,49,"grande"],[50,54,"donare"],[55,57,"da"],[58,61,"Dio"],[63,66,"non"],[67,70,"avere"],[71,76,"altro"],[77,79,"da"],[80,84,"fare"],[85,88,"che"],[89,92,"non"],[93,102,0]]},{"it":"— E per di più è grande, bello, con una gran corona di riccioli biondi, lesto che salta un banco appoggiandovi una mano su; e sa già tirare di scherma.","ja":"","t":[[2,3,"e"],[4,7,"per"],[8,10,"Dio"],[11,14,"più"],[15,16,"essere"],[17,23,"grande"],[25,30,"bello"],[32,35,"con"],[36,39,"un"],[40,44,"grande"],[45,51,"corona"],[52,54,"di"],[55,63,0],[64,70,"biondo"],[72,77,"lesto"],[78,81,"che"],[82,87,"saltare"],[88,90,"un"],[91,96,"banco"],[97,110,"appoggiare"],[111,114,"un"],[115,119,"mano"],[120,122,"su"],[124,125,"e"],[126,128,"sapere"],[129,132,"già"],[133,139,"tirare"],[140,142,"di"],[143,150,0]]},{"it":"Ha dodici anni, è figliuolo d’un negoziante, va sempre vestito di turchino con dei bottoni dorati, sempre vivo, allegro, grazioso con tutti, e aiuta quanti può all’esame, e nessuno ha mai osato fargli uno sgarbo o dirgli una brutta parola.","ja":"","t":[[0,2,"avere"],[3,9,"dodici"],[10,14,"anno"],[16,17,"essere"],[18,27,"figliuolo"],[28,29,"di"],[30,32,"un"],[33,43,"negoziante"],[45,47,"andare"],[48,54,"sempre"],[55,62,"vestire"],[63,65,"di"],[66,74,0],[75,78,"con"],[79,82,"di"],[83,90,"bottone"],[91,97,0],[99,105,"sempre"],[106,110,"vivere"],[112,119,"allegro"],[121,129,"grazioso"],[130,133,"con"],[134,139,"tutto"],[141,142,"e"],[143,148,"aiutare"],[149,155,"quanto"],[156,159,"potere"],[160,163,"a"],[164,169,"esame"],[171,172,"e"],[173,180,"nessuno"],[181,183,"avere"],[184,187,"mai"],[188,193,0],[194,200,"fare"],[201,204,"un"],[205,211,0],[212,213,"o"],[214,220,"dire"],[221,224,"un"],[225,231,"brutto"],[232,238,"parola"]]},{"it":"Nobis e Franti soltanto lo guardano per traverso e Votini schizza invidia dagli occhi; ma egli non se n’accorge neppure.","ja":"","t":[[0,5,0],[6,7,"e"],[8,14,0],[15,23,"soltanto"],[24,26,"il"],[27,35,"guardare"],[36,39,"per"],[40,48,0],[49,50,"e"],[51,57,0],[58,65,0],[66,73,"invidia"],[74,79,"da"],[80,85,"occhio"],[87,89,"ma"],[90,94,"egli"],[95,98,"non"],[99,101,"se"],[102,103,0],[104,111,"accorgersi"],[112,119,"neppure"]]},{"it":"Tutti gli sorridono e lo pigliano per una mano o per un braccio quando va attorno a raccogliere i lavori, con quella sua maniera graziosa.","ja":"","t":[[0,5,"tutto"],[6,9,"il"],[10,19,"sorridere"],[20,21,"e"],[22,24,"il"],[25,33,"pigliare"],[34,37,"per"],[38,41,"un"],[42,46,"mano"],[47,48,"o"],[49,52,"per"],[53,55,"un"],[56,63,"braccio"],[64,70,"quando"],[71,73,"andare"],[74,81,"attorno"],[82,83,"a"],[84,95,"raccogliere"],[96,97,"il"],[98,104,"lavoro"],[106,109,"con"],[110,116,"quello"],[117,120,"suo"],[121,128,"maniera"],[129,137,"grazioso"]]},{"it":"Egli regala dei giornali illustrati, dei disegni, tutto quello che a casa regalano a lui, ha fatto per il Calabrese una piccola carta geografica delle Calabrie; e dà tutto ridendo, senza badarci, come un gran signore, senza predilezioni per alcuno.","ja":"","t":[[0,4,"egli"],[5,11,"regalare"],[12,15,"di"],[16,24,"giornale"],[25,35,0],[37,40,"di"],[41,48,"disegno"],[50,55,"tutto"],[56,62,"quello"],[63,66,"che"],[67,68,"a"],[69,73,"casa"],[74,82,"regalare"],[83,84,"a"],[85,88,"lui"],[90,92,"avere"],[93,98,"fare"],[99,102,"per"],[103,105,"il"],[106,115,"calabrese"],[116,119,"un"],[120,127,"piccolo"],[128,133,"carta"],[134,144,"geografico"],[145,150,"di"],[151,159,0],[161,162,"e"],[163,165,"dare"],[166,171,"tutto"],[172,179,"ridere"],[181,186,"senza"],[187,194,"badare"],[196,200,"come"],[201,203,"un"],[204,208,"grande"],[209,216,"signore"],[218,223,"senza"],[224,236,0],[237,240,"per"],[241,247,"alcuno"]]},{"it":"È impossibile non invidiarlo, non sentirsi da meno di lui in ogni cosa.","ja":"","t":[[0,1,"essere"],[2,13,"impossibile"],[14,17,"non"],[18,28,0],[30,33,"non"],[34,42,"sentire"],[43,45,"da"],[46,50,"meno"],[51,53,"di"],[54,57,"lui"],[58,60,"in"],[61,65,"ogni"],[66,70,"cosa"]]},{"it":"Ah! io pure, come Votini, l’invidio.","ja":"","t":[[0,2,"ah"],[4,6,"io"],[7,11,"pure"],[13,17,"come"],[18,24,0],[26,27,"il"],[28,35,0]]},{"it":"E provo un’amarezza, quasi un certo dispetto contro di lui, qualche volta, quando stento a fare il lavoro a casa, e penso che a quell’ora egli l’ha già fatto, benissimo e senza fatica.","ja":"","t":[[0,1,"e"],[2,7,"provare"],[8,10,"un"],[11,19,0],[21,26,"quasi"],[27,29,"un"],[30,35,"certo"],[36,44,0],[45,51,"contro"],[52,54,"di"],[55,58,"lui"],[60,67,"qualche"],[68,73,"volta"],[75,81,"quando"],[82,88,0],[89,90,"a"],[91,95,"fare"],[96,98,"il"],[99,105,"lavoro"],[106,107,"a"],[108,112,"casa"],[114,115,"e"],[116,121,"pensare"],[122,125,"che"],[126,127,"a"],[128,133,"quello"],[134,137,"ora"],[138,142,"egli"],[143,144,"il"],[145,147,"avere"],[148,151,"già"],[152,157,"fare"],[159,168,"bene"],[169,170,"e"],[171,176,"senza"],[177,183,"fatica"]]},{"it":"Ma poi, quando torno alla scuola, a vederlo così bello, ridente, trionfante, a sentir come risponde alle interrogazioni del maestro franco e sicuro, e com’è cortese e come tutti gli voglion bene, allora ogni amarezza, ogni dispetto mi va via dal cuore, e mi vergogno d’aver provato quei sentimenti.","ja":"","t":[[0,2,"ma"],[3,6,"poi"],[8,14,"quando"],[15,20,"tornare"],[21,25,"a"],[26,32,"scuola"],[34,35,"a"],[36,43,"vedere"],[44,48,"così"],[49,54,"bello"],[56,63,"ridere"],[65,75,0],[77,78,"a"],[79,85,"sentire"],[86,90,"come"],[91,99,"rispondere"],[100,104,"a"],[105,119,"interrogazione"],[120,123,"di"],[124,131,"maestro"],[132,138,0],[139,140,"e"],[141,147,"sicuro"],[149,150,"e"],[151,154,"come"],[155,156,"essere"],[157,164,0],[165,166,"e"],[167,171,"come"],[172,177,"tutto"],[178,181,"il"],[182,189,0],[190,194,"bene"],[196,202,"allora"],[203,207,"ogni"],[208,216,0],[218,222,"ogni"],[223,231,0],[232,234,"mi"],[235,237,"andare"],[238,241,"via"],[242,245,"da"],[246,251,"cuore"],[253,254,"e"],[255,257,"mi"],[258,266,"ver
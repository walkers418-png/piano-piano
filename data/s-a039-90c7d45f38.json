ai.","ja":"","t":[[2,8,"quando"],[9,13,"dovere"],[14,20,"andare"],[21,23,"a"],[24,30,"teatro"],[32,35,"non"],[36,37,"ci"],[38,39,"essere"],[40,44,"caso"],[45,48,"che"],[49,51,"mi"],[52,62,"addormentare"],[63,66,"mai"]]},{"it":"―","ja":"","t":[]},{"it":"Lascio pensare a voi come rimasero la mattina dopo, quando, svegliandosi, si trovarono tutt’e tre nel letto, mascherati!","ja":"","t":[[0,6,"lasciare"],[7,14,"pensare"],[15,16,"a"],[17,20,"voi"],[21,25,"come"],[26,34,"rimanere"],[35,37,"il"],[38,45,"mattina"],[46,50,"dopo"],[52,58,"quando"],[60,72,"svegliare"],[74,76,"si"],[77,86,"trovare"],[87,91,"tutto"],[92,93,"e"],[94,97,"tre"],[98,101,"in"],[102,107,"letto"],[109,119,0]]},{"it":"― Meno male ― disse Cesare ― che domani sera c’è un’altra festa da ballo.","ja":"","t":[[2,6,"meno"],[7,11,"male"],[14,19,"dire"],[20,26,0],[29,32,"che"],[33,39,"domani"],[40,44,"sera"],[45,46,"ci"],[47,48,"essere"],[49,51,"un"],[52,57,"altro"],[58,63,"festa"],[64,66,"da"],[67,72,"ballo"]]},{"it":"Anderemo a quella.","ja":"","t":[[0,8,0],[9,10,"a"],[11,17,"quello"]]},{"it":"― E il premio delle cento lire?","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,13,"premio"],[14,19,"di"],[20,25,"cento"],[26,30,"lira"]]},{"it":"― domandarono Orazio e Pierino.","ja":"","t":[[2,13,"domandare"],[14,20,0],[21,22,"e"],[23,30,0]]},{"it":"― C’è anche il premio.","ja":"","t":[[2,3,"ci"],[4,5,"essere"],[6,11,"anche"],[12,14,"il"],[15,21,"premio"]]},{"it":"―","ja":"","t":[]},{"it":"Lesti lesti saltarono il letto, lesti lesti si spogliarono da Rigoletti e si rivestirono da ragazzi, e lesti lesti nascosero tutto il loro bagaglio in fondo a un piccolo armadio a muro.","ja":"","t":[[0,5,"lesto"],[6,11,"lesto"],[12,21,"saltare"],[22,24,"il"],[25,30,"letto"],[32,37,"lesto"],[38,43,"lesto"],[44,46,"si"],[47,58,"spogliare"],[59,61,"da"],[62,71,0],[72,73,"e"],[74,76,"si"],[77,88,0],[89,91,"da"],[92,99,"ragazzo"],[101,102,"e"],[103,108,"lesto"],[109,114,"lesto"],[115,124,"nascondere"],[125,130,"tutto"],[131,133,"il"],[134,138,"loro"],[139,147,"bagaglio"],[148,150,"in"],[151,156,"fondo"],[157,158,"a"],[159,161,"un"],[162,169,"piccolo"],[170,177,"armadio"],[178,179,"a"],[180,184,"muro"]]},{"it":"Arrivati alla sera dipoi, ripeterono la medesima scena della gran sonnolenza e dell’entrare sotto i lenzuoli bell’e vestiti cogli abiti da maschera.","ja":"","t":[[0,8,"arrivare"],[9,13,"a"],[14,18,"sera"],[19,24,0],[26,36,"ripetere"],[37,39,"il"],[40,48,"medesimo"],[49,54,"scena"],[55,60,"di"],[61,65,"grande"],[66,76,0],[77,78,"e"],[79,83,"di"],[84,91,"entrare"],[92,97,"sotto"],[98,99,"il"],[100,108,"lenzuolo"],[109,113,"bello"],[114,115,"e"],[116,123,"vestire"],[124,129,"con"],[130,135,"abitare"],[136,138,"da"],[139,147,"maschera"]]},{"it":"Appena, però, si accorsero che la mamma, dopo averli baciati, era rientrata nella sua camera, saltarono dal letto e si posero a girandolare in su e in giù, tanto per non lasciarsi tradire dal sonno.","ja":"","t":[[0,6,"appena"],[8,12,"però"],[14,16,"si"],[17,26,"accorgersi"],[27,30,"che"],[31,33,"il"],[34,39,"mamma"],[41,45,"dopo"],[46,52,"avere"],[53,60,"baciare"],[62,65,"essere"],[66,75,"rientrare"],[76,81,"in"],[82,85,"suo"],[86,92,"camera"],[94,103,"saltare"],[104,107,"da"],[108,113,"letto"],[114,115,"e"],[116,118,"si"],[119,125,"porre"],[126,127,"a"],[128,139,0],[140,142,"in"],[143,145,"su"],[146,147,"e"],[148,150,"in"],[151,154,"giù"],[156,161,"tanto"],[162,165,"per"],[166,169,"non"],[170,179,"lasciare"],[180,187,"tradire"],[188,191,"da"],[192,197,"sonno"]]},{"it":"Aspetta, aspetta, aspetta, finalmente dopo un secolo sonarono le dieci.","ja":"","t":[[0,7,"aspettare"],[9,16,"aspettare"],[18,25,"aspettare"],[27,37,"finalmente"],[38,42,"dopo"],[43,45,"un"],[46,52,"secolo"],[53,61,"sonare"],[62,64,"il"],[65,70,"dieci"]]},{"it":"― Dunque si va, o non si va?","ja":"","t":[[2,8,"dunque"],[9,11,"si"],[12,14,"andare"],[16,17,"o"],[18,21,"non"],[22,24,"si"],[25,27,"andare"]]},{"it":"Se vogliamo andare, questa sarebbe l’ora ― disse Cesare.","ja":"","t":[[0,2,"se"],[3,11,"volere"],[12,18,"andare"],[20,26,"questo"],[27,34,"essere"],[35,36,"il"],[37,40,"ora"],[43,48,"dire"],[49,55,0]]},{"it":"― E la chiave di casa l’hai presa?","ja":"","t":[[2,3,"e"],[4,6,"il"],[7,13,"chiave"],[14,16,"di"],[17,21,"casa"],[22,23,"il"],[24,27,"avere"],[28,33,"prendere"]]},{"it":"― domandò Orazio.","ja":"","t":[[2,9,"domandare"],[10,16,0]]},{"it":"― Eccola qui.","ja":"","t":[[2,8,0],[9,12,"qui"]]},{"it":"― E tu, Pierino, a che cosa pensi?","ja":"","t":[[2,3,"e"],[4,6,"tu"],[8,15,0],[17,18,"a"],[19,22,"che"],[23,27,"cosa"],[28,33,"pensare"]]},{"it":"― Per me, se si deve andare, andiamo: ma il core mi dice che questi sotterfugi ci porteranno disgrazia.","ja":"","t":[[2,5,"per"],[6,8,"me"],[10,12,"se"],[13,15,"si"],[16,20,"dovere"],[21,27,"andare"],[29,36,"andare"],[38,40,"ma"],[41,43,"il"],[44,48,0],[49,51,"mi"],[52,56,"dire"],[57,60,"che"],[61,67,"questo"],[68,78,0],[79,81,"ci"],[82,92,"portare"],[93,102,"disgrazia"]]},{"it":"Se la mamma, nel tempo che siamo al teatro, la si svegliasse?...","ja":"","t":[[0,2,"se"],[3,5,"il"],[6,11,"mamma"],[13,16,"in"],[17,22,"tempo"],[23,26,"che"],[27,32,"essere"],[33,35,"a"],[36,42,"teatro"],[44,46,"il"],[47,49,"si"],[50,60,"svegliare"]]},{"it":"― E perchè si dovrebbe svegliare?","ja":"","t":[[2,3,"e"],[4,10,"perché"],[11,13,"si"],[14,22,"dovere"],[23,32,"svegliare"]]},{"it":"― I casi son tanti!","ja":"","t":[[2,3,"il"],[4,8,"caso"],[9,12,"essere"],[13,18,"tanto"]]},{"it":"E se una volta svegliata, la venisse in camera nostra e non ci trovasse nessuno?...","ja":"","t":[[0,1,"e"],[2,4,"se"],[5,8,"un"],[9,14,"volta"],[15,24,"svegliare"],[26,28,"il"],[29,36,"venire"],[37,39,"in"],[40,46,"camera"],[47,53,"nostro"],[54,55,"e"],[56,59,"non"],[60,62,"ci"],[63,71,"trovare"],[72,79,"nessuno"]]},{"it":"― Come sei uggioso!","ja":"","t":[[2,6,"come"],[7,10,"essere"],[11,18,0]]},{"it":"Benedetto i ragazzi e chi ci s’impiccia?","ja":"","t":[[0,9,"benedetto"],[10,11,"il"],[12,19,"ragazzo"],[20,21,"e"],[22,25,"chi"],[26,28,"ci"],[2
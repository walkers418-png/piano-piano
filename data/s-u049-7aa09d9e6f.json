,"pallido"],[76,79,"che"],[80,87,"tremare"],[88,90,"da"],[91,95,"capo"],[96,97,"a"],[98,103,"piede"]]},{"it":"Egli pensava a suo padre, certo.","ja":"","t":[[0,4,"egli"],[5,12,"pensare"],[13,14,"a"],[15,18,"suo"],[19,24,"padre"],[26,31,"certo"]]},{"it":"Anch’io ci pensai.","ja":"","t":[[0,4,"anche"],[5,7,"io"],[8,10,"ci"],[11,17,"pensare"]]},{"it":"Io sto con l’animo in pace, almeno, quando sono a scuola, io so che mio padre è a casa, seduto a tavolino, lontano da ogni pericolo; ma quanti miei compagni pensano che i loro padri lavorano sopra un ponte altissimo o vicino alle ruote d’una macchina, e che un gesto, un passo falso può costar loro la vita!","ja":"","t":[[0,2,"io"],[3,6,"stare"],[7,10,"con"],[11,12,"il"],[13,18,"animo"],[19,21,"in"],[22,26,"pace"],[28,34,"almeno"],[36,42,"quando"],[43,47,"essere"],[48,49,"a"],[50,56,"scuola"],[58,60,"io"],[61,63,"sapere"],[64,67,"che"],[68,71,"mio"],[72,77,"padre"],[78,79,"essere"],[80,81,"a"],[82,86,"casa"],[88,94,"sedere"],[95,96,"a"],[97,105,"tavolino"],[107,114,"lontano"],[115,117,"da"],[118,122,"ogni"],[123,131,"pericolo"],[133,135,"ma"],[136,142,"quanto"],[143,147,"mio"],[148,156,"compagno"],[157,164,"pensare"],[165,168,"che"],[169,170,"il"],[171,175,"loro"],[176,181,"padre"],[182,190,"lavorare"],[191,196,"sopra"],[197,199,"un"],[200,205,"ponte"],[206,215,"alto"],[216,217,"o"],[218,224,"vicino"],[225,229,"a"],[230,235,"ruota"],[236,237,"di"],[238,241,"un"],[242,250,"macchina"],[252,253,"e"],[254,257,"che"],[258,260,"un"],[261,266,"gesto"],[268,270,"un"],[271,276,"passo"],[277,282,"falso"],[283,286,"potere"],[287,293,0],[294,298,"loro"],[299,301,"il"],[302,306,"vita"]]},{"it":"Sono come tanti figliuoli di soldati, che abbiano i loro padri in battaglia.","ja":"","t":[[0,4,"essere"],[5,9,"come"],[10,15,"tanto"],[16,25,"figliuolo"],[26,28,"di"],[29,36,"soldato"],[38,41,"che"],[42,49,"avere"],[50,51,"il"],[52,56,"loro"],[57,62,"padre"],[63,65,"in"],[66,75,"battaglia"]]},{"it":"Il muratorino guardava, guardava, e tremava sempre più forte, e mio padre se n’accorse e gli disse: — Vattene a casa, ragazzo, va subito da tuo padre, che lo troverai sano e tranquillo; va’!","ja":"","t":[[0,2,"il"],[3,13,0],[14,22,"guardare"],[24,32,"guardare"],[34,35,"e"],[36,43,"tremare"],[44,50,"sempre"],[51,54,"più"],[55,60,"forte"],[62,63,"e"],[64,67,"mio"],[68,73,"padre"],[74,76,"se"],[77,78,0],[79,86,"accorgersi"],[87,88,"e"],[89,92,"il"],[93,98,"dire"],[102,109,0],[110,111,"a"],[112,116,"casa"],[118,125,"ragazzo"],[127,129,"andare"],[130,136,"subito"],[137,139,"da"],[140,143,"tuo"],[144,149,"padre"],[151,154,"che"],[155,157,"il"],[158,166,"trovare"],[167,171,"sano"],[172,173,"e"],[174,184,"tranquillo"],[186,188,"andare"]]},{"it":"— Il muratorino se n’andò voltandosi indietro a ogni passo.","ja":"","t":[[2,4,"il"],[5,15,0],[16,18,"se"],[19,20,0],[21,25,"andare"],[26,36,"voltare"],[37,45,"indietro"],[46,47,"a"],[48,52,"ogni"],[53,58,"passo"]]},{"it":"E intanto la folla si rimise in moto, e la donna gridava, da straziar l’anima: — È morto!","ja":"","t":[[0,1,"e"],[2,9,"intanto"],[10,12,"il"],[13,18,"folla"],[19,21,"si"],[22,28,"rimettere"],[29,31,"in"],[32,36,"moto"],[38,39,"e"],[40,42,"il"],[43,48,"donna"],[49,56,"gridare"],[58,60,"da"],[61,69,0],[70,71,"il"],[72,77,"anima"],[81,82,"essere"],[83,88,"morire"]]},{"it":"È morto!","ja":"","t":[[0,1,"essere"],[2,7,"morire"]]},{"it":"È morto!","ja":"","t":[[0,1,"essere"],[2,7,"morire"]]},{"it":"— No, no, non è morto, — le dicevan da tutte le parti.","ja":"","t":[[2,4,"no"],[6,8,"no"],[10,13,"non"],[14,15,"essere"],[16,21,"morire"],[25,27,"il"],[28,35,0],[36,38,"da"],[39,44,"tutto"],[45,47,"il"],[48,53,"parte"]]},{"it":"Ma essa non ci badava e si strappava i capelli.","ja":"","t":[[0,2,"ma"],[3,7,"essa"],[8,11,"non"],[12,14,"ci"],[15,21,"badare"],[22,23,"e"],[24,26,"si"],[27,36,"strappare"],[37,38,"il"],[39,46,"capello"]]},{"it":"Quando sentii una voce sdegnata che disse: — Tu ridi!","ja":"","t":[[0,6,"quando"],[7,13,"sentire"],[14,17,"un"],[18,22,"voce"],[23,31,0],[32,35,"che"],[36,41,"dire"],[45,47,"tu"],[48,52,"ridere"]]},{"it":"— e vidi nello stesso tempo un uomo barbuto che guardava in faccia Franti, il quale sorrideva ancora.","ja":"","t":[[2,3,"e"],[4,8,"vedere"],[9,14,"in"],[15,21,"stesso"],[22,27,"tempo"],[28,30,"un"],[31,35,"uomo"],[36,43,"barbuto"],[44,47,"che"],[48,56,"guardare"],[57,59,"in"],[60,66,"fare"],[67,73,0],[75,77,"il"],[78,83,"quale"],[84,93,"sorridere"],[94,100,"ancora"]]},{"it":"Allora l’uomo gli cacciò in terra il berretto con un ceffone, dicendo: — Scopriti il capo, malnato, quando passa un ferito del lavoro!","ja":"","t":[[0,6,"allora"],[7,8,"il"],[9,13,"uomo"],[14,17,"il"],[18,24,"cacciare"],[25,27,"in"],[28,33,"terra"],[34,36,"il"],[37,45,"berretto"],[46,49,"con"],[50,52,"un"],[53,60,0],[62,69,"dire"],[73,81,"scoprire"],[82,84,"il"],[85,89,"capo"],[91,98,0],[100,106,"quando"],[107,112,"passare"],[113,115,"un"],[116,122,"ferito"],[123,126,"di"],[127,133,"lavoro"]]},{"it":"— La folla era già passata tutta, e si vedeva in mezzo alla strada una lunga striscia di sangue.","ja":"","t":[[2,4,"il"],[5,10,"folla"],[11,14,"essere"],[15,18,"già"],[19,26,"passare"],[27,32,"tutto"],[34,35,"e"],[36,38,"si"],[39,45,"vedere"],[46,48,"in"],[49,54,"mezzo"],[55,59,"a"],[60,66,"strada"],[67,70,"un"],[71,76,"lungo"],[77,85,"striscia"],[86,88,"di"],[89,95,"sangue"]]}],"q":[],"g":{},"n":500,"w":["a","accanto","accorgersi","allora","almeno","alto","altro","anche","ancora","andare","anima","animo","avanzare","avere","badare","barbuto","basso","battaglia","berretto","bianco","bimbo","bocca","braccio","cacciare","cadere","camminare","capello","capo","casa","certo","che","ci","come","compagno","con","cosa","da","davanti","di","dietro","dire","disteso","domandare","donna","due","e","egli","essa","essere","falso","fare","ferito","figliuolo","folla","fondo","forte","gente","gesto","ghiaccio","già","gomito","gridare","guardare","guardia","il","in","indietro","intanto","io","lavorare","lavoro","lesto","lontano","loro","lune
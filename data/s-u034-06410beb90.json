,[33,38,"forte"]]},{"it":"Ma tutt’a un tratto Garrone saltò su col viso stravolto e coi pugni stretti, e gridò con la voce strozzata dall’ira: — Finitela.","ja":"","t":[[0,2,"ma"],[3,7,"tutto"],[8,9,"a"],[10,12,"un"],[13,19,"tratto"],[20,27,0],[28,33,"saltare"],[34,36,"su"],[37,40,"con"],[41,45,"viso"],[46,55,0],[56,57,"e"],[58,61,"con"],[62,67,"pugno"],[68,75,"stretto"],[77,78,"e"],[79,84,"gridare"],[85,88,"con"],[89,91,"il"],[92,96,"voce"],[97,106,"strozzare"],[107,111,"da"],[112,115,"ira"],[119,127,"finire"]]},{"it":"Siete bestie.","ja":"","t":[[0,5,"essere"],[6,12,"bestia"]]},{"it":"Abusate perchè è buono.","ja":"","t":[[0,7,"abusare"],[8,14,"perché"],[15,16,"essere"],[17,22,"buono"]]},{"it":"Se vi pestasse le ossa stareste mogi come cani.","ja":"","t":[[0,2,"se"],[3,5,"vi"],[6,14,"pestare"],[15,17,"il"],[18,22,"osso"],[23,31,"stare"],[32,36,0],[37,41,"come"],[42,46,"cane"]]},{"it":"Siete un branco di vigliacchi.","ja":"","t":[[0,5,"essere"],[6,8,"un"],[9,15,"branco"],[16,18,"di"],[19,29,0]]},{"it":"Il primo che gli fa ancora uno scherno lo aspetto fuori e gli rompo i denti, lo giuro, anche sotto gli occhi di suo padre!","ja":"","t":[[0,2,"il"],[3,8,"primo"],[9,12,"che"],[13,16,"il"],[17,19,"fare"],[20,26,"ancora"],[27,30,"un"],[31,38,0],[39,41,"il"],[42,49,"aspetto"],[50,55,"fuori"],[56,57,"e"],[58,61,"il"],[62,67,"rompere"],[68,69,"il"],[70,75,"dente"],[77,79,"il"],[80,85,"giurare"],[87,92,"anche"],[93,98,"sotto"],[99,102,"il"],[103,108,"occhio"],[109,111,"di"],[112,115,"suo"],[116,121,"padre"]]},{"it":"— Tutti tacquero.","ja":"","t":[[2,7,"tutto"],[8,16,"tacere"]]},{"it":"Ah!","ja":"","t":[[0,2,"ah"]]},{"it":"Com’era bello a vedere, Garrone, con gli occhi che mandavan fiamme!","ja":"","t":[[0,3,"come"],[4,7,"essere"],[8,13,"bello"],[14,15,"a"],[16,22,"vedere"],[24,31,0],[33,36,"con"],[37,40,"il"],[41,46,"occhio"],[47,50,"che"],[51,59,"mandare"],[60,66,"fiamma"]]},{"it":"Un leoncello furioso, pareva.","ja":"","t":[[0,2,"un"],[3,12,0],[13,20,"furioso"],[22,28,"parere"]]},{"it":"Guardò uno per uno i più arditi, e tutti chinaron la testa.","ja":"","t":[[0,6,"guardare"],[7,10,"un"],[11,14,"per"],[15,18,"un"],[19,20,"il"],[21,24,"più"],[25,31,"ardire"],[33,34,"e"],[35,40,"tutto"],[41,49,"chinare"],[50,52,"il"],[53,58,"testa"]]},{"it":"Quando il supplente rientrò, con gli occhi rossi, non si sentiva più un alito.","ja":"","t":[[0,6,"quando"],[7,9,"il"],[10,19,"supplente"],[20,27,"rientrare"],[29,32,"con"],[33,36,"il"],[37,42,"occhio"],[43,48,"rosso"],[50,53,"non"],[54,56,"si"],[57,64,"sentire"],[65,68,"più"],[69,71,"un"],[72,77,0]]},{"it":"— Egli rimase stupito.","ja":"","t":[[2,6,"egli"],[7,13,"rimanere"],[14,21,"stupito"]]},{"it":"Ma poi, vedendo Garrone ancora tutto acceso e fremente,","ja":"","t":[[0,2,"ma"],[3,6,"poi"],[8,15,"vedere"],[16,23,0],[24,30,"ancora"],[31,36,"tutto"],[37,43,"accendere"],[44,45,"e"],[46,54,"fremere"]]}],"q":[],"g":{},"n":471,"w":["a","abusare","accadere","accendere","affacciare","afferrare","ah","alcuno","allora","altro","alzare","ammonire","anche","ancora","ardire","aspetto","atto","avere","baccano","badare","banco","barba","battere","bello","bene","bestia","bidello","braccio","branco","brutto","buono","calamaio","calza","cane","carta","cenno","centesimo","che","chiamare","chiasso","chinare","ci","codesto","come","compagno","con","contro","cosa","crescere","da","dente","descrivere","di","dire","direttore","disperato","due","e","egli","elenco","entrare","essere","famoso","fare","fiamma","fiatare","finire","forse","forte","forza","francobollo","fremere","fretta","fuori","furioso","gatto","giorno","giovinetto","giurare","già","gomito","grande","gridare","guardare","il","improvvisamente","in","infatti","ira","li","libreria","lotteria","lui","ma","maestro","malumore","mandare","mattina","mercato","mercoledì","mettere","mio","misurare","modo","muro","naso","ne","nessuno","non","occhio","occupato","ora","osso","padre","parere","parola","passare","pazienza","pena","pensare","per","perché","perdere","pes
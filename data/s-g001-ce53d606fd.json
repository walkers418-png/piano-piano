,42,"di"],[43,46,0],[47,50,"che"],[51,57,"giusto"],[58,59,"essere"],[60,65,"fuori"],[66,73,"insieme"],[74,78,"a"],[79,84,"mamma"],[85,86,"a"],[87,90,"fare"],[91,96,"di"],[97,103,"visita"]]},{"it":"..................................................................................................","ja":"","t":[]},{"it":"Ecco qui: sono andato su in camera di Ada, ho aperto la cassetta della sua scrivania, le ho preso il suo giornale di memorie, e ora posso copiare in pace.","ja":"","t":[[0,4,"ecco"],[5,8,"qui"],[10,14,"essere"],[15,21,"andare"],[22,24,"su"],[25,27,"in"],[28,34,"camera"],[35,37,"di"],[38,41,0],[43,45,"avere"],[46,52,"aprire"],[53,55,"il"],[56,64,"cassetta"],[65,70,"di"],[71,74,"suo"],[75,84,"scrivania"],[86,88,"il"],[89,91,"avere"],[92,97,"prendere"],[98,100,"il"],[101,104,"suo"],[105,113,"giornale"],[114,116,"di"],[117,124,"memoria"],[126,127,"e"],[128,131,"ora"],[132,137,"potere"],[138,145,"copiare"],[146,148,"in"],[149,153,"pace"]]},{"it":"«Oh, se quel vecchiaccio del Capitani non tornasse più! ed invece, è venuto anche stasera.","ja":"","t":[[1,3,"oh"],[5,7,"se"],[8,12,"quello"],[13,24,0],[25,28,"di"],[29,37,"capitano"],[38,41,"non"],[42,50,"tornare"],[51,54,"più"],[56,58,"e"],[59,65,"invece"],[67,68,"essere"],[69,75,"venire"],[76,81,"anche"],[82,89,"stasera"]]},{"it":"È impossibile! non mi piace!","ja":"","t":[[0,1,"essere"],[2,13,"impossibile"],[15,18,"non"],[19,21,"mi"],[22,27,"piacere"]]},{"it":"Non mi piace, e non mi piacerà mai, mai, mai...","ja":"","t":[[0,3,"non"],[4,6,"mi"],[7,12,"piacere"],[14,15,"e"],[16,19,"non"],[20,22,"mi"],[23,30,"piacere"],[31,34,"mai"],[36,39,"mai"],[41,44,"mai"]]},{"it":"La mamma ha detto che è molto ricco; e che se mi chiedesse in moglie, dovrei sposarlo.","ja":"","t":[[0,2,"il"],[3,8,"mamma"],[9,11,"avere"],[12,17,"dire"],[18,21,"che"],[22,23,"essere"],[24,29,"molto"],[30,35,"ricco"],[37,38,"e"],[39,42,"che"],[43,45,"se"],[46,48,"mi"],[49,58,"chiedere"],[59,61,"in"],[62,68,"moglie"],[70,76,"dovere"],[77,85,"sposa
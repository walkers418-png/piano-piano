13,"essere"],[14,18,0],[19,24,"falso"],[26,28,0],[30,39,"signorino"]]},{"it":"Immediatamente un altro povero cieco che era dall’altra parte della scalinata è venuto a esaminare il biglietto e ha detto:","ja":"","t":[[0,14,"immediatamente"],[15,17,"un"],[18,23,"altro"],[24,30,"povero"],[31,36,"cieco"],[37,40,"che"],[41,44,"essere"],[45,49,"da"],[50,55,"altro"],[56,61,"parte"],[62,67,"di"],[68,77,0],[78,79,"essere"],[80,86,"venire"],[87,88,"a"],[89,98,"esaminare"],[99,101,"il"],[102,111,"biglietto"],[112,113,"e"],[114,116,"avere"],[117,122,"dire"]]},{"it":"- Ma non vedi che è buonissimo?","ja":"","t":[[2,4,"ma"],[5,8,"non"],[9,13,"vedere"],[14,17,"che"],[18,19,"essere"],[20,30,"buono"]]},{"it":"E a me, signorino?","ja":"","t":[[0,1,"e"],[2,3,"a"],[4,6,"me"],[8,17,"signorino"]]},{"it":"Non me ne dà uno anche a me? -","ja":"","t":[[0,3,"non"],[4,6,"me"],[7,9,"ne"],[10,12,"dare"],[13,16,"un"],[17,22,"anche"],[23,24,"a"],[25,27,"me"]]},{"it":"Io per non fare ingiustizie ne ho dato uno anche a lui: e siccome in quel momento uno zoppo che chiedeva l’elemosina sulla porta della chiesa è corso precipitosamente a me per godere dello stesso trattamento dei suoi due colleghi ho dato cinque lire anche a lui.","ja":"","t":[[0,2,"io"],[3,6,"per"],[7,10,"non"],[11,15,"fare"],[16,27,"ingiustizia"],[28,30,"ne"],[31,33,"avere"],[34,38,"dare"],[39,42,"un"],[43,48,"anche"],[49,50,"a"],[51,54,"lui"],[56,57,"e"],[58,65,"siccome"],[66,68,"in"],[69,73,"quello"],[74,81,"momento"],[82,85,"un"],[86,91,"zoppo"],[92,95,"che"],[96,104,"chiedere"],[105,106,"il"],[107,116,"elemosina"],[117,122,"su"],[123,128,"porta"],[129,134,"di"],[135,141,"chiesa"],[142,143,"essere"],[144,149,"correre"],[150,166,"precipitosamente"],[167,168,"a"],[169,171,"me"],[172,175,"per"],[176,182,"godere"],[183,188,"di"],[189,195,"stesso"],[196,207,"trattamento"],[208,211,"di"],[212,216,"suo"],[217,220,"due"],[221,229,"collegare"],[230,232,"avere"],[233,237,"dare"],[238,244,"cinque"],[245,249,"lira"],[250,255,"anche"],[256,257,"a"],[258,261,"lui"]]},{"it":"Ma il bello della scena è stato questo: che io infatuato come ero in quel momento della mia munificenza, mentre mi davo una grande aria di importanza nel levar di tasca i miei biglietti di banca, non ho neanche menomamente pensato al fatto stranissimo di quei due ciechi che vedevano e di quello zoppo che correva.","ja":"","t":[[0,2,"ma"],[3,5,"il"],[6,11,"bello"],[12,17,"di"],[18,23,"scena"],[24,25,"essere"],[26,31,"essere"],[32,38,"questo"],[40,43,"che"],[44,46,"io"],[47,56,0],[57,61,"come"],[62,65,"essere"],[66,68,"in"],[69,73,"quello"],[74,81,"momento"],[82,87,"di"],[88,91,"mio"],[92,103,0],[105,111,"mentre"],[112,114,"mi"],[115,119,"dare"],[120,123,"un"],[124,130,"grande"],[131,135,"aria"],[136,138,"di"],[139,149,"importanza"],[150,153,"in"],[154,159,"levare"],[160,162,"di"],[163,168,"tasca"],[169,170,"il"],[171,175,"mio"],[176,185,"biglietto"],[186,188,"di"],[189,194,"banca"],[196,199,"non"],[200,202,"avere"],[203,210,"neanche"],[211,222,0],[223,230,"pensare"],[231,233,"a"],[234,239,"fare"],[240,251,"strano"],[252,254,"di"],[255,259,"quello"],[260,263,"due"],[264,270,"cieco"],[271,274,"che"],[275,283,"vedere"],[284,285,"e"],[286,288,"dire"],[289,295,"quello"],[296,301,"zoppo"],[302,305,"che"],[306,313,"correre"]]},{"it":"Ci ho ripensato dopo...","ja":"","t":[[0,2,"ci"],[3,5,"avere"],[6,15,"ripensare"],[16,20,"dopo"]]},{"it":"Allora ho capito che la carità è una gran bella cosa, ma bisogna saperla fare... e lì per lì ho provato tanta stizza di essere stato ingannato così sfacciatamente che, per un legittimo sentimento di reazione, sono andato al negozio Balestra e mi son mangiato tre lire di pasticcini!","ja":"","t":[[0,6,"allora"],[7,9,"avere"],[10,16,"capire"],[17,20,"che"],[21,23,"il"],[24,30,"carità"],[31,32,"essere"],[33,36,"un"],[37,41,"grande"],[42,47,"bello"],[48,52,"cosa"],[54,56,"ma"],[57,64,"bisognare"],[65,72,"sapere"],[73,77,"fare"],[81,82,"e"],[83,85,"lì"],[86,89,"per"],[90,92,"lì"],[93,95,"avere"],[96,103,"provare"]
,103,"e"],[104,105,"il"],[106,112,"occhio"],[113,120,"diritto"],[121,124,"di"],[125,130,"babbo"]]},{"it":"Guai se le sorelle e i fratelli maggiori avessero torto un capello a Gigino!","ja":"","t":[[0,4,"guaio"],[5,7,"se"],[8,10,"il"],[11,18,"sorella"],[19,20,"e"],[21,22,"il"],[23,31,"fratello"],[32,40,"maggiore"],[41,49,"avere"],[50,55,"torto"],[56,58,"un"],[59,66,"capello"],[67,68,"a"],[69,75,0]]},{"it":"C’era da far nascere una specie di finimondo.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,8,"da"],[9,12,"fare"],[13,20,"nascere"],[21,24,"un"],[25,31,"specie"],[32,34,"di"],[35,44,0]]},{"it":"Volete che vi dica il più gran difetto di questo ragazzo?","ja":"","t":[[0,6,"volere"],[7,10,"che"],[11,13,"vi"],[14,18,"dire"],[19,21,"il"],[22,25,"più"],[26,30,"grande"],[31,38,"difetto"],[39,41,"di"],[42,48,"questo"],[49,56,"ragazzo"]]},{"it":"Durerete fatica a crederlo, eppure è così: il suo più gran difetto era quello di vergognarsi a passar per un ragazzo: voleva per forza parere un giovinotto, un uomo fatto!","ja":"","t":[[0,8,"durare"],[9,15,"fatica"],[16,17,"a"],[18,26,"credere"],[28,34,"eppure"],[35,36,"essere"],[37,41,"così"],[43,45,"il"],[46,49,"suo"],[50,53,"più"],[54,58,"grande"],[59,66,"difetto"],[67,70,"essere"],[71,77,"quello"],[78,80,"di"],[81,92,"vergognarsi"],[93,94,"a"],[95,101,"passare"],[102,105,"per"],[106,108,"un"],[109,116,"ragazzo"],[118,124,"volere"],[125,128,"per"],[129,134,"forza"],[135,141,"parere"],[142,144,"un"],[145,155,0],[157,159,"un"],[160,164,"uomo"],[165,170,"fare"]]},{"it":"A domandargli quanti anni avesse, per il solito rispondeva:","ja":"","t":[[0,1,"a"],[2,13,"domandare"],[14,20,"quanto"],[21,25,"anno"],[26,32,"avere"],[34,37,"per"],[38,40,"il"],[41,47,"solito"],[48,58,"rispondere"]]},{"it":"— Il babbo e la mamma dicono che ne ho dieci; ma lo dicono per farmi arrabbiare....","ja":"","t":[[2,4,"il"],[5,10,"babbo"],[11,12,"e"],[13,15,"il"],[16,21,"mamma"],[22,28,"dire"],[29,32,"che"],[33,35,"ne"],[36,38,"avere"],[39,44,"dieci"],[46,48,"m
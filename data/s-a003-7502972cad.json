"]]},{"it":"Me lo fai, dunque, questo piacere?","ja":"","t":[[0,2,"me"],[3,5,"il"],[6,9,"fare"],[11,17,"dunque"],[19,25,"questo"],[26,33,"piacere"]]},{"it":"― Eppure scommetto che se il suo babbo fosse tanto buono da comprarle un cappello a tuba, lei non si vergognerebbe a farsi vedere in mezzo alla strada con quella cupola in capo!","ja":"","t":[[2,8,"eppure"],[9,18,"scommettere"],[19,22,"che"],[23,25,"se"],[26,28,"il"],[29,32,"suo"],[33,38,"babbo"],[39,44,"essere"],[45,50,"tanto"],[51,56,"buono"],[57,59,"da"],[60,69,"comprare"],[70,72,"un"],[73,81,"cappello"],[82,83,"a"],[84,88,"tuba"],[90,93,"lei"],[94,97,"non"],[98,100,"si"],[101,114,"vergognarsi"],[115,116,"a"],[117,122,"fare"],[123,129,"vedere"],[130,132,"in"],[133,138,"mezzo"],[139,143,"a"],[144,150,"strada"],[151,154,"con"],[155,161,"quello"],[162,168,0],[169,171,"in"],[172,176,"capo"]]},{"it":"—","ja":"","t":[]},{"it":"Gigino guardò in viso la Veronica, e abbassando la voce domandò:","ja":"","t":[[0,6,0],[7,13,"guardare"],[14,16,"in"],[17,21,"viso"],[22,24,"il"],[25,33,0],[35,36,"e"],[37,47,"abbassare"],[48,50,"il"],[51,55,"voce"],[56,63,"domandare"]]},{"it":"— Hai saputo forse qualche cosa?...","ja":"","t":[[2,5,"avere"],[6,12,"sapere"],[13,18,"forse"],[19,26,"qualche"],[27,31,"cosa"]]},{"it":"— Di che?","ja":"","t":[[2,4,"di"],[5,8,"che"]]},{"it":"— Del cappello....","ja":"","t":[[2,5,"di"],[6,14,"cappello"]]},{"it":"— Cioè?","ja":"","t":[[2,6,"cioè"]]},{"it":"— Dunque non sai nulla?...","ja":"","t":[[2,8,"dunque"],[9,12,"non"],[13,16,"sapere"],[17,22,"nulla"]]},{"it":"Meno male....","ja":"","t":[[0,4,"meno"],[5,9,"male"]]},{"it":"Che cosa dunque, dicevi?","ja":"","t":[[0,3,"che"],[4,8,"cosa"],[9,15,"dunque"],[17,23,"dire"]]},{"it":"— Dicevo che lei sarebbe capacissimo di mettersi in testa un cappello a tuba e di andare magari a farsi vedere da tutti!...","ja":"","t":[[2,8,"dire"],[9,12,"che"],[13,16,"lei"],[17,24,"essere"],[25,36,"capace"],[37,39,"di"],[40,48,"mettere"],[49,51,"in"],[52,57,"testa"],[58,6
{"id":"u014","title":"Novembre・Il carbonaio e il signore","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"IL CARBONAIO E IL SIGNORE","ja":"","t":[[0,2,"il"],[3,12,"carbonaio"],[13,14,"e"],[15,17,"il"],[18,25,"signore"]]},{"it":"7, lunedì.","ja":"","t":[[3,9,"lunedì"]]},{"it":"Non l’avrebbe mai detta Garrone, sicuramente, quella parola che disse ieri mattina Carlo Nobis a Betti.","ja":"","t":[[0,3,"non"],[4,5,"il"],[6,13,"avere"],[14,17,"mai"],[18,23,"dire"],[24,31,0],[33,44,"sicuramente"],[46,52,"quello"],[53,59,"parola"],[60,63,"che"],[64,69,"dire"],[70,74,"ieri"],[75,82,"mattina"],[83,88,0],[89,94,0],[95,96,"a"],[97,102,0]]},{"it":"Carlo Nobis è superbo perchè suo padre è un gran signore: un signore alto, con tutta la barba nera, molto serio, che viene quasi ogni giorno ad accompagnare il figliuolo.","ja":"","t":[[0,5,0],[6,11,0],[12,13,"essere"],[14,21,"superbo"],[22,28,"perché"],[29,32,"suo"],[33,38,"padre"],[39,40,"essere"],[41,43,"un"],[44,48,"grande"],[49,56,"signore"],[58,60,"un"],[61,68,"signore"],[69,73,"alto"],[75,78,"con"],[79,84,"tutto"],[85,87,"il"],[88,93,"barba"],[94,98,"nero"],[100,105,"molto"],[106,111,"serio"],[113,116,"che"],[117,122,"venire"],[123,128,"quasi"],[129,133,"ogni"],[134,140,"giorno"],[141,143,"a"],[144,156,"accompagnare"],[157,159,"il"],[160,169,"figliuolo"]]},{"it":"Ieri mattina Nobis si bisticciò con Betti, uno dei più piccoli, figliuolo d’un carbonaio, e non sapendo più che rispondergli, perchè aveva torto, gli disse forte: — Tuo padre è uno straccione.","ja":"","t":[[0,4,"ieri"],[5,12,"mattina"],[13,18,0],[19,21,"si"],[22,31,0],[32,35,"con"],[36,41,0],[43,46,"un"],[47,50,"di"],[51,54,"più"],[55,62,"piccolo"],[64,73,"figliuolo"],[74,75,"di"],[76,78,"un"],[79,88,"carbonaio"],[90,91,"e"],[92,95,"non"],[96,103,"sapere"],[104,107,"più"],[108,111,"che"],[112,124,"rispondere"],[126,132,"perché"],[133,138,"avere"],[139,144,"torto"],[146,149,"il"],[150,155,"dire"],[156,161,"forte"],[165,168,"tuo"],[169,174,"padre"],[175,176,"essere"],[177,180,"un"],[181,191,0]]},{"it":"— Betti arrossì fino ai capelli, e non disse nulla, ma gli vennero le lacrime agli occhi, e tornato a casa ripeté la parola a suo padre; ed ecco il carbonaio, un piccolo uomo tutto nero, che compare alla lezione del dopopranzo col ragazzo per mano, a fare le lagnanze al maestro.","ja":"","t":[[2,7,0],[8,15,0],[16,20,"fino"],[21,23,"a"],[24,31,"capello"],[33,34,"e"],[35,38,"non"],[39,44,"dire"],[45,50,"nulla"],[52,54,"ma"],[55,58,"il"],[59,66,"venire"],[67,69,"il"],[70,77,"lacrima"],[78,82,"a"],[83,88,"occhio"],[90,91,"e"],[92,99,"tornare"],[100,101,"a"],[102,106,"casa"],[107,113,"ripetere"],[114,116,"il"],[117,123,"parola"],[124,125,"a"],[126,129,"suo"],[130,135,"padre"],[137,139,"e"],[140,144,"ecco"],[145,147,"il"],[148,157,"carbonaio"],[159,161,"un"],[162,169,"piccolo"],[170,174,"uomo"],[175,180,"tutto"],[181,185,"nero"],[187,190,"che"],[191,198,"comparire"],[199,203,"a"],[204,211,"lezione"],[212,215,"di"],[216,226,0],[227,230,"con"],[231,238,"ragazzo"],[239,242,"per"],[243,247,"mano"],[249,250,"a"],[251,255,"fare"],[256,258,"il"],[259,267,0],[268,270,"a"],[271,278,"maestro"]]},{"it":"Mentre faceva le sue lagnanze al maestro, e tutti tacevano, il padre di Nobis, che levava il mantello al figliuolo, come al solito, sulla soglia dell’uscio, udendo pronunciare il suo nome, entrò, e domandò spiegazione.","ja":"","t":[[0,6,"mentre"],[7,13,"fare"],[14,16,"il"],[17,20,"suo"],[21,29,0],[30,32,"a"],[33,40,"maestro"],[42,43,"e"],[44,49,"tutto"],[50,58,"tacere"],[60,62,"il"],[63,68,"padre"],[69,71,"di"],[72,77,0],[79,82,"che"],[83,89,"levare"],[90,92,"il"],[93,101,"mantello"],[102,104,"a"],[105,114,"figliuolo"],[116,120,"come"],[121,123,"a"],[124,130,"solito"],[132,137,"su"],[138,144,0],[145,149,"di"],[150,155,"uscio"],[157,163,0],[164,175,0],[176,178,"il"],[179,182,"suo"],[183,187,"nome"],[189,194,"entrare"],[196,197,"e"],[198,205,"domandare"],[206,217,"spiegazione"]]},{"it":"— È quest’operaio, — rispose il maestro, — che è venuto a lagnarsi perchè il suo figliuolo Carlo disse al suo ragazzo: Tuo padre è uno straccione.","ja":"","t":[[2,3,"essere"],[4,9,"questo"],[10,17,"operaio"],[21,28,"rispondere"],[29,31,"il"],[32,39,"maestro"],[43,46,"che"],[47,48,"essere"],[49,55,"venire"],[56,57,"a"],[58,66,0],[67,73,"perché"],[74,76,"il"],[77,80,"suo"],[81,90,"figliuolo"],[91,96,0],[97,102,"dire"],[103,105,"a"],[106,109,"suo"],[110,117,"ragazzo"],[119,122,"tuo"],[123,128,"padre"],[129,130,"essere"],[131,134,"un"],[135,145,0]]},{"it":"Il padre di Nobis corrugò la fronte e arrossì un poco.","ja":"","t":[[0,2,"il"],[3,8,"padre"],[9,11,"di"],[12,17,0],[18,25,0],[26,28,"il"],[29,35,"fronte"],[36,37,"e"],[38,45,0],[46,48,"un"],[49,53,"poco"]]},{"it":"Poi domandò al figliuolo: — Hai detto quella parola?","ja":"","t":[[0,3,"poi"],[4,11,"domandare"],[12,14,"a"],[15,24,"figliuolo"],[28,31,"avere"],[32,37,"dire"],[38,44,"quello"],[45,51,"parola"]]},{"it":"Il figliuolo, — ritto in mezzo alla scuola, col capo basso, davanti al piccolo Betti, — non rispose.","ja":"","t":[[0,2,"il"],[3,12,"figliuolo"],[16,21,"ritto"],[22,24,"in"],[25,30,"mezzo"],[31,35,"a"],[36,42,"scuola"],[44,47,"con"],[48,52,"capo"],[53,58,"basso"],[60,67,"davanti"],[68,70,"a"],[71,78,"piccolo"],[79,84,0],[88,91,"non"],[92,99,"rispondere"]]},{"it":"Allora il padre lo prese per un braccio e lo spinse più avanti in faccia a Betti, che quasi si toccavano, e gli disse: — Domandagli scusa.","ja":"","t":[[0,6,"allora"],[7,9,"il"],[10,15,"padre"],[16,18,"il"],[19,24,"prendere"],[25,28,"per"],[29,31,"un"],[32,39,"braccio"],[40,41,"e"],[42,44,"il"],[45,51,"spingere"],[52,55,"più"],[56,62,"avanti"],[63,65,"in"],[66,72,"fare"],[73,74,"a"],[75,80,0],[82,85,"che"],[86,91,"quasi"],[92,94,"si"],[95,104,"toccare"],[106,107,"e"],[108,111,"il"],[112,117,"dire"],[121,131,"domandare"],[132,137,"scusa"]]},{"it":"Il carbonaio volle interporsi, dicendo: — No, no.","ja":"","t":[[0,2,"il"],[3,12,"carbonaio"],[13,18,"volere"],[19,29,0],[31,38,"dire"],[42,44,"no"],[46,48,"no"]]},{"it":"— Ma il signore non gli badò, e ripeté al figliuolo: — Domandagli scusa.","ja":"","t":[[2,4,"ma"],[5,7,"il"],[8,15,"signore"],[16,19,"non"],[20,23,"il"],[24,28,"badare"],[30,31,"e"],[32,38,"ripetere"],[39,41,"a"],[42,51,"figliuolo"],[55,65,"domandare"],[66,71,"scusa"]]},{"it":"Ripeti le mie parole.","ja":"","t":[[0,6,"ripetere"],[7,9,"il"],[10,13,"mio"],[14,20,"parola"]]},{"it":"Io ti domando scusa della parola ingiuriosa, insensata, ignobile che dissi contro tuo padre, al quale il mio... si tiene onorato di stringere la mano.","ja":"","t":[[0,2,"io"],[3,5,"ti"],[6,13,"domandare"],[14,19,"scusa"],[20,25,"di"],[26,32,"parola"],[33,43,0],[45,54,0],[56,64,0],[65,68,"che"],[69,74,"dire"],[75,81,"contro"],[82,85,"tuo"],[86,91,"padre"],[93,95,"a"],[96,101,"quale"],[102,104,"il"],[105,108,"mio"],[112,114,"si"],[115,120,"tenere"],[121,128,0],[129,131,"di"],[132,141,"stringere"],[142,144,"il"],[145,149,"mano"]]},{"it":"—","ja":"","t":[]},{"it":"Il carbonaio fece un gesto risoluto, come a dire: Non voglio.","ja":"","t":[[0,2,"il"],[3,12,"carbonaio"],[13,17,"fare"],[18,20,"un"],[21,26,"gesto"],[27,35,"risolvere"],[37,41,"come"],[42,43,"a"],[44,48,"dire"],[50,53,"non"],[54,60,"volere"]]},{"it":"Il signore non gli diè retta, e il suo figliuolo disse lentamente, con un fil di voce, senza alzar gli occhi da terra: — Io ti domando scusa... della parola ingiuriosa... insensata... ignobile, che dissi contro tuo padre, al quale il mio... si tiene onorato di stringer la mano.","ja":"","t":[[0,2,"il"],[3,10,"signore"],[11,14,"non"],[15,18,"il"],[19,22,"dare"],[23,28,"retta"],[30,31,"e"],[32,34,"il"],[35,38,"suo"],[39,48,"figliuolo"],[49,54,"dire"],[55,65,"lentamente"],[67,70,"con"],[71,73,"un"],[74,77,0],[78,80,"di"],[81,85,"voce"],[87,92,"senza"],[93,98,0],[99,102,"il"],[103,108,"occhio"],[109,111,"da"],[112,117,"terra"],[121,123,"io"],[124,126,"ti"],[127,134,"domandare"],[135,140,"scusa"],[144,149,"di"],[150,156,"parola"],[157,167,
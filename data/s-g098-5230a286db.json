n favore di lei.","ja":"","t":[[0,1,"e"],[2,4,"dire"],[5,11,"questo"],[13,22,"seguitare"],[23,24,"a"],[25,29,"dire"],[30,31,"il"],[32,38,"unione"],[40,42,"il"],[43,49,"nostro"],[50,60,"avversario"],[61,64,"che"],[65,73,"volere"],[74,77,"ora"],[78,86,"apparire"],[87,89,"un"],[90,94,"eroe"],[95,98,"di"],[99,111,0],[112,113,"e"],[114,116,"un"],[117,124,0],[125,129,"di"],[130,139,0],[141,145,"avere"],[146,150,"tutto"],[151,156,"altro"],[157,160,"che"],[161,168,"piacere"],[170,171,"e"],[172,176,"anzi"],[177,182,"provare"],[183,188,"tanto"],[189,195,"dolore"],[196,197,"e"],[198,203,"tanto"],[204,210,"rabbia"],[211,214,"che"],[215,223,"licenziare"],[224,226,"su"],[227,230,"due"],[231,236,"piede"],[237,239,"il"],[240,247,0],[248,257,"domestico"],[258,264,0],[265,270,"di"],[271,280,"innocente"],[282,288,"magari"],[289,293,"dopo"],[294,300,"avere"],[301,308,"coperta"],[309,310,"di"],[311,320,0],[321,327,"perché"],[328,331,"tra"],[332,333,"il"],[334,340,"legare"],[341,344,"di"],[345,352,"defunto"],[353,361,0],[362,369,0],[370,372,"ve"],[373,374,0],[375,378,"essere"],[379,382,"un"],[383,385,"Dio"],[386,395,0],[396,400,"lira"],[401,403,"in"],[404,410,"favore"],[411,413,"di"],[414,417,"lei"]]},{"it":"Bisogna convenire che questa era la verità; e io non potevo comprendere come mai il mio cognato, che pure era cosi furbo, avesse potuto dare appiglio ai suoi avversari di dirgli delle cose cosi scottanti mentre era facile prevedere che essi sarebbero stati informati esattamente di tutta la faccenda, pensando che l’incaricato di distribuire ai poveri l’eredità del signor Venanzio era stato proprio il sindaco cioè uno dei capi del partito conservatore e che era stato presente alla lettura del testamento quando l’avvocato Maralli aveva fatto quella famosa scenata che ho detto prima.","ja":"","t":[[0,7,"bisognare"],[8,17,"convenire"],[18,21,"che"],[22,28,"questo"],[29,32,"essere"],[33,35,"il"],[36,42,"verità"],[44,45,"e"],[46,48,"io"],[49,52,"non"],[53,59,"potere"],[60,71,"comprendere"],
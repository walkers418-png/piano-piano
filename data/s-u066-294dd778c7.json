{"id":"u066","title":"Marzo・Mia sorella","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"MIA SORELLA.","ja":"","t":[[0,3,"mio"],[4,11,"sorella"]]},{"it":"24, venerdì.","ja":"","t":[[4,11,"venerdì"]]},{"it":"Perchè, Enrico, dopo che nostro padre t’aveva già rimproverato d’esserti portato male con Coretti, hai fatto ancora quello sgarbo a me?","ja":"","t":[[0,6,"perché"],[8,14,0],[16,20,"dopo"],[21,24,"che"],[25,31,"nostro"],[32,37,"padre"],[38,39,"ti"],[40,45,"avere"],[46,49,"già"],[50,62,"rimproverare"],[63,64,"di"],[65,72,"essere"],[73,80,"portare"],[81,85,"male"],[86,89,"con"],[90,97,0],[99,102,"avere"],[103,108,"fare"],[109,115,"ancora"],[116,122,"quello"],[123,129,"sgarbo"],[130,131,"a"],[132,134,"me"]]},{"it":"Tu non immagini la pena che n’ho provata.","ja":"","t":[[0,2,"tu"],[3,6,"non"],[7,15,"immaginare"],[16,18,"il"],[19,23,"pena"],[24,27,"che"],[28,29,0],[30,32,"avere"],[33,40,"provare"]]},{"it":"Non sai che quand’eri bambino ti stavo per ore e ore accanto alla culla, invece di divertirmi con le mie compagne, e che quand’eri malato scendevo da letto ogni notte per sentire se ti bruciava la fronte?","ja":"","t":[[0,3,"non"],[4,7,"sapere"],[8,11,"che"],[12,17,"quando"],[18,21,"essere"],[22,29,"bambino"],[30,32,"ti"],[33,38,"stare"],[39,42,"per"],[43,46,"ora"],[47,48,"e"],[49,52,"ora"],[53,60,"accanto"],[61,65,"a"],[66,71,"cullare"],[73,79,"invece"],[80,82,"di"],[83,93,"divertire"],[94,97,"con"],[98,100,"il"],[101,104,"mio"],[105,113,"compagna"],[115,116,"e"],[117,120,"che"],[121,126,"quando"],[127,130,"essere"],[131,137,"malato"],[138,146,"scendere"],[147,149,"da"],[150,155,"letto"],[156,160,"ogni"],[161,166,"notte"],[167,170,"per"],[171,178,"sentire"],[179,181,"se"],[182,184,"ti"],[185,193,"bruciare"],[194,196,"il"],[197,203,"fronte"]]},{"it":"Non lo sai, tu che offendi tua sorella, che se una sventura tremenda ci colpisse, ti farei da madre io, e ti vorrei bene come a un figliuolo?","ja":"","t":[[0,3,"non"],[4,6,"il"],[7,10,"sapere"],[12,14,"tu"],[15,18,"che"],[19,26,"offendere"],[27,30,"tuo"],[31,38,"sorella"],[40,43,"che"],[44,46,"se"],[47,50,"un"],[51,59,"sventura"],[60,68,"tremendo"],[69,71,"ci"],[72,80,"colpire"],[82,84,"ti"],[85,90,"fare"],[91,93,"da"],[94,99,"madre"],[100,102,"io"],[104,105,"e"],[106,108,"ti"],[109,115,"volere"],[116,120,"bene"],[121,125,"come"],[126,127,"a"],[128,130,"un"],[131,140,"figliuolo"]]},{"it":"Non sai che quando nostro padre e nostra madre non ci saranno più, sarò io la tua migliore amica, la sola con cui potrai parlare dei nostri morti e della tua infanzia, e che se ci fosse bisogno lavorerei per te, Enrico, per guadagnarti il pane e farti studiare, e che ti amerò sempre quando sarai grande, che ti seguirò col mio pensiero quando andrai lontano, sempre, perchè siamo cresciuti insieme e abbiamo lo stesso sangue?","ja":"","t":[[0,3,"non"],[4,7,"sapere"],[8,11,"che"],[12,18,"quando"],[19,25,"nostro"],[26,31,"padre"],[32,33,"e"],[34,40,"nostro"],[41,46,"madre"],[47,50,"non"],[51,53,"ci"],[54,61,"essere"],[62,65,"più"],[67,71,"essere"],[72,74,"io"],[75,77,"il"],[78,81,"tuo"],[82,90,"migliore"],[91,96,"amica"],[98,100,"il"],[101,105,"solo"],[106,109,"con"],[110,113,"cui"],[114,120,"potere"],[121,128,"parlare"],[129,132,"di"],[133,139,"nostro"],[140,145,"morire"],[146,147,"e"],[148,153,"di"],[154,157,"tuo"],[158,166,"infanzia"],[168,169,"e"],[170,173,"che"],[174,176,"se"],[177,179,"ci"],[180,185,"essere"],[186,193,"bisogno"],[194,203,"lavorare"],[204,207,"per"],[208,210,"te"],[212,218,0],[220,223,"per"],[224,235,"guadagnare"],[236,238,"il"],[239,243,"pane"],[244,245,"e"],[246,251,"fare"],[252,260,"studiare"],[262,263,"e"],[264,267,"che"],[268,270,"ti"],[271,276,"amare"],[277,283,"sempre"],[284,290,"quando"],[291,296,"essere"],[297,303,"grande"],[305,308,"che"],[309,311,"ti"],[312,319,"seguire"],[320,323,"con"],[324,327,"mio"],[328,336,"pensiero"],[337,343,"quando"],[344,350,"andare"],[351,358,"lontano"],[360,366,"sempre"],[368,374,"perché"],[375,380,"essere"],[381,390,"crescere"],[391,398,"insieme"],[399,400,"e"],[401,408,"avere"],[409,411,"il"],[412,418,"stesso"],[419,425,"sangue"]]},{"it":"O Enrico, stanne pur sicuro, quando sarai un uomo, se t’accadrà una disgrazia, se sarai solo, sta pur sicuro che mi cercherai, che verrai da me a dirmi: — Silvia, sorella, lasciami stare con te, parliamo di quando eravamo felici, ti ricordi? parliamo di nostra madre, della nostra casa, di quei bei giorni tanto lontani.","ja":"","t":[[0,1,"o"],[2,8,0],[10,16,0],[17,20,"pure"],[21,27,"sicuro"],[29,35,"quando"],[36,41,"essere"],[42,44,"un"],[45,49,"uomo"],[51,53,"se"],[54,55,"ti"],[56,63,"accadere"],[64,67,"un"],[68,77,"disgrazia"],[79,81,"se"],[82,87,"essere"],[88,92,"solo"],[94,97,"stare"],[98,101,"pure"],[102,108,"sicuro"],[109,112,"che"],[113,115,"mi"],[116,125,"cercare"],[127,130,"che"],[131,137,"venire"],[138,140,"da"],[141,143,"me"],[144,145,"a"],[146,151,"dire"],[155,161,0],[163,170,"sorella"],[172,180,"lasciare"],[181,186,"stare"],[187,190,"con"],[191,193,"te"],[195,203,"parlare"],[204,206,"di"],[207,213,"quando"],[214,221,"essere"],[222,228,"felice"],[230,232,"ti"],[233,240,"ricordare"],[242,250,"parlare"],[251,253,"di"],[254,260,"nostro"],[261,266,"madre"],[268,273,"di"],[274,280,"nostro"],[281,285,"casa"],[287,289,"di"],[290,294,"quello"],[295,298,"bello"],[299,305,"giorno"],[306,311,"tanto"],[312,319,"lontano"]]},{"it":"— O Enrico, tu troverai sempre tua sorella con le braccia aperte.","ja":"","t":[[2,3,"o"],[4,10,0],[12,14,"tu"],[15,23,"trovare"],[24,30,"sempre"],[31,34,"tuo"],[35,42,"sorella"],[43,46,"con"],[47,49,"il"],[50,57,"braccio"],[58,64,"aprire"]]},{"it":"Sì, caro Enrico, e perdonami anche il rimprovero che ti faccio ora.","ja":"","t":[[0,2,"sì"],[4,8,"caro"],[9,15,0],[17,18,"e"],[19,28,"perdonare"],[29,34,"anche"],[35,37,"il"],[38,48,"rimproverare"],[49,52,"che"],[53,55,"ti"],[56,62,"fare"],[63,66,"ora"]]},{"it":"Io non mi ricorderò di alcun torto tuo, e se anche tu mi dessi altri dispiaceri, che m’importa?","ja":"","t":[[0,2,"io"],[3,6,"non"],[7,9,"mi"],[10,19,"ricordare"],[20,22,"di"],[23,28,"alcuno"],[29,34,"torto"],[35,38,"tuo"],[40,41,"e"],[42,44,"se"],[45,50,"anche"],[51,53,"tu"],[54,56,"mi"],[57,62,"dare"],[63,68,"altro"],[69,79,0],[81,84,"che"],[85,86,"mi"],[87,94,"importare"]]},{"it":"Tu sarai sempre mio fratello lo stesso, io non mi ricorderò mai d’altro che d’averti tenuto in braccio bambino, d’aver amato padre e madre con te, d’averti visto crescere, d’essere stata per tanti anni la tua più fida compagna.","ja":"","t":[[0,2,"tu"],[3,8,"essere"],[9,15,"sempre"],[16,19,"mio"],[20,28,"fratello"],[29,31,"il"],[32,38,"stesso"],[40,42,"io"],[43,46,"non"],[47,49,"mi"],[50,59,"ricordare"],[60,63,"mai"],[64,65,"di"],[66,71,"altro"],[72,75,"che"],[76,77,"di"],[78,84,"avere"],[85,91,"tenere"],[92,94,"in"],[95,102,"braccio"],[103,110,"bambino"],[112,113,"di"],[114,118,"avere"],[119,124,"amare"],[125,130,"padre"],[131,132,"e"],[133,138,"madre"],[139,142,"con"],[143,145,"te"],[147,148,"di"],[149,155,"avere"],[156,161,"vedere"],[162,170,"crescere"],[172,173,"di"],[174,180,"essere"],[181,186,"essere"],[187,190,"per"],[191,196,"tanto"],[197,201,"anno"],[202,204,"il"],[205,208,"tuo"],[209,212,"più"],[213,217,"fidarsi"],[218,226,"compagna"]]},{"it":"Ma tu scrivimi una buona parola sopra questo stesso quaderno e io ripasserò a leggerla prima di sera.","ja":"","t":[[0,2,"ma"],[3,5,"tu"],[6,14,"scrivere"],[15,18,"un"],[19,24,"buono"],[25,31,"parola"],[32,37,"sopra"],[38,44,"questo"],[45,51,"stesso"],[52,60,"quaderno"],[61,62,"e"],[63,65,"io"],[66,75,"ripassare"],[76,77,"a"],[78,86,"leggere"],[87,92,"prima"],[93,95,"Dio"],[96,100,"sera"]]},{"it":"Intanto, per mostrarti che non sono in collera con te, vedendo che eri stanco, ho copiato per te il racconto mensile Sangue romagnolo, che tu dovevi copiare per il muratorino malato: cercalo nel cassetto di sinistra del tuo tavolino.","ja":"","t":[[0,7,"intanto"],[9,12,"per"],[13,22,"mostrare"],[23,26,"che"],[27,30,"non"]
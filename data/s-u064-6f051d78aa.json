io"],[126,128,"di"],[129,136,"secondo"],[138,144,"rimanere"],[145,152,"stupito"],[153,154,"a"],[155,158,"non"],[159,167,"vedere"],[168,171,"più"],[172,174,"il"],[175,183,"berretto"],[184,186,"di"],[187,192,"pelle"],[193,195,"di"],[196,201,"gatto"],[202,203,"e"],[204,206,"il"],[207,213,"maglia"],[214,219,"colore"],[220,230,0],[232,238,"questo"],[239,244,"volta"],[245,248,"essere"],[249,256,"vestire"],[257,261,"come"],[262,264,"un"],[265,274,0]]},{"it":"In una galleria vidi per un momento Votini, con un gran colletto di trina, poi disparve.","ja":"","t":[[0,2,"in"],[3,6,"un"],[7,15,"galleria"],[16,20,"vedere"],[21,24,"per"],[25,27,"un"],[28,35,"momento"],[36,42,0],[44,47,"con"],[48,50,"un"],[51,55,"grande"],[56,64,0],[65,67,"di"],[68,73,0],[75,78,"poi"],[79,87,0]]},{"it":"C’era in un palchetto del proscenio, pieno di gente, il capitano d’artiglieria, il padre di Robetti, quello delle stampelle, che salvò un bambino dall’omnibus.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,8,"in"],[9,11,"un"],[12,21,0],[22,25,"di"],[26,35,0],[37,42,"pieno"],[43,45,"di"],[46,51,"gente"],[53,55,"il"],[56,64,"capitano"],[65,66,"di"],[67,78,"artiglieria"],[80,82,"il"],[83,88,"padre"],[89,91,"di"],[92,99,0],[101,107,"quello"],[108,113,"di"],[114,123,"stampella"],[125,128,"che"],[129,134,"salvare"],[135,137,"un"],[138,145,"bambino"],[146,150,"da"],[151,158,0]]},{"it":"Allo scoccar delle due la banda sonò, e salirono nello stesso tempo per la scaletta di destra il sindaco, il prefetto, l’assessore, il provveditore, e molti altri signori, tutti vestiti di nero, che s’andarono a sedere sui seggioloni rossi, sul davanti del palcoscenico.","ja":"","t":[[0,4,"a"],[5,12,0],[13,18,"di"],[19,22,"due"],[23,25,"il"],[26,31,"banda"],[32,36,"sonare"],[38,39,"e"],[40,48,"salire"],[49,54,"in"],[55,61,"stesso"],[62,67,"tempo"],[68,71,"per"],[72,74,"il"],[75,83,0],[84,86,"di"],[87,93,"destra"],[94,96,"il"],[97,104,"sindaco"],[106,108,"il"],[109,117,0],[119,120,"il"],[121,130,0],[132,134,"il"],[135,147,0],[149
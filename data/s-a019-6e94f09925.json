"t":[[0,4,"vivere"],[5,7,"il"],[8,14,"nostro"],[15,25,"imperatore"]]},{"it":"Viva l’imperatore di tutte le scimmie!...","ja":"","t":[[0,4,"vivere"],[5,6,"il"],[7,17,"imperatore"],[18,20,"di"],[21,26,"tutto"],[27,29,"il"],[30,37,"scimmia"]]},{"it":"― gridò quella immensa folla, entusiasmandosi e battendo le mani.","ja":"","t":[[2,7,"gridare"],[8,14,"quello"],[15,22,"immenso"],[23,28,"folla"],[30,45,0],[46,47,"e"],[48,56,"battere"],[57,59,"il"],[60,64,"mano"]]},{"it":"Fu portata subito in mezzo alla piazzetta una vecchia seggiola impagliata, che, veduta di dietro somigliava moltissimo a un trono imperiale: e Pipì vi si assise sopra con sussiego e maestà.","ja":"","t":[[0,2,"essere"],[3,10,"portare"],[11,17,"subito"],[18,20,"in"],[21,26,"mezzo"],[27,31,"a"],[32,41,"piazzetta"],[42,45,"un"],[46,53,"vecchio"],[54,62,"seggiola"],[63,73,0],[75,78,"che"],[80,86,"vedere"],[87,89,"di"],[90,96,"dietro"],[97,107,"somigliare"],[108,118,"molto"],[119,120,"a"],[121,123,"un"],[124,129,"trono"],[130,139,"imperiale"],[141,142,"e"],[143,147,0],[148,150,"vi"],[151,153,"si"],[154,160,0],[161,166,"sopra"],[167,170,"con"],[171,179,0],[180,181,"e"],[182,188,"maestà"]]},{"it":"Intanto una numerosa fanfara musicale composta di cento cembali e di cento corni di bove, cominciò a sonare l’inno della incoronazione.","ja":"","t":[[0,7,"intanto"],[8,11,"un"],[12,20,"numeroso"],[21,28,0],[29,37,"musicale"],[38,46,"comporre"],[47,49,"di"],[50,55,"cento"],[56,63,0],[64,65,"e"],[66,68,"dire"],[69,74,"cento"],[75,80,"corno"],[81,83,"di"],[84,88,0],[90,98,"cominciare"],[99,100,"a"],[101,107,"sonare"],[108,109,"il"],[110,114,"inno"],[115,120,"di"],[121,134,0]]},{"it":"Quattro scimmiotti, vestiti da paggi, presentarono al nuovo imperatore un bel vassoio tessuto di giunchi, sul quale vedevasi la corona e lo scettro imperiale.","ja":"","t":[[0,7,"quattro"],[8,18,0],[20,27,"vestito"],[28,30,"da"],[31,36,0],[38,50,"presentare"],[51,53,"a"],[54,59,"nuovo"],[60,70,"imperatore"],[71,73,"un"],[74,77,"bello"],[78,
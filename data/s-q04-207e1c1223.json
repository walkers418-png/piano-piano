{"id":"q04","title":"第4話 仕事","lv":1,"kind":"連載","note":"","lines":[{"it":"Kenta vuole imparare a cucinare in Italia.","ja":"ケンタはイタリアで料理を学びたいと思っています。","t":[[0,5,0],[6,11,"volere"],[12,20,"imparare"],[21,22,"a"],[23,31,"cucinare"],[32,34,"in"],[35,41,0]]},{"it":"Ma non ha molti soldi.","ja":"でも、お金があまりありません。","t":[[0,2,"ma"],[3,6,"non"],[7,9,"avere"],[10,15,"molto"],[16,21,"soldi"]]},{"it":"Oggi parla con Nonna Rita.","ja":"今日、ノンナ・リータと話します。","t":[[0,4,"oggi"],[5,10,"parlare"],[11,14,"con"],[15,20,0],[21,25,0]]},{"it":"«Posso lavorare qui? Posso lavare i piatti.»","ja":"「ここで働けますか？お皿を洗えます」","t":[[1,6,"potere"],[7,15,"lavorare"],[16,19,"qui"],[21,26,"potere"],[27,33,"lavare"],[34,35,"il"],[36,42,"piatto"]]},{"it":"Rita lo guarda per un momento.","ja":"リータはしばらく彼を見つめます。","t":[[0,4,0],[5,7,"il"],[8,14,"guardare"],[15,18,"per"],[19,21,"un"],[22,29,"momento"]]},{"it":"«Sai cucinare?»","ja":"「料理はできるの？」","t":[[1,4,"sapere"],[5,13,"cucinare"]]},{"it":"«No, ma voglio imparare.»","ja":"「いいえ、でも学びたいです」","t":[[1,3,"no"],[5,7,"ma"],[8,14,"volere"],[15,23,"imparare"]]},{"it":"«Bene. Cominci domani alle sei.»","ja":"「いいよ。明日の6時から始めなさい」","t":[[1,5,"bene"],[7,14,"cominciare"],[15,21,"domani"],[22,26,"a"],[27,30,"essere"]]},{"it":"«Alle sei di sera?»","ja":"「夕方の6時ですか？」","t":[[1,5,"a"],[6,9,"essere"],[10,12,"di"],[13,17,"sera"]]},{"it":"«No, ragazzo. Alle sei di mattina!»","ja":"「いや、若いの。朝の6時だよ！」","t":[[1,3,"no"],[5,12,"ragazzo"],[14,18,"a"],[19,22,"essere"],[23,25,"di"],[26,33,"mattina"]]},{"it":"In quel momento entra una ragazza.","ja":"そのとき、若い女性が入ってきます。","t":[[0,2,"in"],[3,7,"quello"],[8,15,"momento"],[16,21,"entrare"],[22,25,"un"],[26,33,"ragazza"]]},{"it":"«Questa è Lucia, mia nipote» dice Rita.","ja":"「こちらはルチア、私の孫だよ」とリータが言います。","t":[[1,7,"questo"],[8,9,"essere"],[10,15,0],[17,20,"mio"],[21,27,"g:nipote"],[29,33,"dire"],[34,38,0]]},{"it":"Lucia guarda Kenta, ma non sorride.","ja":"ルチアはケンタを見ますが、笑いません。","t":[[0,5,0],[6,12,"guardare"],[13,18,0],[20,22,"ma"],[23,26,"non"],[27,34,"g:sorride"]]}],"q":[{"skill":"match","s":"ケンタが働き始める時間は？","o":["朝6時","夕方6時","朝9時"],"why":"Alle sei di mattina!"},{"skill":"match","s":"ルチアは誰？","o":["リータの孫","リータの娘","ケンタの友達"],"why":"mia nipote とあります。"},{"skill":"infer","s":"最後の文からわかるルチアの様子は？","o":["ケンタを歓迎していないようだ","ケンタが大好きだ","とても楽しそうだ"],"why":"笑わないという描写が手がかりです。"}],"g":{"nipote":"孫・おい・めい","sorride":"ほほえむ"},"n":70,"w":["a","avere","bene","cominciare","con","cucinare","di","dire","domani","entrare","essere","guardare","il","imparare","in","lavare","lavorare","ma","mattina","mio","molto","momento","no","non","oggi","parlare","per","piatto","potere","quello","questo","qui","ragazza","ragazzo","sapere","sera","soldi","un","volere"]}
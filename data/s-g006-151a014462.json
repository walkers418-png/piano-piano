{"id":"g006","title":"9 ottobre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Oggi Ada, Luisa e Virginia hanno tormentato tutto il giorno la mamma, perché acconsentisse a dare quella famosa festa da ballo della quale esse chiacchieran tra loro da tanto tempo.","ja":"","t":[[0,4,"oggi"],[5,8,0],[10,15,0],[16,17,"e"],[18,26,0],[27,32,"avere"],[33,43,"tormentare"],[44,49,"tutto"],[50,52,"il"],[53,59,"giorno"],[60,62,"il"],[63,68,"mamma"],[70,76,"perché"],[77,90,"acconsentire"],[91,92,"a"],[93,97,"dare"],[98,104,"quello"],[105,111,"famoso"],[112,117,"festa"],[118,120,"da"],[121,126,"ballo"],[127,132,"di"],[133,138,"quale"],[139,143,0],[144,156,"chiacchierare"],[157,160,"tra"],[161,165,"loro"],[166,168,"da"],[169,174,"tanto"],[175,180,"tempo"]]},{"it":"Prega e riprega, la mamma, ch’è tanto buona, ha finito per contentarle, e la festa è stata fissata per martedì di quest’altra settimana.","ja":"","t":[[0,5,"pregare"],[6,7,"e"],[8,15,0],[17,19,"il"],[20,25,"mamma"],[27,29,"che"],[30,31,"essere"],[32,37,"tanto"],[38,43,"buono"],[45,47,"avere"],[48,54,"finire"],[55,58,"per"],[59,70,0],[72,73,"e"],[74,76,"il"],[77,82,"festa"],[83,84,"essere"],[85,90,"essere"],[91,98,"fissare"],[99,102,"per"],[103,110,"martedì"],[111,113,"di"],[114,119,"questo"],[120,125,"altro"],[126,135,"settimana"]]},{"it":"Il bello è che, discorrendo degli inviti da fare, hanno rammentato, naturalmente, anche tutti quelli ai quali ho portato ieri le fotografie.","ja":"","t":[[0,2,"il"],[3,8,"bello"],[9,10,"essere"],[11,14,"che"],[16,27,"discorrere"],[28,33,"di"],[34,40,"invito"],[41,43,"da"],[44,48,"fare"],[50,55,"avere"],[56,66,"rammentare"],[68,80,"naturalmente"],[82,87,"anche"],[88,93,"tutto"],[94,100,"quello"],[101,103,"a"],[104,109,"quale"],[110,112,"avere"],[113,120,"portare"],[121,125,"ieri"],[126,128,"il"],[129,139,"fotografia"]]},{"it":"Figuriamoci se dopo quei complimenti scritti dalle mie sorelle in fondo ai loro ri
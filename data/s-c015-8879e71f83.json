{"id":"c015","title":"Il soldo bucato","lv":5,"kind":"童話","note":"Luigi Capuana「C'era una volta...」（1882年）の原文です。古い語や綴りがあります。","lines":[{"it":"IL SOLDO BUCATO","ja":"","t":[[0,2,"il"],[3,8,"soldo"],[9,15,0]]},{"it":"C’era una volta una povera donna rimasta vedova con un figliolino al petto.","ja":"","t":[[0,1,"ci"],[2,5,"essere"],[6,9,"un"],[10,15,"volta"],[16,19,"un"],[20,26,"povero"],[27,32,"donna"],[33,40,"rimanere"],[41,47,0],[48,51,"con"],[52,54,"un"],[55,65,0],[66,68,"a"],[69,74,"petto"]]},{"it":"Era di cattiva salute, e con quel bimbo da allattare poteva lavorare pochino.","ja":"","t":[[0,3,"essere"],[4,6,"dire"],[7,14,"cattivo"],[15,21,"salute"],[23,24,"e"],[25,28,"con"],[29,33,"quello"],[34,39,"bimbo"],[40,42,"da"],[43,52,0],[53,59,"potere"],[60,68,"lavorare"],[69,76,0]]},{"it":"Faceva dei piccoli servigi alle vicine, e così lei e la sua creatura non morivano di fame.","ja":"","t":[[0,6,"fare"],[7,10,"di"],[11,18,"piccolo"],[19,26,0],[27,31,"a"],[32,38,"vicino"],[40,41,"e"],[42,46,"così"],[47,50,"lei"],[51,52,"e"],[53,55,"il"],[56,59,"suo"],[60,68,"creatura"],[69,72,"non"],[73,81,"morire"],[82,84,"di"],[85,89,"fame"]]},{"it":"Quel figliolino era bello come il sole; e la sua mamma, ogni mattina, dopo averlo rifasciato, lavato e pettinato, un po’ per buon augurio, un po’ per chiasso, soleva dirgli:","ja":"","t":[[0,4,"quello"],[5,15,0],[16,19,"essere"],[20,25,"bello"],[26,30,"come"],[31,33,"il"],[34,38,"sole"],[40,41,"e"],[42,44,"il"],[45,48,"suo"],[49,54,"mamma"],[56,60,"ogni"],[61,68,"mattina"],[70,74,"dopo"],[75,81,"avere"],[82,92,0],[94,100,"lavare"],[101,102,"e"],[103,112,"pettinare"],[114,116,"un"],[117,119,"poco"],[121,124,"per"],[125,129,"buono"],[130,137,"augurio"],[139,141,"un"],[142,144,"poco"],[146,149,"per"],[150,157,"chiasso"],[159,165,0],[166,172,"dire"]]},{"it":"E ogni volta che lei gli diceva: tu sarai Re, il bimbo accennava di sì colla testina, come se avesse capito.","ja":"","t":[[0,1,"e"],[2,6,"ogni"],[7,12,"volta"],[13,16,"che"],[17,20,"lei"],[21,24,"il"],[25,31,"dire"],[33,35,"tu"],[36,41,"essere"],[42,44,"re"],[46,48,"il"],[49,54,"bimbo"],[55,64,"accennare"],[65,67,"di"],[68,70,"sì"],[71,76,"con"],[77,84,0],[86,90,"come"],[91,93,"se"],[94,100,"avere"],[101,107,"capire"]]},{"it":"Un giorno si trovò a passare proprio il Re, e sentito: Bimbo mio, tu sarai Re, la prese in mala parte, perchè non aveva avuto ancora figliuoli e ne era accorato assai.","ja":"","t":[[0,2,"un"],[3,9,"giorno"],[10,12,"si"],[13,18,"trovare"],[19,20,"a"],[21,28,"passare"],[29,36,"proprio"],[37,39,"il"],[40,42,"re"],[44,45,"e"],[46,53,"sentire"],[55,60,"bimbo"],[61,64,"mio"],[66,68,"tu"],[69,74,"essere"],[75,77,"re"],[79,81,"il"],[82,87,"prendere"],[88,90,"in"],[91,95,0],[96,101,"parte"],[103,109,"perché"],[110,113,"non"],[114,119,"avere"],[120,125,"avere"],[126,132,"ancora"],[133,142,"figliuolo"],[143,144,"e"],[145,147,"ne"],[148,151,"essere"],[152,160,0],[161,166,"assai"]]},{"it":"— Comarina, — le disse — non vi arrischiate più a dire così, o guai a voi!","ja":"","t":[[2,10,0],[14,16,"il"],[17,22,"dire"],[25,28,"non"],[29,31,"vi"],[32,43,0],[44,47,"più"],[48,49,"a"],[50,54,"dire"],[55,59,"così"],[61,62,"o"],[63,67,"guaio"],[68,69,"a"],[70,73,"voi"]]},{"it":"—","ja":"","t":[]},{"it":"La povera donna, dalla paura, non disse più nulla.","ja":"","t":[[0,2,"il"],[3,9,"povero"],[10,15,"donna"],[17,22,"da"],[23,28,"paura"],[30,33,"non"],[34,39,"dire"],[40,43,"più"],[44,49,"nulla"]]},{"it":"Però quel figliolino, ora che la sua mamma stava zitta, ogni mattina, appena rifasciato, lavato e pettinato, si metteva a piangere e strillare.","ja":"","t":[[0,4,"però"],[5,9,"quello"],[10,20,0],[22,25,"ora"],[26,29,"che"],[30,32,"il"],[33,36,"suo"],[37,42,"mamma"],[43,48,"stare"],[49,54,"zitto"],[56,60,"ogni"],[61,68,"mattina"],[70,76,"appena"],[77,87,0],[89,95,"lavare"],[96,97,"e"],[98,107,"pettinare"],[109,111,"si"],[112,119,"mettere"],[120,121,"a"],[122,130,"piangere"],[131,132,"e"],[133,142,"strillare"]]},{"it":"Lei gli ripeteva:","ja":"","t"
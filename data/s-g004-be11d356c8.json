9,92,"per"],[93,102,0]]},{"it":"Che chiasso!","ja":"","t":[[0,3,"che"],[4,11,"chiasso"]]},{"it":"- Il mio vestito di batista rosa! - ha urlato Luisa, facendosi smorta in viso dalla stizza.","ja":"","t":[[2,4,"il"],[5,8,"mio"],[9,16,"vestito"],[17,19,"di"],[20,27,0],[28,32,"rosa"],[36,38,"avere"],[39,45,"urlare"],[46,51,0],[53,62,"fare"],[63,69,"smorto"],[70,72,"in"],[73,77,"viso"],[78,83,"da"],[84,90,"stizza"]]},{"it":"La signorina Bice mi ha preso per un braccio rivolgendomi alla luce, e: - Come mai ti sono venute quelle belle gote rosse, eh, Giannino? - mi ha detto in aria di canzonatura.","ja":"","t":[[0,2,"il"],[3,12,"signorina"],[13,17,0],[18,20,"mi"],[21,23,"avere"],[24,29,"prendere"],[30,33,"per"],[34,36,"un"],[37,44,"braccio"],[45,57,"rivolgere"],[58,62,"a"],[63,67,"luce"],[69,70,"e"],[74,78,"come"],[79,82,"mai"],[83,85,"ti"],[86,90,"essere"],[91,97,"venire"],[98,104,"quello"],[105,110,"bello"],[111,115,"gota"],[116,121,"rosso"],[123,125,0],[127,135,0],[139,141,"mi"],[142,144,"avere"],[145,150,"dire"],[151,153,"in"],[154,158,"aria"],[159,161,"di"],[162,173,0]]},{"it":"Luisa mi ha fatto cenno che non parlassi; ma io, facendo finta di non vederla, ho risposto: - Ho trovato una pomata in una cassetta... - E quella signorina ha cominciato a ridere in un modo così malizioso, che non so quello che le avrei fatto.","ja":"","t":[[0,5,0],[6,8,"mi"],[9,11,"avere"],[12,17,"fare"],[18,23,"cenno"],[24,27,"che"],[28,31,"non"],[32,40,"parlare"],[42,44,"ma"],[45,47,"io"],[49,56,"fare"],[57,62,"finta"],[63,65,"di"],[66,69,"non"],[70,77,"vedere"],[79,81,"avere"],[82,90,"rispondere"],[94,96,"avere"],[97,104,"trovare"],[105,108,"un"],[109,115,0],[116,118,"in"],[119,122,"un"],[123,131,"cassetta"],[137,138,"e"],[139,145,"quello"],[146,155,"signorina"],[156,158,"avere"],[159,169,"cominciare"],[170,171,"a"],[172,178,"ridere"],[179,181,"in"],[182,184,"un"],[185,189,"modo"],[190,194,"così"],[195,204,0],[206,209,"che"],[210,213,"non"],[214,216,"sapere"],[217,223,"quello"],[224,227,"che"],[228,230,"il"],[231,236,"avere"],[237,242,"fare"]]},{"it":"Mia sorella, dopo, ha detto che Bice Rossi è una pettegola, che non le parrà vero di andare a raccontare a tutti che mia sorella si tinge la faccia: e questo poi non è vero, e io lo potrei giurare, perché quella pasta serve a colorire i fiori di seta che Luisa sa fare tanto bene per guarnire i cappelli.","ja":"","t":[[0,3,"mio"],[4,11,"sorella"],[13,17,"dopo"],[19,21,"avere"],[22,27,"dire"],[28,31,"che"],[32,36,0],[37,42,"rosso"],[43,44,"essere"],[45,48,"un"],[49,58,0],[60,63,"che"],[64,67,"non"],[68,70,"il"],[71,76,"parere"],[77,81,"vero"],[82,84,"di"],[85,91,"andare"],[92,93,"a"],[94,104,"raccontare"],[105,106,"a"],[107,112,"tutto"],[113,116,"che"],[117,120,"mio"],[121,128,"sorella"],[129,131,"si"],[132,137,"tingere"],[138,140,"il"],[141,147,"fare"],[149,150,"e"],[151,157,"questo"],[158,161,"poi"],[162,165,"non"],[166,167,"essere"],[168,172,"vero"],[174,175,"e"],[176,178,"io"],[179,181,"il"],[182,188,"potere"],[189,196,"giurare"],[198,204,"perché"],[205,211,"quello"],[212,217,"pasta"],[218,223,"servire"],[224,225,"a"],[226,234,"colorire"],[235,236,"il"],[237,242,"fiore"],[243,245,"di"],[246,250,"seta"],[251,254,"che"],[255,260,0],[261,263,"sapere"],[264,268,"fare"],[269,274,"tanto"],[275,279,"bene"],[280,283,"per"],[284,292,0],[293,294,"il"],[295,303,"cappello"]]},{"it":"Stavo per ritornare in camera alla svelta, allorché mi sono fermato davanti a Luisa e, guardandola fissa, le ho strappato una gala in fondo al vestito.","ja":"","t":[[0,5,"stare"],[6,9,"per"],[10,19,"ritornare"],[20,22,"in"],[23,29,"camera"],[30,34,"a"],[35,41,"svelto"],[43,51,0],[52,54,"mi"],[55,59,"essere"],[60,67,"fermare"],[68,75,"davanti"],[76,77,"a"],[78,83,0],[84,85,"e"],[87,98,"guardare"],[99,104,"fisso"],[106,108,"il"],[109,111,"avere"],[112,121,"strappare"],[122,125,"un"],[126,130,"gala"],[131,133,"in"],[134,139,"fondo"],[140,142,"a"],[143,150,"vestito"]]},{"it":"Non l’avessi mai fatto!...","ja":"","t":[[0,3,"non"],[4,5,"il"],[6,12,"avere"],[13,16,"mai"],[17,22,"fare"]]},{"it":"È diventata una furia, e mi ha dato uno schiaffo...","ja":"","t":[[0,1,"essere"],[2,11,"diventare"],[12,15,"un"],[16,21,"furia"],[23,24,"e"],[25,27,"mi"],[28,30,"avere"],[31,35,"dare"],[36,39,"un"],[40,48,0]]},{"it":"«Ah, signorina!...» ho detto fra me e me.","ja":"","t":[[1,3,"ah"],[5,14,"signorina"],[20,22,"avere"],[23,28,"dire"],[29,32,"fra"],[33,35,"me"],[36,37,"e"],[38,40,"me"]]},{"it":"«Se sapesse che le ho preso i ritratti!».","ja":"","t":[[1,3,"se"],[4,11,"sapere"],[12,15,"che"],[16,18,"il"],[19,21,"avere"],[22,27,"prendere"],[28,29,"il"],[30,38,"ritratto"]]},{"it":"Le sorelle credono che le gote dei ragazzi sieno fatte apposta per essere schiaffeggiate...","ja":"","t":[[0,2,"il"],[3,10,"sorella"],[11,18,"credere"],[19,22,"che"],[23,25,"il"],[26,30,"gota"],[31,34,"di"],[35,42,"ragazzo"],[43,48,0],[49,54,"fare"],[55,62,"apposta"],[63,66,"per"],[67,73,"essere"],[74,88,0]]},{"it":"Se sapessero, invece, i pensieri tetri e disperati che ci vengono in mente quando fanno così!...","ja":"","t":[[0,2,"se"],[3,12,"sapere"],[14,20,"invece"],[22,23,"il"],[24,32,"pensiero"],[33,38,0],[39,40,"e"],[41,50,"disperare"],[51,54,"che"],[55,57,"ci"],[58,65,"venire"],[66,68,"in"],[69,74,"mentire"],[75,81,"quando"],[82,87,"fare"],[88,92,"così"]]},{"it":"Sono stato zitto, ma... a domani.","ja":"","t":[[0,4,"essere"],[5,10,"essere"],[11,16,"zitto"],[18,20,"ma"],[24,25,"a"],[26,32,"domani"]]}],"q":[],"g":{},"n":594,"w":["Dio","a","accorgersi","acqua","ah","altro","alzare","amica","andare","annoiare","appena","apposta","aria","armadio","arrivare","avere","bello","bene","bianco","bicchiere","bocca","braccio","busto","buttare","camera","cappello","carino","casa","cassetta","cenno","cercare","che","chiasso","chiedere","ci","circa","ciuco","colmo","colore","colorire","come","cominciare","con","conoscere","contentezza","coperta","cosa","così","credere","da","dare","davanti","davvero","dentro","di","dire","disordine","disperare","diventa
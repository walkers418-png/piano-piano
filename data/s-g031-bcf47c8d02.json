are"],[78,82,"quello"],[83,86,"bello"],[87,93,"giocare"],[95,99,"come"],[100,102,"ti"],[103,107,"fare"],[108,114,"vedere"],[115,119,"ieri"],[120,122,"in"],[123,127,"quello"],[128,131,"bello"],[132,137,"libro"],[138,140,"di"],[141,147,"figura"]]},{"it":"Io sarò il signore e tu lo schiavo che io abbandono nel bosco...","ja":"","t":[[0,2,"io"],[3,7,"essere"],[8,10,"il"],[11,18,"signore"],[19,20,"e"],[21,23,"tu"],[24,26,"il"],[27,34,"schiavo"],[35,38,"che"],[39,41,"io"],[42,51,"abbandonare"],[52,55,"in"],[56,61,"bosco"]]},{"it":"- Sì!","ja":"","t":[[2,4,"sì"]]},{"it":"Sì! - ha risposto subito.","ja":"","t":[[0,2,"sì"],[6,8,"avere"],[9,17,"rispondere"],[18,24,"subito"]]},{"it":"La mamma, con le mie sorelle e la signora Merope non erano ancora tornate; Caterina era a preparare da mangiare in cucina: e io ho condotto Maria in camera mia, le ho levato il vestitino bianco, e le ho messo il mio di panno turchino, perché sembrasse proprio un ragazzo.","ja":"","t":[[0,2,"il"],[3,8,"mamma"],[10,13,"con"],[14,16,"il"],[17,20,"mio"],[21,28,"sorella"],[29,30,"e"],[31,33,"il"],[34,41,"signora"],[42,48,0],[49,52,"non"],[53,58,"essere"],[59,65,"ancora"],[66,73,"tornare"],[75,83,0],[84,87,"essere"],[88,89,"a"],[90,99,"preparare"],[100,102,"da"],[103,111,"mangiare"],[112,114,"in"],[115,121,"cucina"],[123,124,"e"],[125,127,"io"],[128,130,"avere"],[131,139,"condurre"],[140,145,0],[146,148,"in"],[149,155,"camera"],[156,159,"mio"],[161,163,"il"],[164,166,"avere"],[167,173,"levare"],[174,176,"il"],[177,186,"vestitino"],[187,193,"bianco"],[195,196,"e"],[197,199,"il"],[200,202,"avere"],[203,208,"mettere"],[209,211,"il"],[212,215,"mio"],[216,218,"Dio"],[219,224,"panno"],[225,233,0],[235,241,"perché"],[242,251,"sembrare"],[252,259,"proprio"],[260,262,"un"],[263,270,"ragazzo"]]},{"it":"Poi ho preso la mia scatola di colori e le ho tinto la faccia da mulatto, ho preso un paio di forbici e siamo scesi giù nel giardino, dove ho ordinato allo schiavo che mi venisse dietro.","ja":"","t":[[0,3,"poi"],[
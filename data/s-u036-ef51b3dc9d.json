are"],[44,54,"imprestare"],[55,56,"il"],[57,62,"libro"],[63,66,"per"],[67,75,"studiare"],[76,78,"il"],[79,86,"lezione"],[88,90,"si"],[91,100,0],[101,102,"il"],[103,112,0],[113,118,"di"],[119,126,"camicia"],[127,130,"con"],[131,136,"di"],[137,143,"spillo"],[145,147,"e"],[148,149,"essere"],[150,153,"un"],[154,159,"pietà"],[160,161,"a"],[162,169,"vedere"],[170,173,"fare"],[174,176,"il"],[177,187,"ginnastica"],[188,191,"con"],[192,198,"quello"],[199,207,0],[208,211,"che"],[212,214,"ci"],[215,222,0],[223,229,"dentro"],[231,234,"con"],[235,239,"quello"],[240,247,"calzoni"],[248,251,"che"],[252,263,"strascicare"],[265,266,"e"],[267,271,"quello"],[272,284,0],[285,291,"troppo"],[292,297,"lungo"],[299,302,"con"],[303,305,"il"],[306,313,"manica"],[314,324,0],[325,329,"sino"],[330,332,"a"],[333,339,"gomito"]]},{"it":"E studia, s’impegna; sarebbe uno dei primi se potesse lavorare a casa tranquillo.","ja":"","t":[[0,1,"e"],[2,8,"studiare"],[10,11,"si"],[12,19,"impegnare"],[21,28,"essere"],[29,32,"un"],[33,36,"di"],[37,42,"primo"],[43,45,"se"],[46,53,"potere"],[54,62,"lavorare"],[63,64,"a"],[65,69,"casa"],[70,80,"tranquillo"]]},{"it":"Questa mattina è venuto alla scuola col segno d’un’unghiata sopra una gota, e tutti a dirgli: — È stato tuo padre, non lo puoi negare sta volta, è tuo padre che t’ha fatto quello.","ja":"","t":[[0,6,"questo"],[7,14,"mattina"],[15,16,"essere"],[17,23,"venire"],[24,28,"a"],[29,35,"scuola"],[36,39,"con"],[40,45,"segno"],[46,47,"di"],[48,50,"un"],[51,59,0],[60,65,"sopra"],[66,69,"un"],[70,74,"gota"],[76,77,"e"],[78,83,"tutto"],[84,85,"a"],[86,92,"dire"],[96,97,"essere"],[98,103,"essere"],[104,107,"tuo"],[108,113,"padre"],[115,118,"non"],[119,121,"il"],[122,126,"potere"],[127,133,"negare"],[134,137,"stare"],[138,143,"volta"],[145,146,"essere"],[147,150,"tuo"],[151,156,"padre"],[157,160,"che"],[161,162,"ti"],[163,165,"avere"],[166,171,"fare"],[172,178,"quello"]]},{"it":"Dillo al Direttore, che lo faccia chiamare in questura.","ja":"","t":[[0,5,0],[6,8,"a"]
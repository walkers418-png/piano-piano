],[34,37,"in"],[38,43,"bosco"],[45,53,"cominciare"],[54,55,"a"],[56,63,"correre"],[64,68,"come"],[69,71,"un"],[72,80,0]]},{"it":"Ma quando fu arrivato a un certo punto, quasi in faccia alla Quercia grande, si fermò, perchè gli parve di aver sentito gente fra mezzo alle frasche.","ja":"","t":[[0,2,"ma"],[3,9,"quando"],[10,12,"essere"],[13,21,"arrivare"],[22,23,"a"],[24,26,"un"],[27,32,"certo"],[33,38,"punto"],[40,45,"quasi"],[46,48,"in"],[49,55,"fare"],[56,60,"a"],[61,68,"quercia"],[69,75,"grande"],[77,79,"si"],[80,85,"fermare"],[87,93,"perché"],[94,97,"il"],[98,103,"parere"],[104,106,"di"],[107,111,"avere"],[112,119,"sentire"],[120,125,"gente"],[126,129,"fra"],[130,135,"mezzo"],[136,140,"a"],[141,148,0]]},{"it":"Difatti vide apparire sulla strada, indovinate chi?… la Volpe e il Gatto, ossia i due compagni di viaggio, coi quali aveva cenato all’osteria del Gambero Rosso.","ja":"","t":[[0,7,"difatti"],[8,12,"vedere"],[13,21,"apparire"],[22,27,"su"],[28,34,"strada"],[36,46,"indovinare"],[47,50,"chi"],[53,55,"il"],[56,61,"volpe"],[62,63,"e"],[64,66,"il"],[67,72,"gatto"],[74,79,"ossia"],[80,81,"il"],[82,85,"due"],[86,94,"compagno"],[95,97,"di"],[98,105,"viaggio"],[107,110,"con"],[111,116,"quale"],[117,122,"avere"],[123,129,"cenare"],[130,133,"a"],[134,141,"osteria"],[142,145,"di"],[146,153,"gambero"],[154,159,"rosso"]]},{"it":"— Ecco il nostro caro Pinocchio!","ja":"","t":[[2,6,"ecco"],[7,9,"il"],[10,16,"nostro"],[17,21,"caro"],[22,31,0]]},{"it":"— gridò la Volpe, abbracciandolo e baciandolo.","ja":"","t":[[2,7,"gridare"],[8,10,"il"],[11,16,"volpe"],[18,32,"abbracciare"],[33,34,"e"],[35,45,"baciare"]]},{"it":"— Come mai sei qui?","ja":"","t":[[2,6,"come"],[7,10,"mai"],[11,14,"essere"],[15,18,"qui"]]},{"it":"— Come mai sei qui?","ja":"","t":[[2,6,"come"],[7,10,"mai"],[11,14,"essere"],[15,18,"qui"]]},{"it":"— ripetè il Gatto.","ja":"","t":[[2,8,"ripetere"],[9,11,"il"],[12,17,"gatto"]]},{"it":"― È una storia lunga — disse il burattino — e ve la racconterò a comodo.","ja":""
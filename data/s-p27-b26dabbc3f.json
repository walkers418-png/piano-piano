o"],[238,244,"lavare"],[246,247,"e"],[248,251,"non"],[252,257,"dire"],[258,263,"altro"],[264,267,"che"],[268,274,"questo"],[275,281,"parola"]]},{"it":"— O mamma mia,… aiutatemi perchè muoio!…","ja":"","t":[[2,3,"o"],[4,9,"mamma"],[10,13,"mio"],[16,25,"aiutare"],[26,32,"perché"],[33,38,"morire"]]},{"it":"— Poi cadde disteso sulla rena del lido.","ja":"","t":[[2,5,"poi"],[6,11,"cadere"],[12,19,"disteso"],[20,25,"su"],[26,30,0],[31,34,"di"],[35,39,0]]},{"it":"Alla vista di quel morticino, i ragazzi spaventati si dettero a scappare a gambe, e in pochi minuti non si videro più.","ja":"","t":[[0,4,"a"],[5,10,"vista"],[11,13,"di"],[14,18,"quello"],[19,28,0],[30,31,"il"],[32,39,"ragazzo"],[40,50,"spaventato"],[51,53,"si"],[54,61,"dare"],[62,63,"a"],[64,72,"scappare"],[73,74,"a"],[75,80,"gamba"],[82,83,"e"],[84,86,"in"],[87,92,"poco"],[93,99,"minuto"],[100,103,"non"],[104,106,"si"],[107,113,"vedere"],[114,117,"più"]]},{"it":"Ma Pinocchio rimase lì; e sebbene per il dolore e per lo spavento, anche lui fosse più morto che vivo, nondimeno corse ad inzuppare il suo fazzoletto nell’acqua del mare, e si pose a bagnare la tempia del suo povero compagno di scuola.","ja":"","t":[[0,2,"ma"],[3,12,0],[13,19,"rimanere"],[20,22,"lì"],[24,25,"e"],[26,33,"sebbene"],[34,37,"per"],[38,40,"il"],[41,47,"dolore"],[48,49,"e"],[50,53,"per"],[54,56,"il"],[57,65,"spavento"],[67,72,"anche"],[73,76,"lui"],[77,82,"essere"],[83,86,"più"],[87,92,"morto"],[93,96,"che"],[97,101,"vivere"],[103,112,"nondimeno"],[113,118,"correre"],[119,121,"a"],[122,131,"inzuppare"],[132,134,"il"],[135,138,"suo"],[139,149,"fazzoletto"],[150,154,"in"],[155,160,"acqua"],[161,164,"di"],[165,169,"mare"],[171,172,"e"],[173,175,"si"],[176,180,"porre"],[181,182,"a"],[183,190,"bagnare"],[191,193,"il"],[194,200,"tempia"],[201,204,"di"],[205,208,"suo"],[209,215,"povero"],[216,224,"compagno"],[225,227,"di"],[228,234,"scuola"]]},{"it":"E intanto, piangendo dirottamente e disperandosi, lo chiamava per nome e gli diceva:","ja":"","t":[[0
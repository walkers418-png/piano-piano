{"id":"u099","title":"Luglio・L'ultimo esame","lv":6,"kind":"名作","note":"Edmondo De Amicis「Cuore」（1886年）の原文です。古い語や当時の価値観が含まれます。","lines":[{"it":"L'ULTIMO ESAME","ja":"","t":[[0,1,"il"],[2,8,"ultimo"],[9,14,"esame"]]},{"it":"7, venerdì","ja":"","t":[[3,10,"venerdì"]]},{"it":"Questa mattina ci diedero gli esami verbali.","ja":"","t":[[0,6,"questo"],[7,14,"mattina"],[15,17,"ci"],[18,25,"dare"],[26,29,"il"],[30,35,"esame"],[36,43,0]]},{"it":"Alle otto eravamo tutti in classe, e alle otto e un quarto cominciarono a chiamarci quattro alla volta nel camerone, dove c’era un gran tavolo coperto d’un tappeto verde, e intorno il Direttore e quattro maestri, fra i quali il nostro.","ja":"","t":[[0,4,"a"],[5,9,"otto"],[10,17,"essere"],[18,23,"tutto"],[24,26,"in"],[27,33,"classe"],[35,36,"e"],[37,41,"a"],[42,46,"otto"],[47,48,"e"],[49,51,"un"],[52,58,"quarto"],[59,71,"cominciare"],[72,73,"a"],[74,83,"chiamare"],[84,91,"quattro"],[92,96,"a"],[97,102,"volta"],[103,106,"in"],[107,115,0],[117,121,"dove"],[122,123,"ci"],[124,127,"essere"],[128,130,"un"],[131,135,"grande"],[136,142,"tavolo"],[143,150,"coprire"],[151,152,"di"],[153,155,"un"],[156,163,"tappeto"],[164,169,"verde"],[171,172,"e"],[173,180,"intorno"],[181,183,"il"],[184,193,"direttore"],[194,195,"e"],[196,203,"quattro"],[204,211,"maestro"],[213,216,"fra"],[217,218,"il"],[219,224,"quale"],[225,227,"il"],[228,234,"nostro"]]},{"it":"Io fui uno dei primi chiamati.","ja":"","t":[[0,2,"io"],[3,6,"essere"],[7,10,"un"],[11,14,"di"],[15,20,"primo"],[21,29,"chiamare"]]},{"it":"Povero maestro!","ja":"","t":[[0,6,"povero"],[7,14,"maestro"]]},{"it":"Come m’accorsi che ci vuol bene davvero, questa mattina.","ja":"","t":[[0,4,"come"],[5,6,"mi"],[7,14,"accorgersi"],[15,18,"che"],[19,21,"ci"],[22,26,"volere"],[27,31,"bene"],[32,39,"davvero"],[41,47,"questo"],[48,55,"mattina"]]},{"it":"Mentre c’interrogavano gli altri, egli non aveva occhi che per noi; si turbava quando eravamo incerti a rispondere, si rasserenava quando davamo una bella rispo
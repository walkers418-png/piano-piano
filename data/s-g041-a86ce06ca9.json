{"id":"g041","title":"6 dicembre","lv":7,"kind":"日記","note":"Vamba「Il giornalino di Gian Burrasca」（1912年）の原文です。いたずら好きの少年の日記で、当時の綴りや言い回しが含まれます。","lines":[{"it":"Scrivo dopo aver divorato tutte le mie lacrime.","ja":"","t":[[0,6,"scrivere"],[7,11,"dopo"],[12,16,"avere"],[17,25,"divorare"],[26,31,"tutto"],[32,34,"il"],[35,38,"mio"],[39,46,"lacrima"]]},{"it":"Proprio così; perché ho finito in questo momento di mangiare una scodella di minestra piangendovi dentro per la rabbia di doverla mangiare.","ja":"","t":[[0,7,"proprio"],[8,12,"così"],[14,20,"perché"],[21,23,"avere"],[24,30,"finire"],[31,33,"in"],[34,40,"questo"],[41,48,"momento"],[49,51,"di"],[52,60,"mangiare"],[61,64,"un"],[65,73,0],[74,76,"di"],[77,85,"minestra"],[86,97,"piangere"],[98,104,"dentro"],[105,108,"per"],[109,111,"il"],[112,118,"rabbia"],[119,121,"di"],[122,129,"dovere"],[130,138,"mangiare"]]},{"it":"Il babbo ieri ha decretato che la mia punizione per l’affare del fantoccio di Virginia e per l’altra sciocchezza dei versi contro il professor Muscolo debba consistere nel darmi da mangiare per sei giorni consecutivi sempre minestra, niente altro che minestra.","ja":"","t":[[0,2,"il"],[3,8,"babbo"],[9,13,"ieri"],[14,16,"avere"],[17,26,0],[27,30,"che"],[31,33,"il"],[34,37,"mio"],[38,47,"punizione"],[48,51,"per"],[52,53,"il"],[54,60,"affare"],[61,64,"di"],[65,74,"fantoccio"],[75,77,"di"],[78,86,0],[87,88,"e"],[89,92,"per"],[93,94,"il"],[95,100,"altro"],[101,112,"sciocchezza"],[113,116,"di"],[117,122,"versare"],[123,129,"contro"],[130,132,"il"],[133,142,0],[143,150,"muscolo"],[151,156,"dovere"],[157,167,"consistere"],[168,171,"in"],[172,177,"dare"],[178,180,"da"],[181,189,"mangiare"],[190,193,"per"],[194,197,"essere"],[198,204,"giorno"],[205,216,0],[217,223,"sempre"],[224,232,"minestra"],[234,240,"niente"],[241,246,"altro"],[247,250,"che"],[251,259,"minestra"]]},{"it":"E questo, si capisce, perché sanno che io le minestre non le posso soffrire...","ja":"","t":[[0,1,"e"],[2,8,"questo"],[10,12,"si"],[13,20,"capire"],[22,28,"perché"],[29,34,"sapere"],[35,38,"che"],[39,41,"io"],[42,44,"il"],[45,53,"minestra"],[54,57,"non"],[58,60,"il"],[61,66,"potere"],[67,75,"soffrire"]]},{"it":"Se per combinazione la minestra mi piacesse, si può esser sicuri che mi avrebbero tenuto sei giorni senza minestra...","ja":"","t":[[0,2,"se"],[3,6,"per"],[7,19,"combinazione"],[20,22,"il"],[23,31,"minestra"],[32,34,"mi"],[35,43,"piacere"],[45,47,"si"],[48,51,"potere"],[52,57,"essere"],[58,64,"sicuro"],[65,68,"che"],[69,71,"mi"],[72,81,"avere"],[82,88,"tenere"],[89,92,"essere"],[93,99,"giorno"],[100,105,"senza"],[106,114,"minestra"]]},{"it":"E poi dicono che son dispettosi i ragazzi!...","ja":"","t":[[0,1,"e"],[2,5,"poi"],[6,12,"dire"],[13,16,"che"],[17,20,"essere"],[21,31,0],[32,33,"il"],[34,41,"ragazzo"]]},{"it":"Il fatto è che ho resistito tutto il giorno rifiutandomi di mangiare, deciso a morir di fame piuttosto che sottostare a una prepotenza così feroce.","ja":"","t":[[0,2,"il"],[3,8,"fare"],[9,10,"essere"],[11,14,"che"],[15,17,"avere"],[18,27,"resistere"],[28,33,"tutto"],[34,36,"il"],[37,43,"giorno"],[44,56,"rifiutare"],[57,59,"di"],[60,68,"mangiare"],[70,76,"decidere"],[77,78,"a"],[79,84,"morire"],[85,87,"di"],[88,92,"fame"],[93,102,"piuttosto"],[103,106,"che"],[107,117,0],[118,119,"a"],[120,123,"un"],[124,134,"prepotenza"],[135,139,"così"],[140,146,"feroce"]]},{"it":"Ma purtroppo stasera non ne potevo più e... ho dovuto piegarmi alla necessità, piangendo amaramente sul mio infelice destino e sulla minestra di capellini che ho terminata in questo momento.","ja":"","t":[[0,2,"ma"],[3,12,"purtroppo"],[13,20,"stasera"],[21,24,"non"],[25,27,"ne"],[28,34,"potere"],[35,38,"più"],[39,40,"e"],[44,46,"avere"],[47,53,"dovere"],[54,62,"piegare"],[63,67,"a"],[68,77,"necessità"],[79,88,"piangere"],[89,99,0],[100,103,"su"],[104,107,"mio"],[108,116,"infelice"],[117,124,"destino"],[125,126,"e"],[127,132,"su"],[133,141,"minestra"],[142,144,"di"],[145,154,"capellino"],[155,158,"che"],[159,161,"avere"],[162,
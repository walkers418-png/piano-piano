"],[45,50,"buono"],[51,56,"mamma"],[58,61,"il"],[62,66,"porre"],[67,69,"in"],[70,75,"bocca"],[76,78,"un"],[79,84,"altro"],[85,87,"poco"],[89,91,"di"],[92,100,"zucchero"],[102,103,"e"],[104,108,"dopo"],[109,112,"il"],[113,121,"presentare"],[122,129,"daccapo"],[130,132,"il"],[133,142,"bicchiere"]]},{"it":"— Così non lo posso bere!","ja":"","t":[[2,6,"così"],[7,10,"non"],[11,13,"il"],[14,19,"potere"],[20,24,"bere"]]},{"it":"— disse il burattino, facendo mille smorfie.","ja":"","t":[[2,7,"dire"],[8,10,"il"],[11,20,"burattino"],[22,29,"fare"],[30,35,"mille"],[36,43,"smorfia"]]},{"it":"— Perchè?","ja":"","t":[[2,8,"perché"]]},{"it":"— Perchè mi dà noia quel guanciale che ho laggiù sui piedi.","ja":"","t":[[2,8,"perché"],[9,11,"mi"],[12,14,"dare"],[15,19,"noia"],[20,24,"quello"],[25,34,"guanciale"],[35,38,"che"],[39,41,"avere"],[42,48,"laggiù"],[49,52,"su"],[53,58,"piede"]]},{"it":"—","ja":"","t":[]},{"it":"La Fata gli levò il guanciale.","ja":"","t":[[0,2,"il"],[3,7,"fata"],[8,11,"il"],[12,16,"levare"],[17,19,"il"],[20,29,"guanciale"]]},{"it":"— È inutile!","ja":"","t":[[2,3,"essere"],[4,11,"inutile"]]},{"it":"Nemmeno così la posso bere…","ja":"","t":[[0,7,"nemmeno"],[8,12,"così"],[13,15,"il"],[16,21,"potere"],[22,26,"bere"]]},{"it":"— Che cos’altro ti dà noia?","ja":"","t":[[2,5,"che"],[6,9,"cosa"],[10,15,"altro"],[16,18,"ti"],[19,21,"dare"],[22,26,"noia"]]},{"it":"— Mi dà noia l’uscio di camera, che è mezzo aperto.","ja":"","t":[[2,4,"mi"],[5,7,"dare"],[8,12,"noia"],[13,14,"il"],[15,20,"uscio"],[21,23,"di"],[24,30,"camera"],[32,35,"che"],[36,37,"essere"],[38,43,"mezzo"],[44,50,"aperto"]]},{"it":"La Fata andò, e chiuse l’uscio di camera.","ja":"","t":[[0,2,"il"],[3,7,"fata"],[8,12,"andare"],[14,15,"e"],[16,22,"chiudere"],[23,24,"il"],[25,30,"uscio"],[31,33,"di"],[34,40,"camera"]]},{"it":"— Insomma, — gridò Pinocchio dando in uno scoppio di pianto — quest’acquaccia amara, non la voglio bere, no, no, no!…","ja":"","t":[[2,9,"insomma"],[13,18,"gridare"],[19,28,0],[29,34,"dare"],[35,37,"in"],[38,41,"un"],[42,49,"scoppiare"],[50,52,"di"],[53,59,"pianto"],[62,67,"questo"],[68,77,0],[78,83,"amaro"],[85,88,"non"],[89,91,"il"],[92,98,"volere"],[99,103,"bere"],[105,107,"no"],[109,111,"no"],[113,115,"no"]]},{"it":"— Ragazzo mio, te ne pentirai…","ja":"","t":[[2,9,"ragazzo"],[10,13,"mio"],[15,17,"te"],[18,20,"ne"],[21,29,"pentirsi"]]},{"it":"— Non me n’importa…","ja":"","t":[[2,5,"non"],[6,8,"me"],[9,10,0],[11,18,"importare"]]},{"it":"— La tua malattia è grave.","ja":"","t":[[2,4,"il"],[5,8,"tuo"],[9,17,"malattia"],[18,19,"essere"],[20,25,"grave"]]},{"it":"— Non me n’importa…","ja":"","t":[[2,5,"non"],[6,8,"me"],[9,10,0],[11,18,"importare"]]},{"it":"— La febbre ti porterà in poche ore all’altro mondo…","ja":"","t":[[2,4,"il"],[5,11,"febbre"],[12,14,"ti"],[15,22,"portare"],[23,25,"in"],[26,31,"poco"],[32,35,"ora"],[36,39,"a"],[40,45,"altro"],[46,51,"mondo"]]},{"it":"— Non me n’importa…","ja":"","t":[[2,5,"non"],[6,8,"me"],[9,10,0],[11,18,"importare"]]},{"it":"— Non hai paura della morte?","ja":"","t":[[2,5,"non"],[6,9,"avere"],[10,15,"paura"],[16,21,"di"],[22,27,"morto"]]},{"it":"— Punto paura!","ja":"","t":[[2,7,"punto"],[8,13,"paura"]]},{"it":"Piuttosto morire, che bevere quella medicina cattiva.","ja":"","t":[[0,9,"piuttosto"],[10,16,"morire"],[18,21,"che"],[22,28,0],[29,35,"quello"],[36,44,"medicina"],[45,52,"cattivo"]]},{"it":"—","ja":"","t":[]},{"it":"A questo punto, la porta della camera si spalancò, ed entrarono dentro quattro conigli neri come l’inchiostro, che portavano sulle spalle una piccola bara da morto.","ja":"","t":[[0,1,"a"],[2,8,"questo"],[9,14,"punto"],[16,18,"il"],[19,24,"porta"],[25,30,"di"],[31,37,"camera"],[38,40,"si"],[41,49,"spalancare"],[51,53,"e"],[54,63,"entrare"],[64,70,"dentro"],[71,78,"quattro"],[79,86,"coniglio"],[87,91,"nero"],[92,96,"come"],[97,98,"il"],[99,109,"inchiostro"],[111,114,"che"],[115,124,"portare"],[125,130,"su"],[131,137,"spalla"],[138,141,"un"],[142,149,"piccolo"],[150,154,0],[155,157,"da"],[158,
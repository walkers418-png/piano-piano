elli; e in presenza a loro, infilatosi quel pipone fra i labbri, cominciò a fumare con lo stesso garbo e con la stessa disinvoltura, come avrebbe fatto un vecchio marinaio.","ja":"","t":[[0,6,"appena"],[7,15,"arrivare"],[16,17,"a"],[18,22,"casa"],[24,30,"chiamare"],[31,37,"subito"],[39,43,"tutto"],[44,51,"allegro"],[53,55,"il"],[56,61,"babbo"],[63,65,"il"],[66,71,"mamma"],[72,73,"e"],[74,75,"il"],[76,84,"fratello"],[86,87,"e"],[88,90,"in"],[91,99,"presenza"],[100,101,"a"],[102,106,"loro"],[108,118,"infilare"],[119,123,"quello"],[124,130,0],[131,134,"fra"],[135,136,"il"],[137,143,"labbro"],[145,153,"cominciare"],[154,155,"a"],[156,162,"fumare"],[163,166,"con"],[167,169,"il"],[170,176,"stesso"],[177,182,"garbo"],[183,184,"e"],[185,188,"con"],[189,191,"il"],[192,198,"stesso"],[199,211,0],[213,217,"come"],[218,225,"avere"],[226,231,"fare"],[232,234,"un"],[235,242,"vecchio"],[243,251,"marinaio"]]},{"it":"La mamma e i fratelli, a vedergli uscir di bocca quelle nuvole di fumo, ridevano come matti: ma il suo babbo, che era uno scimmione pieno di giudizio e di esperienza di mondo, gli disse in tono di avvertimento salutare:","ja":"","t":[[0,2,"il"],[3,8,"mamma"],[9,10,"e"],[11,12,"il"],[13,21,"fratello"],[23,24,"a"],[25,33,"vedere"],[34,39,"uscire"],[40,42,"di"],[43,48,"bocca"],[49,55,"quello"],[56,62,"nuvola"],[63,65,"di"],[66,70,"fumo"],[72,80,"ridere"],[81,85,"come"],[86,91,"matto"],[93,95,"ma"],[96,98,"il"],[99,102,"suo"],[103,108,"babbo"],[110,113,"che"],[114,117,"essere"],[118,121,"un"],[122,131,0],[132,137,"pieno"],[138,140,"di"],[141,149,"giudizio"],[150,151,"e"],[152,154,"dire"],[155,165,"esperienza"],[166,168,"di"],[169,174,"mondo"],[176,179,"il"],[180,185,"dire"],[186,188,"in"],[189,193,"tono"],[194,196,"di"],[197,209,0],[210,218,"salutare"]]},{"it":"― Bada, Pipì!","ja":"","t":[[2,6,"badare"],[8,12,0]]},{"it":"A furia di scimmiottare gli uomini, un giorno o l’altro diventerai un uomo anche tu.... e allora!","ja":"","t":[[0,1,"a"],[2,7,"furia"],[8,10,"di"],[11,23,0